    if overrideEarned and overrideEarned > 0 and overrideEarned <= 350000 then
        diff = overrideEarned
        shouldCountKill = true
        _lastKnownBounty = cur
    elseif not isAt30M and cur > _lastKnownBounty then
        diff = cur - _lastKnownBounty
        if diff <= 350000 then
            shouldCountKill = true
        end
        _lastKnownBounty = cur
    elseif cur < _lastKnownBounty then
        local lost = _lastKnownBounty - cur
        _lastKnownBounty = cur
