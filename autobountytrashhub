local function resolveTargetHrp(target)
    if not target then return nil end
    if typeof(target) == "Instance" then
        if target:IsA("Player") and target.Character then
            return target.Character:FindFirstChild("HumanoidRootPart") or target.Character.PrimaryPart
        elseif target:IsA("Model") then
            return target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")
        elseif target:IsA("BasePart") then
            return target
        end
    end
    return nil
end

local function calculateLandingCFrame(targetHrp, mode, offsetDist, overheadH, autoFace)
    local targetCF = targetHrp.CFrame
    local targetPos = targetCF.Position
    local look = targetCF.LookVector
    local flatLook = Vector3.new(look.X, 0, look.Z)
    flatLook = flatLook.Magnitude > 1e-5 and flatLook.Unit or Vector3.new(0, 0, -1)
    local dist = offsetDist or 4.0
    local height = overheadH or 4.5

    local landingPos
    if mode == "Front" then
        landingPos = targetPos + (flatLook * dist) + Vector3.new(0, 0.5, 0)
    elseif mode == "Overhead" then
        landingPos = targetPos + Vector3.new(0, height, 0)
    elseif mode == "Direct" then
        landingPos = targetPos + Vector3.new(0, 1.0, 0)
    else
        landingPos = targetPos - (flatLook * dist) + Vector3.new(0, 0.5, 0)
    end
    if landingPos.Y > -140 and landingPos.Y < 5.5 and landingPos.X < 45000 and landingPos.Z < 30000 then
        landingPos = Vector3.new(landingPos.X, 5.5, landingPos.Z)
    end

    if autoFace then
        local aim = Vector3.new(targetPos.X, landingPos.Y, targetPos.Z)
        if (aim - landingPos).Magnitude <= 1e-5 then aim = landingPos + flatLook end
        return CFrame.lookAt(landingPos, aim)
    else
        return CFrame.new(landingPos) * (targetCF - targetPos)
    end
end

