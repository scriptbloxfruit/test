function Hunter.Destroy()
    Hunter._isRunning = false
    if Hunter.Noclip then pcall(Hunter.Noclip.Destroy, Hunter.Noclip) end
    if Hunter.PortalRuntime then pcall(Hunter.PortalRuntime.Destroy) end
    if Hunter._cancelHop then pcall(Hunter._cancelHop) end
    if Hunter._stopHopScanner then pcall(Hunter._stopHopScanner) end
    if Hunter.GunM1 then pcall(Hunter.GunM1.Destroy, Hunter.GunM1) end
    if Hunter.M1GunAim then pcall(Hunter.M1GunAim.Destroy, Hunter.M1GunAim) end
    if Hunter.ArenaCheck then pcall(Hunter.ArenaCheck.Destroy) end
    if Hunter.PortalXTracker then pcall(Hunter.PortalXTracker.Destroy) end
    if Hunter.ObservationHaki then pcall(Hunter.ObservationHaki.Stop) end
    if Hunter.KenCheck and type(Hunter.KenCheck.Destroy) == "function" then pcall(Hunter.KenCheck.Destroy) end
        if Hunter.SkillCheck then pcall(Hunter.SkillCheck.ClearCache) end
    if Hunter.SkillDodge then pcall(Hunter.SkillDodge.Destroy, Hunter.SkillDodge) end
    if Hunter.WaterWalker then pcall(Hunter.WaterWalker.Destroy, Hunter.WaterWalker) end
    if Hunter.SoruApproach then pcall(Hunter.SoruApproach.Destroy, Hunter.SoruApproach) end
    if Hunter.GhostShipRoute then pcall(Hunter.GhostShipRoute.Destroy, Hunter.GhostShipRoute) end
    if Hunter.Sea3TeleporterRoute then pcall(Hunter.Sea3TeleporterRoute.Destroy, Hunter.Sea3TeleporterRoute) end
    if Hunter.AntiLava then pcall(Hunter.AntiLava.Destroy, Hunter.AntiLava) end
    pcall(function() Hunter.Kinematics:Destroy() end)
    if Hunter.Motion then pcall(Hunter.Motion.Destroy, Hunter.Motion) end
    if Hunter.LowHealthGuard then pcall(Hunter.LowHealthGuard.Destroy, Hunter.LowHealthGuard) end
    if Hunter.LowHealthEscape then pcall(Hunter.LowHealthEscape.Stop, "destroy") end
    for _, conn in ipairs(Hunter._connections) do pcall(function() conn:Disconnect() end) end
    pcall(function() RunService:UnbindFromRenderStep("BF_AimOverride_Post") end)
    if Hunter._laserAdorn then pcall(function() Hunter._laserAdorn:Destroy() end) end
    if Hunter._targetHighlight then pcall(function() Hunter._targetHighlight:Destroy() end) end
    if Hunter._skeletonLines then
        for _, line in pairs(Hunter._skeletonLines) do
            if line and type(line.Remove) == "function" then
                pcall(function() line:Remove() end)
            end
        end
        Hunter._skeletonLines = {}
    end
    if Hunter._hudConn then
        pcall(function() Hunter._hudConn:Disconnect() end)
        Hunter._hudConn = nil
    end
    if Hunter._hudConnections then
        for _, conn in ipairs(Hunter._hudConnections) do
            pcall(function() conn:Disconnect() end)
        end
        Hunter._hudConnections = nil
    end
    if Hunter._gui then pcall(function() Hunter._gui:Destroy() end) end
    pcall(function()
        for _, gName in ipairs({"TrashHub_FluentNotifyGui", "HopToastGui"}) do
            local c = game:GetService("CoreGui"):FindFirstChild(gName)
            if c then c:Destroy() end
            local pgui = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
            local p = pgui and pgui:FindFirstChild(gName)
            if p then p:Destroy() end
            if type(gethui) == "function" then
                local hui = gethui()
                local h = hui and hui:FindFirstChild(gName)
                if h then h:Destroy() end
            end
        end
    end)
    pcall(function()
        local wp = Workspace:FindFirstChild("BF_WaterWalkerPlatform")
        if wp then wp:Destroy() end
    end)
    setHover(false)
    if Hunter._bloxMouse then
        pcall(function()
            rawset(Hunter._bloxMouse, "Hit", Hunter._storedHit or RealMouse.Hit)
            rawset(Hunter._bloxMouse, "Target", Hunter._storedTarget or RealMouse.Target)
            rawset(Hunter._bloxMouse, "X", Hunter._storedX or RealMouse.X)
            rawset(Hunter._bloxMouse, "Y", Hunter._storedY or RealMouse.Y)
        end)
    end
    for _, connName in ipairs({
        "_TrashHub_SoundMuteConn", "_TrashHub_CleanMapConn", "_TrashHub_SeatConn",
        "_TrashHub_MainCharConn", "_TrashHub_KenCharConn", "_TrashHub_SpawnCombatConn", "_TrashHubNoclipConn",
        "_TrashHub_KenChildConn", "_TrashHub_KenAttrConn", "_TrashHub_NotifConn", "_TrashHub_EscapeConn",
        "_TrashHub_CameraConn", "_TrashHub_DiedConn", "_TrashHub_ZeroDelayConn",
        "_TrashHub_LowHpHeartbeat", "_TrashHub_V4EnergyConn", "_TrashHub_V4ChildConn",
        "_TrashHub_V4CharConn"
    }) do
        pcall(function()
            if getgenv()[connName] then
                getgenv()[connName]:Disconnect()
                getgenv()[connName] = nil
            end
        end)
    end
    getgenv()._BF_HunterKiller = nil
    getgenv()._BF_AimBot = nil
    getgenv()._TrashHub_GCLoopGen = nil
    getgenv()._TrashHub_BoostGen = nil
    if getgenv()._TrashHub_BoostConnections then
        for _, c in ipairs(getgenv()._TrashHub_BoostConnections) do
            pcall(function() c:Disconnect() end)
        end
        getgenv()._TrashHub_BoostConnections = nil
    end
    if getgenv()._TrashHub_NotifTextConns then
        for _, c in ipairs(getgenv()._TrashHub_NotifTextConns) do
            pcall(function() c:Disconnect() end)
        end
        getgenv()._TrashHub_NotifTextConns = nil
    end
    if getgenv()._TrashHub_HealthConns then
        for _, conn in ipairs(getgenv()._TrashHub_HealthConns) do
            pcall(function() conn:Disconnect() end)
        end
        getgenv()._TrashHub_HealthConns = nil
    end
    isHopping = false
    Hunter._isHealingInSky = false
end
do
    local bootState = getgenv()._TrashHubBootState
    if bootState and bootState.JobId == game.JobId then
        bootState.Phase = "ready"
        bootState.ReadyAt = os.time()
    end
    print("[TrashHub][BOOT_READY] JobId=" .. tostring(game.JobId))
end
return Hunter
