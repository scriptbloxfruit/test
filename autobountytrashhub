    function api:IsSelfStunDodging()
        if not self.Enabled or self.Destroyed or not Hunter.TargetPlayer then
            self.StunDodgeUntil = 0
            self._hasSnappedForCurrentStun = false
            self._grabLockedDuringStun = false
            return false
        end
        local now = os.clock()
        local myChar = LocalPlayer and LocalPlayer.Character
        if myChar and Hunter.StunCheck and Hunter.StunCheck.IsInGodhumanZ and Hunter.StunCheck.IsInGodhumanZ(myChar) then
            return false
        end
        if myChar and Hunter.StunCheck and Hunter.StunCheck.IsRealStun then
            local isStunned = Hunter.StunCheck.IsRealStun(myChar)
            if isStunned then
                local myRoot = myChar:FindFirstChild("HumanoidRootPart")
                local tPart = Hunter.TargetPart
                local inRange = true
                if myRoot and tPart and tPart.Parent then
                    inRange = (myRoot.Position - tPart.Position).Magnitude <= (self.MaxProximity or 250)
                end
                if inRange then
                    if now >= (self.StunDodgeUntil or 0) and now >= (self.EnemyDodgeUntil or 0) then
                        self.ShotsInCurrentDodge = 0
                    end
                    self.StunDodgeUntil = math.max(self.StunDodgeUntil or 0, now + (self.StunHoldAfterClear or 0.5))
                    if type(activateRaceV3) == "function" then
                        pcall(activateRaceV3)
                    end
                end
                -- Universal Stun Dodge: Do not abort dodge on server physics lock!
                if Hunter.StunCheck.IsServerPhysicsLocked and Hunter.StunCheck.IsServerPhysicsLocked(myChar) then
                    self.StunDodgeUntil = math.max(self.StunDodgeUntil or 0, now + (self.StunHoldAfterClear or 0.5))
                end
            else
                if now >= (self._grabLockUntil or 0) then
                    self._grabLockedDuringStun = false
                    self._hasSnappedForCurrentStun = false
                else
                    return false
                end
            end
