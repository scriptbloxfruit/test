            tPos.X + (api.SkyLateralOffsetX or 55),
            tPos.Y + (api.SkyHeightOffset or 120),
            tPos.Z + (api.SkyLateralOffsetZ or 35)
        )
        if (mPos - tPos).Magnitude <= api.DirectTeleportRange then
            local lookAtPos = Hunter.PredictedPos or tPos
            local nextCF = Hunter.Kinematics:LookAt(skyGoal, lookAtPos, myRoot.CFrame)
            if Hunter.AntiLava then
                nextCF = Hunter.AntiLava:FilterMove(myRoot, myHum, nextCF)
            end
            if Hunter.GhostShipRoute then
                nextCF = Hunter.GhostShipRoute:ClampInteriorCFrame(myRoot, nextCF)
            end
            myRoot.CFrame = nextCF
            myRoot.AssemblyLinearVelocity = Vector3.zero
            myRoot.AssemblyAngularVelocity = Vector3.zero
            _lastControlledCombatPos = nextCF.Position
            _lastControlledTargetPos = tPos
            _lastControlledCombatTick = tick()
        end
    end

    local function markMultiHitGrabStun()
        local now = os.clock()
        api._grabLockedDuringStun = true
        api._grabLockUntil = math.max(api._grabLockUntil or 0, now + 0.28)
        api.StunDodgeUntil = math.max(api.StunDodgeUntil or 0, now + (api.StunHoldAfterClear or 0.5))
        -- Universal Stun Dodge: Do NOT pause kinematics or disable hover! Snap sky immediately!
        snapToSkyAboveTarget()
    end

    local function triggerSelfStunDodge(stunSource)
        if not api.Enabled or api.Destroyed or not Hunter._isRunning then return end
        if not Hunter.TargetPlayer or Hunter._isHealingInSky or _isPortalWarping or isHopping then return end
        local myChar, myHum, myRoot = getCharacter()
        if not myRoot or not myHum or myHum.Health <= 0 then return end
        if Hunter.StunCheck and Hunter.StunCheck.IsInGodhumanZ and Hunter.StunCheck.IsInGodhumanZ(myChar) then return end
        local tPart = Hunter.TargetPart
        if not tPart or not tPart.Parent then return end
        if (myRoot.Position - tPart.Position).Magnitude > (api.MaxProximity or 250) then return end

        local now = os.clock()
        if Hunter.StunCheck then
            Hunter.StunCheck._lastRealStunAt = now
        end
        if now >= (api.StunDodgeUntil or 0) and now >= (api.EnemyDodgeUntil or 0) then
            api.ShotsInCurrentDodge = 0
        end
        api.StunDodgeUntil = math.max(api.StunDodgeUntil or 0, now + (api.StunHoldAfterClear or 0.5))
        api.LastThreatPlayer = Hunter.TargetPlayer
        api.ActiveMode = "STUN_DODGE"

        if Hunter._skillHeldKey then
            pcall(function() VirtualInputManager:SendKeyEvent(false, Hunter._skillHeldKey, false, game) end)
            Hunter._skillHeldKey = nil
        end
        isSkillHolding = false
        Hunter._isPreparingSkillCast = false
        if type(activateRaceV3) == "function" then
            pcall(activateRaceV3)
        end

        if stunSource == "SHV2CGrabbed" or stunSource == "MagnetLanding" or myRoot.Anchored then
            markMultiHitGrabStun()
            snapToSkyAboveTarget()
            return
        end

        if not api._hasSnappedForCurrentStun then
            api._hasSnappedForCurrentStun = true
            api._lastStunEntryAt = now
            snapToSkyAboveTarget()
        elseif (now - (api._lastStunEntryAt or 0)) > 0.04 then
            local tPos = (Hunter.PortalXTracker and Hunter.TargetPlayer and Hunter.PortalXTracker.GetRealPosition(Hunter.TargetPlayer)) or tPart.Position
            if (myRoot.Position.Y - tPos.Y) < 60 then
                markMultiHitGrabStun()
            end
        end
    end

    local function hookLocalCharacter(char)
        disconnectList(api._localCharConns)
        api._hasSnappedForCurrentStun = false
        api._grabLockedDuringStun = false
        api._grabLockUntil = 0
        if not char or api.Destroyed then return end
        local conns = api._localCharConns

        local function bindStunValue(stunObj)
            if not stunObj or not stunObj:IsA("ValueBase") then return end
            local prevVal = tonumber(stunObj.Value) or 0
            local wasActive = prevVal > 0
            if wasActive then
                triggerSelfStunDodge("StunValue")
            end
            table.insert(conns, stunObj:GetPropertyChangedSignal("Value"):Connect(function()
                local nowVal = tonumber(stunObj.Value) or 0
                local nowActive = nowVal > 0
                local now = os.clock()
                if nowActive then
                    if Hunter.StunCheck then
                        Hunter.StunCheck._lastRealStunAt = now
                    end
                    if not wasActive then
                        api._hasSnappedForCurrentStun = false
                        triggerSelfStunDodge("StunValue")
                    else
                        if api.Enabled and not api.Destroyed and Hunter.TargetPlayer then
                            api.StunDodgeUntil = math.max(api.StunDodgeUntil or 0, now + (api.StunHoldAfterClear or 0.5))
                        end
                        if nowVal > prevVal + 0.005 and (now - (api._lastStunEntryAt or 0)) > 0.03 then
                            markMultiHitGrabStun()
                        elseif api._grabLockedDuringStun then
                            api._grabLockUntil = math.max(api._grabLockUntil or 0, now + 0.25)
                        end
                    end
                else
                    if not api._grabLockedDuringStun then
                        api._hasSnappedForCurrentStun = false
                    end
                end
                prevVal = nowVal
                wasActive = nowActive
            end))
        end

        local existingStun = char:FindFirstChild("Stun")
        if existingStun then bindStunValue(existingStun) end

        table.insert(conns, char.ChildAdded:Connect(function(child)
            if child.Name == "Stun" then
                bindStunValue(child)
            elseif child.Name == "SHV2CGrabbed" or child.Name == "MagnetLanding" then
                triggerSelfStunDodge(child.Name)
            end
        end))

        task.spawn(function()
            local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 2.0)
            if not hum or LocalPlayer.Character ~= char or api.Destroyed then return end
            local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 2.0)
            if animator and LocalPlayer.Character == char and not api.Destroyed then
                table.insert(conns, animator.AnimationPlayed:Connect(function(track)
                    if not api.Enabled or api.Destroyed then return end
                    local anim = track and track.Animation
                    if not anim then return end
                    local animId = tostring(anim.AnimationId or "")
                    local animName = tostring(anim.Name or "")
                    if animName:sub(1, 4) == "Stun"
                        or animId:find("18494058576", 1, true)
                        or animId:find("18494061159", 1, true)
                        or animId:find("18494062997", 1, true)
                        or animId:find("18561611486", 1, true)
                        or animId:find("18494066274", 1, true)
                        or animId:find("18494064880", 1, true)
                        or animId:find("18494068064", 1, true)
                        or animId:find("75845415758616", 1, true)
                        or animId:find("18494070495", 1, true)
                    then
                        triggerSelfStunDodge("StunAnim")
                    end
                end))
            end
        end)
    end

    if LocalPlayer.Character then hookLocalCharacter(LocalPlayer.Character) end
    table.insert(api._connections, LocalPlayer.CharacterAdded:Connect(hookLocalCharacter))
