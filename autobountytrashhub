local function getToolByType(toolType)
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local function matchTool(item)
        if not (item and item:IsA("Tool")) then return false end
        local tt = tostring(item.ToolTip or "")
        local wt = tostring(item:GetAttribute("WeaponType") or "")
        if toolType == "Fruit" or toolType == "Blox Fruit" then
            return tt == "Blox Fruit" or wt == "Demon Fruit" or wt == "Blox Fruit"
        elseif toolType == "Sword" then
            return tt == "Sword" or wt == "Sword"
        elseif toolType == "Melee" then
            return tt == "Melee" or wt == "Melee" or tt == "Combat"
        elseif toolType == "Gun" then
            return tt == "Gun" or wt == "Gun"
        end
        return false
    end
    if char then
        for _, item in ipairs(char:GetChildren()) do
            if matchTool(item) then return item end
        end
    end
    if bp then
        for _, item in ipairs(bp:GetChildren()) do
            if matchTool(item) then return item end
        end
    end
    return nil
end
