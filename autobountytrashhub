    local function breakRunningDoorXLoopIfNeeded(plr, char, hrp)
        local st = getPlayerState(plr)
        local doorMode = char and char:FindFirstChild("DoorMode")

        if doorMode then
            st.InPortalX = true
            if st.StartTime == 0 then
                st.StartTime = os.clock()
            end

            if hrp then
                hrp.Anchored = false
            end
            st.DetachedDoorMode = doorMode

            local ancConn
            ancConn = doorMode.AncestryChanged:Connect(function(_, newParent)
                if newParent == nil then
                    st.InPortalX = false
                    st.DetachedDoorMode = nil
                    if ancConn and ancConn.Connected then
                        ancConn:Disconnect()
                    end
                end
            end)
            table.insert(_connections, ancConn)

            pcall(function()
                doorMode.Parent = ReplicatedStorage
            end)
        elseif st.DetachedDoorMode then
            if st.DetachedDoorMode.Parent == nil or (os.clock() - st.StartTime) > (st.Duration + 0.5) then
                st.InPortalX = false
                st.DetachedDoorMode = nil
            else
                st.InPortalX = true
            end
        else
            st.InPortalX = false
            st.StartTime = 0
        end

        if hrp and hrp.Anchored and st.InPortalX then
            hrp.Anchored = false
        end

        if hrp and not isSpoofedPortalPosition(hrp.Position) then
            st.LastValidCFrame = hrp.CFrame
        end
