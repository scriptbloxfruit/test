function SoruBody:CanSoru(target)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if not char or not hrp or not hum or hum.Health <= 0 then
        return false, "Character not ready or dead"
    end

    if self.Destroyed or not self.Enabled then return false, "soru-disabled" end
    if not char:HasTag("Soru") then return false, "soru-not-unlocked" end
    if hum.Sit then return false, "character-seated" end
    if globalState and globalState.Swimming then
        globalState.Swimming = false
    end
    if hum:GetState() == Enum.HumanoidStateType.Swimming then
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool and tool:GetAttribute("State") == "StartCasting" then return false, "skill-casting" end
    if not char:FindFirstChild("DoorMode") and (char:FindFirstChild("Phoenix")
        or char:FindFirstChild("Dragon") or char:FindFirstChild("DisableMovement")) then
        return false, "movement-disabled"
    end
    if Hunter and Hunter.IsActionLocked then
        local locked, lockReason = Hunter.IsActionLocked(char)
        if locked then
            return false, "Action locked: " .. tostring(lockReason)
        end
    end
    local busy = char:FindFirstChild("Busy")
    if busy and busy.Value == true then
        return false, "Currently in Busy state"
    end

    local stun = char:FindFirstChild("Stun")
    if stun and stun.Value > 0 then
        return false, "Currently Stunned"
    end

    local energy = char:FindFirstChild("Energy")
    if not energy then return false, "energy-unavailable" end
    if energy.Value < 10 then
        return false, "Not enough energy (Need at least 10 Energy)"
    end

    if hrp.Anchored then
        return false, "Character is Anchored"
    end

    if target then
        local targetHrp = resolveTargetHrp(target)
        local targetPosition = typeof(target) == "Vector3" and target or targetHrp and targetHrp.Parent and targetHrp.Position
        if not targetPosition then
            return false, "Target does not exist or left game"
        end
        local dist = (targetPosition - hrp.Position).Magnitude
        local maxRange = self:GetMaxRange()
        if dist > maxRange then
            return false, string.format("Target too far (%.1f > Max %.0f studs)", dist, maxRange)
        end
    end

    local cooldown = self:GetCooldownInfo()
    if not cooldown.Ready then return false, "soru-cooldown" end
    return true, "Ready"
end

function SoruBody:To(target, mode, offsetDist)
    if not self.Enabled then
        return false, "SoruBody module is disabled"
    end

    target = target or self.ActiveTarget
    if not target then
        local err = "No target provided"
        if type(self.OnSoruFailed) == "function" then task.spawn(pcall, self.OnSoruFailed, err, nil) end
        return false, err
    end

    local ready, readyReason = self:CanSoru(target)
    if not ready then
        if type(self.OnSoruFailed) == "function" then task.spawn(pcall, self.OnSoruFailed, readyReason, target) end
        return false, readyReason
    end
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not myHrp or not myHum or myHum.Health <= 0 then
        local err = "Player character not spawned"
        if type(self.OnSoruFailed) == "function" then task.spawn(pcall, self.OnSoruFailed, err, target) end
        return false, err
    end

    local destCF
    local targetDesc = "Coordinates"

    if typeof(target) == "Vector3" then
        destCF = CFrame.new(target)
        targetDesc = string.format("Pos(%.0f, %.0f, %.0f)", target.X, target.Y, target.Z)
    else
        local targetHrp = resolveTargetHrp(target)
        if not targetHrp or not targetHrp.Parent then
            local err = "Target HumanoidRootPart not found"
            if type(self.OnSoruFailed) == "function" then task.spawn(pcall, self.OnSoruFailed, err, target) end
            return false, err
        end

        local dist = (targetHrp.Position - myHrp.Position).Magnitude
        local maxRange = self:GetMaxRange()
        if dist > maxRange then
            local err = string.format("Target too far (%.0f studs > limit %.0f studs)", dist, maxRange)
            if type(self.OnSoruFailed) == "function" then task.spawn(pcall, self.OnSoruFailed, err, target) end
            return false, err
        end

        local useMode = mode or self.DefaultMode or "Behind"
        local useDist = offsetDist or self.OffsetDist or 2.0
        destCF = calculateLandingCFrame(targetHrp, useMode, useDist, self.OverheadHeight, self.AutoFaceTarget)
        targetDesc = targetHrp.Parent.Name
    end

    if type(self.LandingFilter) == "function" then
        local ok, filtered, reason = pcall(self.LandingFilter, destCF, target)
        if not ok then return false, tostring(filtered) end
        if typeof(filtered) ~= "CFrame" then return false, reason or "landing-unavailable" end
        destCF = filtered
    end
    local position = destCF.Position
    if position.X ~= position.X or position.Y ~= position.Y or position.Z ~= position.Z
        or math.abs(position.X) == math.huge or math.abs(position.Y) == math.huge or math.abs(position.Z) == math.huge then
        return false, "landing-invalid"
    end
    if LocalPlayer.Character ~= myChar or myHrp.Parent ~= myChar then return false, "character-changed" end
    local stillReady, stillReason = self:CanSoru(target)
    if not stillReady then return false, stillReason end
    if (destCF.Position - myHrp.Position).Magnitude > self:GetMaxRange() then return false, "landing-out-of-range" end
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local commE = remotes and remotes:FindFirstChild("CommE")
    if not commE or not commE:IsA("RemoteEvent") then return false, "soru-remote-unavailable" end
    local cooldown = self:GetCooldownInfo()
    local startCF, endCF = myHrp.CFrame, destCF
    local sent, sendError = pcall(function()
        commE:FireServer("Soru", startCF, endCF, Workspace:GetServerTimeNow(), math.random(1, 999999999))
    end)
    if not sent then return false, tostring(sendError) end
    ownLastUse = tick()
    if nativeCharacter == myChar and nativeScript == myChar:FindFirstChild("Soru") and nativeState then
        nativeState.LastUse = ownLastUse
    end
    if cooldown.UseCharge then myHum:SetAttribute("SoruCharges", math.max(0, cooldown.Charges - 1)) end
    myHrp.AssemblyLinearVelocity, myHrp.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
    myHrp.CFrame = endCF

    if type(self.OnSoruSuccess) == "function" then
        task.spawn(pcall, self.OnSoruSuccess, target, endCF.Position)
    end

    return true, string.format("Soru success to %s!", targetDesc)
end

function SoruBody:ToNearestPlayer(mode, offsetDist, maxRange)
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return false, "Missing HumanoidRootPart" end

    local rangeLimit = maxRange or self:GetMaxRange()
    local bestHrp, bestDist = nil, rangeLimit

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - myHrp.Position).Magnitude
                if d <= bestDist then
                    bestDist = d
                    bestHrp = hrp
                end
            end
        end
    end

    if bestHrp then
        return self:To(bestHrp, mode, offsetDist)
    end
    return false, "No players in Soru range"
end

function SoruBody:ToNearestMob(mode, offsetDist, maxRange)
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return false, "Missing HumanoidRootPart" end

    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies then return false, "Enemies folder not found" end

    local rangeLimit = maxRange or self:GetMaxRange()
    local bestHrp, bestDist = nil, rangeLimit

    for _, mob in ipairs(enemies:GetChildren()) do
        local hrp = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
        local hum = mob:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then
            local d = (hrp.Position - myHrp.Position).Magnitude
            if d <= bestDist then
                bestDist = d
                bestHrp = hrp
            end
        end
    end

    if bestHrp then
        return self:To(bestHrp, mode, offsetDist)
    end
    return false, "No mobs in Soru range"
end

function SoruBody:SetTarget(target)
    self.ActiveTarget = target
    return self
end

function SoruBody:GetTarget()
    return self.ActiveTarget
end

function SoruBody:BindKey(keyCode, mode, offsetDist)
    keyCode = keyCode or Enum.KeyCode.R
    self:UnbindKey()

    self._boundKey = keyCode
    self._keyConnection = UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if UserInputService:GetFocusedTextBox() then return end

        if input.KeyCode == keyCode then
            local target = self.ActiveTarget
            if target then
                self:To(target, mode, offsetDist)
            else
                self:ToNearestPlayer(mode, offsetDist)
            end
        end
    end)
    table.insert(self._connections, self._keyConnection)
    return self
end

function SoruBody:UnbindKey()
    if self._keyConnection then
        pcall(function() self._keyConnection:Disconnect() end)
        self._keyConnection = nil
    end
    self._boundKey = nil
    return self
end

function SoruBody:HookMouseHit(enable)
    self._hookActive = (enable ~= false)
    return self
end

function SoruBody:Destroy()
    self.Destroyed = true
    bindingSerial += 1
    nativeState, nativeScript, nativeCharacter, globalState = nil, nil, nil, nil
    self.LandingFilter = nil
    self.Enabled = false
    self._hookActive = false
    self:UnbindKey()

    for _, c in ipairs(self._connections) do
        pcall(function() c:Disconnect() end)
    end
    self._connections = {}
    self.ActiveTarget = nil

    if ENV.SoruBody == self then ENV.SoruBody = nil end
    if ENV._SoruHookSystem == self then ENV._SoruHookSystem = nil end
end

ENV.SoruBody = SoruBody
return SoruBody
end)()

Hunter.SoruApproach = (function()
    local CollectionService = game:GetService("CollectionService")
    local api = {LastReason = "ready", Uses = 0, LastUseAt = -math.huge, LastKind = nil}

    Hunter.SoruBody.LandingFilter = function(cframe, target)
        local _, hum, root = getCharacter()
        if not root or not hum or hum.Health <= 0 then return nil, "character-unavailable" end
        local landing = Hunter.AntiLava:FilterMove(root, hum, cframe)
        if Hunter.GhostShipRoute then landing = Hunter.GhostShipRoute:ClampInteriorCFrame(root, landing) end
        local part = typeof(target) == "Instance" and target:IsA("BasePart") and target or nil
        if part and (landing.Position - part.Position).Magnitude > Hunter.GunM1:GetComboDistance() then
            return nil, "landing-outside-combo-range"
        end
        return landing
    end

    local function directRange()
        local cfg = Hunter.Config or CONFIG
        if cfg.ComboTeleportEnabled == false then return 0 end
        return math.clamp(tonumber(cfg.ComboTeleportRange) or 100, 0, 100)
    end
    function api:IsPending(root, humanoid, targetPart)
        if self.Destroyed or not root or not humanoid or humanoid.Health <= 0 or not targetPart
            or not targetPart.Parent or targetPart ~= Hunter.TargetPart or Hunter.TargetSuspended then return false end
        local distance = (targetPart.Position - root.Position).Magnitude
        local cooldown = math.max(tonumber((Hunter.Config or CONFIG).ComboTeleportCooldown) or 0.8, 0.15)
        return distance > math.max(Hunter.GunM1:GetComboDistance() + 2, 12)
            and distance <= directRange() and os.clock() - self.LastUseAt >= cooldown
    end
    function api:TryApproach(root, humanoid, targetPart)
        local cfg, player, char = Hunter.Config or CONFIG, Hunter.TargetPlayer, Hunter.TargetCharacter
        local function reject(reason) self.LastReason = reason; return false end
        if self.Destroyed or not Hunter._isRunning or isHopping or _isPortalWarping
            or Hunter._isGhostShipRouting or Hunter._isHealingInSky or Hunter.TargetSuspended
            or CollectionService:HasTag(LocalPlayer, "Teleporting") then return reject("movement-in-progress") end
        if not root or not humanoid or humanoid.Health <= 0 or not player or player.Character ~= char
            or not isAlive(char) or not targetPart or targetPart ~= Hunter.TargetPart
            or not targetPart:IsDescendantOf(char) then return reject("target-unavailable") end
        if isSkillHolding or Hunter._skillHeldKey or Hunter._isPreparingSkillCast then return reject("skill-casting") end
        local myChar = root.Parent
        if root.Anchored then return reject("character-anchored") end
        if Hunter.IsActionLocked then
            local locked, why = Hunter.IsActionLocked(myChar)
            if locked then return reject("action-locked:" .. tostring(why)) end
        end
        if Hunter.StunCheck and Hunter.StunCheck.IsRealStun and Hunter.StunCheck.IsRealStun(myChar) then return reject("stunned") end
        if Hunter.SkillDodge and Hunter.SkillDodge:ShouldKiteInSky() then return reject("dodge-active") end
        if Hunter.GhostShipRoute:GetArea(root.Position) ~= Hunter.GhostShipRoute:GetArea(targetPart.Position) then
            return reject("room-door-required")
        end
        if Hunter.Sea3TeleporterRoute and Hunter.Sea3TeleporterRoute.Busy then return reject("route-active") end
        if not isLocalPlayerInPortalDimension() and (
            (Hunter.PortalXTracker and Hunter.PortalXTracker.IsInPortalX(player)) or isTargetUsingPortalDimension(player)
        ) then return reject("target-in-portal-dimension") end
        local position = (Hunter.PortalXTracker and Hunter.PortalXTracker.GetRealPosition(player)) or targetPart.Position
        if isLocalPlayerInPortalDimension() and not isPlayerInPortalVDimension(player) then return reject("different-dimension") end
        local distance = (position - root.Position).Magnitude
        if distance <= math.max(Hunter.GunM1:GetComboDistance() + 2, 12) then return reject("already-in-combo-range") end
        local cooldown = math.max(tonumber(cfg.ComboTeleportCooldown) or 0.8, 0.15)
        if os.clock() - self.LastUseAt < cooldown then return reject("approach-debounce") end
        local used, reason
        if distance <= directRange() then
            local look = targetPart.CFrame.LookVector
            local flat = Vector3.new(look.X, 0, look.Z)
            flat = flat.Magnitude > 0.001 and flat.Unit or Vector3.new(0, 0, -1)
            local landingPos = position - flat * 3 + Vector3.new(0, 0.5, 0)
            if landingPos.Y > -140 and landingPos.Y < 5.5 and landingPos.X < 45000 and landingPos.Z < 30000
                and not isLocalPlayerInPortalDimension() then landingPos = Vector3.new(landingPos.X, 5.5, landingPos.Z) end
            local landing = Hunter.Kinematics:LookAt(landingPos, Vector3.new(position.X, landingPos.Y, position.Z), root.CFrame)
            local filtered, filterReason = Hunter.SoruBody.LandingFilter(landing, targetPart)
            if not filtered then return reject(filterReason or "landing-unavailable") end
            if Hunter.TargetPlayer ~= player or Hunter.TargetPart ~= targetPart or Hunter.TargetCharacter ~= char
                or LocalPlayer.Character ~= myChar or root.Parent ~= myChar then return reject("target-or-character-changed") end
            setHover(true)
            root.CFrame = filtered
            root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
            used, reason, self.LastKind = true, "direct-combo-teleport", "teleport"
        else
            if cfg.SoruBodyEnabled == false then return reject("outside-combo-teleport-range") end
            if distance > Hunter.SoruBody:GetMaxRange() then return reject("outside-approach-range") end
            local ready, why = Hunter.SoruBody:CanSoru(targetPart)
            if not ready then return reject(why) end
            Hunter.SoruBody:SetTarget(targetPart)
            local ok
            ok, used, reason = pcall(function()
                local sent, whyNot = Hunter.SoruBody:To(targetPart, "Behind", 3)
                if not sent and whyNot == "landing-out-of-range" then return Hunter.SoruBody:To(targetPart, "Front", 3) end
                return sent, whyNot
            end)
            if not ok then self.LastError = tostring(used); return reject("soru-error") end
            self.LastKind = "soru"
        end
        if not used then return reject(reason or "approach-failed") end
        self.Uses += 1
        self.LastUseAt, self.LastReason, self.LastError = os.clock(), reason, nil
        Hunter.Kinematics:Pause()
        if Hunter.Motion then Hunter.Motion:Reset() end
        setHover(true)
        Hunter.PredictedPos = getPredictedPos(targetPart)
        print(string.format("[TrashHub][COMBO_APPROACH] Method=%s Distance=%.1f", self.LastKind, distance))
        return true
    end
    function api:GetStatus()
        return {Uses = self.Uses, LastReason = self.LastReason, LastError = self.LastError,
            Method = self.LastKind, Cooldown = Hunter.SoruBody:GetCooldownInfo()}
    end
    function api:Destroy()
        self.Destroyed = true
        if Hunter.SoruBody then Hunter.SoruBody:Destroy() end
    end
    return api
end)()

do
