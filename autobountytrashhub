        local ok, status = pcall(ken.GetStatus, LocalPlayer)
        return ok and status.Valid == true and status.Character == char
            and (status.HasV1 == true or status.HasV2 == true)
            and status.Active == false and status.KenDisabled == false
    end
    local function releaseKey()
        if state.KeyDown then
            state.KeyDown = false
            pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game) end)
        end
    end
    local function cancelPress()
        releaseKey()
        state.Serial += 1
        state.Pressing = false
    end

    local function triggerEnableObservation(char)
        char = char or LocalPlayer.Character
        if not canEnable(char) or state.Pressing or tick() - state.LastAttempt < 1.2 then return end
        state.Pressing = true
        state.Serial += 1
        local serial = state.Serial
        task.spawn(function()
            local ok, pressError = pcall(function()
                if serial ~= state.Serial or not canEnable(char) then return end
                state.LastAttempt = tick()
                state.KeyDown = true
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                task.wait(0.05)
            end)
            if serial == state.Serial then
                releaseKey()
                state.Pressing = false
            end
            if not ok and not state.Stopped then
                warn("[TrashHub][KEN_INPUT_ERROR] " .. tostring(pressError))
            end
        end)
    end

    local function onCharacterAdded(char)
        cancelPress()
        state.LastAttempt = -math.huge
        task.delay(0.6, function()
            if LocalPlayer.Character == char then triggerEnableObservation(char) end
        end)
    end
    local stopWatch = ken.WatchTarget(LocalPlayer, function(status, eventType)
        if state.Stopped or not Hunter._isRunning then return end
        if status.Active then
            state.LastAttempt = tick()
        elseif eventType == "KenActiveChanged" or eventType == "KenBreakRecovered" then
            local char = status.Character
            if not char or char ~= LocalPlayer.Character then return end
            task.delay(eventType == "KenBreakRecovered" and 0.1 or 0.2, function()
                if char == LocalPlayer.Character then triggerEnableObservation(char) end
            end)
        end
    end)
    connections[#connections + 1] = LocalPlayer.CharacterAdded:Connect(onCharacterAdded)
    connections[#connections + 1] = LocalPlayer.CharacterRemoving:Connect(function()
        cancelPress()
    end)

    Hunter.TriggerEnableObservation = triggerEnableObservation
    Hunter.ObservationHaki = {
        GetStatus = function() return ken.GetStatus(LocalPlayer) end,
        Stop = function()
            if state.Stopped then return end
            state.Stopped = true
            cancelPress()
            stopWatch()
            for _, connection in ipairs(connections) do
                pcall(function() connection:Disconnect() end)
            end
            table.clear(connections)
            if Hunter.TriggerEnableObservation == triggerEnableObservation then Hunter.TriggerEnableObservation = nil end
        end,
    }
    if LocalPlayer.Character then onCharacterAdded(LocalPlayer.Character) end
end

