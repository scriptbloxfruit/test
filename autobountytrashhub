}

local platform = nil
local connections = {}

local function getOrCreatePlatform()
    if platform and platform.Parent then
        return platform
    end

    local part = Instance.new("Part")
    part.Name = "TrashHub_WaterPlatform"
    part.Size = CONFIG.PlatformSize
    part.Anchored = true
    part.CanCollide = true
    part.CanTouch = false
    part.CanQuery = false
