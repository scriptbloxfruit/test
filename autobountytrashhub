function SoruBody:GetCooldownInfo()
    local char = LocalPlayer.Character
    local data = LocalPlayer:FindFirstChild("Data")
    local race = data and data:FindFirstChild("Race")
    local base = race and race.Value == "Human" and race:FindFirstChild("Evolved") and 10 or 15
    local reduction = char and tonumber(char:GetAttribute("FlashstepCooldown")) or 0
    local duration = base * (1 - math.clamp(reduction or 0, 0, 1))
    local now = tick()
    local bound = nativeCharacter == char and nativeScript == (char and char:FindFirstChild("Soru"))
        and nativeState and type(rawget(nativeState, "LastUse")) == "number"
    local lastUse = bound and rawget(nativeState, "LastUse") or ownLastUse
    local remaining = math.max(0, duration - (now - lastUse))
    if not bound then remaining = math.max(remaining, fallbackReadyAt - now) end
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local charges = hum and tonumber(hum:GetAttribute("SoruCharges")) or 0
    return {Ready = remaining <= 0 or charges > 0, Remaining = remaining,
        Duration = duration, Charges = math.max(0, charges), UseCharge = remaining > 0 and charges > 0,
        Source = bound and "Character.Soru.LastUse" or "local-timer"}
end

local function discoverNativeStateAsync(char, serial)
    local scriptInstance = char:FindFirstChild("Soru") or char:WaitForChild("Soru", 3.0)
    if not scriptInstance or serial ~= bindingSerial or SoruBody.Destroyed or LocalPlayer.Character ~= char then return false end
    local getter = type(getupvalues) == "function" and getupvalues or debug and debug.getupvalues
    if type(getgc) ~= "function" or type(getfenv) ~= "function" or type(getter) ~= "function" then return false end
    local ok, list = pcall(getgc, false)
    if not ok or type(list) ~= "table" then return false end
    local sliceStart = os.clock()
    for i = 1, #list do
        if serial ~= bindingSerial or SoruBody.Destroyed or LocalPlayer.Character ~= char then return false end
        local fn = list[i]
        if type(fn) == "function" then
            local envOk, environment = pcall(getfenv, fn)
            if envOk and type(environment) == "table" and rawget(environment, "script") == scriptInstance then
                local upOk, values = pcall(getter, fn)
                if upOk and type(values) == "table" then
                    for _, value in pairs(values) do
                        if type(value) == "table" and type(rawget(value, "LastUse")) == "number"
                            and type(rawget(value, "LastAfter")) == "number" then
                            if LocalPlayer.Character ~= char or SoruBody.Destroyed then return false end
                            nativeState, nativeScript, nativeCharacter = value, scriptInstance, char
                            if ownLastUse > 0 then nativeState.LastUse = math.max(nativeState.LastUse, ownLastUse) end
                            return true
                        end
                    end
                end
            end
        end
        if os.clock() - sliceStart > 0.001 then
            task.wait()
            sliceStart = os.clock()
        end
    end
    return false
end

local function bindCharacter(char)
    bindingSerial += 1
    local serial = bindingSerial
    nativeState, nativeScript, nativeCharacter, ownLastUse = nil, nil, nil, 0
    fallbackReadyAt = tick() + SoruBody:GetCooldownInfo().Duration
    if not char then return end
    task.spawn(function()
        task.wait(2.0)
        for attempt = 1, 2 do
            if serial ~= bindingSerial or SoruBody.Destroyed or LocalPlayer.Character ~= char then return end
            if discoverNativeStateAsync(char, serial) then return end
            task.wait(3.0)
        end
    end)
end

