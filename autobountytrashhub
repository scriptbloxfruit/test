        p.CFrame = CFrame.new(pos.X, targetY, pos.Z)
        _waterPlatformLastX, _waterPlatformLastZ = pos.X, pos.Z
    end

    local isStunPhysicsLocked = Hunter and Hunter.StunCheck and Hunter.StunCheck.IsServerPhysicsLocked and Hunter.StunCheck.IsServerPhysicsLocked(char)
    if not isStunPhysicsLocked and pos.Y > -140 and pos.Y < 5.0 and pos.X < 45000 and pos.Z < 30000 and not isLocalPlayerInPortalDimension() then
        local safeY = CONFIG.SafeHoverY or 5.5
        hrp.CFrame = CFrame.new(pos.X, safeY, pos.Z) * (hrp.CFrame - pos)
        local vel = hrp.AssemblyLinearVelocity
        if vel.Y < 0 then
            hrp.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
        end
    end
end)
table.insert(connections, steppedConn)

local camConn = workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    if platform and platform.Parent then
        platform.Parent = workspace.CurrentCamera or workspace
    end
end)
table.insert(connections, camConn)

local function cleanup()
    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    connections = {}
    if platform and platform.Parent then
        pcall(function() platform:Destroy() end)
        platform = nil
    end
end

return {Config = CONFIG, Destroy = cleanup}
end)()

Hunter.AntiLava = (function()
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local player = Players.LocalPlayer
local env = type(getgenv) == "function" and getgenv() or _G
local previous = env.__TrashHubAntiLava
if type(previous) == "table" and type(previous.Destroy) == "function" then pcall(previous.Destroy, previous) end

local api = {Version = "1.1", Config = {Enabled = true, Clearance = 0.75, MaxRise = 512},
    LastReason = "initializing", Blocks = 0, Destroyed = false}
local tracked, containers, pending = {}, {}, {}
local connections = {}
local hazardList, listDirty = {}, true
local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Include
overlap.RespectCanCollide = false
overlap.MaxParts = 16
local lastSafeRoot, lastSafeCFrame
local lastMaintenance = -math.huge

local function connect(signal, fn)
    local connection = signal:Connect(fn)
    table.insert(connections, connection)
    return connection
end

local function inMap(instance)
    local map = Workspace:FindFirstChild("Map")
    return map and instance:IsDescendantOf(map)
end

local function isContainer(instance)
    if not (instance.Name == "LavaParts" or CollectionService:HasTag(instance, "__LavaContainer")) then
        return false
    end
    if not inMap(instance) then return false end
    if CollectionService:HasTag(instance, "__LavaContainer") then return true end
    return instance.Name == "LavaParts" and instance:FindFirstChild("LavaDamage") ~= nil
end

local function isHazard(part)
    if not part:IsA("BasePart") then return false end
    if part:GetAttribute("__LavaPart") == true then return true end
    local parent = part.Parent
    while parent and parent ~= Workspace do
        if containers[parent] then return true end
        parent = parent.Parent
    end
    return false
end

local function suppressTouch(part, state)
    if state.Writing or api.Destroyed or not api.Config.Enabled or not part.Parent then return end
    state.Writing = true
    local ok, errorMessage = pcall(function() part.CanTouch = false end)
    state.Writing = false
    if not ok then api.LastError = tostring(errorMessage) end
end

local function untrack(part)
    local state = tracked[part]
    if not state then return end
    tracked[part] = nil
    if state.Connection then state.Connection:Disconnect() end
    if part.Parent then pcall(function() part.CanTouch = state.OriginalCanTouch end) end
    listDirty = true
end

local function track(part)
    if tracked[part] or not isHazard(part) then return end
    local state = {OriginalCanTouch = part.CanTouch, Writing = false}
    tracked[part] = state
    state.Connection = part:GetPropertyChangedSignal("CanTouch"):Connect(function() suppressTouch(part, state) end)
    suppressTouch(part, state)
    listDirty = true
end

local function registerContainer(container)
    if containers[container] or not isContainer(container) then return end
    containers[container] = true
    for _, descendant in ipairs(container:GetDescendants()) do
        if descendant:IsA("BasePart") then track(descendant) end
    end
end

local function discover(instance)
    if instance.Name == "LavaParts" or CollectionService:HasTag(instance, "__LavaContainer") then
        if isContainer(instance) then registerContainer(instance) end
    elseif instance:GetAttribute("__LavaPart") == true then
        track(instance)
    elseif instance.Name == "LavaDamage" and instance.Parent then
        registerContainer(instance.Parent)
    end
end

local lavaBounds = {}
local minLavaY = math.huge
local maxLavaY = -math.huge
local hasAnyLava = false
local _lastOverlapPos = nil
local _lastOverlapResult = false
local _lastOverlapTick = 0

local function refreshList()
    if not listDirty then return end
    hazardList = {}
    table.clear(lavaBounds)
    minLavaY = math.huge
    maxLavaY = -math.huge
    for part in pairs(tracked) do
        if part.Parent and part:IsDescendantOf(Workspace) then
            table.insert(hazardList, part)
            local pPos = part.Position
            local pSz = part.Size
            local halfY = pSz.Y * 0.5
            local bottomY = pPos.Y - halfY
            local topY = pPos.Y + halfY
            if bottomY < minLavaY then minLavaY = bottomY end
            if topY > maxLavaY then maxLavaY = topY end
            local radius = pSz.Magnitude * 0.5
            table.insert(lavaBounds, {
                pos = pPos,
                radius = radius,
                halfY = halfY,
            })
        end
    end
    hasAnyLava = (#hazardList > 0)
    overlap.FilterDescendantsInstances = hazardList
    listDirty = false
    _lastOverlapPos = nil
end

local function bodyBox(root, humanoid)
    local clearance = math.max(0, tonumber(api.Config.Clearance) or 0.75)
    local below = math.max(0, humanoid.HipHeight) + root.Size.Y * 0.5 + clearance
    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        local leg = root.Parent:FindFirstChild("Left Leg") or root.Parent:FindFirstChild("Right Leg")
        below += leg and leg.Size.Y or 2
    end
    local above = root.Size.Y * 0.5 + 2 + clearance
    local size = Vector3.new(math.max(4, root.Size.X + 2) + clearance * 2,
        above + below, math.max(3, root.Size.Z + 2) + clearance * 2)
    return size, (above - below) * 0.5
end

local function overlapsLava(cframe, size, centerOffset)
    local boxCFrame = cframe * CFrame.new(0, centerOffset, 0)
    local pos = boxCFrame.Position
    local now = os.clock()
    if _lastOverlapPos and (now - _lastOverlapTick) < 0.05 then
        local dx = pos.X - _lastOverlapPos.X
        local dy = pos.Y - _lastOverlapPos.Y
        local dz = pos.Z - _lastOverlapPos.Z
        if (dx * dx + dy * dy + dz * dz) < 0.04 then
            return _lastOverlapResult
        end
    end

    local broad = Workspace:GetPartBoundsInBox(boxCFrame, size, overlap)
    local res = (#broad > 0)
    _lastOverlapPos = pos
    _lastOverlapResult = res
    _lastOverlapTick = now
    return res
end

local function _filterMoveNearLava(self, root, desiredCFrame, size, centerOffset)
    if not overlapsLava(desiredCFrame, size, centerOffset) then
        lastSafeRoot, lastSafeCFrame = root, desiredCFrame
        return desiredCFrame, "clear"
    end
    self.Blocks += 1
    local maxRise = math.clamp(tonumber(self.Config.MaxRise) or 512, 0, 512)
    local lower, rise = 0, math.min(2, maxRise)
    while rise > 0 and rise <= maxRise do
        local lifted = desiredCFrame + Vector3.new(0, rise, 0)
        if not overlapsLava(lifted, size, centerOffset) then
            for _ = 1, 5 do
                local middle = (lower + rise) * 0.5
                if overlapsLava(desiredCFrame + Vector3.new(0, middle, 0), size, centerOffset) then
                    lower = middle
                else
                    rise = middle
                end
            end
            lifted = desiredCFrame + Vector3.new(0, rise + 0.25, 0)
            if not overlapsLava(lifted, size, centerOffset) then
                lastSafeRoot, lastSafeCFrame = root, lifted
                return lifted, "raised-above-lava"
            end
            break
        end
        if rise == maxRise then break end
        lower, rise = rise, math.min(rise * 2, maxRise)
    end
    if not overlapsLava(root.CFrame, size, centerOffset) then return root.CFrame, "blocked-lava-entry" end
    if lastSafeRoot == root and lastSafeCFrame
        and (lastSafeCFrame.Position - root.Position).Magnitude <= 512
        and not overlapsLava(lastSafeCFrame, size, centerOffset) then
        return lastSafeCFrame, "returned-to-safe-position"
    end
    return root.CFrame, "no-clear-lava-exit"
end

local _lastFilteredDesiredPos = nil
local _lastFilteredResultCF = nil
local _lastFilteredTick = 0
local _lastFilteredReason = "cached"
local _lastFilteredRoot, _lastFilteredPassThrough = nil, false

function api:FilterMove(root, humanoid, desiredCFrame)
    if self.Destroyed or not self.Config.Enabled then return desiredCFrame end
    if not root or not root.Parent or not humanoid or humanoid.Health <= 0 then return desiredCFrame end
    if type(self.MovementGuard) == "function" then
        local ok, allowed = pcall(self.MovementGuard, root, humanoid, desiredCFrame)
        if not ok then self.LastError = tostring(allowed); return root.CFrame end
        if allowed == false then self.LastReason = "movement-owned-by-route"; return desiredCFrame end
    end
    refreshList()
    if not hasAnyLava then self.LastReason = "no-map-lava"; return desiredCFrame end

    local pos = desiredCFrame.Position
    local now = os.clock()
    if _lastFilteredRoot == root and _lastFilteredPassThrough and _lastFilteredDesiredPos and (now - _lastFilteredTick) < 0.08 and not listDirty then
        local dx = pos.X - _lastFilteredDesiredPos.X
        local dy = pos.Y - _lastFilteredDesiredPos.Y
        local dz = pos.Z - _lastFilteredDesiredPos.Z
        if (dx * dx + dy * dy + dz * dz) < 0.0225 then
            self.LastReason = _lastFilteredReason
            return desiredCFrame
        end
    end

    local size, centerOffset = bodyBox(root, humanoid)
    local halfBodyY = size.Y * 0.5
    local bodyBottom = (pos.Y + centerOffset) - halfBodyY
    local bodyTop = (pos.Y + centerOffset) + halfBodyY

    -- Fast altitude gate: if completely above or below all lava in the map, exit in 0ms!
    if bodyBottom > (maxLavaY + 4) or bodyTop < (minLavaY - 4) then
        self.LastReason = "altitude-clear"
        lastSafeRoot, lastSafeCFrame = root, desiredCFrame
        _lastFilteredDesiredPos = pos
        _lastFilteredResultCF = desiredCFrame
        _lastFilteredTick = now
        _lastFilteredReason = "altitude-clear"
        _lastFilteredRoot, _lastFilteredPassThrough = root, true
        return desiredCFrame
    end

    -- Fast proximity gate: check 3D distance to all lava bounds
    local bodyRadius = size.Magnitude * 0.5
    local isNearLava = false
    for i = 1, #lavaBounds do
        local lb = lavaBounds[i]
        local maxDist = lb.radius + bodyRadius + 4
        local dx = pos.X - lb.pos.X
        local dz = pos.Z - lb.pos.Z
        if math.abs(dx) <= maxDist and math.abs(dz) <= maxDist then
            local dy = (pos.Y + centerOffset) - lb.pos.Y
            if math.abs(dy) <= (lb.halfY + halfBodyY + 4) then
                if (dx * dx + dz * dz) <= (maxDist * maxDist) then
                    isNearLava = true
                    break
                end
            end
        end
    end

    if not isNearLava then
        self.LastReason = "far-from-lava"
        lastSafeRoot, lastSafeCFrame = root, desiredCFrame
        _lastFilteredDesiredPos = pos
        _lastFilteredResultCF = desiredCFrame
        _lastFilteredTick = now
        _lastFilteredReason = "far-from-lava"
        _lastFilteredRoot, _lastFilteredPassThrough = root, true
        return desiredCFrame
    end

    local ok, safeCFrame, reason = pcall(_filterMoveNearLava, self, root, desiredCFrame, size, centerOffset)
    if not ok then
        self.LastReason, self.LastError = "overlap-query-failed", tostring(safeCFrame)
        return root.CFrame
    end
    self.LastReason, self.LastError = reason, nil
    _lastFilteredDesiredPos = pos
    _lastFilteredResultCF = safeCFrame
    _lastFilteredTick = now
    _lastFilteredReason = reason
    _lastFilteredRoot, _lastFilteredPassThrough = root, safeCFrame == desiredCFrame
    return safeCFrame
end

