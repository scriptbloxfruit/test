    if not pName or pName == "" then return false end
    if _permanentKilledByBlacklist[pName] then
        local t = _permanentKilledByBlacklist[pName]
        if type(t) == "number" and (tick() - t < 10) then
            return false
        elseif type(t) == "boolean" and t == true then
            _permanentKilledByBlacklist[pName] = tick()
            return false
        else
            _permanentKilledByBlacklist[pName] = nil
        end
    end
    if _killedTargets[pName] then
        local t = _killedTargets[pName]
        if type(t) == "number" and (tick() - t < 15) then
