_portalCanUse = function()
    if not _portalIsEnabled() then return false, "Portal C tt trong CONFIG" end
    if tick() < _portalCharacterReadyAt then return false, "Waiting for character/UI init" end
    if tick() < _portalRetryAfterTick then return false, "Waiting for UI stabilization" end
    local char = LocalPlayer.Character
    if not char then return false, "No character" end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false, "Dead" end
    if hum.Sit then return false, "Sitting" end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false, "Missing HRP" end
    if hrp:GetAttribute("PortaledToAnotherDimension") or isLocalPlayerInPortalDimension() then return false, "In another dimension" end
    if Hunter.IsActionLocked then
        local locked, lockReason = Hunter.IsActionLocked(char)
        if locked then return false, "Action locked / Stunned: " .. tostring(lockReason) end
    end
    local tool = char:FindFirstChild("Portal-Portal") or (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild("Portal-Portal"))
    if not tool then return false, "Missing Portal tool" end
    local level = tool:FindFirstChild("Level")
    if level and level.Value < 200 then return false, "Mastery < 200" end
    local energy = char:FindFirstChild("Energy")
    if energy and tonumber(energy.Value) and tonumber(energy.Value) < 100 then return false, "Not enough energy" end

    if tick() - _portalWarpCooldownTick < PORTAL_WARP_COOLDOWN then
        return false, string.format("Internal cooldown (%.1fs)", PORTAL_WARP_COOLDOWN - (tick() - _portalWarpCooldownTick))
    end

    local guiReady = _portalCheckGuiCooldownReady()
    local ready, skillState = Hunter.IsSkillReady(tool, "C", true)
    if skillState and skillState.Exact == true then
        if not skillState.CooldownReady then
            return false, skillState.Reason or "Portal C on cooldown (Exact)"
        end
    elseif guiReady ~= nil then
        if not guiReady then
            return false, "Portal C on cooldown (GUI)"
        end
    elseif not ready then
        local cStamp = tonumber(char:GetAttribute("CBloxFruitCooldownClient")) or tonumber(char:GetAttribute("CBloxFruitCooldown"))
        if cStamp and (tick() - cStamp) < 14.5 then
            return false, "Portal C on cooldown (Timestamp)"
        elseif not cStamp and not ready then
            return false, (skillState and skillState.Reason) or "Portal C status unavailable"
        end
    end

    return true, "Ready"
end

local function _portalWarpToIsland(islandName, onComplete, targetPos, targetPlayer)
    if isLocalPlayerInPortalDimension() then
        if onComplete then onComplete(false, "In portal dimension") end
        return
    end
    local canUse, reason = _portalCanUse()
    if not canUse then
        if onComplete then onComplete(false, reason) end
        return
    end
    local minPortalDist = _portalGetMinDistance()
    local liveTargetDist = _portalGetLiveTargetDistance(targetPlayer)
    if Hunter.TargetPlayer ~= targetPlayer or not liveTargetDist or liveTargetDist < minPortalDist then
        _portalRetryAfterTick = tick() + 0.8
        if onComplete then onComplete(false, "Target close or invalid") end
        return
    end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then
        if onComplete then onComplete(false, "No character") end
        return
    end
    if Hunter.GhostShipRoute and (Hunter.GhostShipRoute:IsInside(hrp.Position)
        or Hunter.GhostShipRoute:HasForcedExit()
        or (Hunter.GhostShipRoute.Busy and Hunter.GhostShipRoute.Phase ~= "APPROACH")) then
        if onComplete then onComplete(false, "Waiting for room door exit") end
        return
    end
    local tool = char:FindFirstChild("Portal-Portal")
        or (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild("Portal-Portal"))
    if not tool then
        _portalRetryAfterTick = tick() + 2
        if onComplete then onComplete(false, "Portal tool missing") end
        return
    end
    if Hunter._localSkillCooldownUntil then
        Hunter._localSkillCooldownUntil["Portal-Portal_C"] = nil
    end
    local prevTool = nil
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") and item.Name ~= "Portal-Portal" then
            prevTool = item
            break
        end
    end
    local safetyRadius = (Hunter.Config and Hunter.Config.PortalSafetyRadius) or CONFIG.PortalSafetyRadius or 1500
    local skyHeightOffset = (Hunter.Config and Hunter.Config.PortalSkyHeight) or CONFIG.PortalSkyHeight or 500

    local function _isAnyPlayerNearby(checkRadius)
        local myPos = hrp.Position
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local oRoot = p.Character:FindFirstChild("HumanoidRootPart")
                local oHum = p.Character:FindFirstChildOfClass("Humanoid")
                if oRoot and (not oHum or oHum.Health > 0) then
                    if (oRoot.Position - myPos).Magnitude <= checkRadius then
                        return true
                    end
                end
            end
        end
        return false
    end

    local function _climbUpFromCurrentY(offsetY)
        if not (hrp and hrp.Parent) then return end
        local targetSkyY = hrp.Position.Y + offsetY
        local climbSpeed = tonumber(CONFIG.TweenSpeed) or 220
        local maxClimbDuration = (offsetY / math.max(climbSpeed, 1)) + 1.0
        local ascendStart = os.clock()
        setHover(true)
        while hrp and hrp.Parent and hrp.Position.Y < targetSkyY do
            local dt = task.wait()
            local clampedDt = math.clamp(dt, 0, 0.033)
            local newY = math.min(hrp.Position.Y + climbSpeed * clampedDt, targetSkyY)
            hrp.CFrame = CFrame.new(hrp.Position.X, newY, hrp.Position.Z) * (hrp.CFrame - hrp.CFrame.Position)
            hrp.AssemblyLinearVelocity = Vector3.new(0, 20, 0)
            hrp.AssemblyAngularVelocity = Vector3.zero
            if os.clock() - ascendStart > maxClimbDuration then
                hrp.CFrame = CFrame.new(hrp.Position.X, targetSkyY, hrp.Position.Z) * (hrp.CFrame - hrp.CFrame.Position)
                break
            end
        end
        if hrp and hrp.Parent then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
        setHover(true)
    end

    local isThreatNear = _isAnyPlayerNearby(safetyRadius)
    if isThreatNear then
        _climbUpFromCurrentY(skyHeightOffset)
    else
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        setHover(true)
    end

    if tool and tool.Parent ~= char then
        pcall(function() hum:EquipTool(tool) end)
        local eqWait = os.clock()
        Hunter._lastSkillEquipTool, Hunter._lastSkillEquipAt = tool, eqWait
        while tool.Parent ~= char and (os.clock() - eqWait < 1.0) do
            if LocalPlayer.Character ~= char or hum.Health <= 0 then break end
            task.wait(0.02)
        end
    end
    local function restorePreviousTool()
        if LocalPlayer.Character ~= char or not hum.Parent or hum.Health <= 0 then return end
        if prevTool and prevTool.Parent then
            pcall(function() hum:EquipTool(prevTool) end)
        end
    end

    if LocalPlayer.Character ~= char or hum.Health <= 0 or tool.Parent ~= char then
        _portalRetryAfterTick = tick() + 1.5
        restorePreviousTool()
        if onComplete then onComplete(false, "Cannot equip Portal") end
        return
    end

    local runtimeReady = Hunter.WaitForSkillRuntime(tool, "C", 0.65)
    if Hunter._localSkillCooldownUntil then
        Hunter._localSkillCooldownUntil["Portal-Portal_C"] = nil
    end
    if not runtimeReady then
        local guiReadyNow = _portalCheckGuiCooldownReady()
        local checkState = Hunter.ReadSkillState(tool, "C")
        local exactOnCooldown = (checkState and checkState.Exact == true and checkState.CooldownReady == false)
        if exactOnCooldown or guiReadyNow == false then
            _portalRetryAfterTick = tick() + 1.2
            restorePreviousTool()
            if onComplete then onComplete(false, "Portal C on cooldown") end
            return
        end
        task.wait(0.18)
    else
        task.wait(0.14)
    end

    liveTargetDist = _portalGetLiveTargetDistance(targetPlayer)
    if Hunter.TargetPlayer ~= targetPlayer or not liveTargetDist or liveTargetDist < minPortalDist then
        _portalRetryAfterTick = tick() + 0.8
        restorePreviousTool()
        if onComplete then onComplete(false, "Target close or invalid") end
        return
    end

    local liveProjectedPos, liveRawPos = _portalGetEffectiveTargetPos(targetPlayer, targetPos, 1.6)
    local updatedTargetPos = liveProjectedPos or liveRawPos or targetPos

    _portalTargetPlayerRef = targetPlayer
    _portalTargetPosition = updatedTargetPos
    _portalTargetIslandOverride = islandName
    _portalWarpCooldownTick = tick()

    if not isThreatNear and _isAnyPlayerNearby(safetyRadius) then
        isThreatNear = true
        _climbUpFromCurrentY(skyHeightOffset)
    end

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    local startPos = hrp.Position

    local gatewayInvoked = false
    local selectedIslandName = islandName

    if not _portalRequestGateway or not _portalRequestGateway.Parent then
        pcall(function()
            local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
            _portalRequestGateway = remotes and remotes:FindFirstChild("RequestGateway")
        end)
    end
    if _portalRequestGateway then
        local hookTargetPlayer = targetPlayer
        local hookTargetPos = updatedTargetPos
        local hookIslandName = islandName
        _portalRequestGateway.OnClientInvoke = function(list)
            gatewayInvoked = true
            if typeof(list) == "table" then
                local bestIsland = _portalSelectBestIslandFromList(list, hookTargetPlayer, hookTargetPos, hookIslandName)
                if bestIsland then
                    selectedIslandName = bestIsland
                    _portalLastWarpedIsland = bestIsland
                    _portalLastWarpSuccessTick = tick()
                    if type(showBottomRightNotify) == "function" then
                        showBottomRightNotify("Portal Gateway", "Teleporting -> " .. tostring(bestIsland), Color3.fromRGB(0, 180, 255))
                    end
                    return bestIsland
                end
            elseif hookIslandName then
                selectedIslandName = hookIslandName
                _portalLastWarpedIsland = hookIslandName
                _portalLastWarpSuccessTick = tick()
                return hookIslandName
            end
            if _portalDefaultGatewayCtrl and _portalDefaultGatewayCtrl.LoadListAndAwaitSelection then
                return _portalDefaultGatewayCtrl.LoadListAndAwaitSelection(list)
            end
            return hookIslandName
        end
    end

    local VIM = game:GetService("VirtualInputManager")
    local function pressPortalC(isRetry)
        local currentDist = _portalGetLiveTargetDistance(targetPlayer)
        if LocalPlayer.Character ~= char or Hunter.TargetPlayer ~= targetPlayer
            or not currentDist or currentDist < minPortalDist or tool.Parent ~= char then
            _portalRetryAfterTick = tick() + 0.8
            return false
        end
        if Hunter.IsActionLocked and Hunter.IsActionLocked(char) then
            return false
        end
        local energy = char:FindFirstChild("Energy")
        if energy and tonumber(energy.Value) and tonumber(energy.Value) < 100 then
            return false
        end
        if Hunter._localSkillCooldownUntil then
            Hunter._localSkillCooldownUntil["Portal-Portal_C"] = nil
        end
        local check = Hunter.ReadSkillState(tool, "C")
        local guiReadyNow = _portalCheckGuiCooldownReady()
        if isRetry then
            if (check and check.Exact == true and check.CooldownReady == false) or guiReadyNow == false then
                return true
            end
        else
            if (check and check.Exact == true and check.CooldownReady == false) or guiReadyNow == false then
                return false
            end
        end
        Hunter._skillHeldKey = nil
        if unlockSkillState then unlockSkillState() end
        Hunter._skillHeldKey = Enum.KeyCode.C
        local keyDownOk = pcall(function() VIM:SendKeyEvent(true, Enum.KeyCode.C, false, game) end)
        task.wait(0.08)
        local keyUpOk = pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode.C, false, game) end)
        task.wait(0.04)
        Hunter._skillHeldKey = nil
        return keyDownOk and keyUpOk
    end

    if not pressPortalC(false) then
        _portalTargetIslandOverride = nil
        _portalTargetPosition = nil
        _portalTargetPlayerRef = nil
        _portalRetryAfterTick = tick() + 1.2
        restorePreviousTool()
        if onComplete then onComplete(false, "Target close or cannot cast C") end
        return
    end

    local arrived = false
    local maxSteps = 25
    local step = 0
    while step < maxSteps do
        step = step + 1
        task.wait(0.12)
        if not hrp or not hrp.Parent then break end

        if (hrp.Position - startPos).Magnitude > 300 then
            arrived = true
            break
        end

        if gatewayInvoked and maxSteps < 55 then
            maxSteps = 55
        end

        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        if not gatewayInvoked and (step == 4 or step == 8 or step == 14) then
            if not pressPortalC(true) then break end
        end
    end

    if arrived and hrp and hrp.Parent then
        _portalLastWarpedIsland = selectedIslandName
        _portalLastWarpSuccessTick = tick()
        local arrivalPos = hrp.Position
        local goalAfterWarp = updatedTargetPos or targetPos
        local stepDir = hrp.CFrame.LookVector
        if goalAfterWarp then
            local toGoalXZ = Vector3.new(goalAfterWarp.X - arrivalPos.X, 0, goalAfterWarp.Z - arrivalPos.Z)
            if toGoalXZ.Magnitude > 1 then
                stepDir = toGoalXZ.Unit
            end
        end
        stepDir = Vector3.new(stepDir.X, 0, stepDir.Z)
        if stepDir.Magnitude < 0.1 then
            stepDir = Vector3.new(1, 0, 0)
        else
            stepDir = stepDir.Unit
        end
        local safeArrivalPos = arrivalPos + (stepDir * 26) + Vector3.new(0, 12, 0)
        hrp.CFrame = CFrame.lookAt(safeArrivalPos, safeArrivalPos + stepDir)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        task.wait(0.12)
        if hrp and hrp.Parent then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end

        task.wait(0.04)
        restorePreviousTool()
        if onComplete then onComplete(true, "Arrived at: " .. tostring(selectedIslandName)) end
    else
        _portalTargetIslandOverride = nil
        _portalTargetPosition = nil
        _portalTargetPlayerRef = nil
        _portalRetryAfterTick = tick() + 1.2
        restorePreviousTool()
        if onComplete then onComplete(false, gatewayInvoked and "TimeoutSauKhiChonDao" or "ChuaMoCong") end
    end
end

local function _portalFindOptimalRoute(myPos, targetPos, targetPlayer)
    local tweenSpeed = CONFIG.TweenSpeed or 220
    local projectedGoalPos, rawGoalPos = _portalGetEffectiveTargetPos(targetPlayer, targetPos, 1.8)
    projectedGoalPos = projectedGoalPos or targetPos
    rawGoalPos = rawGoalPos or targetPos

    local routeGoalPos = rawGoalPos
    local directDist = (myPos - rawGoalPos).Magnitude
    local myHorizDistToGoal = _portalHorizDist(myPos, rawGoalPos)

    if Hunter and Hunter.GhostShipRoute and Hunter.GhostShipRoute.GetEntrancePosition
        and not Hunter.GhostShipRoute:IsInside(myPos) then
        local entrancePos = Hunter.GhostShipRoute:GetEntrancePosition(targetPos)
            or Hunter.GhostShipRoute:GetEntrancePosition(rawGoalPos)
        if entrancePos then
            local distToEntrance = (myPos - entrancePos).Magnitude
            if distToEntrance < 850 then
                return {
                    type = "DIRECT",
                    totalTime = distToEntrance / tweenSpeed,
                    directDist = distToEntrance,
                    island = nil,
                    islandPos = nil,
                    savedTime = 0,
                    savedHorizDist = 0,
                }
            end
            routeGoalPos = entrancePos
            projectedGoalPos = entrancePos
            directDist = math.max(directDist, distToEntrance)
            myHorizDistToGoal = _portalHorizDist(myPos, entrancePos)
        end
    end

    local bestRoute = {
        type = "DIRECT",
        totalTime = directDist / tweenSpeed,
        directDist = directDist,
        island = nil,
        islandPos = nil,
        savedTime = 0,
        savedHorizDist = 0,
        portalGoalPos = projectedGoalPos,
    }

    local minPortalDist = _portalGetMinDistance()
    if directDist < minPortalDist then
        return bestRoute
    end

    local currentIslands = _portalGetIslandsForCurrentSea()

    local closestIsland = nil
    local closestIslandPos = nil
    local bestScore = math.huge
    local closestHorizToTarget = math.huge
    local closest3DToTarget = math.huge

    for islandName, islandPos in pairs(currentIslands) do
        if not _portalIsRestrictedInteriorIsland(islandName, islandPos, routeGoalPos) then
            local score = _portalCalcIslandScore(islandPos, projectedGoalPos, routeGoalPos)
            if score < bestScore then
                bestScore = score
                closestIsland = islandName
                closestIslandPos = islandPos
                closestHorizToTarget = _portalHorizDist(islandPos, routeGoalPos)
                closest3DToTarget = (islandPos - routeGoalPos).Magnitude
            end
        end
    end

    local maxOffshoreDist = _portalGetMaxOffshoreDistance()
    if closestHorizToTarget > maxOffshoreDist then
        bestRoute.type = "TOO_FAR_OFFSHORE"
        bestRoute.offshoreDist = closestHorizToTarget
        bestRoute.nearestIsland = closestIsland
        return bestRoute
    end

    if closestIsland and closestIslandPos then
        local myDistToChosenIsland = _portalHorizDist(myPos, closestIslandPos)
        local savedHorizDist = myHorizDistToGoal - closestHorizToTarget
        local recentlyWarpedSameIsland = (_portalLastWarpedIsland == closestIsland)
            and ((tick() - _portalLastWarpSuccessTick) < 4.5)

        if myDistToChosenIsland >= PORTAL_SAME_ISLAND_RADIUS
            and savedHorizDist >= PORTAL_MIN_SAVED_HORIZ_DIST
            and not recentlyWarpedSameIsland
        then
            local portalTime = PORTAL_WARP_DURATION + (closest3DToTarget / tweenSpeed)
            local timeSaved = (directDist / tweenSpeed) - portalTime
            bestRoute = {
                type = "PORTAL",
                totalTime = portalTime,
                directDist = directDist,
                island = closestIsland,
                islandPos = closestIslandPos,
                islandToTarget = closest3DToTarget,
                savedHorizDist = savedHorizDist,
                savedTime = math.max(timeSaved, 0),
                portalGoalPos = projectedGoalPos,
            }
        end
    end

    return bestRoute
end

_portalExecuteSmartWarp = function(targetPlayer, targetPos)
    if _isPortalWarping then return end

    local _, _, myRoot = getCharacter()
    if not myRoot then return end
    if Hunter.GhostShipRoute and (Hunter.GhostShipRoute:IsInside(myRoot.Position)
        or Hunter.GhostShipRoute:HasForcedExit()
        or (Hunter.GhostShipRoute.Busy and Hunter.GhostShipRoute.Phase ~= "APPROACH")) then return end
    local liveTargetDist = _portalGetLiveTargetDistance(targetPlayer)
    if Hunter.TargetPlayer ~= targetPlayer or not liveTargetDist or liveTargetDist < _portalGetMinDistance() then return end

    local route = _portalFindOptimalRoute(myRoot.Position, targetPos, targetPlayer)
    if route.type ~= "PORTAL" then return end

    if Hunter.GhostShipRoute and Hunter.GhostShipRoute.Busy and Hunter.GhostShipRoute.Phase == "APPROACH" then
        Hunter.GhostShipRoute:Reset("portal-preempt")
    end

    _isPortalWarping = true
    _portalLastTargetPlayer = targetPlayer
    local warpGoalPos = route.portalGoalPos or targetPos

    task.spawn(function()
        local ok, err = xpcall(function()
            _portalWarpToIsland(route.island, function(success, msg)
                _isPortalWarping = false
                if success then
                else
                    _portalLastTargetPlayer = nil
                end
            end, warpGoalPos, targetPlayer)
        end, function(e) return tostring(e) end)
        if not ok then
            _isPortalWarping = false
            _portalLastTargetPlayer = nil
            _portalTargetIslandOverride = nil
            _portalTargetPosition = nil
            _portalTargetPlayerRef = nil
            _portalRetryAfterTick = tick() + 1.5
        end
    end)
end
end
do
    local _fastSkill = {
        initialized = false,
        hookInstalled = false,
        ownsHook = false,
        oldIndex = nil,
        globalModule = nil,
        castGuardFunction = nil,
        castGuardIndex = nil,
        maintenanceToken = 0,
        maintenanceActive = false,
        watchConnections = {},
        watchedObjects = setmetatable({}, {__mode = "k"}),
        watchedCharacter = nil,
    }

    local function _fs_isCharacterLocked(character)
        character = character or LocalPlayer.Character
        if not character then return true end
        local hk = getgenv()._BF_HunterKiller or Hunter
        if hk and hk.IsActionLocked then
            return hk.IsActionLocked(character)
        end
        return false
    end

    local _castGuardSearchRunning = false
    local function _fs_findCastGuardUpvalueAsync()
        if _fastSkill.castGuardFunction and _fastSkill.castGuardIndex then return true end
        local cached = getgenv()._TrashHub_CachedCastGuard
        if type(cached) == "table" and type(cached.fn) == "function" and type(cached.idx) == "number" then
            _fastSkill.castGuardFunction = cached.fn
            _fastSkill.castGuardIndex = cached.idx
            return true
        end
        if _castGuardSearchRunning then return false end
        if type(getgc) ~= "function" or type(debug) ~= "table"
            or type(debug.getupvalues) ~= "function" or type(debug.setupvalue) ~= "function"
            or type(debug.getinfo) ~= "function" then
            return false
        end
        _castGuardSearchRunning = true
        task.spawn(function()
            task.wait(2.5)
            local okList, list = pcall(getgc, false)
            if okList and type(list) == "table" then
                local sliceStart = os.clock()
                for i = 1, #list do
                    local obj = list[i]
                    if type(obj) == "function" then
                        local okInfo, info = pcall(debug.getinfo, obj)
                        local src = okInfo and info and tostring(info.short_src or info.source or "") or ""
                        if src:find("MovesetClientRunner", 1, true) then
                            local okUp, upvalues = pcall(debug.getupvalues, obj)
                            if okUp and type(upvalues) == "table" then
                                local hasGlobalRef = false
                                local boolIndex = nil
                                for idx, val in pairs(upvalues) do
                                    if val == _fastSkill.globalModule then
                                        hasGlobalRef = true
                                    elseif type(val) == "boolean" then
                                        boolIndex = idx
                                    end
                                end
                                if hasGlobalRef and boolIndex then
                                    _fastSkill.castGuardFunction = obj
                                    _fastSkill.castGuardIndex = boolIndex
                                    getgenv()._TrashHub_CachedCastGuard = { fn = obj, idx = boolIndex }
                                    break
                                end
                            end
                        end
                    end
                    if os.clock() - sliceStart > 0.001 then
                        task.wait()
                        sliceStart = os.clock()
                    end
                end
            end
            _castGuardSearchRunning = false
        end)
        return false
    end

    local function _fs_resetCastGuard()
        if not _fastSkill.castGuardFunction or not _fastSkill.castGuardIndex then
            _fs_findCastGuardUpvalueAsync()
            return false
        end
        local ok = pcall(debug.setupvalue, _fastSkill.castGuardFunction, _fastSkill.castGuardIndex, false)
        return ok
    end

    local function _fs_resetGlobalState()
        if not _fastSkill.globalModule then return false end
        if _fs_isCharacterLocked(LocalPlayer.Character) then return false end
        _fastSkill.globalModule.busy = false
        _fastSkill.globalModule.castTimer = 0
        _fastSkill.globalModule.equipTimer = 0
        _fastSkill.globalModule.tapCooldown = 0
        _fastSkill.globalModule.fruitSwapTimeLockout = 0
        _fastSkill.globalModule.Swimming = false
