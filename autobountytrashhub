                if info.CanPvP then
                    local r = p.Character:FindFirstChild("HumanoidRootPart") or p.Character.PrimaryPart
                    local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
                    if r and humanoid and humanoid.Health > 0 then
                        local rPos = (Hunter.PortalXTracker and Hunter.PortalXTracker.GetRealPosition(p)) or r.Position
                        local d = (rPos - myRoot.Position).Magnitude
                        local hp = humanoid.Health

                        if amInDimension then
                            local score = 1000000 + (2500 - math.min(d, 2500)) - (hp * 0.01)
                            if score > bestScore then
                                bestScore = score
                                bestPlayer = p
                            end
                        else
                            if hp < bestHealth or (hp == bestHealth and d < bestDist) then
                                bestHealth = hp
                                bestDist = d
                                bestPlayer = p
                            end
                        end
                    end
                end
            end
        end
    end
    if bestPlayer and bestPlayer.Character then
        local r = bestPlayer.Character:FindFirstChild("HumanoidRootPart") or bestPlayer.Character.PrimaryPart
        if r then
