        if not self.Enabled or self.Destroyed then
            return false
        end
        local myChar = LocalPlayer and LocalPlayer.Character
        if myChar and Hunter.StunCheck and Hunter.StunCheck.IsServerPhysicsLocked and Hunter.StunCheck.IsServerPhysicsLocked(myChar) then
            return self:IsSelfStunDodging()
        end
        if self:IsSelfStunDodging() then
            return true
        end
        if self.LastThreatPlayer ~= Hunter.TargetPlayer then
            self.EnemyDodgeUntil = 0
            return false
        end
        return os.clock() < self.EnemyDodgeUntil
    end

