        for _, edge in ipairs(ONE_HOP_LIST) do
            if isEdgeUnlocked(edge) then
                local cost = evaluateRouteCost({ edge }, myPos, targetPos)
                if cost < bestCost then
                    bestCost = cost
                    bestHops = { edge }
