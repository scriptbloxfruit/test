local shootModule = getShootModule(0)
local shootHandler = nil
if shootModule then
    local okReq, res = pcall(require, shootModule)
    if okReq and type(res) == "function" then shootHandler = res end
end

if shootHandler then
    installHook(shootHandler)
else
    task.defer(function()
        local deferredSm = getShootModule(1.5)
