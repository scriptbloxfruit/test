Hunter.SoruApproach = (function()
    local CollectionService = game:GetService("CollectionService")
    local api = {LastReason = "ready", Uses = 0, LastUseAt = -math.huge}

    Hunter.SoruBody.LandingFilter = function(cframe, target)
        local _, hum, root = getCharacter()
        if not root or not hum or hum.Health <= 0 then return nil, "character-unavailable" end
        local landing = Hunter.AntiLava:FilterMove(root, hum, cframe)
        if Hunter.GhostShipRoute then
            landing = Hunter.GhostShipRoute:ClampInteriorCFrame(root, landing)
        end
        local part = typeof(target) == "Instance" and target:IsA("BasePart") and target or nil
        if part and (landing.Position - part.Position).Magnitude > Hunter.GunM1:GetComboDistance() then
            return nil, "landing-outside-combo-range"
        end
        return landing
    end

    function api:TryApproach(root, humanoid, targetPart)
        local cfg = Hunter.Config or CONFIG
        local player = Hunter.TargetPlayer
        local char = Hunter.TargetCharacter
        if self.Destroyed or cfg.SoruBodyEnabled == false or not Hunter._isRunning or isHopping
            or _isPortalWarping or Hunter._isGhostShipRouting or Hunter._isHealingInSky
            or isSkillHolding or Hunter._skillHeldKey
            or CollectionService:HasTag(LocalPlayer, "Teleporting") then
            self.LastReason = "movement-or-cast-in-progress"
            return false
        end
        if not root or not humanoid or humanoid.Health <= 0 or not player or player.Character ~= char
            or not isAlive(char) or not targetPart or targetPart ~= Hunter.TargetPart
            or not targetPart:IsDescendantOf(char) then
            self.LastReason = "target-unavailable"
            return false
        end
        if Hunter.GhostShipRoute:GetArea(root.Position) ~= Hunter.GhostShipRoute:GetArea(targetPart.Position) then
            self.LastReason = "room-door-required"
            return false
        end
        if not isLocalPlayerInPortalDimension() and (
            (Hunter.PortalXTracker and Hunter.PortalXTracker.IsInPortalX(player))
            or isTargetUsingPortalDimension(player)
        ) then
            self.LastReason = "target-in-portal-dimension"
            return false
        end
        local realTargetPos = (Hunter.PortalXTracker and Hunter.PortalXTracker.GetRealPosition(player)) or targetPart.Position
        local distance = (realTargetPos - root.Position).Magnitude
        if distance < 30 then self.LastReason = "closer-than-30-studs"; return false end
        if distance > Hunter.SoruBody:GetMaxRange() then self.LastReason = "outside-soru-range"; return false end
        if os.clock() - self.LastUseAt < 0.15 then self.LastReason = "soru-debounce"; return false end
        local ready, readyReason = Hunter.SoruBody:CanSoru(targetPart)
        if not ready then self.LastReason = readyReason; return false end

        Hunter.SoruBody:SetTarget(targetPart)
        local ok, used, reason = pcall(function()
            local sent, why = Hunter.SoruBody:To(targetPart, "Behind", 3)
            if not sent and why == "landing-out-of-range" then
                return Hunter.SoruBody:To(targetPart, "Front", 3)
            end
            return sent, why
        end)
        if not ok then self.LastReason, self.LastError = "soru-error", tostring(used); return false end
        self.LastReason, self.LastError = reason, nil
        if not used then return false end
        self.Uses += 1
        self.LastUseAt = os.clock()
        Hunter.Kinematics:Pause()
        Hunter.PredictedPos = getPredictedPos(targetPart)
        return true
    end

    function api:GetStatus()
        return {Uses = self.Uses, LastReason = self.LastReason, LastError = self.LastError,
            Cooldown = Hunter.SoruBody:GetCooldownInfo()}
    end

    function api:Destroy()
        self.Destroyed = true
        if Hunter.SoruBody then Hunter.SoruBody:Destroy() end
    end
    return api
end)()

