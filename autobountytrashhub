    for _, part in ipairs(hazardList) do if not part.CanTouch then suppressed += 1 end end
    return {Version = self.Version, Enabled = self.Config.Enabled, Destroyed = self.Destroyed, Tracked = #hazardList,
        TouchSuppressed = suppressed, Blocks = self.Blocks, LastReason = self.LastReason, LastError = self.LastError}
end

function api:Destroy()
    if self.Destroyed then return end
    self.Destroyed = true
    self.MovementGuard = nil
    for _, connection in ipairs(connections) do pcall(function() connection:Disconnect() end) end
    table.clear(connections)
    for part in pairs(tracked) do untrack(part) end
    table.clear(containers)
    table.clear(pending)
    table.clear(hazardList)
    if env.__TrashHubAntiLava == self then env.__TrashHubAntiLava = nil end
    lastSafeRoot, lastSafeCFrame = nil, nil
end

