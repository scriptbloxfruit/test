local function scanHopServers(canContinue)
    if hopScanPool.Stopped or not Hunter._isRunning then return {}, "Scanner stopped" end
    local serverBrowser = ReplicatedStorage:FindFirstChild("__ServerBrowser")
    if not serverBrowser or not serverBrowser:IsA("RemoteFunction") then
        Hunter.HopScanStatus = {Phase = "unavailable", Error = "__ServerBrowser RemoteFunction unavailable"}
        warn("[TrashHub][HOP_SCAN] __ServerBrowser RemoteFunction unavailable")
        return {}, "__ServerBrowser RemoteFunction unavailable"
    end
    if hopScanPool.Active then return {}, "A server scan is already active" end
    rememberHopServer(game.JobId, "visit")
    local regionDisplay, regionFilterList = _resolveHopRegion()
    local concurrency = math.floor(hopNumber(HOP_CONFIG.ScanConcurrency, 6, 1, 10))
    local timeout = hopNumber(HOP_CONFIG.ScanTimeoutSeconds, 12, 2, 60)
    local totalBuckets = math.floor(hopNumber(HOP_CONFIG.MaxBuckets, 100, 1, 100))
    local startedAt = tick()
    local scan = {Open = true, Pending = 0, Requested = 0, Completed = 0, Errors = 0,
        Seen = 0, RegionMatched = 0, Visited = 0, Full = 0, Deadline = startedAt + timeout}
    hopScanPool.Active = scan
    local candidates, seenIds, buckets = {}, {}, {}
    for bucket = 1, totalBuckets do buckets[#buckets + 1] = bucket end
    shuffleHopList(buckets)
    local function active()
        return scan.Open and not hopScanPool.Stopped and Hunter._isRunning
            and tick() < scan.Deadline and (not canContinue or canContinue())
    end
    local function collect(result)
        for jobId, data in pairs(result) do
            if not active() then return end
            if not validHopJobId(jobId) or seenIds[jobId] or type(data) ~= "table" then continue end
            seenIds[jobId] = true
            scan.Seen += 1
            local region = tostring(data.Region or "")
            local regionNorm = region:lower():gsub("[%s_%-]+", "")
            if regionNorm == "sg" then regionNorm = "singapore" end
            if regionNorm == "hk" then regionNorm = "hongkong" end
            local matched = #regionFilterList == 0
            for _, filter in ipairs(regionFilterList) do
                if filter == "" or regionNorm:find(filter, 1, true) then matched = true; break end
            end
            if not matched then continue end
            scan.RegionMatched += 1
            if jobId == game.JobId or isHopBlocked(jobId) then scan.Visited += 1; continue end
            local count, capacity = tonumber(data.Count), tonumber(data.MaxPlayers)
            if count and count == count and capacity and capacity > 0 and capacity < math.huge
                and count >= capacity then scan.Full += 1; continue end
            if count and (count ~= count or math.abs(count) == math.huge or count < 0) then count = nil end
            candidates[#candidates + 1] = {JobId = jobId, Region = region, Count = count}
        end
    end
    local nextBucket = 1
    while active() do
        while active() and nextBucket <= totalBuckets and hopScanPool.InFlight < concurrency do
            local bucket = buckets[nextBucket]
            nextBucket += 1
            if hopScanPool.Pending[bucket] then continue end
            local request = {}
            hopScanPool.Pending[bucket] = request
            hopScanPool.InFlight += 1
            scan.Requested += 1
            scan.Pending += 1
            request.Thread = task.spawn(function()
                local ok, result = pcall(function() return serverBrowser:InvokeServer(bucket) end)
                if hopScanPool.Pending[bucket] == request then
                    hopScanPool.Pending[bucket] = nil
                    hopScanPool.InFlight = math.max(0, hopScanPool.InFlight - 1)
                end
                scan.Pending = math.max(0, scan.Pending - 1)
                if not active() then return end
                scan.Completed += 1
                if ok and type(result) == "table" then
                    local collected = pcall(collect, result)
                    if not collected then scan.Errors += 1 end
                else
                    scan.Errors += 1
                end
            end)
        end
        if nextBucket > totalBuckets and scan.Pending == 0 then break end
        task.wait(0.05)
    end
    scan.Open = false
    if hopScanPool.Active == scan then hopScanPool.Active = nil end
    shuffleHopList(candidates)
    local cancelled = hopScanPool.Stopped or not Hunter._isRunning or (canContinue and not canContinue())
    Hunter.HopScanStatus = {
        Phase = cancelled and "cancelled" or (tick() >= scan.Deadline and "timeout" or "complete"),
        Region = regionDisplay, TotalBuckets = totalBuckets, RequestedBuckets = scan.Requested,
        CompletedBuckets = scan.Completed, FailedBuckets = scan.Errors, InFlight = hopScanPool.InFlight,
        SeenServers = scan.Seen, RegionMatched = scan.RegionMatched, VisitedServers = scan.Visited,
        FullServers = scan.Full, Candidates = #candidates, Elapsed = tick() - startedAt,
    }
    if not cancelled then
        print(string.format("[TrashHub][HOP_SCAN] Region=%s Buckets=%d/%d Requested=%d Candidates=%d Visited=%d Full=%d Errors=%d Pending=%d Phase=%s",
            regionDisplay, scan.Completed, totalBuckets, scan.Requested, #candidates, scan.Visited,
            scan.Full, scan.Errors, hopScanPool.InFlight, Hunter.HopScanStatus.Phase))
    end
    return cancelled and {} or candidates
end

autoHopServer = function(reason)
    if isHopping or not Hunter._isRunning then return false end
    if isLocalPlayerInPortalDimension() then return false end
    local instantRetreatHop = reason == "LowHealthRetreat" and Hunter._isHealingInSky == true
    isHopping = true

    local connections = {}
    local cancelled = false
    local activeAttempt = nil
    local function alive()
        return not cancelled and Hunter._isRunning
    end
    local function cleanup()
        cancelled = true
        activeAttempt = nil
        for _, connection in ipairs(connections) do
            pcall(function() connection:Disconnect() end)
        end
        table.clear(connections)
        if Hunter._cancelHop == cleanup then Hunter._cancelHop = nil end
        isHopping = false
    end
    Hunter._cancelHop = cleanup
    local lastRiskNoticeAt = -math.huge
    local function waitForBountyClear(ctx)
        while alive() and (not ctx or activeAttempt == ctx) do
            local blocked, state, riskReason = isBountyAtRisk(true)
            if not blocked then return true end
            local phase = state == "safe" and "waiting-safe-clearance"
                or state == "unknown" and "waiting-bounty-data" or "waiting-bounty-risk"
            Hunter.HopStatus = {Phase = phase, JobId = ctx and ctx.jobId, Reason = tostring(riskReason or "bounty-risk")}
            if tick() - lastRiskNoticeAt >= 1 then
                lastRiskNoticeAt = tick()
                TrashHubNotify.NotifyStatus("Teleport paused", "Protecting bounty", FLUENT_ACCENTS.Warning,
                    "Action", state == "safe" and "Confirming that bounty risk has cleared..."
                    or state == "unknown" and "Waiting for reliable combat status..." or "Bounty at risk: waiting until it clears")
            end
            task.wait(0.1)
        end
        return false
    end

    task.spawn(function()
        local ok, hopError = xpcall(function()
            pcall(saveStatsToJson)
            pcall(function()
                local parentGui = (type(gethui) == "function" and gethui()) or game:GetService("CoreGui")
                if parentGui then
                    local oldGui = parentGui:FindFirstChild("BF_HunterTargetMenu")
                    if oldGui then oldGui:Destroy() end
                end
            end)
            Hunter.Kinematics:Reset()
            Hunter.TargetPlayer = nil
            Hunter.TargetCharacter = nil
            Hunter.TargetPart = nil
            local _, _, myRoot = getCharacter()
            if not myRoot then
                Hunter.HopStatus = {Phase = "no-character", Reason = tostring(reason)}
                return
            end
            if Hunter.GhostShipRoute:IsInside(myRoot.Position) then
                Hunter.GhostShipRoute:RequestExit("SERVER_HOP")
            else
                Hunter.GhostShipRoute:Reset("server-hop")
            end
            pcall(function()
                if instantRetreatHop or Hunter.GhostShipRoute:IsInside(myRoot.Position) then return end
                local curCF = myRoot.CFrame
                local curPos = curCF.Position
                myRoot.CFrame = CFrame.new(curPos.X, curPos.Y + 250, curPos.Z) * (curCF - curPos)
                myRoot.AssemblyLinearVelocity = Vector3.zero
                myRoot.AssemblyAngularVelocity = Vector3.zero
            end)

            TrashHubNotify.NotifyHopStatus("Waiting for safe teleport",
                instantRetreatHop and "Continuing retreat climb" or "Climbing to safe sky (+250Y)")
            connections[#connections + 1] = RunService.RenderStepped:Connect(function(dt)
                if not alive() then return end
                local _, hum, root = getCharacter()
                if not root then return end
                if isLocalPlayerInPortalDimension() then
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                    return
                end
                if Hunter.GhostShipRoute:IsInside(root.Position) or Hunter.GhostShipRoute.Busy then
                    Hunter.GhostShipRoute:RequestExit("SERVER_HOP")
                    Hunter.Kinematics:Pause()
                    setHover(true)
                    Hunter.GhostShipRoute:Step(dt, root, hum, nil, nil)
                    return
                end
                if instantRetreatHop then
                    Hunter.LowHealthEscape.ContinueClimb(dt, root)
                    return
                end
                local clampedDt = math.clamp(dt, 0, 0.033)
                local newPos = root.Position + Vector3.new(0, 220 * clampedDt, 0)
                root.CFrame = CFrame.new(newPos) * (root.CFrame - root.CFrame.Position)
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end)

            if not waitForBountyClear() then return end

            connections[#connections + 1] = TeleportService.TeleportInitFailed:Connect(function(player, result, errorMessage, placeId, teleportOptions)
                local ctx = activeAttempt
                if not alive() or player ~= LocalPlayer or not ctx then return end
                if tonumber(placeId) and tonumber(placeId) ~= game.PlaceId then return end
                local failedJobId = nil
                pcall(function() failedJobId = teleportOptions and teleportOptions.ServerInstanceId end)
                if failedJobId and failedJobId ~= "" and failedJobId ~= ctx.jobId then return end
                ctx.failed = true
                ctx.error = tostring(result) .. ": " .. tostring(errorMessage or "")
                if result == Enum.TeleportResult.Flooded then ctx.retryDelay = 15 end
            end)
            connections[#connections + 1] = LocalPlayer.OnTeleport:Connect(function(state)
                local ctx = activeAttempt
                if not alive() or not ctx then return end
                if state == Enum.TeleportState.Failed then
                    ctx.failed = true
                    ctx.error = tostring(state)
                elseif state == Enum.TeleportState.RequestedFromServer
                    or state == Enum.TeleportState.Started
                    or state == Enum.TeleportState.WaitingForServer
                    or state == Enum.TeleportState.InProgress then
                    ctx.started = true
                    ctx.startedAt = ctx.startedAt or tick()
                    if ctx.state ~= state then ctx.stateAt = tick() end
                    ctx.state = state
                    Hunter.HopStatus = {Phase = tostring(state), JobId = ctx.jobId, Reason = tostring(reason)}
                end
            end)

            local requestTimeout = math.max(tonumber(CONFIG.TeleportRequestTimeout) or 20, 5)
            local handoffTimeout = math.max(tonumber(CONFIG.TeleportHandoffTimeout) or 90, requestTimeout)
            local fallbackDelay = math.max(tonumber(CONFIG.TeleportFallbackDelay) or 6, 1)
            while alive() do
                if not waitForBountyClear() then return end
                local regionDisplay = _resolveHopRegion()
                TrashHubNotify.NotifyHopStatus("Scanning servers...",
                    string.format("Region: %s | Random server selection", tostring(regionDisplay)))
                local candidates = scanHopServers(alive)
                if not alive() then return end
                if #candidates == 0 then
                    if not HOP_CONFIG.RetryIfNotFound then break end
                    task.wait(math.max(tonumber(HOP_CONFIG.RetryDelaySeconds) or 3, 0.25))
                    continue
                end

                for _, chosen in ipairs(candidates) do
                    if not waitForBountyClear() then return end
                    local targetJobId = chosen.JobId
                    if type(targetJobId) ~= "string" or #targetJobId <= 20
                        or targetJobId == game.JobId or isHopBlocked(targetJobId) then continue end
                    rememberHopServer(targetJobId, "attempt")
                    local ctx = {jobId = targetJobId, started = false, failed = false, error = ""}
                    activeAttempt = ctx
                    Hunter.HopStatus = {Phase = "requesting", JobId = targetJobId, Reason = tostring(reason)}
                    print("[TrashHub][HOP_BEGIN] Target=" .. targetJobId .. " Reason=" .. tostring(reason))
                    TrashHubNotify.NotifyHopStatus("Teleporting to server...",
                        string.format("%s | %s Players", tostring(chosen.Region or "Server"), tostring(chosen.Count or "?")), FLUENT_ACCENTS.Earned)

                    local requestStartedAt = tick()
                    local serverBrowser = ReplicatedStorage:FindFirstChild("__ServerBrowser")
                    local canUseNativeRemote = serverBrowser and serverBrowser:IsA("RemoteFunction")
                    if canUseNativeRemote then
                        task.spawn(function()
                            if not alive() or activeAttempt ~= ctx then
                                ctx.remoteDone = true
                                return
                            end
                            if not waitForBountyClear(ctx) then ctx.remoteDone = true; return end
                            local remoteOk, remoteError = pcall(function()
                                if not waitForBountyClear(ctx) then return end
                                requestStartedAt = tick()
                                ctx.remoteSent = true
                                serverBrowser:InvokeServer("teleport", targetJobId)
                            end)
                            ctx.remoteDone = true
                            if not remoteOk then ctx.remoteError = tostring(remoteError) end
                        end)
                    end
                    while alive() and not ctx.failed do
                        local now = tick()
                        if ctx.started then
                            if now - (ctx.stateAt or ctx.startedAt or requestStartedAt) >= handoffTimeout then
                                ctx.failed = true
                                ctx.error = "Teleport handoff timed out after " .. handoffTimeout .. "s (" .. tostring(ctx.state) .. ")"
                            end
                        elseif canUseNativeRemote and not ctx.remoteDone then
                            if ctx.remoteSent and not ctx.pendingReported and now - requestStartedAt >= requestTimeout then
                                ctx.pendingReported = true
                                Hunter.HopStatus = {Phase = "native-request-pending", JobId = targetJobId}
                                warn("[TrashHub][HOP_PENDING] Native teleport request is still pending; waiting before sending another request")
                            end
                        elseif not ctx.fallbackRequested and (not canUseNativeRemote or ctx.remoteError or now - requestStartedAt >= fallbackDelay) then
                            if not waitForBountyClear(ctx) then return end
                            local fallbackOk, fallbackError = pcall(function()
                                if not waitForBountyClear(ctx) then return end
                                ctx.fallbackRequested = true
                                ctx.fallbackAt = tick()
                                TeleportService:TeleportToPlaceInstance(game.PlaceId, targetJobId, LocalPlayer)
                            end)
                            if not fallbackOk then
                                ctx.failed = true
                                ctx.error = tostring(fallbackError)
                            end
                        elseif ctx.fallbackRequested and now - ctx.fallbackAt >= requestTimeout then
                            ctx.failed = true
                            ctx.error = "No teleport acknowledgement within " .. requestTimeout .. " seconds"
                        end
                        if not ctx.failed then task.wait(0.1) end
                    end
                    -- A yielding native request must settle before a new target is requested.
                    while alive() and canUseNativeRemote and not ctx.remoteDone do
                        task.wait(0.1)
                    end
                    if not alive() then return end
                    rememberHopServer(targetJobId, "failed")
                    Hunter.HopStatus = {Phase = "failed", JobId = targetJobId, Error = ctx.error}
                    warn("[TrashHub][HOP_RETRY] " .. targetJobId .. ": " .. tostring(ctx.error))
                    if activeAttempt == ctx then activeAttempt = nil end
                    task.wait(math.max(ctx.retryDelay or tonumber(HOP_CONFIG.RetryDelaySeconds) or 3, 0.25))
                end
                if alive() then
                    task.wait(math.max(tonumber(HOP_CONFIG.RetryDelaySeconds) or 3, 0.25))
                end
            end
        end, function(err)
            return tostring(err)
        end)
        cleanup()
        if not ok then
            Hunter.HopStatus = {Phase = "error", Error = tostring(hopError)}
            warn("[TrashHub][HOP_ERROR] " .. tostring(hopError))
        end
    end)
    return true
end

end

local _HL_PORTALX_FILL = Color3.fromRGB(180, 50, 255)
local _HL_PORTALX_OUTLINE = Color3.fromRGB(0, 255, 255)
local _HL_DEFAULT_FILL = Color3.fromRGB(255, 30, 60)
local _HL_DEFAULT_OUTLINE = Color3.fromRGB(255, 45, 75)

local function _update3DLaserImpl(tCharOverride, tPartOverride)
    if Hunter._laserAdorn then
        local old = Hunter._laserAdorn
        Hunter._laserAdorn = nil
        pcall(old.Destroy, old)
    end
    local cfg = Hunter.Config or CONFIG
    local myChar = LocalPlayer.Character
    local _, _, myRoot = getCharacter()
    local targetChar = tCharOverride or Hunter.TargetCharacter
    local targetPart = tPartOverride or Hunter.TargetPart

    if myRoot and targetChar and targetPart and targetPart.Parent and isAlive(targetChar) then
        local isPortalX = Hunter.TargetPlayer ~= nil and isTargetUsingPortalDimension(Hunter.TargetPlayer)
        local realCF = isPortalX and Hunter.PortalXTracker and Hunter.PortalXTracker.GetRealCFrame(Hunter.TargetPlayer)
        local realPos = (realCF and realCF.Position) or (isPortalX and Hunter.PortalXTracker and Hunter.PortalXTracker.GetRealPosition(Hunter.TargetPlayer))

        local targetChestPart = (targetChar:FindFirstChild("UpperTorso") or targetChar:FindFirstChild("Torso")) or targetPart
        local pB = realPos and (realPos + Vector3.new(0, 1.5, 0)) or targetChestPart.Position
        local dist = (pB - myRoot.Position).Magnitude

        if cfg and cfg.DisableCombatHighlight then
            if Hunter._targetHighlight then
                local oldHl = Hunter._targetHighlight
                Hunter._targetHighlight = nil
                pcall(oldHl.Destroy, oldHl)
            end
        else
            if not Hunter._targetHighlight or Hunter._targetHighlight.Parent ~= Workspace.Terrain then
                if Hunter._targetHighlight then
                    local oldHl = Hunter._targetHighlight
                    Hunter._targetHighlight = nil
                    pcall(oldHl.Destroy, oldHl)
                end
                local hl = Instance.new("Highlight")
                hl.Name = "BF_HunterHighlight"
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = Workspace.Terrain
                Hunter._targetHighlight = hl
                Hunter._lastHighlightMode = nil
            end
            local hl = Hunter._targetHighlight
            if hl.Adornee ~= targetChar or Hunter._lastHighlightMode ~= isPortalX then
                hl.Adornee = targetChar
                if isPortalX then
                    hl.FillColor = _HL_PORTALX_FILL
                    hl.FillTransparency = 0.45
                    hl.OutlineColor = _HL_PORTALX_OUTLINE
                    hl.OutlineTransparency = 0.0
                else
                    hl.FillColor = _HL_DEFAULT_FILL
                    hl.FillTransparency = 0.92
                    hl.OutlineColor = _HL_DEFAULT_OUTLINE
                    hl.OutlineTransparency = 0.0
                end
                Hunter._lastHighlightMode = isPortalX
            end
            if not hl.Enabled then
                hl.Enabled = true
            end
        end

        if isPortalX then
            if not Hunter._portalXBillboard or Hunter._portalXBillboard.Parent ~= Workspace.Terrain then
                if Hunter._portalXBillboard then
                    local oldBb = Hunter._portalXBillboard
                    Hunter._portalXBillboard = nil
                    pcall(oldBb.Destroy, oldBb)
                end
                local bb = Instance.new("BillboardGui")
                bb.Name = "BF_HunterPortalX_ESP"
                bb.Adornee = Workspace.Terrain
                bb.AlwaysOnTop = true
                bb.Size = UDim2.new(0, 240, 0, 48)
                bb.Parent = Workspace.Terrain
                local lbl = Instance.new("TextLabel")
                lbl.Name = "PortalXLabel"
                lbl.BackgroundTransparency = 1
                lbl.Size = UDim2.new(1, 0, 1, 0)
                lbl.Font = Enum.Font.GothamBold
                lbl.TextSize = 13
                lbl.TextColor3 = Color3.fromRGB(0, 255, 255)
                lbl.TextStrokeColor3 = Color3.fromRGB(140, 0, 255)
                lbl.TextStrokeTransparency = 0
                lbl.Parent = bb
                Hunter._portalXBillboard = bb
                Hunter._portalXLabel = lbl
            end
            if Hunter._portalXBillboard and Hunter._portalXLabel then
                local targetDisplayName = (Hunter.TargetPlayer and Hunter.TargetPlayer.DisplayName) or "Target"
                local distM = math.floor(dist)
                Hunter._portalXBillboard.StudsOffsetWorldSpace = pB + Vector3.new(0, 3.2, 0)
                Hunter._portalXLabel.Text = string.format("[PORTAL X] %s (%dm)\n[INVINCIBLE - FOLLOWING]", targetDisplayName, distM)
                if not Hunter._portalXBillboard.Enabled then
                    Hunter._portalXBillboard.Enabled = true
                end
            end
        elseif Hunter._portalXBillboard and Hunter._portalXBillboard.Enabled then
            Hunter._portalXBillboard.Enabled = false
        end
    else
        if Hunter._laserAdorn then
            local old = Hunter._laserAdorn
            Hunter._laserAdorn = nil
            pcall(old.Destroy, old)
        end
        if Hunter._targetHighlight then
            if Hunter._targetHighlight.Enabled then
                Hunter._targetHighlight.Enabled = false
            end
            if Hunter._targetHighlight.Adornee ~= nil then
                Hunter._targetHighlight.Adornee = nil
            end
            Hunter._lastHighlightMode = nil
        end
        if Hunter._portalXBillboard and Hunter._portalXBillboard.Enabled then
            Hunter._portalXBillboard.Enabled = false
        end
    end
end

