local function setupNotificationListener()
    pcall(function()
        local pg = LocalPlayer:FindFirstChild("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 2.0)
        if not pg then return end
        local processedLabels = setmetatable({}, { __mode = "k" })
        local textConns = {}
        if getgenv()._TrashHub_NotifConn then
            pcall(function() getgenv()._TrashHub_NotifConn:Disconnect() end)
        end
        if getgenv()._TrashHub_NotifTextConns then
            for _, c in ipairs(getgenv()._TrashHub_NotifTextConns) do
                pcall(function() c:Disconnect() end)
            end
        end
        getgenv()._TrashHub_NotifTextConns = textConns

        local function checkLabel(desc)
            if desc:IsA("TextLabel") and desc.Text ~= "" then
                local cText = ""
                pcall(function() cText = desc.ContentText end)
                local cleanVictim, earnedVal, cleanFullText = parseKillNotificationText(desc.Text, cText)
                if cleanVictim and cleanVictim ~= "" then
                    local prevKey = processedLabels[desc]
                    local curKey = cleanFullText .. "|" .. tostring(earnedVal or "")
                    if prevKey == curKey then return end
                    processedLabels[desc] = curKey

                    local now = tick()
                    _killedTargets[cleanVictim] = now

                    local pObj = Players:FindFirstChild(cleanVictim)
                    if pObj then
                        _lastKilledVictimName = string.format("%s (@%s)", pObj.DisplayName, pObj.Name)
                    else
                        _lastKilledVictimName = cleanVictim
                    end

                    if earnedVal and earnedVal > 0 then
                        _lastNotifEarnedVal = earnedVal
                        _lastNotifEarnedTick = now
                        _recentNotifEarnedByVictim[cleanVictim:lower()] = {
                            earned = earnedVal,
                            tick = now,
                            victimDisplay = _lastKilledVictimName,
                            consumed = false
                        }
                    end

                    local current = Hunter.TargetPlayer or _currentCombatTarget
                    local shouldTransition = (current == nil) or (current.Name == cleanVictim)
                    if current and current.Name == cleanVictim then
                        Hunter.TargetPlayer = nil
                        Hunter.TargetCharacter = nil
                        Hunter.TargetPart = nil
                        Hunter.PredictedPos = nil
                        _currentCombatTarget = nil
                        _lastCombatEnemyName = cleanVictim
                        _combatElapsedTime = 0
                        _lastCombatTick = nil
                        _lastTargetHealth = nil
                        _lastDamageDealtTick = nil
                        _hasEngagedInCombat = false
                        _targetInvalidSince = nil
                        _targetInvalidPlayer = nil
                        _lastControlledCombatPos = nil
                        _lastControlledTargetPos = nil
                        _lastControlledCombatTick = 0
                        isSkillHolding = false
                        setHover(false)
                    end
                    _lastFindTargetTime = 0
                    _noTargetStartTime = 0
                    if shouldTransition then
                        _postKillTransitionPending = true
                        _postKillTransitionTick = now
                    end

                    local victimForStats = _lastKilledVictimName
                    local rawVictimName = cleanVictim
                    if earnedVal and earnedVal > 0 then
                        task.defer(function()
                            updateBountyStats(victimForStats, earnedVal)
                        end)
                    else
                        task.spawn(function()
                            local wStart = tick()
                            while tick() - wStart < 1.2 do
                                local foundVal = scanNotificationsForVictimEarned(rawVictimName)
                                if foundVal and foundVal > 0 then
                                    updateBountyStats(victimForStats, foundVal)
                                    return
                                end
                                task.wait(0.08)
                            end
                            local finalVal = scanNotificationsForVictimEarned(rawVictimName)
                            if finalVal and finalVal > 0 then
                                updateBountyStats(victimForStats, finalVal)
                            end
                        end)
                    end
                end
            end
        end

        local function attachTextListener(label)
            local conn = label:GetPropertyChangedSignal("Text"):Connect(function()
                checkLabel(label)
            end)
            table.insert(textConns, conn)
        end

        local function bindNotifsContainer(notifs)
            if not notifs then return end
            local conn = notifs.DescendantAdded:Connect(function(desc)
                task.defer(checkLabel, desc)
                if desc:IsA("TextLabel") then
                    attachTextListener(desc)
                end
            end)
            table.insert(textConns, conn)
            getgenv()._TrashHub_NotifConn = conn
            for _, desc in ipairs(notifs:GetDescendants()) do
                if desc:IsA("TextLabel") then
                    attachTextListener(desc)
                end
            end
        end

        local notifs = pg:FindFirstChild("Notifications") or pg:WaitForChild("Notifications", 2.0)
        if notifs then
            bindNotifsContainer(notifs)
        end
        local pgConn = pg.ChildAdded:Connect(function(child)
            if child.Name == "Notifications" then
                bindNotifsContainer(child)
            end
        end)
        table.insert(textConns, pgConn)
    end)
end
task.delay(0.2, setupNotificationListener)
