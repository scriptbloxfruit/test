        if numericHealth > 0 and numericHealth <= LOW_HP_ESCAPE_CFG.TriggerHealth then
            if not Hunter._isHealingInSky then
                handleLowHealthEscape(root, hum)
            end
        elseif numericHealth <= 0 then
            releaseLowHealthEscape("character died")
        end
    end

