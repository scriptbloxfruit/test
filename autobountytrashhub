    local function triggerEnemySkillDodge(attacker, skillInfo)
        if not api.Enabled or api.Destroyed or not Hunter._isRunning then return end
        if not attacker or not Hunter.TargetPlayer or attacker ~= Hunter.TargetPlayer then return end
        local _, myHum, myRoot = getCharacter()
        if not myRoot or not myHum or myHum.Health <= 0 then return end
        local enemyRoot = api._enemyRoots[attacker] or (attacker.Character and attacker.Character:FindFirstChild("HumanoidRootPart"))
        if not enemyRoot then return end

        local dist = (enemyRoot.Position - myRoot.Position).Magnitude
        if dist > (api.MaxProximity or 250) then return end

        if tonumber(skillInfo.Id) == 11839435734 or tostring(skillInfo.Id) == "11839435734" then
            markEnemyPortalVCast(attacker, false)
        end

        local now = os.clock()
        if now >= api.EnemyDodgeUntil then
            api.ShotsInCurrentDodge = 0
        end
        local holdTime = (tonumber(skillInfo.Duration) or 1.5) + 0.15
        api.EnemyDodgeUntil = math.max(api.EnemyDodgeUntil, now + holdTime)
        api.LastThreatPlayer = attacker
        api.LastThreatSkill = skillInfo
        api.ActiveMode = "ENEMY_SKILL_DODGE"

        if Hunter._skillHeldKey then
            pcall(function() VirtualInputManager:SendKeyEvent(false, Hunter._skillHeldKey, false, game) end)
            Hunter._skillHeldKey = nil
        end
        isSkillHolding = false
        Hunter._isPreparingSkillCast = false
        snapToSkyAboveTarget()
    end

    local function hookPlayer(player)
        if player == LocalPlayer then return end
        disconnectList(api._playerConns[player])
        disconnectList(api._playerCharConns[player])
        api._playerConns[player] = {}
        api._playerCharConns[player] = {}
        api._hookedAnimators = setmetatable({}, { __mode = "k" })

        local function onTrackPlayed(track)
            if not api.Enabled or api.Destroyed then return end
            local anim = track and track.Animation
            if not anim then return end
            local animIdStr = tostring(anim.AnimationId or "")
            local animDigits = extractRbxAssetDigits(animIdStr)

            if animDigits and PORTAL_V_ANIM_IDS[animDigits] then
                markEnemyPortalVCast(player, false)
            end

            if not Hunter.TargetPlayer or player ~= Hunter.TargetPlayer then return end

            local skillInfo = DANGER_LOOKUP[animIdStr] or (animDigits and DANGER_LOOKUP[animDigits])
            if not skillInfo then return end
            if skillInfo.Id == 10122845177 and track.Speed > 0 and track.Speed < 0.25 then return end
            triggerEnemySkillDodge(player, skillInfo)
        end

        local function bindEnemySound(soundObj, charConnList)
            if not soundObj or not soundObj:IsA("Sound") then return end
            local sDigits = extractRbxAssetDigits(soundObj.SoundId)
            local sName = soundObj.Name
            local isRelevantSound = (sDigits and PORTAL_V_SOUND_IDS[sDigits]) or sName == "PortalV" or sName == "DivinePortalV" or sName == "PortalVTeleport"

            local function checkSound()
                if not soundObj.Parent or api.Destroyed then return end
                if not soundObj.IsPlaying then return end

                local digits = extractRbxAssetDigits(soundObj.SoundId)
                local name = soundObj.Name

                if (digits and PORTAL_V_SOUND_IDS[digits]) or name == "PortalV" or name == "DivinePortalV" or name == "PortalVTeleport" then
                    local isTp = (digits == "11848254064" or name == "PortalVTeleport")
                    markEnemyPortalVCast(player, isTp)
                    if Hunter.TargetPlayer and player == Hunter.TargetPlayer then
                        local vSkillEntry = DANGER_LOOKUP["rbxassetid://11839435734"] or { Id = 11839435734, Duration = 3.0 }
                        triggerEnemySkillDodge(player, vSkillEntry)
                    end
                end
            end

            if isRelevantSound then
                checkSound()
                table.insert(charConnList, soundObj:GetPropertyChangedSignal("Playing"):Connect(checkSound))
                table.insert(charConnList, soundObj.Played:Connect(checkSound))
            end
            table.insert(charConnList, soundObj:GetPropertyChangedSignal("SoundId"):Connect(checkSound))
        end

        local function bindAnimator(animator, charConnList)
            if not animator or not animator:IsA("Animator") or api._hookedAnimators[animator] then return end
            api._hookedAnimators[animator] = true
            table.insert(charConnList, animator.AnimationPlayed:Connect(onTrackPlayed))
        end

        local function bindRaceV4Value(raceVal, charConnList)
            if not raceVal or not raceVal:IsA("BoolValue") then return end
            table.insert(charConnList, raceVal:GetPropertyChangedSignal("Value"):Connect(function()
                if raceVal.Value == true and Hunter.TargetPlayer == player then
                    triggerEnemySkillDodge(player, RACE_V4_ENTRY)
                end
            end))
        end

        local function bindTransformedToolRig(tool, charConnList)
            if not tool or not tool:IsA("Tool") then return end
            local rigObj = tool:FindFirstChild("TransformedRigObject")
            if not rigObj or not rigObj:IsA("ObjectValue") then return end
            local function inspectRig(rigModel)
                if typeof(rigModel) == "Instance" then
                    for _, desc in ipairs(rigModel:GetDescendants()) do
                        if desc:IsA("Animator") then bindAnimator(desc, charConnList) end
                    end
                end
            end
            if rigObj.Value then inspectRig(rigObj.Value) end
            table.insert(charConnList, rigObj:GetPropertyChangedSignal("Value"):Connect(function() inspectRig(rigObj.Value) end))
        end

        local function setupChar(char)
            disconnectList(api._playerCharConns[player])
            api._enemyRoots[player] = nil
            local charConnList = api._playerCharConns[player]
            if not char then return end

            local immediateRoot = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
            if immediateRoot then api._enemyRoots[player] = immediateRoot end

            local raceVal = char:FindFirstChild("RaceTransformed")
            if raceVal then bindRaceV4Value(raceVal, charConnList) end

            task.spawn(function()
                local root = immediateRoot or char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 2.0) or char.PrimaryPart
                if player.Character ~= char or api.Destroyed or _activeTrackedTarget ~= player or api._playerCharConns[player] ~= charConnList then return end
                api._enemyRoots[player] = root

                local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 2.0)
                if player.Character ~= char or api.Destroyed or _activeTrackedTarget ~= player or api._playerCharConns[player] ~= charConnList then return end
                if hum and player.Character == char then
                    local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 2.0)
                    if animator and _activeTrackedTarget == player and api._playerCharConns[player] == charConnList then
                        bindAnimator(animator, charConnList)
                    end
                end
                if _activeTrackedTarget ~= player or api._playerCharConns[player] ~= charConnList or api.Destroyed then return end

                for _, desc in ipairs(char:GetDescendants()) do
                    if desc:IsA("Animator") then bindAnimator(desc, charConnList)
                    elseif desc:IsA("Sound") then bindEnemySound(desc, charConnList)
                    elseif desc:IsA("Tool") then bindTransformedToolRig(desc, charConnList)
                    elseif desc.Name == "RaceTransformed" and desc:IsA("BoolValue") then bindRaceV4Value(desc, charConnList) end
                end

                table.insert(charConnList, char.DescendantAdded:Connect(function(desc)
                    if _activeTrackedTarget ~= player or api.Destroyed then return end
                    if desc.Name == "HumanoidRootPart" and desc:IsA("BasePart") then api._enemyRoots[player] = desc
                    elseif desc:IsA("Animator") then bindAnimator(desc, charConnList)
                    elseif desc:IsA("Sound") then bindEnemySound(desc, charConnList)
                    elseif desc:IsA("Tool") then bindTransformedToolRig(desc, charConnList)
                    elseif desc.Name == "RaceTransformed" and desc:IsA("BoolValue") then bindRaceV4Value(desc, charConnList) end
                end))
            end)
        end

        if player.Character then setupChar(player.Character) end
        table.insert(api._playerConns[player], player.CharacterAdded:Connect(setupChar))
        table.insert(api._playerConns[player], player.CharacterRemoving:Connect(function()
            disconnectList(api._playerCharConns[player])
            api._enemyRoots[player] = nil
        end))
    end

    local _activeTrackedTarget = nil
    local function unhookCurrentTarget()
        if _activeTrackedTarget then
            local p = _activeTrackedTarget
            disconnectList(api._playerConns[p])
            disconnectList(api._playerCharConns[p])
            api._playerConns[p] = nil
            api._playerCharConns[p] = nil
            api._enemyRoots[p] = nil
            api._hookedAnimators = setmetatable({}, { __mode = "k" })
            _activeTrackedTarget = nil
        end
    end

    local function updateTargetTracking()
        local currentTarget = Hunter.TargetPlayer
        if currentTarget ~= _activeTrackedTarget then
            unhookCurrentTarget()
            if currentTarget and currentTarget ~= LocalPlayer and currentTarget.Parent then
                _activeTrackedTarget = currentTarget
                hookPlayer(currentTarget)
            end
        end
    end
    api.UpdateTarget = updateTargetTracking

    table.insert(api._connections, Players.PlayerRemoving:Connect(function(p)
        if p == _activeTrackedTarget then
            unhookCurrentTarget()
        end
        disconnectList(api._playerConns[p])
        disconnectList(api._playerCharConns[p])
        api._playerConns[p] = nil
        api._playerCharConns[p] = nil
