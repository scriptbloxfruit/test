Hunter.WaitForSkillRuntime = function(tool, keyName, timeout)
    local char = LocalPlayer.Character
    local waitStarted = os.clock()
    local deadline = waitStarted + math.max(0.35, tonumber(timeout) or 0.65)
    if unlockSkillState then unlockSkillState() end
    repeat
        if not char or LocalPlayer.Character ~= char or not tool or tool.Parent ~= char
            or not Hunter._isRunning then
            return false
        end
        if Hunter.IsActionLocked(char) then
            if os.clock() >= deadline then
                return false
            end
            task.wait(0.015)
            continue
        end
        local result = Hunter.ReadSkillState(tool, keyName)
        local elapsed = os.clock() - waitStarted
        local isMovesetTool = tool:GetAttribute("MovesetToolUid") ~= nil
        if result then
            if result.Unlocked == false or result.CooldownReady == false
                or result.Status == "NO_SKILL" or result.Status == "LOCKED"
                or (result.Exact == true and result.Status == "COOLDOWN")
                or ((isMovesetTool or elapsed >= 0.08) and result.EstimatedCooldownReady == false) then
                Hunter._localSkillCooldownUntil = Hunter._localSkillCooldownUntil or {}
                Hunter._localSkillCooldownUntil[tostring(tool.Name) .. "_" .. tostring(keyName)] = os.clock() + 0.45
                return false
            end
            if (result.Exact == true and result.Ready == true)
                or (isMovesetTool and result.Unlocked ~= false and result.EstimatedCooldownReady ~= false) then
                if unlockSkillState then unlockSkillState() end
                return true
            end
        end
        if elapsed >= 0.08
            and (not result or (result.CooldownReady ~= false and result.EstimatedCooldownReady ~= false and result.Unlocked ~= false)) then
            if unlockSkillState then unlockSkillState() end
            Hunter._skillRuntimeBlock = nil
            return true
        end
        if unlockSkillState then unlockSkillState() end
        if os.clock() >= deadline then
            return false
        end
        task.wait(0.015)
    until false
end



