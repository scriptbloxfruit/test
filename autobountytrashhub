        if _offshoreCache then _offshoreCache[p] = nil end
        if Hunter._enemyPortalVCastTick then Hunter._enemyPortalVCastTick[p] = nil end
        if Hunter._enemyPortalVCastPos then Hunter._enemyPortalVCastPos[p] = nil end
        if Hunter._enemyPortalVTeleportTick then Hunter._enemyPortalVTeleportTick[p] = nil end
        if Hunter._targetSpeedTracker then Hunter._targetSpeedTracker[p] = nil end
    end))

    function api:StepMovement(dt, myRoot, myHum, tPart, skillsCfg)
        updateTargetTracking()
        if not self.Enabled or self.Destroyed or not myRoot or not myHum or myHum.Health <= 0 or not tPart or not tPart.Parent then
            self.ActiveMode = nil
            self.ReturningFromSky = false
            return false
        end
        local myChar = myRoot.Parent
        if myChar and Hunter.StunCheck and Hunter.StunCheck.IsServerPhysicsLocked and Hunter.StunCheck.IsServerPhysicsLocked(myChar) then
            self:IsSelfStunDodging()
            self.ActiveMode = "SERVER_STUN_LOCKED"
            if Hunter.Kinematics then
                Hunter.Kinematics:Pause()
            end
            return false
        end
        if Hunter.GhostShipRoute and (
            Hunter.GhostShipRoute.Busy
            or Hunter.GhostShipRoute:GetArea(myRoot.Position) ~= Hunter.GhostShipRoute:GetArea(tPart.Position)
            or Hunter.GhostShipRoute:IsInsideGhostShip(myRoot.Position)
            or Hunter.GhostShipRoute:IsInsideGhostShip(tPart.Position)
        ) then
            self.ActiveMode = nil
            self.ReturningFromSky = false
            return false
        end
        if isLocalPlayerInPortalDimension() then
            self.ActiveMode = nil
            self.ReturningFromSky = false
            return false
        end

        local tPos = (Hunter.PortalXTracker and Hunter.TargetPlayer and Hunter.PortalXTracker.GetRealPosition(Hunter.TargetPlayer)) or tPart.Position
        local mPos = myRoot.Position
        local distToTarget = (mPos - tPos).Magnitude

        if distToTarget > 2500
            or (Hunter.TargetPlayer and isTargetInPortalVDimension(Hunter.TargetPlayer))
            or (Hunter.TargetPlayer and (
                (Hunter.PortalXTracker and Hunter.PortalXTracker.IsInPortalX(Hunter.TargetPlayer))
                or isTargetUsingPortalDimension(Hunter.TargetPlayer)
            ))
        then
            self.EnemyDodgeUntil = 0
            self.StunDodgeUntil = 0
            self.ActiveMode = nil
            self.ReturningFromSky = false
            return false
        end

        local lookAtPos = Hunter.PredictedPos or getPredictedPos(tPart) or tPos
        local shouldKite, kiteReason = self:ShouldKiteInSky(skillsCfg)

        if shouldKite then
            if kiteReason == "STUN_DODGE" or (Hunter.StunCheck and Hunter.StunCheck.IsRealStun and Hunter.StunCheck.IsRealStun(myChar)) then
                cleanSelfStunMovers(myRoot)
            end
            self.ActiveMode = kiteReason
            self.ReturningFromSky = true
            if Hunter.Kinematics then
                Hunter.Kinematics:Pause()
            end
            local skyGoal = Vector3.new(
                tPos.X + (self.SkyLateralOffsetX or 55),
                tPos.Y + (self.SkyHeightOffset or 120),
                tPos.Z + (self.SkyLateralOffsetZ or 35)
            )
            local distToSkyGoal = (skyGoal - mPos).Magnitude
            local nextPos
            if distToTarget <= self.DirectTeleportRange or distToSkyGoal <= self.DirectTeleportRange then
                nextPos = skyGoal
            else
                local clampedDt = math.clamp(tonumber(dt) or 0.016, 0, 0.033)
                local stepDist = math.min(distToSkyGoal, 220 * clampedDt)
                nextPos = mPos + (skyGoal - mPos).Unit * stepDist
            end

            local nextCF = Hunter.Kinematics:LookAt(nextPos, lookAtPos, myRoot.CFrame)
            if Hunter.AntiLava then
                nextCF = Hunter.AntiLava:FilterMove(myRoot, myHum, nextCF)
            end
            if Hunter.GhostShipRoute then
                nextCF = Hunter.GhostShipRoute:ClampInteriorCFrame(myRoot, nextCF)
            end
            myRoot.CFrame = nextCF
            myRoot.AssemblyLinearVelocity = Vector3.zero
            myRoot.AssemblyAngularVelocity = Vector3.zero
            _lastControlledCombatPos = nextCF.Position
            _lastControlledTargetPos = tPos
            _lastControlledCombatTick = tick()
            return true
        else
            self.ActiveMode = nil
            local triggerDist = Hunter.GunM1:GetComboDistance()
            if self.ReturningFromSky then
                self.ReturningFromSky = false
                if distToTarget <= self.DirectTeleportRange and distToTarget > triggerDist then
                    if Hunter.SoruApproach and Hunter.SoruApproach:TryApproach(myRoot, myHum, tPart) then
                        _lastControlledCombatPos = myRoot.Position
                        _lastControlledTargetPos = tPos
                        _lastControlledCombatTick = tick()
                        return true
                    end
                    local landingPos = tPos + Vector3.new(0, 1.5, 2.0)
                    if landingPos.Y > -140 and landingPos.Y < 5.5 and landingPos.X < 45000 and landingPos.Z < 30000 then
                        landingPos = Vector3.new(landingPos.X, 5.5, landingPos.Z)
                    end
                    local nextCF = Hunter.Kinematics:LookAt(landingPos, lookAtPos, myRoot.CFrame)
                    if Hunter.AntiLava then
                        nextCF = Hunter.AntiLava:FilterMove(myRoot, myHum, nextCF)
                    end
                    if Hunter.GhostShipRoute then
                        nextCF = Hunter.GhostShipRoute:ClampInteriorCFrame(myRoot, nextCF)
                    end
                    myRoot.CFrame = nextCF
                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                    _lastControlledCombatPos = nextCF.Position
                    _lastControlledTargetPos = tPos
                    _lastControlledCombatTick = tick()
                    return true
                end
            end
            return false
        end
    end

    function api:Destroy()
        self.Destroyed = true
        self.Enabled = false
        self.EnemyDodgeUntil = 0
        self.StunDodgeUntil = 0
        unhookCurrentTarget()
        disconnectList(self._connections)
        disconnectList(self._localCharConns)
        for p, list in pairs(self._playerConns) do disconnectList(list) end
        for p, list in pairs(self._playerCharConns) do disconnectList(list) end
        table.clear(self._playerConns)
        table.clear(self._playerCharConns)
        table.clear(self._enemyRoots)
    end

    return api
end)()

