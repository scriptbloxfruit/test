            Hunter._storedTarget = rawget(BloxMouse, "Target") or Hunter._storedTarget
            Hunter._storedX = rawget(BloxMouse, "X") or Hunter._storedX or 0
            Hunter._storedY = rawget(BloxMouse, "Y") or Hunter._storedY or 0

            rawset(BloxMouse, "Hit", nil)
            rawset(BloxMouse, "Target", nil)
            rawset(BloxMouse, "X", nil)
            rawset(BloxMouse, "Y", nil)

            mt.__newindex = function(self, key, val)
                if key == "Hit" then Hunter._storedHit = val return end
                if key == "Target" then Hunter._storedTarget = val return end
                if key == "X" then Hunter._storedX = val return end
                if key == "Y" then Hunter._storedY = val return end
                rawset(self, key, val)
            end

            mt.__index = function(self, key)
                if Hunter._isRunning and Hunter.TargetPart and Hunter.TargetPart.Parent and isAlive(Hunter.TargetCharacter) then
                    local predPos = getPredictedPos(Hunter.TargetPart)
                    local aimCamera = Workspace.CurrentCamera or Camera
