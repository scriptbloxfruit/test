    }
    local overrides = Hunter.Config and Hunter.Config.Kinematics
    if type(overrides) == "table" then
        for name, value in pairs(overrides) do
            if cfg[name] ~= nil and type(value) == "number" and value == value and math.abs(value) < math.huge then
