do
    local _fastSkill = {
        initialized = false,
        hookInstalled = false,
        ownsHook = false,
        oldIndex = nil,
        globalModule = nil,
        castGuardFunction = nil,
        castGuardIndex = nil,
        maintenanceToken = 0,
        maintenanceActive = false,
        watchConnections = {},
        watchedObjects = setmetatable({}, {__mode = "k"}),
        watchedCharacter = nil,
    }

    local function _fs_isCharacterLocked(character)
        character = character or LocalPlayer.Character
        if not character then return true end
        local hk = getgenv()._BF_HunterKiller or Hunter
        if hk and hk.IsActionLocked then
            return hk.IsActionLocked(character)
        end
        return false
    end

    local _castGuardSearchRunning = false
    local function _fs_findCastGuardUpvalueAsync()
        if _fastSkill.castGuardFunction and _fastSkill.castGuardIndex then return true end
        local cached = getgenv()._TrashHub_CachedCastGuard
        if type(cached) == "table" and type(cached.fn) == "function" and type(cached.idx) == "number" then
            _fastSkill.castGuardFunction = cached.fn
            _fastSkill.castGuardIndex = cached.idx
            return true
        end
        if _castGuardSearchRunning then return false end
        if type(getgc) ~= "function" or type(debug) ~= "table"
            or type(debug.getupvalues) ~= "function" or type(debug.setupvalue) ~= "function"
            or type(debug.getinfo) ~= "function" then
            return false
        end
        _castGuardSearchRunning = true
        task.spawn(function()
            task.wait(2.5)
            local okList, list = pcall(getgc, false)
            if okList and type(list) == "table" then
                local sliceStart = os.clock()
                for i = 1, #list do
                    local obj = list[i]
                    if type(obj) == "function" then
                        local okInfo, info = pcall(debug.getinfo, obj)
                        local src = okInfo and info and tostring(info.short_src or info.source or "") or ""
                        if src:find("MovesetClientRunner", 1, true) then
                            local okUp, upvalues = pcall(debug.getupvalues, obj)
                            if okUp and type(upvalues) == "table" then
                                local hasGlobalRef = false
                                local boolIndex = nil
                                for idx, val in pairs(upvalues) do
                                    if val == _fastSkill.globalModule then
                                        hasGlobalRef = true
                                    elseif type(val) == "boolean" then
                                        boolIndex = idx
                                    end
                                end
                                if hasGlobalRef and boolIndex then
                                    _fastSkill.castGuardFunction = obj
                                    _fastSkill.castGuardIndex = boolIndex
                                    getgenv()._TrashHub_CachedCastGuard = { fn = obj, idx = boolIndex }
                                    break
                                end
                            end
                        end
                    end
                    if os.clock() - sliceStart > 0.001 then
                        task.wait()
                        sliceStart = os.clock()
                    end
                end
            end
            _castGuardSearchRunning = false
        end)
        return false
    end

    local function _fs_resetCastGuard()
        if not _fastSkill.castGuardFunction or not _fastSkill.castGuardIndex then
            _fs_findCastGuardUpvalueAsync()
            return false
        end
        local ok = pcall(debug.setupvalue, _fastSkill.castGuardFunction, _fastSkill.castGuardIndex, false)
        return ok
    end

    local function _fs_resetGlobalState()
        if not _fastSkill.globalModule then return false end
        if _fs_isCharacterLocked(LocalPlayer.Character) then return false end
        _fastSkill.globalModule.busy = false
        _fastSkill.globalModule.castTimer = 0
        _fastSkill.globalModule.equipTimer = 0
        _fastSkill.globalModule.tapCooldown = 0
        _fastSkill.globalModule.fruitSwapTimeLockout = 0
        _fastSkill.globalModule.Swimming = false
        return true
    end

    local function _fs_init()
        if _fastSkill.initialized then return true end
        pcall(function()
            local gModule = ReplicatedStorage:FindFirstChild("Global")
            if gModule then
                _fastSkill.globalModule = require(gModule)
            else
                task.defer(function()
                    pcall(function()
                        local gm = ReplicatedStorage:FindFirstChild("Global") or ReplicatedStorage:WaitForChild("Global", 1.0)
                        if gm then
                            _fastSkill.globalModule = require(gm)
                            _fs_findCastGuardUpvalueAsync()
                        end
                    end)
                end)
            end
        end)
        _fs_findCastGuardUpvalueAsync()
        pcall(function()
            local prev = getgenv().__FastSkill
            local prevState = prev and type(prev.GetState) == "function" and prev.GetState()
            if prevState and prevState.hookInstalled and prevState.oldIndex and type(hookmetamethod) == "function" then
                pcall(function()
                    hookmetamethod(game, "__index", prevState.oldIndex)
                end)
            end
            _fastSkill.oldIndex = nil
            _fastSkill.hookInstalled = false
            _fastSkill.ownsHook = false
        end)
        _fastSkill.initialized = true
        return true
    end

    local function _fs_bypass()
        pcall(function()
            local character = LocalPlayer.Character
            if not character then return end
            if _fs_isCharacterLocked(character) then return end
            local hk = getgenv()._BF_HunterKiller or Hunter
            local busy = character:FindFirstChild("Busy")
            if busy and (busy:IsA("BoolValue") or busy:IsA("ValueBase")) then
                busy.Value = false
            end
            if not (hk and hk._skillHeldKey) then
                for _, child in ipairs(character:GetChildren()) do
                    if child:IsA("Tool") then
                        local holding = child:FindFirstChild("Holding")
                        if holding and holding:IsA("BoolValue") then
                            holding.Value = false
                        end
                    end
                end
            end
            _fs_resetGlobalState()
            _fs_resetCastGuard()
        end)
    end

    local function _fs_disconnectWatchers()
        for _, conn in ipairs(_fastSkill.watchConnections) do
            pcall(function() conn:Disconnect() end)
        end
        _fastSkill.watchConnections = {}
        _fastSkill.watchedObjects = setmetatable({}, {__mode = "k"})
        _fastSkill.watchedCharacter = nil
    end

    local function _fs_trackConn(conn)
        table.insert(_fastSkill.watchConnections, conn)
        return conn
    end

    local function _fs_watchBusy(busyObj, character)
        if not busyObj or _fastSkill.watchedObjects[busyObj] then return end
        _fastSkill.watchedObjects[busyObj] = true
        if busyObj.Value == true and not _fs_isCharacterLocked(character) then
            busyObj.Value = false
        end
        _fs_trackConn(busyObj.Changed:Connect(function(val)
            if val == true and not _fs_isCharacterLocked(character) then
                busyObj.Value = false
            end
        end))
    end

    local function _fs_watchTool(tool, character)
        if not tool or not tool:IsA("Tool") or _fastSkill.watchedObjects[tool] then return end
        _fastSkill.watchedObjects[tool] = true
        local function bindHolding(holding)
            if not holding or not holding:IsA("BoolValue") or _fastSkill.watchedObjects[holding] then return end
            _fastSkill.watchedObjects[holding] = true
            _fs_trackConn(holding.Changed:Connect(function(val)
                local hk = getgenv()._BF_HunterKiller or Hunter
                if val == true and not (hk and hk._skillHeldKey) and not _fs_isCharacterLocked(character) then
                    holding.Value = false
                end
            end))
        end
        bindHolding(tool:FindFirstChild("Holding"))
        _fs_trackConn(tool.ChildAdded:Connect(function(child)
            if child.Name == "Holding" then bindHolding(child) end
        end))
    end

    local function _fs_attachWatchers(character)
        _fs_disconnectWatchers()
        if not character then return end
        _fastSkill.watchedCharacter = character

        local busy = character:FindFirstChild("Busy")
        if busy then _fs_watchBusy(busy, character) end
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("Tool") then _fs_watchTool(child, character) end
        end

        _fs_trackConn(character.ChildAdded:Connect(function(child)
            if child.Name == "Busy" then
                _fs_watchBusy(child, character)
            elseif child:IsA("Tool") then
                _fs_watchTool(child, character)
                if not _fs_isCharacterLocked(character) then
                    _fs_resetGlobalState()
                end
            end
        end))

        _fs_trackConn(RunService.Heartbeat:Connect(function()
            if character.Parent == nil then return end
            if not _fs_isCharacterLocked(character) then
                local b = character:FindFirstChild("Busy")
                if b and b.Value == true then b.Value = false end
                _fs_resetGlobalState()
            end
        end))

        _fs_bypass()
    end

    local function _fs_startMaintenance(isRunningFn)
        _fastSkill.maintenanceToken = _fastSkill.maintenanceToken + 1
        local token = _fastSkill.maintenanceToken
        _fastSkill.maintenanceActive = true
        task.spawn(function()
            while token == _fastSkill.maintenanceToken do
                if isRunningFn and not isRunningFn() then break end
                local character = LocalPlayer.Character
                if character ~= _fastSkill.watchedCharacter then
                    _fs_attachWatchers(character)
                end
                task.wait(0.25)
            end
            if token == _fastSkill.maintenanceToken then
                _fastSkill.maintenanceActive = false
                _fs_disconnectWatchers()
            end
        end)
    end

    local function _fs_stopMaintenance()
        _fastSkill.maintenanceToken = _fastSkill.maintenanceToken + 1
        _fastSkill.maintenanceActive = false
        _fs_disconnectWatchers()
    end

    getgenv().__FastSkill = {
        Init = _fs_init,
        Bypass = _fs_bypass,
        ResetCastGuard = _fs_resetCastGuard,
        StartMaintenance = _fs_startMaintenance,
        StopMaintenance = _fs_stopMaintenance,
        GetState = function() return _fastSkill end,
    }

    _fs_init()
    _fs_startMaintenance(function() return Hunter._isRunning end)
end

local function setupPlayerDeathListener(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 2.0)
    if not hum then return end
    if getgenv()._TrashHub_DiedConn then
        pcall(function() getgenv()._TrashHub_DiedConn:Disconnect() end)
    end
    getgenv()._TrashHub_DiedConn = hum.Died:Connect(function()
        pcall(function()
            if not Hunter._isRunning then return end
            local inActualCombat = isLocalPlayerInCombat() or (_currentCombatTarget ~= nil and _lastCombatTick ~= nil and (tick() - _lastCombatTick) < 8)
            local enemy = Hunter.TargetPlayer or _currentCombatTarget
            local enemyName = (enemy and enemy.Name) or _lastCombatEnemyName
            if inActualCombat and enemyName and enemyName ~= "" then
                _permanentKilledByBlacklist[enemyName] = true
                _skippedTargets[enemyName] = true
            end
            Hunter.Kinematics:Reset()
            Hunter.TargetPlayer = nil
            Hunter.TargetCharacter = nil
            Hunter.TargetPart = nil
            _currentCombatTarget = nil
            _lastCombatEnemyName = ""
            _hasEngagedInCombat = false
            setHover(false)
            if inActualCombat and not _hasTriggeredDeathHop then
                task.spawn(function()
                    if not Hunter._isRunning then return end
                    task.wait(2)
                    local hasOtherTargets = false
                    pcall(function()
                        for _, p in ipairs(Players:GetPlayers()) do
                            if p ~= LocalPlayer and p.Character and isAlive(p.Character) then
                                local info = inspectPlayer(p, false)
                                if info.CanPvP then
                                    hasOtherTargets = true
                                    break
                                end
                            end
                        end
                    end)
                    if not hasOtherTargets and type(autoHopServer) == "function" then
                        _hasTriggeredDeathHop = true
                        autoHopServer("KilledInServer_NoTargetsLeft")
                    end
                end)
            end
        end)
    end)
end

Hunter.GhostShipRoute = (function()
    local CollectionService = game:GetService("CollectionService")
    local api = {Busy = false, LastReason = "idle", Direction = nil, Area = nil, Phase = "IDLE"}
    local state = {Token = 0, KatakuriFallbackUntil = 0}
    local connections = {}
    local knownSea2 = {[4442272183] = true, [7239319209] = true, [79091703265657] = true}
    local knownSea3 = {[7449423635] = true, [100117331123089] = true, [12398492067] = true, [15206981881] = true}
    local forcedExit, lowHealthAfterExit, hopExit = false, false, false
    local cakeLoafLodPart = nil

    local FLAMINGO_ENTRANCE_POS = Vector3.new(-286.986, 306.137, 592.882)
    local FLAMINGO_EXIT_POS = Vector3.new(2284.909, 15.538, 910.481)
    local FLAMINGO_ENTER_SPAWN_POS = Vector3.new(2284.909, 15.538, 905.481)
    local FLAMINGO_EXIT_SPAWN_POS = Vector3.new(-286.986, 306.137, 597.882)
    local FLAMINGO_ENTER_SETTLE_POS = Vector3.new(2284.909, 15.538, 890.0)
    local FLAMINGO_EXIT_SETTLE_POS = Vector3.new(-286.986, 306.137, 606.0)
    local GHOST_SHIP_ENTRANCE_POS = Vector3.new(923.12, 125.09, 32885.81)
    local GHOST_SHIP_EXIT_POS = Vector3.new(-6518.59, 83.24, -123.51)
    local KATAKURI_MIRROR_POS = Vector3.new(-2151.822, 149.316, -12404.905)
    local KATAKURI_MIRROR_STAGE_POS = Vector3.new(-2149.643, 155.0, -12380.0)
    local KATAKURI_ROOM_SPAWN_POS = Vector3.new(-2089.866, 4536.924, -14800.007)
    local CAKE_LOAF_LOD_POS = Vector3.new(-1993, 400, -12416)

    local function finiteVector(value)
        return typeof(value) == "Vector3" and value.X == value.X and value.Y == value.Y and value.Z == value.Z
            and math.abs(value.X) < math.huge and math.abs(value.Y) < math.huge and math.abs(value.Z) < math.huge
    end

    local function ensureCakeLoafLod(active)
        if not active then
            if cakeLoafLodPart then
                pcall(function()
                    CollectionService:RemoveTag(cakeLoafLodPart, "LoDPosition")
                    cakeLoafLodPart:Destroy()
                end)
                cakeLoafLodPart = nil
            end
            return
        end
        local cam = Workspace.CurrentCamera
        if not cam then return end
        if not cakeLoafLodPart or not cakeLoafLodPart.Parent then
            pcall(function()
                local p = Instance.new("Part")
                p.Name = "CakeLoafLoDAnchor"
                p.Anchored = true
                p.CanCollide = false
                p.CanTouch = false
                p.CanQuery = false
                p.Transparency = 1
                p.Size = Vector3.new(1, 1, 1)
                p.Position = CAKE_LOAF_LOD_POS
                p.Parent = cam
                CollectionService:AddTag(p, "LoDPosition")
                cakeLoafLodPart = p
            end)
        else
            pcall(function()
                cakeLoafLodPart.Position = CAKE_LOAF_LOD_POS
                if cakeLoafLodPart.Parent ~= cam then
                    cakeLoafLodPart.Parent = cam
                end
                if not CollectionService:HasTag(cakeLoafLodPart, "LoDPosition") then
                    CollectionService:AddTag(cakeLoafLodPart, "LoDPosition")
                end
            end)
        end
    end

    local function findBigMirrorParts()
        local map = Workspace:FindFirstChild("Map")
        local cakeLoaf = map and map:FindFirstChild("CakeLoaf")
        local bigMirror = cakeLoaf and cakeLoaf:FindFirstChild("BigMirror")
        if not bigMirror then return nil, nil end
        local main = bigMirror:FindFirstChild("Main")
        local other = bigMirror:FindFirstChild("Other")
        if main and not main:IsA("BasePart") then main = nil end
        if other and not other:IsA("BasePart") then other = nil end
        return main, other
    end

    local _cachedKatakuriGate = nil
    local function findKatakuriExitGate()
        if _cachedKatakuriGate and _cachedKatakuriGate.Parent and api:IsInsideKatakuriRoom(_cachedKatakuriGate.Position) then
            return _cachedKatakuriGate
        end
        local map = Workspace:FindFirstChild("Map")
        if map then
            local cakeLoaf = map:FindFirstChild("CakeLoaf")
            if cakeLoaf then
                for _, inst in ipairs(cakeLoaf:GetDescendants()) do
                    if inst:IsA("TouchTransmitter") then
                        local parent = inst.Parent
                        if parent and parent:IsA("BasePart") and api:IsInsideKatakuriRoom(parent.Position) then
                            _cachedKatakuriGate = parent
                            return parent
                        end
                    end
                end
            end
            for _, inst in ipairs(map:GetDescendants()) do
                if inst:IsA("TouchTransmitter") then
                    local parent = inst.Parent
                    if parent and parent:IsA("BasePart") and api:IsInsideKatakuriRoom(parent.Position) then
                        _cachedKatakuriGate = parent
                        return parent
                    end
                end
            end
        end
        local wo = Workspace:FindFirstChild("_WorldOrigin")
        if wo then
            for _, inst in ipairs(wo:GetDescendants()) do
                if inst:IsA("TouchTransmitter") then
                    local parent = inst.Parent
                    if parent and parent:IsA("BasePart") and api:IsInsideKatakuriRoom(parent.Position) then
                        _cachedKatakuriGate = parent
                        return parent
                    end
                end
            end
        end
        for _, inst in ipairs(Workspace:GetChildren()) do
            if inst:IsA("BasePart") and api:IsInsideKatakuriRoom(inst.Position) and inst:FindFirstChildOfClass("TouchTransmitter") then
                _cachedKatakuriGate = inst
                return inst
            end
        end
        return nil
    end

    local function triggerKatakuriMirrorTouch(root, gate, now)
        if not root or not root.Parent then return end
        pcall(function() root.Anchored = false end)
        local main, other = findBigMirrorParts()
        local primary = gate or main or other
        if primary and primary.Parent then
            pcall(function()
                primary.CanTouch = true
                primary.CanCollide = false
            end)
            if typeof(firetouchinterest) == "function" then
                pcall(firetouchinterest, root, primary, 0)
                pcall(firetouchinterest, root, primary, 1)
            end
        end
        if other and other ~= primary and other.Parent then
            pcall(function()
                other.CanTouch = true
                other.CanCollide = false
            end)
            if typeof(firetouchinterest) == "function" then
                pcall(firetouchinterest, root, other, 0)
                pcall(firetouchinterest, root, other, 1)
            end
        end
    end

    local function syncDoorTouch(activeGate)
        local map = Workspace:FindFirstChild("Map")
        local dress = map and map:FindFirstChild("Dressrosa")
        local restoreAll = api.Destroyed or not Hunter._isRunning
        if dress then
            local fe = dress:FindFirstChild("FlamingoEntrance")
            local fx = dress:FindFirstChild("FlamingoExit")
            if fe and fe:IsA("BasePart") then
                local allow = restoreAll or (activeGate == fe)
                if fe.CanTouch ~= allow then pcall(function() fe.CanTouch = allow end) end
            end
            if fx and fx:IsA("BasePart") then
                local allow = restoreAll or (activeGate == fx)
                if fx.CanTouch ~= allow then pcall(function() fx.CanTouch = allow end) end
            end
        end
        local main, other = findBigMirrorParts()
        if main then
            pcall(function()
                main.CanTouch = true
                if activeGate ~= main then
                    main.CanCollide = true
                end
            end)
        end
        if other then
            pcall(function() other.CanTouch = true end)
        end
    end

    function api:IsInsideGhostShip(position)
        local map = Workspace:FindFirstChild("Map")
        local isSea2 = knownSea2[game.PlaceId] or (map and
            (map:FindFirstChild("GhostShip") or map:FindFirstChild("GhostShipInterior") or map:FindFirstChild("Dressrosa")))
        return isSea2 and finiteVector(position) and position.Z > 30000 or false
    end

    function api:IsInsideFlamingoRoom(position)
        local map = Workspace:FindFirstChild("Map")
        local isSea2 = knownSea2[game.PlaceId] or (map and
            (map:FindFirstChild("Dressrosa") or map:FindFirstChild("GhostShip") or map:FindFirstChild("GhostShipInterior")))
        if not (isSea2 and finiteVector(position)) then return false end
        return position.X >= 2035 and position.X <= 2545
            and position.Y >= -15 and position.Y <= 285
            and position.Z >= 412 and position.Z <= 920
    end

    function api:IsInsideKatakuriRoom(position)
        local map = Workspace:FindFirstChild("Map")
        local isSea3 = knownSea3[game.PlaceId] or (map and
            (map:FindFirstChild("CakeLoaf") or map:FindFirstChild("Turtle") or map:FindFirstChild("Waterfall")))
        if not (isSea3 and finiteVector(position)) then return false end
        return position.X >= -2650 and position.X <= -1500
            and position.Y >= 4250 and position.Y <= 5100
            and position.Z >= -15550 and position.Z <= -14250
    end

    function api:GetArea(position)
        if self:IsInsideGhostShip(position) then return "GHOST_SHIP" end
        if self:IsInsideFlamingoRoom(position) then return "FLAMINGO_ROOM" end
        if self:IsInsideKatakuriRoom(position) then
            if os.clock() < (state.KatakuriFallbackUntil or 0) then
                return nil
            end
            return "KATAKURI_ROOM"
        end
        return nil
    end

    function api:IsInside(position)
        return self:GetArea(position) ~= nil
    end

    function api:GetEntrancePosition(targetPosition)
        local targetArea = targetPosition and self:GetArea(targetPosition) or nil
        if targetArea == "FLAMINGO_ROOM" then
            local map = Workspace:FindFirstChild("Map")
            local dress = map and map:FindFirstChild("Dressrosa")
            local fe = dress and dress:FindFirstChild("FlamingoEntrance")
            return (fe and fe:IsA("BasePart") and fe.Position) or FLAMINGO_ENTRANCE_POS
        elseif targetArea == "GHOST_SHIP" then
            local map = Workspace:FindFirstChild("Map")
            local gs = map and map:FindFirstChild("GhostShip")
            local tp = gs and gs:FindFirstChild("Teleport")
            return (tp and tp:IsA("BasePart") and tp.Position) or GHOST_SHIP_ENTRANCE_POS
        elseif targetArea == "KATAKURI_ROOM" then
            local main = findBigMirrorParts()
            return (main and main.Position) or KATAKURI_MIRROR_POS
        end
        return nil
    end

    function api:ClampInteriorCFrame(root, desiredCFrame)
        if not root or not desiredCFrame then return desiredCFrame end
        syncDoorTouch(self.Busy and self.Phase == "WAIT" and state.AllowTouchFallback and state.Gate or nil)
        if self.Busy or self.Direction == "EXIT" then return desiredCFrame end
        if not self:IsInsideFlamingoRoom(root.Position) then return desiredCFrame end
        local pos = desiredCFrame.Position
        local rot = desiredCFrame - pos
        local x = math.clamp(pos.X, 2048, 2530)
        local y = math.clamp(pos.Y, 13.5, 245)
        local z = math.clamp(pos.Z, 425, 898)
        if math.abs(x - 2284.909) <= 20 and y <= 32 and z > 890 then
            z = 890
        end
        if x == pos.X and y == pos.Y and z == pos.Z then
            return desiredCFrame
        end
        return CFrame.new(x, y, z) * rot
    end

    function api:GetDirection(root, targetPosition)
        if not root then return nil, nil end
        local myArea = self:GetArea(root.Position)
        if forcedExit and myArea then
            if myArea == "KATAKURI_ROOM" and not findKatakuriExitGate() then
                return nil, nil
            end
            return "EXIT", myArea
        end
        local targetArea = targetPosition and self:GetArea(targetPosition) or nil
        if myArea and myArea ~= targetArea then
            if myArea == "KATAKURI_ROOM" and not findKatakuriExitGate() then
                return nil, nil
            end
            return "EXIT", myArea
        end
        if not myArea and targetArea then return "ENTER", targetArea end
        return nil, nil
    end

    function api:Reset(reason)
        state.Token += 1
        state.Root, state.Character, state.Gate, state.SpawnPos, state.GatePos, state.SettlePos = nil, nil, nil, nil, nil, nil
        state.Target, state.RequestPending, state.RequestIssued, state.Hold, state.ArrivedAt = nil, false, false, nil, nil
        state.RetryAt, state.WaitStarted, state.TriggerAt, state.AllowTouchFallback = nil, nil, nil, false
        state.Waypoints, state.WaypointIndex = nil, nil
        self.Busy, self.Direction, self.Area, self.Phase = false, nil, nil, "IDLE"
        self.LastReason = reason or "reset"
        Hunter._isGhostShipRouting = false
        ensureCakeLoafLod(false)
        syncDoorTouch(nil)
    end

    function api:RequestExit(reason)
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not root or not self:IsInside(root.Position) then return false end
        if self:GetArea(root.Position) == "KATAKURI_ROOM" and not findKatakuriExitGate() then
            return false
        end
        if reason == "LOW_HEALTH" then lowHealthAfterExit = true end
        if not forcedExit then
            if self.Phase ~= "WAIT" and self.Phase ~= "SETTLE" then self:Reset("forced-exit") end
            forcedExit = true
        end
        if reason == "SERVER_HOP" then hopExit = true end
        self.Busy, Hunter._isGhostShipRouting = true, true
        return true
    end

    function api:HasForcedExit() return forcedExit end

    function api:DeferLowHealth()
        if self.Phase == "WAIT" or self.Phase == "SETTLE" then
            lowHealthAfterExit = true
            return true
        end
        return false
    end

    function api:ConsumeLowHealthExit(root)
        if lowHealthAfterExit and root and not self:IsInside(root.Position) and not self.Busy then
            lowHealthAfterExit = false
            return true
        end
        return false
    end

    local function endpoints(direction, area, root)
        local map = Workspace:FindFirstChild("Map")
        if area == "KATAKURI_ROOM" then
            ensureCakeLoafLod(true)
            local main, other = findBigMirrorParts()
            if direction == "ENTER" then
                local gate = main or other
                local gatePos = (gate and gate.Position) or KATAKURI_MIRROR_POS
                return gate, KATAKURI_ROOM_SPAWN_POS, gatePos, nil
            else
                local exitGate = findKatakuriExitGate()
                local gatePos = (exitGate and exitGate.Position) or KATAKURI_ROOM_SPAWN_POS
                return exitGate, KATAKURI_MIRROR_STAGE_POS, gatePos, nil
            end
        end
        if area == "FLAMINGO_ROOM" then
            local dress = map and map:FindFirstChild("Dressrosa")
            local entrance = dress and dress:FindFirstChild("FlamingoEntrance")
            local exit = dress and dress:FindFirstChild("FlamingoExit")
            local gate = direction == "EXIT" and exit or entrance
            local destGate = direction == "EXIT" and entrance or exit
            local gatePos = (gate and gate:IsA("BasePart") and gate.Position)
                or (direction == "EXIT" and FLAMINGO_EXIT_POS or FLAMINGO_ENTRANCE_POS)
            local rootSizeZ = (root and root.Size and root.Size.Z) or 1
            local spawnPos
            if destGate and destGate:IsA("BasePart") then
                spawnPos = destGate.CFrame * Vector3.new(0, 0, -rootSizeZ - 4)
            else
                spawnPos = direction == "EXIT" and FLAMINGO_EXIT_SPAWN_POS or FLAMINGO_ENTER_SPAWN_POS
            end
            local settlePos = direction == "EXIT" and FLAMINGO_EXIT_SETTLE_POS or FLAMINGO_ENTER_SETTLE_POS
            return (gate and gate:IsA("BasePart") and gate or nil), spawnPos, gatePos, settlePos
        end
        local outside = map and map:FindFirstChild("GhostShip")
        local inside = map and map:FindFirstChild("GhostShipInterior")
        local source = direction == "EXIT" and inside or outside
        local destination = direction == "EXIT" and outside or inside
        local gate = source and source:FindFirstChild("Teleport")
        local spawn = destination and destination:FindFirstChild("TeleportSpawn")
        local gatePos = (gate and gate:IsA("BasePart") and gate.Position)
            or (direction == "EXIT" and GHOST_SHIP_EXIT_POS or GHOST_SHIP_ENTRANCE_POS)
        local spawnPos = spawn and spawn:IsA("BasePart") and spawn.Position or nil
        if gate and gate:IsA("BasePart") and spawnPos then
            return gate, spawnPos, gatePos, nil
        end
        return nil, spawnPos, gatePos, nil
    end

    local function freeze(root, cframe)
        if cframe then root.CFrame = cframe end
        root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
    end

    local function approachWaypoints(root, gate, gatePos, direction, area)
        local points = {}
        if area == "KATAKURI_ROOM" then
            if direction == "ENTER" then
                local stagePos = KATAKURI_MIRROR_STAGE_POS
                if gate and gate:IsA("BasePart") then
                    stagePos = gate.Position + (gate.CFrame.RightVector * 25) + Vector3.new(0, 5, 0)
                end
                local distToGate = (root.Position - gatePos).Magnitude
                if distToGate > 260 or root.Position.Z < gatePos.Z - 15 then
                    table.insert(points, Vector3.new(stagePos.X, math.max(root.Position.Y, 265), stagePos.Z))
                end
                if distToGate > 22 then
                    table.insert(points, stagePos)
                end
            end
            table.insert(points, gatePos)
            return points
        end
        if area == "FLAMINGO_ROOM" then
            if direction == "ENTER" then
                local stagePos = Vector3.new(gatePos.X, gatePos.Y, gatePos.Z + 6)
                if (root.Position - gatePos).Magnitude > 10 then
                    table.insert(points, stagePos)
                end
            else
                local stagePos = Vector3.new(gatePos.X, gatePos.Y, gatePos.Z - 6)
                if (root.Position - gatePos).Magnitude > 10 then
                    table.insert(points, stagePos)
                end
            end
            table.insert(points, gatePos)
            return points
        end
        if gate and direction == "EXIT" and root.Position.Y > gatePos.Y + 8 then
            local lava = gate.Parent and gate.Parent:FindFirstChild("LavaParts")
            local clearance, stagingZ = 10, gatePos.Z
            local crossesUpperFloor = false
            for _, part in ipairs(lava and lava:GetDescendants() or {}) do
                if part:IsA("BasePart") then
                    local half, frame = part.Size * 0.5, part.CFrame
                    local right, up, look = frame.RightVector, frame.UpVector, frame.LookVector
                    local extents = Vector3.new(
                        math.abs(right.X) * half.X + math.abs(up.X) * half.Y + math.abs(look.X) * half.Z,
                        math.abs(right.Y) * half.X + math.abs(up.Y) * half.Y + math.abs(look.Y) * half.Z,
                        math.abs(right.Z) * half.X + math.abs(up.Z) * half.Y + math.abs(look.Z) * half.Z)
                    local lower, upper = part.Position - extents, part.Position + extents
                    if upper.Y > gatePos.Y + clearance and lower.Y < root.Position.Y + clearance
                        and gatePos.X >= lower.X - clearance and gatePos.X <= upper.X + clearance then
                        crossesUpperFloor = true
                        stagingZ = math.min(stagingZ, lower.Z - clearance)
                    end
                end
            end
            if crossesUpperFloor then
                table.insert(points, Vector3.new(gatePos.X, root.Position.Y, stagingZ))
                table.insert(points, Vector3.new(gatePos.X, gatePos.Y, stagingZ))
            end
        end
        table.insert(points, gatePos)
        return points
    end

    local function arrived(root, direction, spawnPos, area)
        if area == "KATAKURI_ROOM" then
            local insideNow = api:IsInsideKatakuriRoom(root.Position)
            return (direction == "ENTER") and insideNow or (not insideNow)
        end
        if not finiteVector(spawnPos) then return false end
        local currentArea = api:GetArea(root.Position)
        local expectedArea = direction == "ENTER" and area or nil
        return currentArea == expectedArea
            and (root.Position - spawnPos).Magnitude <= 400
    end

    local function requestDoor(root, humanoid)
        if api.Area == "KATAKURI_ROOM" then
            triggerKatakuriMirrorTouch(root, state.Gate, os.clock())
            return
        end
        if state.RequestPending or CollectionService:HasTag(LocalPlayer, "Teleporting") then return end
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local remote = remotes and remotes:FindFirstChild("CommF_")
        if not remote then api.LastReason = "waiting-door-remote"; return end
        local token, character, gate, gatePos, spawnPos = state.Token, state.Character, state.Gate, state.GatePos, state.SpawnPos
        local direction, area = api.Direction, api.Area
        if not finiteVector(gatePos) or not finiteVector(spawnPos) then return end
        state.RequestPending, state.RequestIssued = true, true
        task.spawn(function()
            if token ~= state.Token or not Hunter._isRunning or (isHopping and not hopExit) or _isPortalWarping
                or LocalPlayer.Character ~= character or root.Parent ~= character or humanoid.Health <= 0
                or (gate and not gate.Parent) or (root.Position - gatePos).Magnitude > 8 then
                if token == state.Token then state.RequestPending = false end
                return
            end
            if unlockSkillState then unlockSkillState() end
            local ok, response = pcall(function() return remote:InvokeServer("requestEntrance", spawnPos) end)
            if token ~= state.Token or LocalPlayer.Character ~= character or not Hunter._isRunning
                or root.Parent ~= character or humanoid.Health <= 0 then return end
            state.RequestPending = false
            local expectedArea = direction == "ENTER" and area or nil
            if ok and finiteVector(response) and api:GetArea(response) == expectedArea
                and (response - spawnPos).Magnitude <= 400 then
                syncDoorTouch(nil)
                local targetHoldPos = state.SettlePos or response
                freeze(root, CFrame.new(targetHoldPos) * (root.CFrame - root.Position))
                api.LastReason = "door-response-received"
            elseif not ok then
                api.LastError = tostring(response)
                api.LastReason = "door-request-error"
            else
                api.LastReason = "waiting-door-arrival"
            end
        end)
    end

    function api:Step(dt, root, humanoid, targetPosition, targetPlayer)
        if self.Destroyed then return false end
        if not Hunter._isRunning or (isHopping and not hopExit) or not root or not root.Parent or not humanoid or humanoid.Health <= 0 then
            forcedExit, lowHealthAfterExit, hopExit = false, false, false
            self:Reset("character-unavailable")
            return false
        end
        if _isPortalWarping then
            syncDoorTouch(nil)
            return false
        end
        if state.Root and (state.Root ~= root or state.Character ~= LocalPlayer.Character) then self:Reset("character-changed") end
        local now = os.clock()

        if self.Phase == "APPROACH" and arrived(root, self.Direction, state.SpawnPos, self.Area) then
            syncDoorTouch(nil)
            local holdCF = state.SettlePos and (CFrame.new(state.SettlePos) * (root.CFrame - root.Position)) or root.CFrame
            self.Phase, state.ArrivedAt, state.Hold = "SETTLE", now, holdCF
        end

        if self.Phase == "WAIT" or self.Phase == "SETTLE" then
            if arrived(root, self.Direction, state.SpawnPos, self.Area) then
                syncDoorTouch(nil)
                if self.Phase ~= "SETTLE" then
                    local holdCF = state.SettlePos and (CFrame.new(state.SettlePos) * (root.CFrame - root.Position)) or root.CFrame
                    self.Phase, state.ArrivedAt, state.Hold = "SETTLE", now, holdCF
                end
                freeze(root, state.Hold)
                local settleTime = (self.Area == "KATAKURI_ROOM") and 0.08 or 0.2
                if now - state.ArrivedAt >= settleTime then
                    if CollectionService:HasTag(LocalPlayer, "Teleporting") then
                        pcall(function() CollectionService:RemoveTag(LocalPlayer, "Teleporting") end)
                    end
                    local completedDirection = self.Direction
                    if completedDirection == "EXIT" then forcedExit, hopExit = false, false end
                    self:Reset("door-crossed")
                    return true
                end
                self.LastReason = "settling-door-arrival"
                return true
            end
            if self.Phase == "SETTLE" then
                self:Reset("arrival-position-changed")
            elseif self.Area == "KATAKURI_ROOM" then
                local waitElapsed = now - (state.WaitStarted or now)
                if waitElapsed >= 2.8 then
                    state.KatakuriFallbackUntil = now + 15
                    self:Reset("katakuri-mirror-closed-fallback")
                    return false
                end
                local basePos = (state.Gate and state.Gate.Parent and state.Gate.Position) or state.GatePos or KATAKURI_MIRROR_POS
                local osc = Vector3.new(math.sin(now * 20) * 1.5, math.cos(now * 16) * 2.5, math.cos(now * 22) * 2.5)
                root.CFrame = CFrame.new(basePos + osc) * (root.CFrame - root.Position)
                root.AssemblyLinearVelocity = Vector3.new(0, 0, -15)
                root.AssemblyAngularVelocity = Vector3.zero
                triggerKatakuriMirrorTouch(root, state.Gate, now)
                self.LastReason = "touching-katakuri-mirror"
                return true
            else
                if state.Hold and (root.Position - state.Hold.Position).Magnitude > 80 then
                    self:Reset("door-position-changed")
                    return true
                end
                freeze(root, state.Hold)
                local waitElapsed = now - (state.WaitStarted or now)
                if waitElapsed >= 0.8 and state.Gate then
                    state.AllowTouchFallback = true
                    syncDoorTouch(state.Gate)
                else
                    syncDoorTouch(nil)
                end
                if waitElapsed >= 4 and not state.RequestPending
                    and not CollectionService:HasTag(LocalPlayer, "Teleporting") then
                    self.Phase, state.RetryAt = "APPROACH", now + 1.0
                    state.AllowTouchFallback = false
                    syncDoorTouch(nil)
                    self.LastReason = "retrying-door"
                else
                    if now >= (state.TriggerAt or now) and not state.RequestPending then
                        state.TriggerAt = now + 0.6
                        requestDoor(root, humanoid)
                    end
                    self.LastReason = "waiting-door-arrival"
                    return true
                end
            end
        end

        local direction, area = self:GetDirection(root, targetPosition)
        if not direction or not area then
            forcedExit, hopExit = false, false
            self:Reset("same-area")
            return false
        end
        if self.Direction ~= direction or self.Area ~= area or (state.Target ~= targetPlayer and self.Phase == "APPROACH") then
            self:Reset("route-changed")
        end
        self.Busy, Hunter._isGhostShipRouting = true, true
        self.Direction, self.Area, self.Phase = direction, area, "APPROACH"
        state.Root, state.Character, state.Target = root, LocalPlayer.Character, targetPlayer
        if area ~= "KATAKURI_ROOM" then
            syncDoorTouch(nil)
        end

        local gate, spawnPos, gatePos, settlePos = endpoints(direction, area, root)
        state.Gate, state.SpawnPos, state.GatePos, state.SettlePos = gate, spawnPos, gatePos, settlePos

        if not gate and area ~= "KATAKURI_ROOM" and (not finiteVector(gatePos) or (root.Position - gatePos).Magnitude <= 25) then
            freeze(root)
            self.LastReason = "waiting-streamed-door"
            return true
        end
        if not state.Waypoints or (gate and state.LastWaypointGate ~= gate) then
            state.Waypoints, state.WaypointIndex = approachWaypoints(root, gate, gatePos, direction, area), 1
            state.LastWaypointGate = gate
        end
        if now < (state.RetryAt or -math.huge) then freeze(root); return true end
        local point = state.Waypoints[state.WaypointIndex]
        local offset = point - root.Position
        local reachRadius = (area == "KATAKURI_ROOM") and 4.5 or 1.8
        if area == "KATAKURI_ROOM" and (root.Position - gatePos).Magnitude <= 28 then
            triggerKatakuriMirrorTouch(root, gate, now)
        end
        if offset.Magnitude <= reachRadius then
            if state.WaypointIndex < #state.Waypoints then
                freeze(root, CFrame.new(point) * (root.CFrame - root.Position))
                state.WaypointIndex += 1
                self.LastReason = "following-door-waypoints"
                return true
            end
            if not gate and area ~= "KATAKURI_ROOM" then
                freeze(root, CFrame.new(gatePos) * (root.CFrame - root.Position))
                self.LastReason = "waiting-streamed-door"
                return true
            end
            if unlockSkillState then unlockSkillState() end
            local touchOrigin = (gate and gate.Parent and gate.Position) or gatePos
            freeze(root, CFrame.new(touchOrigin) * (root.CFrame - root.Position))
            self.Phase, state.Hold = "WAIT", root.CFrame
            state.RequestIssued = false
            state.AllowTouchFallback = (area == "KATAKURI_ROOM")
            state.WaitStarted, state.TriggerAt = now, now
            if area == "KATAKURI_ROOM" then
                triggerKatakuriMirrorTouch(root, gate, now)
                self.LastReason = "touching-katakuri-mirror"
            else
                requestDoor(root, humanoid)
                self.LastReason = "requesting-door-entrance"
            end
            return true
        end
        local flySpeed = (area == "KATAKURI_ROOM")
            and math.clamp(tonumber(Hunter.Config and Hunter.Config.TweenSpeed) or tonumber(CONFIG and CONFIG.TweenSpeed) or 325, 220, 360)
            or 220
        local travel = math.min(offset.Magnitude, flySpeed * math.clamp(tonumber(dt) or 0, 0, 0.033))
        local position = root.Position + offset.Unit * travel
        local nextCFrame = Hunter.Kinematics:LookAt(position, point, root.CFrame)
        if not self:IsInside(root.Position) and Hunter.AntiLava then
            nextCFrame = Hunter.AntiLava:FilterMove(root, humanoid, nextCFrame)
        end
        freeze(root, nextCFrame)
        self.LastReason = direction == "EXIT" and "flying-to-exit-door"
            or ((area == "KATAKURI_ROOM") and "flying-to-katakuri-mirror" or "flying-to-entrance-door")
        return true
    end

    function api:GetStatus()
        return {Busy = self.Busy, Phase = self.Phase, Direction = self.Direction, Area = self.Area,
            LastReason = self.LastReason, LastError = self.LastError, ForcedExit = forcedExit,
            Waypoint = state.WaypointIndex, WaypointCount = state.Waypoints and #state.Waypoints,
            Gate = state.Gate and state.Gate:GetFullName(), SpawnPos = state.SpawnPos and tostring(state.SpawnPos)}
    end

    function api:Destroy()
        self.Destroyed = true
        forcedExit, lowHealthAfterExit, hopExit = false, false, false
        self:Reset("destroyed")
        ensureCakeLoafLod(false)
        syncDoorTouch(nil)
        for _, connection in ipairs(connections) do pcall(function() connection:Disconnect() end) end
        table.clear(connections)
    end
    table.insert(connections, LocalPlayer.CharacterRemoving:Connect(function()
        forcedExit, lowHealthAfterExit, hopExit = false, false, false
        api:Reset("character-removing")
    end))
    syncDoorTouch(nil)
    return api
end)()

