local function normalizeHopRecord(jobId, record, now)
    if not validHopJobId(jobId) or type(record) ~= "table" then return nil end
    local at, expires = record.At, record.ExpiresAt
    local kind = record.Kind
    if kind ~= "visit" and kind ~= "attempt" and kind ~= "failed" then return nil end
    if type(at) ~= "number" or type(expires) ~= "number" or at ~= at or expires ~= expires
        or at < 0 or at > now + 300 or expires <= at or expires == math.huge then return nil end
    expires = math.min(expires, at + (kind == "visit" and visitTTL or failureTTL))
    if expires <= now then return nil end
    return {At = at, ExpiresAt = expires, Kind = kind}
end
local function pruneHopBlacklist()
    local now, ordered = os.time(), {}
    for jobId, record in pairs(hopBlacklist) do
        local normalized = normalizeHopRecord(jobId, record, now)
        hopBlacklist[jobId] = normalized
        if normalized then ordered[#ordered + 1] = {JobId = jobId, At = normalized.At} end
    end
    if #ordered > maxHistory then
        table.sort(ordered, function(a, b)
            if a.At == b.At then return a.JobId < b.JobId end
            return a.At < b.At
        end)
        for index = 1, #ordered - maxHistory do hopBlacklist[ordered[index].JobId] = nil end
    end
    Hunter.HopHistoryStatus.Entries = math.min(#ordered, maxHistory)
end
