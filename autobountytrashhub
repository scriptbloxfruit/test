local function isTargetTooFarFromIsland(player)
    if not player then return false, 0, nil end
    if isLocalPlayerInPortalDimension() then return false, 0, nil end
    local now = tick()
    local cached = _offshoreCache[player]
    if cached and (now - cached.time < 0.3) then
        return cached.tooFar, cached.bestDist, cached.bestIsland
    end
    local tooFar, bestDist, bestIsland = false, 0, nil
    pcall(function()
        local char = player.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
        if not root then return end
        local realPos = (Hunter.PortalXTracker and Hunter.PortalXTracker.GetRealPosition(player)) or root.Position
        local islName, _, effectiveDist = _portalGetNearestIslandToPosition(realPos)
        local maxOffshore = _portalGetMaxOffshoreDistance()
        bestDist = effectiveDist or 0
        bestIsland = islName
        if effectiveDist and effectiveDist > maxOffshore then
            tooFar = true
        end
    end)
    if not cached then
        cached = {}
        _offshoreCache[player] = cached
    end
    cached.time = now
    cached.tooFar = tooFar
    cached.bestDist = bestDist
    cached.bestIsland = bestIsland
    return tooFar, bestDist, bestIsland
end

local function isInsideGameSafeZone(pos, player)
    if not pos then return false, "NoPos" end
    if player == LocalPlayer then
        local pgui = LocalPlayer:FindFirstChild("PlayerGui")
        local szUI = pgui and pgui:FindFirstChild("Main") and pgui.Main:FindFirstChild("BottomHUDList") and pgui.Main.BottomHUDList:FindFirstChild("SafeZone")
        if szUI and szUI.Visible == true then
            return true, "OfficialSafeZone"
        end
    end
    if player then
        local pChar = player.Character
        if pChar then
            if pChar:FindFirstChildOfClass("ForceField") then return true, "ForceField" end
            for _, tag in ipairs({"SafeZone", "TempSafeZone", "SafeZoneShield", "PvpDisabled", "PvPDisabled"}) do
                if pChar:FindFirstChild(tag) or pChar:GetAttribute(tag) == true or player:GetAttribute(tag) == true then
                    return true, tag
                end
            end
        end
    end
    local safeZonesFolder = Workspace:FindFirstChild("_WorldOrigin") and Workspace._WorldOrigin:FindFirstChild("SafeZones")
    if safeZonesFolder and #safeZonesFolder:GetChildren() > 0 then
        for _, szPart in ipairs(safeZonesFolder:GetChildren()) do
            if szPart:IsA("BasePart") then
                local mesh = szPart:FindFirstChildOfClass("SpecialMesh")
                local radius = mesh and (mesh.Scale.X / 2) or math.max(szPart.Size.X, szPart.Size.Z) / 2
                if radius < 50 then radius = 250 end
                local horizDist = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(szPart.Position.X, 0, szPart.Position.Z)).Magnitude
                if horizDist <= radius and math.abs(pos.Y - szPart.Position.Y) <= 350 then
                    return true, szPart.Name
                end
            end
        end
    end
    return isPositionInAnySafeZone(pos)
end

local function getOtherPlayerZone(player)
    if not player then return 0, 0 end
    local target = (typeof(player) == "Instance" and player:IsA("Player")) and player or Players:FindFirstChild(tostring(player))
    if not target then return 0, 0 end
    local danger = 0
    pcall(function()
        danger = target:GetAttribute("DangerLevel") or 0
        if danger == 0 and target.Character then
            danger = target.Character:GetAttribute("DangerLevel") or 0
        end
    end)
    local zone = 0
    if danger >= 510 then zone = 6
    elseif danger >= 425 then zone = 5
    elseif danger >= 340 then zone = 4
    elseif danger >= 270 then zone = 3
    elseif danger >= 185 then zone = 2
    elseif danger >= 100 then zone = 1
    end
    return zone, danger
end

Hunter.ArenaCheck = (function()
    local api = {Destroyed = false, NextRefresh = 0, Members = {}, DecodeCache = {}}
    local HttpService = game:GetService("HttpService")

    function api.Refresh()
        if api.Destroyed or os.clock() < api.NextRefresh then return end
        api.NextRefresh = os.clock() + 0.15
        local members, seen, nextCache = {}, {}, {}
        local function add(playerName, source, mode)
            if type(playerName) == "string" and playerName ~= "" then
                members[playerName] = {InArena = true, Mode = mode, Source = source}
            end
        end
        local function readArena(arena, mode)
            if not arena or not arena.Parent or seen[arena] then return end
            seen[arena] = true
            local raw = arena:GetAttribute("EncodedPlayerData")
            if type(raw) == "string" and #raw <= 65536 then
                local cached = api.DecodeCache[arena]
                if not cached or cached.Raw ~= raw then
                    local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
                    cached = {Raw = raw, Data = ok and type(decoded) == "table" and decoded or nil}
                end
                nextCache[arena] = cached
                if cached.Data then
                    for _, row in pairs(cached.Data) do
                        if type(row) == "table" then add(row.Name, "EncodedPlayerData", mode) end
                    end
                end
            end
            local teams = arena:FindFirstChild("pvpTeamsInfo")
            if teams then
                for _, team in ipairs(teams:GetChildren()) do
                    for _, entry in ipairs(team:GetChildren()) do
                        if entry:IsA("ObjectValue") then
                            local player = entry.Value
                            if typeof(player) == "Instance" and player:IsA("Player") and player.Parent == Players then
                                add(player.Name, "pvpTeamsInfo", mode)
                            end
                        end
                    end
                end
            end
        end
        local ok, err = pcall(function()
            for _, arena in ipairs(CollectionService:GetTagged("PvpArena2v2")) do readArena(arena, "2v2") end
            local folder = Workspace:FindFirstChild("PVPArenas")
            if folder then
                for _, arena in ipairs(folder:GetChildren()) do
                    if arena:GetAttribute("EncodedPlayerData") ~= nil or arena:FindFirstChild("pvpTeamsInfo") then
                        readArena(arena)
                    end
                end
            end
        end)
        api.Members, api.DecodeCache = members, nextCache
        api.LastError = not ok and tostring(err) or nil
    end

    function api.GetStatus(player)
        api.Refresh()
        local found = not api.Destroyed and player and api.Members[player.Name]
        if found then return {InArena = true, Mode = found.Mode, Source = found.Source} end
        return {InArena = nil, Mode = nil, Source = api.Destroyed and "destroyed" or "no-roster-evidence"}
    end

    function api.ShouldSkip(player)
        if not player or (Hunter.Config or CONFIG).SkipArenaPlayers == false then return false end
        return api.GetStatus(player).InArena == true
    end

    function api.Destroy()
        api.Destroyed = true
        table.clear(api.Members)
        table.clear(api.DecodeCache)
    end
    return api
end)()


inspectPlayer = function(player, isCurrentTarget)
    local result = {
        Player = player,
        Name = player and player.Name or "",
        DisplayName = player and player.DisplayName or "",
        Character = nil,
        RootPart = nil,
        Position = Vector3.zero,
        Distance = math.huge,
        Health = 0,
        MaxHealth = 100,
        Bounty = 0,
        Level = 0,
        DevilFruit = "None",
        SeaZone = 0,
        DangerLevel = 0,
        Team = player and player.Team and player.Team.Name or "Unknown",
        IsSameMarine = false,
        HasForceField = false,
        HasShield = false,
        InSafeZone = false,
        SafeZoneName = nil,
        CanPvP = false,
        StatusText = "[SCANNING]",
        StatusColor = Color3.fromRGB(150, 150, 150),
    }
    if not player or not player.Parent then
        result.StatusText = "[NOT FOUND]"
        result.StatusColor = Color3.fromRGB(120, 120, 120)
        return result
    end
    local pName = player.Name
    if not isCurrentTarget and not isTargetEligible(pName) then
        result.CanPvP = false
        if _permanentKilledByBlacklist[pName] then
            result.StatusText = "[DEAD - SKIPPED]"
            result.StatusColor = Color3.fromRGB(255, 60, 60)
        elseif _killedTargets[pName] then
            result.StatusText = "[KILLED - SKIPPED]"
            result.StatusColor = Color3.fromRGB(150, 255, 150)
        elseif _skippedTargets[pName] then
            result.StatusText = "[SKIPPED]"
            result.StatusColor = Color3.fromRGB(200, 160, 120)
        end
        return result
    end
    if player == LocalPlayer then
        result.StatusText = "[LOCAL PLAYER]"
        result.StatusColor = Color3.fromRGB(0, 200, 255)
        return result
    end
    local char = player.Character
    result.Character = char
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
    result.RootPart = root
    if not (char and hum and root and hum.Health > 0) then
        result.StatusText = "[DEAD / RESPAWNING]"
        result.StatusColor = Color3.fromRGB(120, 120, 120)
        return result
    end
    local realPos = (Hunter.PortalXTracker and Hunter.PortalXTracker.GetRealPosition(player)) or root.Position
    result.Health = math.floor(hum.Health)
    result.MaxHealth = math.floor(hum.MaxHealth)
    result.Position = realPos
    if Hunter.KenCheck then
        local kenSt = Hunter.KenCheck.GetStatus(player)
        if kenSt then
            result.KenActive = kenSt.Active == true
            result.KenDodgesLeft = tonumber(kenSt.DodgesLeft) or 0
            result.KenDisabled = kenSt.KenDisabled == true
        end
    end
    local _, _, myRoot = getCharacter()
    if myRoot then
        result.Distance = math.floor((realPos - myRoot.Position).Magnitude)
    end

    local arena = Hunter.ArenaCheck and Hunter.ArenaCheck.GetStatus(player)
    result.InArena = arena and arena.InArena
    result.ArenaMode = arena and arena.Mode
    result.ArenaSource = arena and arena.Source
    if result.InArena and (Hunter.Config or CONFIG).SkipArenaPlayers ~= false then
        result.CanPvP = false
        result.StatusText = "[ARENA SESSION - SKIPPED]"
        result.StatusColor = Color3.fromRGB(255, 170, 60)
        return result
    end
    local amInDimension = isLocalPlayerInPortalDimension()
    if amInDimension then
        local distFromMe = result.Distance or math.huge
        local inPortalDim = isPlayerInPortalVDimension(player)
        if not inPortalDim or distFromMe > 2500 then
            result.CanPvP = false
            result.Reason = "TargetOutsidePortalDimension"
            result.StatusText = string.format("[OUTSIDE V PORTAL (%dm) -> SKIPPED]", math.floor(distFromMe))
            result.StatusColor = Color3.fromRGB(180, 80, 255)
            return result
        else
            result.CanPvP = true
            result.StatusText = "[V DIMENSION TARGET]"
            result.StatusColor = Color3.fromRGB(180, 0, 255)
            return result
        end
    end

    if isTargetInPortalVDimension(player) then
        result.CanPvP = false
        result.StatusText = string.format("[IN V PORTAL (%dm) -> SKIPPED]", result.Distance)
        result.StatusColor = Color3.fromRGB(180, 80, 255)
        return result
    end

    local isFarOffshore, offshoreDist, nearestIslName = isTargetTooFarFromIsland(player)
    result.IsFarOffshore = isFarOffshore
    result.OffshoreDist = offshoreDist
    result.NearestIslName = nearestIslName
    if isFarOffshore then
        result.CanPvP = false
        result.StatusText = string.format("[OFFSHORE (%dm from %s > 5000m) -> SKIPPED]", math.floor(offshoreDist or 0), tostring(nearestIslName or "Island"))
        result.StatusColor = Color3.fromRGB(0, 165, 255)
        return result
    end

    result.IsTooFast = false
    result.TargetSpd = 0

    result.Bounty = getPlayerBounty(player)
    result.Level = getPlayerLevel(player)
    result.DevilFruit = getPlayerDevilFruit(player)
    local zNum, dLvl = getOtherPlayerZone(player)
    result.SeaZone = zNum
    result.DangerLevel = dLvl
    local myTeam = LocalPlayer.Team and LocalPlayer.Team.Name
    if myTeam == "Marines" and result.Team == "Marines" then
        result.IsSameMarine = true
    end
    result.HasForceField = (char:FindFirstChildOfClass("ForceField") ~= nil)
    local hasSafeZoneShield = false
    local tsz = char:FindFirstChild("TempSafeZone")
    if tsz and tsz:IsA("BoolValue") and tsz.Value == true then
        hasSafeZoneShield = true
    end
    local szv = char:FindFirstChild("SafeZone")
    if szv and szv:IsA("BoolValue") and szv.Value == true then
        hasSafeZoneShield = true
    end
    result.HasShield = hasSafeZoneShield
    local inSZ, szName = isInsideGameSafeZone(realPos, player)
    if hasSafeZoneShield then
        inSZ = true
        szName = szName or "ShieldSafeZone"
    end
    result.InSafeZone = inSZ
    result.SafeZoneName = szName
    local actCfg = getActiveConfig()
    local isIgn, ignFruit = isFruitIgnored(result.DevilFruit)
    local minLvl = tonumber(actCfg.MinLevel) or 0
    local maxBounty = actCfg.MaxBounty
    local maxBountyNum = tonumber(maxBounty) or 0
    if maxBountyNum > 0 and maxBountyNum < 1000 then
        maxBountyNum = maxBountyNum * 1000000
    end
    local myLevel = getPlayerLevel(LocalPlayer)
    local maxLevelDiff = tonumber(actCfg.MaxLevelDifference) or 500
    local minAllowedLevel = math.max(1, myLevel - maxLevelDiff)
    if minLvl > 0 then
        minAllowedLevel = math.max(minAllowedLevel, minLvl)
    end
    local isLvlLow = (myLevel > maxLevelDiff and (result.Level <= 0 or result.Level < minAllowedLevel))
    local maxDist = tonumber(actCfg.MaxTargetDistance) or 35000
    local isTooFar = (maxDist > 0 and result.Distance > 0 and result.Distance > maxDist)
    local isBountyHigh = (maxBountyNum > 0 and result.Bounty > 0 and result.Bounty > maxBountyNum)
    local isUnderwater = root and isPositionUnderwater(realPos)
    local isPvpDisabled = (player:GetAttribute("PvpDisabled") == true) or (player:GetAttribute("PvPDisabled") == true) or (char and (char:GetAttribute("PvpDisabled") == true or char:GetAttribute("PvPDisabled") == true))
    result.PvPDisabled = isPvpDisabled
    local seaZone, dangerLvl = getOtherPlayerZone(player)
    result.SeaZone = seaZone
    result.DangerLevel = dangerLvl

    if isUnderwater then
        result.CanPvP = false
        result.StatusText = "[UNDERWATER ISLAND]"
        result.StatusColor = Color3.fromRGB(0, 180, 255)
        return result
    elseif seaZone >= 2 then
        result.CanPvP = false
        result.StatusText = string.format("[OUT AT SEA (ZONE %d) -> SKIPPED]", seaZone)
        result.StatusColor = Color3.fromRGB(0, 160, 255)
        return result
    elseif result.HasForceField then
        result.CanPvP = false
        result.StatusText = "[FORCEFIELD ACTIVE]"
        result.StatusColor = Color3.fromRGB(255, 210, 50)
        return result
    elseif isPvpDisabled then
        result.CanPvP = false
        result.StatusText = "[PVP DISABLED]"
        result.StatusColor = Color3.fromRGB(255, 140, 0)
        return result
    elseif result.IsSameMarine then
        result.CanPvP = false
        result.StatusText = "[SAME MARINE TEAM]"
        result.StatusColor = Color3.fromRGB(60, 150, 255)
        return result
    elseif isIgn then
        result.CanPvP = false
        local fLabel = (result.DevilFruit and result.DevilFruit ~= "None") and result.DevilFruit or ignFruit
        result.StatusText = "[SKIPPED FRUIT: " .. fLabel .. "]"
        result.StatusColor = Color3.fromRGB(210, 100, 255)
        return result
    elseif isLvlLow then
        result.CanPvP = false
        result.StatusText = string.format("[LEVEL DIFF: Lv.%d < %d (Below %d Lv)]", result.Level, minAllowedLevel, maxLevelDiff)
        result.StatusColor = Color3.fromRGB(255, 170, 70)
        return result
    elseif isBountyHigh then
        result.CanPvP = false
        result.StatusText = string.format("[HIGH BOUNTY: %.1fM > %.1fM]", result.Bounty / 1000000, maxBountyNum / 1000000)
        result.StatusColor = Color3.fromRGB(255, 90, 90)
        return result
    elseif isTooFar then
        result.CanPvP = false
        result.StatusText = string.format("[TOO FAR: %dm > %dm -> SKIPPED]", result.Distance, maxDist)
        result.StatusColor = Color3.fromRGB(180, 180, 190)
        return result
    end
    local bTag = (result.Bounty and result.Bounty > 0) and (" [" .. string.format("%.1fM", result.Bounty / 1000000) .. "]") or ""
    local isTargetInCombat = isPlayerInCombat(player, char)
    if inSZ then
        result.CanPvP = false
        result.StatusText = "[IN SAFEZONE - SKIPPED]"
        result.StatusColor = Color3.fromRGB(255, 100, 100)
        return result
    else
        result.CanPvP = true
        if isTargetInCombat then
            result.StatusText = "[COMBAT - HUNT NOW" .. bTag .. "]"
            result.StatusColor = Color3.fromRGB(255, 100, 50)
        else
            result.StatusText = "[ELIGIBLE TARGET" .. bTag .. "]"
            result.StatusColor = Color3.fromRGB(0, 255, 150)
        end
    end
    return result
end
isAlive = function(model)
    local ok, res = pcall(function()
        if not model or not model.Parent then return false end
        if model == LocalPlayer.Character then return false end
        local hum = model:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChild("Head")
        return root ~= nil
    end)
    return ok and res or false
end

local function findTarget()
    if isHopping then return nil, nil end
    if not Hunter.Config.AutoHuntEnabled then
        if Hunter.TargetPlayer then skipCurrentTarget("auto-hunt-disabled", false) end
        return nil, nil
    end
    if not Hunter.TargetPlayer then
        local now = tick()
        if now - _lastFindTargetTime < 0.05 then return nil, nil end
        _lastFindTargetTime = now
    end
    local _, _, myRoot = getCharacter()
    if not myRoot then return nil, nil end
    Hunter.Config.SelectedTarget = "LowestHealth"

    local bestPlayer
    local lockedPlayer = Hunter.TargetPlayer
    local amInDimension = isLocalPlayerInPortalDimension()
    if lockedPlayer and lockedPlayer.Parent then
        local liveChar = lockedPlayer.Character
        local liveHum = liveChar and liveChar:FindFirstChildOfClass("Humanoid")
        local liveRoot = liveChar and (liveChar:FindFirstChild("HumanoidRootPart") or liveChar.PrimaryPart)
        local tName = lockedPlayer.Name
        local lockGrace = math.max(tonumber(Hunter.Config.TargetLockGrace) or tonumber(CONFIG.TargetLockGrace) or 8, 0.1)

        if liveHum and liveHum.Health <= 0 then
            local now = tick()
            _killedTargets[tName] = now
            _postKillTransitionPending = true
            _postKillTransitionTick = now
            _lastKilledVictimName = string.format("%s (@%s)", lockedPlayer.DisplayName, tName)
            _lastCombatEnemyName = tName

            Hunter.TargetPlayer = nil
            Hunter.TargetCharacter = nil
            Hunter.TargetPart = nil
            Hunter.PredictedPos = nil
            _currentCombatTarget = nil
            _targetCombatLossSince = nil
            _targetCombatLossPlayer = nil
            _targetInvalidSince = nil
            _targetInvalidPlayer = nil
            _lastControlledCombatPos = nil
            _lastControlledTargetPos = nil
            _combatElapsedTime = 0
            _lastCombatTick = nil
            _lastDamageDealtTick = nil
            _hasEngagedInCombat = false
            _lastFindTargetTime = 0

            local killedVictimLabel = _lastKilledVictimName
            local killedVictimRaw = tName
            local killedVictimKey = extractVictimKey(tName)
            task.spawn(function()
                local waitStart = tick()
                while tick() - waitStart < 2.0 do
                    if Hunter and Hunter._lastProcessedVictimKey == killedVictimKey and (tick() - (Hunter._lastProcessedKillTime or 0) < 4.0) then
                        return
                    end
                    local earnedFromNotif = scanNotificationsForVictimEarned(killedVictimRaw)
                    if earnedFromNotif and earnedFromNotif > 0 then
                        updateBountyStats(killedVictimLabel, earnedFromNotif)
                        return
                    end
                    local curBounty = getPlayerBounty(LocalPlayer)
                    if (tick() - waitStart >= 0.4) and curBounty < 30000000 and _lastKnownBounty and _lastKnownBounty > 0 and curBounty > _lastKnownBounty then
                        updateBountyStats(killedVictimLabel, nil)
                        return
                    end
                    task.wait(0.08)
                end
                -- Timeout 2.0s kết thúc: Nếu không tìm thấy thông báo killing và Bounty không tăng,
                -- tức là mục tiêu bị người khác/NPC giết hoặc tự reset. Không gọi updateBountyStats.
            end)

            local actCfg = getActiveConfig()
            local maxKills = tonumber(actCfg.MaxKillsPerServer) or 6
            if maxKills > 0 and _serverKillsCount >= maxKills then
                task.delay(0.8, function()
                    if type(autoHopServer) == "function" then
                        autoHopServer(string.format("KillLimitReached (%d/%d Kills in Server)", _serverKillsCount, maxKills))
                    end
                end)
            end
            Hunter.TargetSuspended = false
            Hunter.TargetLockStatus = {Phase = "released", PlayerName = tName, Reason = "target-dead"}
            print("[TrashHub][TARGET_RELEASE] " .. tName .. " Reason=target-dead")
        elseif liveChar and liveHum and liveHum.Health > 0 and liveRoot and liveRoot.Parent then
            local now = tick()
            local isPortalX = isTargetUsingPortalDimension(lockedPlayer)
            local info = inspectPlayer(lockedPlayer, true)
            local actCfgCheck = (type(getActiveConfig) == "function" and getActiveConfig()) or CONFIG
            local maxDistLimit = math.max(tonumber(actCfgCheck and actCfgCheck.MaxTargetDistance) or 35000, 35000)
            local isInPortalV = not isPortalX and isTargetInPortalVDimension(lockedPlayer)
            local isFarOffshore = not isPortalX and info.IsFarOffshore == true
            local isOverMaxDist = not isPortalX and not amInDimension and info.Distance and info.Distance > maxDistLimit
            local realPos = (Hunter.PortalXTracker and Hunter.PortalXTracker.GetRealPosition(lockedPlayer)) or liveRoot.Position
            local crossDimension = amInDimension and (not isPlayerInPortalVDimension(lockedPlayer)
                or (realPos - myRoot.Position).Magnitude > 2500)
            local blockedReason = (info.InArena and (Hunter.Config or CONFIG).SkipArenaPlayers ~= false and "arena-session")
                or (crossDimension and "different-dimension")
                or (isInPortalV and "portal-v")
                or (isFarOffshore and "offshore")
                or (isOverMaxDist and "too-far")
                or (not isPortalX and info.InSafeZone and "safe-zone")
                or (not isPortalX and not info.CanPvP and "temporarily-unavailable")
                or nil

            Hunter.TargetCharacter = liveChar
            _targetInvalidSince = nil
            _targetInvalidPlayer = nil
            _targetEvalCache.player = lockedPlayer
            _targetEvalCache.time = now
            _targetEvalCache.info = info
            _targetEvalCache.isFarOffshore = isFarOffshore
            _targetEvalCache.offshoreDist = info.OffshoreDist or 0
            _targetEvalCache.nearestIslName = info.NearestIslName
            _targetEvalCache.isTooFast = false
            _targetEvalCache.targetSpd = 0

            if blockedReason then
                -- Confirmed unattackable targets are released in this scan.
                skipCurrentTarget(blockedReason)
            else
                _targetCombatLossSince = nil
                _targetCombatLossPlayer = nil
                Hunter.TargetSuspended = false
                Hunter.TargetPart = liveRoot
                Hunter.TargetLockStatus = {Phase = "locked", PlayerName = tName}
                _lastCombatEnemyName = tName
                _noTargetStartTime = 0
                return liveChar, liveRoot
            end
        else
            local now = tick()
            if _targetInvalidPlayer ~= lockedPlayer or not _targetInvalidSince then
                _targetInvalidPlayer = lockedPlayer
                _targetInvalidSince = now
            end
            local missingGrace = math.max(lockGrace, tonumber(Hunter.Config.TargetLossGrace) or tonumber(CONFIG.TargetLossGrace) or 2)
            Hunter.TargetSuspended = true
            Hunter.TargetCharacter = nil
            Hunter.TargetPart = nil
            Hunter.PredictedPos = nil
            Hunter.TargetLockStatus = {Phase = "waiting", PlayerName = tName,
                Reason = "character-unavailable", Since = _targetInvalidSince}
            _noTargetStartTime = 0
            if now - _targetInvalidSince < missingGrace then return nil, nil end
            skipCurrentTarget("character-unavailable")
        end
    elseif lockedPlayer then
        skipCurrentTarget("player-left", false)
    end

    local bestDist = math.huge
    local bestHealth = math.huge
    local bestScore = -math.huge
    bestPlayer = nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and isAlive(p.Character) then
            local pName = p.Name
            if amInDimension and isPlayerInPortalVDimension(p) then
                _skippedTargets[pName] = nil
                _killedTargets[pName] = nil
                _permanentKilledByBlacklist[pName] = nil
