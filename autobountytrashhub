local function _portalIsRestrictedInteriorIsland(islandName, islandPos, targetRawPos)
    if not islandPos then return false end
    local lowerName = type(islandName) == "string" and string.lower(islandName) or ""
    local isCursedShipInterior = (islandPos.Z > 25000) or (lowerName:find("haunted ship", 1, true) ~= nil) or (lowerName:find("cursed ship", 1, true) ~= nil)
    local isUnderwaterInterior = (islandPos.X > 45000) or (lowerName:find("underwater", 1, true) ~= nil)
    if isCursedShipInterior or isUnderwaterInterior then
        if not targetRawPos then return true end
        local distToInterior = _portalHorizDist(islandPos, targetRawPos)
        return distToInterior > 1500
    end
    return false
end

_portalGetNearestIslandToPosition = function(pos)
    if not pos then return nil, nil, math.huge, math.huge, math.huge end
    if Hunter and Hunter.GhostShipRoute and Hunter.GhostShipRoute.IsInsideKatakuriRoom
        and Hunter.GhostShipRoute:IsInsideKatakuriRoom(pos) then
        pos = (Hunter.GhostShipRoute.GetEntrancePosition and Hunter.GhostShipRoute:GetEntrancePosition(pos))
            or Vector3.new(-2151.822, 149.316, -12404.905)
    end
    local curIsl = _portalGetIslandsForCurrentSea()
    local bestName = nil
    local bestPos = nil
    local bestEffectiveDist = math.huge
    local bestHorizDist = math.huge
    local best3DDist = math.huge

    for islandName, islandPos in pairs(curIsl) do
        if typeof(islandPos) == "Vector3" and not _portalIsRestrictedInteriorIsland(islandName, islandPos, pos) then
            local dHoriz = _portalHorizDist(islandPos, pos)
            local d3D = (islandPos - pos).Magnitude
            local vertDiff = math.abs(islandPos.Y - pos.Y)
            local effectiveDist = (vertDiff > 2500) and d3D or dHoriz
            if effectiveDist < bestEffectiveDist then
                bestEffectiveDist = effectiveDist
                bestHorizDist = dHoriz
                best3DDist = d3D
                bestName = islandName
                bestPos = islandPos
            end
        end
    end

    return bestName, bestPos, bestEffectiveDist, bestHorizDist, best3DDist
end

local function _portalSyncGatewayList(list)
    if typeof(list) ~= "table" then return end
    local curIsl = _portalGetIslandsForCurrentSea()
    if not curIsl then return end
    for iName, iData in pairs(list) do
        if type(iName) == "string" then
            if typeof(iData) == "Vector3" then
                curIsl[iName] = iData
            elseif typeof(iData) == "CFrame" then
                curIsl[iName] = iData.Position
            elseif typeof(iData) == "Instance" and iData:IsA("BasePart") then
                curIsl[iName] = iData.Position
            elseif typeof(iData) == "table" and #iData >= 3 then
                local x, y, z = tonumber(iData[1]), tonumber(iData[2]), tonumber(iData[3])
                if x and y and z then
                    curIsl[iName] = Vector3.new(x, y, z)
                end
            end
        end
    end
end

