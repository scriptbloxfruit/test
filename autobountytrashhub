        if isGodhumanEquipped or inGodhumanWindow then
            local head = character:FindFirstChild("Head")
            local lowerTorso = character:FindFirstChild("LowerTorso") or character:FindFirstChild("Torso")
            if (head and head:IsA("BasePart") and head.Transparency >= 0.95)
                or (lowerTorso and lowerTorso:IsA("BasePart") and lowerTorso.Transparency >= 0.95) then
                _godhumanZCache[character] = { inGhZ = true, reason = "GodhumanZInvisibleBarrage", at = now }
                return true, "GodhumanZInvisibleBarrage"
            end
        end

        if inGodhumanWindow then
            _godhumanZCache[character] = { inGhZ = true, reason = "GodhumanCastWindow", at = now }
            return true, "GodhumanCastWindow"
        end

        _godhumanZCache[character] = { inGhZ = false, reason = nil, at = now }
        return false, nil
    end

    function StunCheck.HasHyperArmor(character, tool)
        if not character then
            return false
        end
        if character:GetAttribute("UnbreakableAll") == true then
            return true
        end
        if character:FindFirstChild("Dragon") or character:FindFirstChild("PainTransformed") then
            return true
        end
        if tool and tool:IsA("Tool") then
            local toolTip = tool.ToolTip
            local suffix = (toolTip == "Blox Fruit" and "Fruit") or toolTip
            if suffix and character:GetAttribute("Unbreakable" .. suffix) == true then
                return true
            end
        end
        return false
    end

    local _stunAnimCache = setmetatable({}, { __mode = "k" })
    function StunCheck.IsPlayingStunAnimation(character)
        local hum = character and character:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if not animator then
            return false, nil
        end

        local now = os.clock()
        local cached = _stunAnimCache[character]
        if cached and (now - cached.at) < 0.10 then
            return cached.playing, cached.name
        end

        local ok, tracks = pcall(animator.GetPlayingAnimationTracks, animator)
        if not ok or type(tracks) ~= "table" then
            _stunAnimCache[character] = { playing = false, name = nil, at = now }
            return false, nil
        end

        for _, track in ipairs(tracks) do
            if track.IsPlaying and track.Animation then
                local animId = track.Animation.AnimationId
                local animName = track.Animation.Name
                if STUN_ANIMATION_IDS[animId] then
                    _stunAnimCache[character] = { playing = true, name = STUN_ANIMATION_IDS[animId], at = now }
                    return true, STUN_ANIMATION_IDS[animId]
                end
                if type(animName) == "string" and animName:sub(1, 4) == "Stun" then
                    _stunAnimCache[character] = { playing = true, name = animName, at = now }
                    return true, animName
                end
            end
        end

        _stunAnimCache[character] = { playing = false, name = nil, at = now }
        return false, nil
    end

    function StunCheck.GetActiveStunObjects(character)
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local stunObjects = hrp and hrp:FindFirstChild("StunObjects")
        if not stunObjects then
            return false, 0, nil
        end

        local children = stunObjects:GetChildren()
        local count = #children
        if count == 0 then
            return false, 0, nil
        end

        local serverNow = Workspace:GetServerTimeNow()
        local activeCount = 0
        local latestType = nil

        for _, folder in ipairs(children) do
            local ts = tonumber(folder:GetAttribute("LastBodyVelocityTimestamp"))
            local dur = tonumber(folder:GetAttribute("LastBodyVelocityDuration"))
            local animType = folder:GetAttribute("AnimationType")
            local hasActiveWindow = (ts and dur and (serverNow - ts) <= (dur + 0.1))
            local hasMoverChild = (not ts and (folder:FindFirstChildWhichIsA("BodyMover") ~= nil or folder:FindFirstChildWhichIsA("Constraint") ~= nil))
            if hasActiveWindow or hasMoverChild then
                activeCount += 1
                latestType = animType or latestType or "ServerStunMover"
            end
        end

        return activeCount > 0, activeCount, latestType
    end

    function StunCheck.IsMovementDisabled(character, ignoreClientSelfLock)
        if not character then
            return false, 0
        end
        local serverCount = tonumber(character:GetAttribute("DisableMovementServer")) or 0
        if ignoreClientSelfLock then
            return serverCount > 0, serverCount
        end
        local clientCount = tonumber(character:GetAttribute("DisableMovementClient")) or 0
        local total = clientCount + serverCount
        local hasFolder = character:FindFirstChild("DisableMovement") ~= nil
        return (total > 0 or hasFolder), total
    end

    local _realStunCache = setmetatable({}, { __mode = "k" })
    function StunCheck.IsRealStun(character)
        character = character or (LocalPlayer and LocalPlayer.Character)
        if not character then
            return false, nil
        end
        local hum = character:FindFirstChildOfClass("Humanoid")
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp or hum.Health <= 0 then
            return false, nil
        end

        local now = os.clock()
        local cached = _realStunCache[character]
        if cached and (now - cached.at) < 0.10 then
            return cached.isStun, cached.reason
        end

        if character == (LocalPlayer and LocalPlayer.Character) then
            if StunCheck.IsInGodhumanZ and StunCheck.IsInGodhumanZ(character) then
                _realStunCache[character] = { isStun = false, reason = nil, at = now }
                return false, nil
            end
        end

        local stunValObj = character:FindFirstChild("Stun")
        local stunVal = (stunValObj and tonumber(stunValObj.Value)) or 0
        if stunVal > 0 then
            _realStunCache[character] = { isStun = true, reason = "StunValue:" .. tostring(stunVal), at = now }
            return true, "StunValue:" .. tostring(stunVal)
        end

        for _, markerName in ipairs(GRAB_LOCK_MARKERS) do
            if character:FindFirstChild(markerName) then
                _realStunCache[character] = { isStun = true, reason = "GrabMarker:" .. markerName, at = now }
                return true, "GrabMarker:" .. markerName
            end
        end

        local serverMoveDisabled, serverMoveCount = StunCheck.IsMovementDisabled(character, true)
        if serverMoveDisabled then
            _realStunCache[character] = { isStun = true, reason = "DisableMovementServer:" .. tostring(serverMoveCount), at = now }
            return true, "DisableMovementServer:" .. tostring(serverMoveCount)
        end

        local playingStunAnim, animName = StunCheck.IsPlayingStunAnimation(character)
        if playingStunAnim then
            _realStunCache[character] = { isStun = true, reason = "StunAnimation:" .. tostring(animName), at = now }
            return true, "StunAnimation:" .. tostring(animName)
        end

        if not isSkillHolding and not (Hunter and Hunter._skillHeldKey) then
            local hasStunObj, _, stunAnimType = StunCheck.GetActiveStunObjects(character)
            if hasStunObj then
                _realStunCache[character] = { isStun = true, reason = "StunObjects:" .. tostring(stunAnimType or "Active"), at = now }
                return true, "StunObjects:" .. tostring(stunAnimType or "Active")
            end
        end

        _realStunCache[character] = { isStun = false, reason = nil, at = now }
        return false, nil
    end

    StunCheck._lastRealStunAt = 0
    StunCheck._lastRealStunChar = nil

    function StunCheck.IsServerPhysicsLocked(character)
        character = character or (LocalPlayer and LocalPlayer.Character)
        if not character then
            return false, nil
        end
        if character == (LocalPlayer and LocalPlayer.Character) then
            if StunCheck.IsInGodhumanZ and StunCheck.IsInGodhumanZ(character) then
                return false, nil
            end
        end
        local hrp = character:FindFirstChild("HumanoidRootPart")
        for _, markerName in ipairs(GRAB_LOCK_MARKERS) do
            if character:FindFirstChild(markerName) then
                return true, "GrabMarker:" .. markerName
            end
        end
        local isStun, reason = StunCheck.IsRealStun(character)
        local now = os.clock()
        if isStun and character == (LocalPlayer and LocalPlayer.Character) then
            StunCheck._lastRealStunAt = now
            StunCheck._lastRealStunChar = character
        end
        if hrp and hrp.Anchored and not _isPortalWarping and not isHopping and not (Hunter and Hunter._isHealingInSky) and isStun then
            return true, "ServerAnchoredStun"
        end
        local dodge = Hunter and Hunter.SkillDodge
        if dodge and dodge._grabLockedDuringStun then
            if isStun or now < (dodge._grabLockUntil or 0) then
                return true, "MultiHitGrabStun:" .. tostring(reason or "Settle")
            else
                dodge._grabLockedDuringStun = false
                dodge._hasSnappedForCurrentStun = false
            end
        end
        return false, nil
    end

    function StunCheck.IsStunned(character, ignoreBusy)
        character = character or (LocalPlayer and LocalPlayer.Character)
        if not character then
            return true, "NoCharacter", nil
        end

        local hum = character:FindFirstChildOfClass("Humanoid")
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp or hum.Health <= 0 then
            return true, "DeadOrMissingParts", nil
        end

        local inGhZ, ghZReason = StunCheck.IsInGodhumanZ(character)
        if inGhZ then
            return true, ghZReason, { GodhumanGrab = ghZReason }
        end

        local stunValObj = character:FindFirstChild("Stun")
        local stunVal = (stunValObj and tonumber(stunValObj.Value)) or 0
        if stunVal > 0 then
            return true, "StunValue", { Stun = stunVal }
        end

        if not ignoreBusy then
            local busyValObj = character:FindFirstChild("Busy")
            local isBusy = (busyValObj and (busyValObj.Value == true or (tonumber(busyValObj.Value) or 0) > 0)) or false
            if isBusy then
                return true, "BusyValue", { Busy = true }
            end

            local hasStunObj, stunObjCount, stunAnimType = StunCheck.GetActiveStunObjects(character)
            if hasStunObj then
                return true, "StunObjects", { Count = stunObjCount, AnimationType = stunAnimType }
            end

            local moveDisabled, moveDisableCount = StunCheck.IsMovementDisabled(character, false)
            if moveDisabled then
                return true, "DisableMovement", { Count = moveDisableCount }
            end

            if hrp.Anchored then
                return true, "RootPartAnchored", nil
            end
        end

        for _, markerName in ipairs(GRAB_LOCK_MARKERS) do
            if character:FindFirstChild(markerName) then
                return true, "GrabMarker:" .. markerName, { Marker = markerName }
            end
        end

        if hum.Sit then
            return true, "HumanoidSit", nil
        end

        local playingStunAnim, animName = StunCheck.IsPlayingStunAnimation(character)
        if playingStunAnim then
            return true, "StunAnimation:" .. tostring(animName), { Animation = animName }
        end

        return false, "Clear", nil
    end

    function StunCheck.CanCastSkill(tool, keyName, ignoreBusy)
        local char = LocalPlayer and LocalPlayer.Character
        if not char then
            return false, "NoCharacter"
        end

        local inGhZ, ghZReason = StunCheck.IsInGodhumanZ(char)
        if inGhZ then
            return false, "LockedByGodhuman:" .. tostring(ghZReason)
        end

        local isStunned, stunReason = StunCheck.IsStunned(char, ignoreBusy)
        if isStunned then
            return false, "Stunned:" .. tostring(stunReason)
        end

        if not ignoreBusy then
            local g = getGameGlobal()
            if g then
                local nowTick = tick()
                if (nowTick - (tonumber(g.equipTimer) or 0)) < 0.1 then
                    return false, "EquipTimerLockout"
                end
                if g.busy ~= false and g.busy ~= nil then
                    return false, "GlobalBusy:" .. tostring(g.busy)
                end
                if (nowTick - (tonumber(g.castTimer) or 0)) < 0 then
                    return false, "CastTimerActive"
                end
            end
        end

        local activeTool = tool or char:FindFirstChildOfClass("Tool")
        if activeTool then
            local holding = activeTool:FindFirstChild("Holding")
            if holding and holding:IsA("BoolValue") and holding.Value == true then
                return false, "ToolHoldingActive"
            end
            if activeTool:GetAttribute("State") == "StartCasting" then
                return false, "ToolStartCasting"
            end
            if keyName and activeTool:GetAttribute("DisabledSkill" .. tostring(keyName)) == true then
                return false, "DisabledSkillAttribute"
            end
        end

        return true, "Ready"
    end

    function StunCheck.CanAttackM1(weaponType)
        local char = LocalPlayer and LocalPlayer.Character
        if not char then
            return false, "NoCharacter"
        end

        local inGhZ, ghZReason = StunCheck.IsInGodhumanZ(char)
        if inGhZ then
            return false, ghZReason
        end

        local isStunned, stunReason = StunCheck.IsStunned(char, true)
        if isStunned then
            return false, stunReason
        end

        local g = getGameGlobal()
        if g and (tonumber(g.tapCooldown) or 0) > os.clock() then
            return false, "TapCooldown"
        end

        return true, "Ready"
    end

    local env = (type(getgenv) == "function" and getgenv()) or _G
    env.StunCheck = StunCheck
    return StunCheck
end)()

Hunter.IsActionLocked = function(character)
    character = character or (LocalPlayer and LocalPlayer.Character)
    if not character then return true, "NoCharacter" end

    if Hunter.StunCheck then
        local inGhZ, ghZReason = Hunter.StunCheck.IsInGodhumanZ(character)
        if inGhZ then
            return true, "Godhuman:" .. tostring(ghZReason)
        end
        if Hunter.StunCheck.IsServerPhysicsLocked then
            local physLocked, physReason = Hunter.StunCheck.IsServerPhysicsLocked(character)
            if physLocked then
                return true, "Stun:" .. tostring(physReason)
            end
        else
            local realStun, stunReason = Hunter.StunCheck.IsRealStun(character)
            if realStun then
                return true, "Stun:" .. tostring(stunReason)
            end
        end
    end

    return false, nil
end

Hunter._localSkillCooldownUntil = Hunter._localSkillCooldownUntil or {}
Hunter.ReadSkillState = function(tool, keyName)
    local ok, result = pcall(Hunter.SkillCheck.Check, tool, keyName)
    if not ok then
        return nil
    end
    return result
end

Hunter.IsSkillReady = function(tool, keyName, forSelection)
    if not tool then return false, nil end
    local cdKey = tostring(tool.Name) .. "_" .. tostring(keyName)
    if os.clock() < (Hunter._localSkillCooldownUntil[cdKey] or 0) then
        return false, nil
    end
    local ok, ready, result = pcall(Hunter.SkillCheck.IsReady, tool, keyName, forSelection == true)
    if not ok then return false, nil end
    if ready ~= nil then
        return ready == true, result
    end
    if result and result.Status == "UNKNOWN"
        and result.Unlocked ~= false and result.CooldownReady ~= false and result.EstimatedCooldownReady ~= false then
        return true, result
    end
    return false, result
end

Hunter.WaitForSkillRuntime = function(tool, keyName, timeout)
    local char = LocalPlayer.Character
    local waitStarted = os.clock()
    local deadline = waitStarted + math.max(0.35, tonumber(timeout) or 0.65)
    if unlockSkillState then unlockSkillState() end
    repeat
        if not char or LocalPlayer.Character ~= char or not tool or tool.Parent ~= char
            or not Hunter._isRunning then
            return false
        end
        if Hunter.IsActionLocked(char) then
            if os.clock() >= deadline then
                return false
            end
            task.wait(0.015)
            continue
        end
        local result = Hunter.ReadSkillState(tool, keyName)
        local elapsed = os.clock() - waitStarted
        local isMovesetTool = tool:GetAttribute("MovesetToolUid") ~= nil
        if result then
            if result.Unlocked == false or result.CooldownReady == false
                or result.Status == "NO_SKILL" or result.Status == "LOCKED"
                or (result.Exact == true and result.Status == "COOLDOWN")
                or ((isMovesetTool or elapsed >= 0.08) and result.EstimatedCooldownReady == false) then
                Hunter._localSkillCooldownUntil = Hunter._localSkillCooldownUntil or {}
                Hunter._localSkillCooldownUntil[tostring(tool.Name) .. "_" .. tostring(keyName)] = os.clock() + 0.45
                return false
            end
            if (result.Exact == true and result.Ready == true)
                or (isMovesetTool and result.Unlocked ~= false and result.EstimatedCooldownReady ~= false) then
                if unlockSkillState then unlockSkillState() end
                return true
            end
        end
        if elapsed >= 0.08
            and (not result or (result.CooldownReady ~= false and result.EstimatedCooldownReady ~= false and result.Unlocked ~= false)) then
            if unlockSkillState then unlockSkillState() end
            Hunter._skillRuntimeBlock = nil
            return true
        end
        if unlockSkillState then unlockSkillState() end
        if os.clock() >= deadline then
            return false
        end
        task.wait(0.015)
    until false
end



