        local char = root.Parent
        local busyVal = char and char:FindFirstChild("Busy")
        if (busyVal and busyVal.Value == true) or isCharacterTransformed(char) then
            if self.Busy then self:Reset("char-busy-or-transformed") end
            return false
        end

        refreshUnlocksAsync(false)
        if not self.IndraUnlocked and not self.TyrantUnlocked then
            return false
        end

        local myPos = root.Position
        local effectiveTargetPos = targetPos
        if Hunter.GhostShipRoute and Hunter.GhostShipRoute.GetEntrancePosition
            and not Hunter.GhostShipRoute:IsInside(myPos) then
            effectiveTargetPos = Hunter.GhostShipRoute:GetEntrancePosition(targetPos) or targetPos
        end
        local directDist = (myPos - effectiveTargetPos).Magnitude

        if self.Busy and state.Hops then
            if targetPlayer ~= state.TargetPlayer then
                self:Reset("target-changed")
            elseif directDist <= 1400 then
                self:Reset("target-close")
                return false
            else
                local remHops = {}
                for i = state.HopIndex, #state.Hops do
                    table.insert(remHops, state.Hops[i])
                end
                local remCost = evaluateRouteCost(remHops, myPos, effectiveTargetPos)
                if directDist + 400 < remCost then
                    self:Reset("direct-now-faster")
                    return false
                end
            end
        end

        if not self.Busy then
            local bestHops = findBestRoute(myPos, effectiveTargetPos)
            if not bestHops then
                return false
            end
            self.Busy = true
            state.Hops = bestHops
            state.HopIndex = 1
            state.TargetPlayer = targetPlayer
            state.PhaseStartedAt = now
            state.LastTriggerAt = 0
            state.StreamRequestedHop = 0
            state.ClearExitGoal = nil

            local firstEdge = bestHops[1]
            if firstEdge.Mode == "TOUCH" and (myPos - firstEdge.EntryPos).Magnitude <= 24 then
                local awayDir = (myPos - firstEdge.EntryPos)
                awayDir = Vector3.new(awayDir.X, 0, awayDir.Z)
                if awayDir.Magnitude < 0.1 then
                    awayDir = Vector3.new(1, 0, 0)
                else
                    awayDir = awayDir.Unit
                end
                state.StepOutGoal = firstEdge.EntryPos + awayDir * 28
                self.Phase = "STEP_OUT"
                self.LastReason = "stepping-out-of-portal-lock"
            else
                self.Phase = "APPROACH"
                self.LastReason = "approaching-" .. firstEdge.Id
            end
        end

        if self.Phase == "CLEAR_EXIT" then
            local goal = state.ClearExitGoal or targetPos
            local offset = goal - myPos
            if offset.Magnitude <= 3.0 or (now - state.PhaseStartedAt) >= 0.35 then
                self:Reset("completed")
                return false
            end
            local stepDist = math.min(offset.Magnitude, 220 * math.clamp(tonumber(dt) or 0.016, 0, 0.033))
            local nextPos = myPos + offset.Unit * stepDist
            freezeRoot(root, Hunter.Kinematics:LookAt(nextPos, targetPos, root.CFrame))
            return true
        end

        local curEdge = state.Hops and state.Hops[state.HopIndex]
        if not curEdge then
            self:Reset("no-edge")
            return false
        end

        ensureIslandLodActive(curEdge.IslandFolder)
        ensureIslandLodActive("Boat Castle")
        if state.Hops[state.HopIndex + 1] then
            ensureIslandLodActive(state.Hops[state.HopIndex + 1].IslandFolder)
        end
        if state.StreamRequestedHop ~= state.HopIndex then
            state.StreamRequestedHop = state.HopIndex
            local entryP, exitP = curEdge.EntryPos, curEdge.ExitPos
            task.spawn(function()
                pcall(function() LocalPlayer:RequestStreamAroundAsync(entryP, 5) end)
                pcall(function() LocalPlayer:RequestStreamAroundAsync(exitP, 5) end)
            end)
        end

        if humanoid.Sit then humanoid.Sit = false end

        if self.Phase == "STEP_OUT" then
            local goal = state.StepOutGoal or (curEdge.EntryPos + Vector3.new(28, 0, 0))
            local offset = goal - myPos
            if offset.Magnitude <= 2.5 or (now - state.PhaseStartedAt) >= 0.45 then
                self.Phase = "APPROACH"
                state.PhaseStartedAt = now
                self.LastReason = "approaching-" .. curEdge.Id
            else
                local stepDist = math.min(offset.Magnitude, 220 * math.clamp(tonumber(dt) or 0.016, 0, 0.033))
                local nextPos = myPos + offset.Unit * stepDist
                freezeRoot(root, Hunter.Kinematics:LookAt(nextPos, curEdge.EntryPos, root.CFrame))
                return true
            end
        end

        if self.Phase == "APPROACH" then
            local _, hb = findTeleporterInstances(curEdge)
            local goalPos = (hb and hb.Position) or curEdge.EntryPos
            local offset = goalPos - myPos
            if offset.Magnitude <= 14.0 then
                if unlockSkillState then unlockSkillState() end
                freezeRoot(root, CFrame.new(goalPos) * (root.CFrame - myPos))
                self.Phase = "TELEPORT"
                state.PhaseStartedAt = now
                state.LastTriggerAt = 0
                self.LastReason = "teleporting-" .. curEdge.Id
                return true
            end
            local stepDist = math.min(offset.Magnitude, 220 * math.clamp(tonumber(dt) or 0.016, 0, 0.033))
            local nextPos = myPos + offset.Unit * stepDist
            if nextPos.Y > -140 and nextPos.Y < 5.5 then
                nextPos = Vector3.new(nextPos.X, 5.5, nextPos.Z)
            end
            local nextCF = Hunter.Kinematics:LookAt(nextPos, goalPos, root.CFrame)
            if Hunter.AntiLava then
                nextCF = Hunter.AntiLava:FilterMove(root, humanoid, nextCF)
            end
            freezeRoot(root, nextCF)
            return true
        end

        if self.Phase == "TELEPORT" then
            local distToExit = (myPos - curEdge.ExitPos).Magnitude
            local distFromEntry = (myPos - curEdge.EntryPos).Magnitude
            if distToExit <= 280 or (distFromEntry >= 1500 and (now - state.PhaseStartedAt) > 0.08) then
                if state.HopIndex < #state.Hops then
                    state.HopIndex = state.HopIndex + 1
                    self.Phase = "APPROACH"
                    state.PhaseStartedAt = now
                    state.LastTriggerAt = 0
                    self.LastReason = "approaching-" .. state.Hops[state.HopIndex].Id
                    return true
                else
                    local toTarget = targetPos - myPos
                    local flat = Vector3.new(toTarget.X, 0, toTarget.Z)
                    if flat.Magnitude < 0.1 then
                        flat = Vector3.new(1, 0, 0)
                    else
                        flat = flat.Unit
                    end
                    state.ClearExitGoal = myPos + flat * 26 + Vector3.new(0, 4, 0)
                    self.Phase = "CLEAR_EXIT"
                    state.PhaseStartedAt = now
                    self.LastReason = "clearing-exit-portal"
                    return true
                end
            end

            if (now - state.PhaseStartedAt) > 5.0 then
                state.CooldownUntil = now + 8.0
                self:Reset("teleport-timeout")
                return false
            end

            local tpModel, hb = findTeleporterInstances(curEdge)
            local holdPos = (hb and hb.Position) or curEdge.EntryPos
            local yJitter = ((math.floor(now * 20) % 2) == 0) and 0.4 or -0.4
            freezeRoot(root, CFrame.new(holdPos + Vector3.new(0, yJitter, 0)) * (root.CFrame - myPos))

            if hb and (now - state.LastTriggerAt) >= 0.25 then
                state.LastTriggerAt = now
                if unlockSkillState then unlockSkillState() end
                if type(firetouchinterest) == "function" then
                    pcall(firetouchinterest, root, hb, 0)
                    pcall(firetouchinterest, root, hb, 1)
                end
                if curEdge.Mode == "BOAT_CASTLE_RF" and tpModel then
                    local rf = getBoatCastleRemote()
                    local exitCF = curEdge.ExitCFrame
                    if rf then
                        task.spawn(function()
                            local okI, resI = pcall(function()
                                return rf:InvokeServer("InitiateTeleport", tpModel)
                            end)
                            if okI and resI and root and root.Parent then
                                root.CFrame = exitCF
                            end
                        end)
                    end
                end
            end
            return true
        end

        return false
    end

    function api:Destroy()
        self.Destroyed = true
        self:Reset("destroyed")
        for _, c in ipairs(connections) do
            pcall(function() c:Disconnect() end)
        end
        table.clear(connections)
    end

    table.insert(connections, LocalPlayer.CharacterRemoving:Connect(function()
        api:Reset("character-removing")
    end))

    pcall(function()
        local netMod = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
        if netMod then
            local Net = require(netMod)
            local refreshRE = Net:RemoteEvent("BoatCastleTeleportersRefresh")
            if refreshRE then
                table.insert(connections, refreshRE.OnClientEvent:Connect(function()
                    refreshUnlocksAsync(true)
                end))
            end
        end
    end)

    if isSea3() then
        refreshUnlocksAsync(true)
    end

    return api
end)()

local _hasTriggeredLowHealthHop = false

local LOW_HP_ESCAPE_CFG = {
    TriggerHealth = 4000,
    InitialHeightOffset = 450,
    TweenSpeed = 220,
    TweenChunkHeight = 3000,
    StartTweenDelay = 0.12,
}

local _lowHpEscapeSerial = 0
local _lowHpEscapeRoot = nil
local _lowHpCurrentTween = nil

local function releaseLowHealthEscape(reason)
    if not Hunter._isHealingInSky and not _hasTriggeredLowHealthHop then
        return
    end
    _lowHpEscapeSerial += 1
    Hunter._isHealingInSky = false
    if reason ~= "hopping server" then
        _hasTriggeredLowHealthHop = false
    end
    _lowHpEscapeRoot = nil
    if _lowHpCurrentTween then
        pcall(function()
            _lowHpCurrentTween:Cancel()
            _lowHpCurrentTween:Destroy()
        end)
        _lowHpCurrentTween = nil
    end
end

local function handleLowHealthEscape(root, hum)
    if _hasTriggeredLowHealthHop or Hunter._isHealingInSky or isHopping or isLocalPlayerInPortalDimension() then
        return false
    end
    local _, liveHum, liveRoot = getCharacter()
    hum = hum or liveHum
    root = root or liveRoot
    if not hum or hum.Health <= 0 or not root then
        return false
    end

    if Hunter.GhostShipRoute:RequestExit("LOW_HEALTH") or Hunter.GhostShipRoute:DeferLowHealth() then return true end
    if Hunter.GhostShipRoute.Busy then Hunter.GhostShipRoute:Reset("sky-retreat") end
    _hasTriggeredLowHealthHop = true
    Hunter._isHealingInSky = true
    Hunter.Kinematics:Reset()

    pcall(function()
        Hunter.TargetPlayer = nil
        Hunter.TargetCharacter = nil
        Hunter.TargetPart = nil
        _currentCombatTarget = nil
        _hasEngagedInCombat = false
        setHover(false)
    end)

    local currentCFrame = root.CFrame
    local currentPosition = currentCFrame.Position
    local rotationOnly = currentCFrame - currentPosition
    local initialY = currentPosition.Y + LOW_HP_ESCAPE_CFG.InitialHeightOffset

    _lowHpEscapeSerial += 1
    local mySerial = _lowHpEscapeSerial
    _lowHpEscapeRoot = root

    root.CFrame = CFrame.new(currentPosition.X, initialY, currentPosition.Z) * rotationOnly
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    showBottomRightNotify("Safety Retreat", "HP <= 4000 - Sky Retreat", Color3.fromRGB(255, 85, 85), "Action", "Climbing +450Y to hop server")

    local function stillValid()
        return Hunter._isRunning
            and Hunter._isHealingInSky
            and not isHopping
            and mySerial == _lowHpEscapeSerial
            and root == _lowHpEscapeRoot
            and root.Parent ~= nil
            and hum.Health > 0
    end

    task.spawn(function()
        task.wait(LOW_HP_ESCAPE_CFG.StartTweenDelay)

        while stillValid() do
            local startCFrame = root.CFrame
            local startPosition = startCFrame.Position
            local currentRotation = startCFrame - startPosition
            local goalCFrame = CFrame.new(
                startPosition.X,
                startPosition.Y + LOW_HP_ESCAPE_CFG.TweenChunkHeight,
                startPosition.Z
            ) * currentRotation
            local duration = LOW_HP_ESCAPE_CFG.TweenChunkHeight / math.max(LOW_HP_ESCAPE_CFG.TweenSpeed, 1)

            local tween = TweenService:Create(
                root,
                TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
                {CFrame = goalCFrame}
            )
            _lowHpCurrentTween = tween
            tween:Play()
            local playbackState = tween.Completed:Wait()

            if _lowHpCurrentTween == tween then
                _lowHpCurrentTween = nil
            end
            pcall(function()
                tween:Destroy()
            end)

            if playbackState ~= Enum.PlaybackState.Completed then
                return
            end
        end
    end)

    task.spawn(function()
        pcall(function()
            while stillValid() and isBountyAtRisk() do
                showBottomRightNotify("Bounty At Risk", "HP <= 4000 - Sky Retreat", Color3.fromRGB(255, 175, 0), "Action", "Waiting for combat tag to clear...")
                task.wait(0.3)
            end

            if stillValid() then
                showBottomRightNotify("Hop Status", "Low HP - Changing Server", Color3.fromRGB(255, 175, 0), "Detail", "Hopping server immediately from sky...")
                releaseLowHealthEscape("hopping server")
                if type(autoHopServer) == "function" then
                    autoHopServer("LowHealthRetreat")
                end
            end
        end)
    end)

    return true
end

