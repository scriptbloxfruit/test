    if Hunter.SkillDodge and Hunter.SkillDodge:IsEnemySkillDodging() then return false end
    if Hunter.IsActionLocked and Hunter.IsActionLocked(LocalPlayer.Character) then return false end
    unlockSkillState()
    local isGodhumanSkill = (weaponName == "Melee" and (keyName == "Z" or keyName == "C"))
    local spamCount = math.clamp(math.floor(tonumber(count) or 2), 1, 3)
    local spamInterval = math.max(tonumber(countInterval) or 0.035, 0.035)
    local keyHold = math.max(tonumber(holdDuration) or 0, 0.04)
    local casted = false
    local keyIsDown = false
    local maxCastDist = tonumber(customMaxDist) or math.max(Hunter.GunM1:GetComboDistance() + 25, 45)
    local castSerial = Hunter.Kinematics:BeginCast(weaponName, keyName, targetPlayer,
        spamCount * (keyHold + spamInterval) + 0.65)
    isSkillHolding = true

    local cooldownAttribute = tostring(keyName) .. tostring((castTool and castTool.ToolTip) or ""):gsub(" ", "") .. "CooldownClient"
    local stampBefore = LocalPlayer.Character and LocalPlayer.Character:GetAttribute(cooldownAttribute)

    local ok, castError = xpcall(function()
        _lastCombatAttackTime = tick()
        if _currentCombatTarget == targetPlayer then
            _hasEngagedInCombat = true
        end
        for i = 1, spamCount do
            if Hunter.IsRaceV4Ready and Hunter.IsRaceV4Ready() then
                Hunter.TryActivateRaceV4(false)
            end
            if not Hunter._isRunning or isHopping or _isPortalWarping or Hunter._isHealingInSky or Hunter._isGhostShipRouting
                or (Hunter.SkillDodge and Hunter.SkillDodge:IsEnemySkillDodging())
                or Hunter.TargetPlayer ~= targetPlayer
                or not Hunter.Kinematics:IsCastCurrent(castSerial, targetPlayer)
                or not isAlive(Hunter.TargetCharacter) then break end
            if i > 1 then
                local preCheck = Hunter.ReadSkillState(castTool, keyName)
                local stampMid = LocalPlayer.Character and LocalPlayer.Character:GetAttribute(cooldownAttribute)
                if (preCheck and (preCheck.CooldownReady == false or preCheck.EstimatedCooldownReady == false))
                    or (stampMid ~= nil and stampMid ~= stampBefore)
                    or (Hunter.StunCheck and Hunter.StunCheck.IsInGodhumanZ(LocalPlayer.Character)) then
                    casted = true
                    break
                end
            end
            if Hunter.IsActionLocked and Hunter.IsActionLocked(LocalPlayer.Character) then
                break
            end
            part = Hunter.TargetPart
            if not part or not part.Parent then break end

            pcall(function()
                local predPos = getPredictedPos(part)
                Hunter.PredictedPos = predPos
                local _, _, root = getCharacter()
                if root then
                    local flatTarget = Vector3.new(predPos.X, root.Position.Y, predPos.Z)
                    root.CFrame = CFrame.new(root.Position, flatTarget)
                end
                local char = LocalPlayer.Character
                if char then
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then
                        local mp = tool:FindFirstChild("MousePos")
                        if mp then mp.Value = predPos end
                    end
                end
            end)

            local _, _, castRoot = getCharacter()
            if not castRoot or (part.Position - castRoot.Position).Magnitude > maxCastDist then break end
            if castTool.Parent ~= LocalPlayer.Character then break end
            if Hunter._isGhostShipRouting then break end
            if Hunter.IsActionLocked and Hunter.IsActionLocked(LocalPlayer.Character) then break end
            Hunter._skillHeldKey = nil
            unlockSkillState()
            Hunter._skillHeldKey = key
            local pressed = pcall(function()
                VirtualInputManager:SendKeyEvent(true, key, false, game)
            end)
            if pressed then
                keyIsDown = true
                task.wait(keyHold)
            end
            pcall(function()
                VirtualInputManager:SendKeyEvent(false, key, false, game)
            end)
            keyIsDown = false
            if pressed then
                task.wait(0.025)
            end
            Hunter._skillHeldKey = nil
            if pressed then
                local accepted = false
                local lastCheck = nil
                local acknowledgementDeadline = os.clock() + 0.09
                repeat
                    if castTool.Parent ~= LocalPlayer.Character or Hunter.TargetPlayer ~= targetPlayer then break end
                    if Hunter.StunCheck and Hunter.StunCheck.IsInGodhumanZ(LocalPlayer.Character) then
                        accepted = true
                        break
                    end
                    local curChar = LocalPlayer.Character
                    lastCheck = Hunter.ReadSkillState(castTool, keyName)
                    local stampNow = curChar and curChar:GetAttribute(cooldownAttribute)
                    if (lastCheck and (lastCheck.CooldownReady == false or lastCheck.EstimatedCooldownReady == false))
                        or (stampNow ~= nil and stampNow ~= stampBefore) then
                        accepted = true
                        break
                    end
                    if os.clock() >= acknowledgementDeadline then break end
                    task.wait(0.015)
                until false
                if accepted then
                    casted = true
                    if isGodhumanSkill then
                        Hunter._godhumanLockUntil = os.clock() + (keyName == "Z" and 0.45 or 0.35)
                    end
                    Hunter._lastSkillCast = {Tool = castTool.Name, Key = keyName, At = os.clock()}
                    Hunter._lastSkillRejection = nil
                    break
                end
            end
            if i < spamCount then
                task.wait(spamInterval)
            end
        end
    end, function(err)
        return tostring(err) .. "\n" .. debug.traceback()
    end)

    if keyIsDown then
        pcall(function()
            VirtualInputManager:SendKeyEvent(false, key, false, game)
        end)
    end
    isSkillHolding = false
    Hunter._skillHeldKey = nil
    Hunter.Kinematics:EndCast(castSerial)
    if casted and castTool then
        Hunter._localSkillCooldownUntil = Hunter._localSkillCooldownUntil or {}
        Hunter._localSkillCooldownUntil[tostring(castTool.Name) .. "_" .. tostring(keyName)] = os.clock() + 1.50
        Hunter._lastSkillCast = {Tool = castTool.Name, Key = keyName, At = os.clock()}
        if isGodhumanSkill then
            Hunter._godhumanLockUntil = math.max(Hunter._godhumanLockUntil or 0, os.clock() + (keyName == "Z" and 0.45 or 0.35))
            task.wait(0.06)
            waitUntilSkillAnimationDone(keyName == "Z" and 1.65 or 1.15)
        end
    end
    unlockSkillState()
    if not ok then
        Hunter._skillCastError = tostring(castError)
        if os.clock() - (Hunter._lastSkillErrorLog or -math.huge) >= 3 then
            Hunter._lastSkillErrorLog = os.clock()
        end
    else
        Hunter._skillCastError = nil
    end
    return ok and casted
end
