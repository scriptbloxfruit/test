    for part in pairs(tracked) do
        if part.Parent and part:IsDescendantOf(Workspace) then
            table.insert(hazardList, part)
            local pPos = part.Position
            local pSz = part.Size
            local halfY = pSz.Y * 0.5
            local bottomY = pPos.Y - halfY
            local topY = pPos.Y + halfY
            if bottomY < minLavaY then minLavaY = bottomY end
            if topY > maxLavaY then maxLavaY = topY end
            local radius = pSz.Magnitude * 0.5
            table.insert(lavaBounds, {
