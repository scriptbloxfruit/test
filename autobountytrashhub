--[[
    ============================================================================
    KenCheckModule.lua (Standalone Reusable Module)
    Chức năng:
      - Kiểm tra trạng thái Haki Quan Sát (Observation Haki / Ken Haki) của bất kỳ Target nào
        (hoặc của chính LocalPlayer).
      - Đọc trực tiếp từ Server-Replicated Attributes trên `Player` & `Character`:
          + `Player:GetAttribute("KenActive")`      : Đang bật (true) hay tắt (false)
          + `Player:GetAttribute("KenDodgesLeft")`  : Số lần né còn lại (VD: 10, 8, 6.5, 0)
          + `Player:GetAttribute("KenMaxDodges")`   : Số lần né tối đa (VD: 8, 10, 11)
          + `Player:GetAttribute("LastKenDodge")`   : Timestamp server lần né gần nhất
          + `Character:FindFirstChild("KenDisabled")`: Đang bị Phá Ken (khóa 5 giây)
          + `CollectionService:HasTag(Character, "Ken" / "KenUpgrade")`: Sở hữu V1 / V2
      - Tự động quản lý lifecycle, dọn dẹp kết nối (Zero Memory Leak).
    ============================================================================
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")

local KenCheckModule = {}
KenCheckModule.__index = KenCheckModule

local _connections = {}
local _watchers = {}
local _destroyed = false
local _dodgeListeners = {} -- Danh sách callback khi phát hiện Target vừa né đòn bằng Ken

-- Helper: Chuyển đổi đầu vào (Player hoặc Character Model) thành (Player?, Model?)
local function resolveTarget(target)
    if typeof(target) ~= "Instance" then
        return nil, nil
    end
    if target:IsA("Player") then
        return target, target.Character
    elseif target:IsA("Model") then
        return Players:GetPlayerFromCharacter(target), target
    elseif target:IsA("BasePart") or target:IsA("Humanoid") then
        local model = target:FindFirstAncestorOfClass("Model")
        if model then
            return Players:GetPlayerFromCharacter(model), model
        end
    end
    return nil, nil
end

-- ============================================================================
-- 1. CÁC HÀM KIỂM TRA CỐT LÕI (CORE CHECK API)
-- ============================================================================

--[[
    Kiểm tra Target có đang BẬT Haki Quan Sát hay không (`KenActive == true`).
]]
function KenCheckModule.IsKenActive(target): boolean
    local player = resolveTarget(target)
    if not player then
        return false
    end
    return player:GetAttribute("KenActive") == true
end

--[[
    Lấy số lần né (Dodges) CÒN LẠI của Target (`KenDodgesLeft`).
    Lưu ý: Có thể là số thập phân (VD: 6.5) vì một số đòn chỉ trừ 0.5 lượt né.
]]
function KenCheckModule.GetDodgesLeft(target): number
    local player = resolveTarget(target)
    if not player then
        return 0
    end
    local dodges = tonumber(player:GetAttribute("KenDodgesLeft"))
    if dodges then
        return math.max(0, dodges)
    end
    return 0
end

--[[
    Lấy tổng số lần né TỐI ĐA của Target (`KenMaxDodges`).
]]
function KenCheckModule.GetMaxDodges(target): number
    local player = resolveTarget(target)
    if not player then
        return 0
    end
    return tonumber(player:GetAttribute("KenMaxDodges")) or 0
end

--[[
    Kiểm tra Target có đang bị PHÁ KEN (`KenDisabled` trong Character - kéo dài 5s) hay không.
]]
function KenCheckModule.IsKenDisabled(target): boolean
    local _, char = resolveTarget(target)
    if not char then
        return false
    end
    return char:FindFirstChild("KenDisabled") ~= nil
end

--[[
    Kiểm tra thực tế Target CÓ THỂ NÉ ĐÒN BẰNG KEN ngay lúc này hay không.
    Trả về `true` KHI VÀ CHỈ KHI:
      1. Đang bật Ken (`KenActive == true`)
      2. KHÔNG bị Phá Ken (`KenDisabled == nil`)
      3. Số lần né còn lại `>= minDodgeCost` (mặc định `0.5`)
]]
function KenCheckModule.CanDodge(target, minDodgeCost: number?): boolean
    local player, char = resolveTarget(target)
    if not player or not char then
        return false
    end
    if player:GetAttribute("KenActive") ~= true then
        return false
    end
    if char:FindFirstChild("KenDisabled") ~= nil then
        return false
    end
    local dodgesLeft = tonumber(player:GetAttribute("KenDodgesLeft")) or 0
    local threshold = minDodgeCost or 0.5
    return dodgesLeft >= threshold
end

--[[
    Kiểm tra có nên ưu tiên dùng chiêu PHÁ KEN (Ken-Break) hay không.
    - Nếu `ShouldUseKenBreak(target) == true`: Target đang bật Ken và còn lượt né -> Chỉ nên tung chiêu Phá Ken hoặc bait Ken.
    - Nếu `ShouldUseKenBreak(target) == false`: Target đang tắt Ken, hoặc đã hết lượt né (`DodgesLeft == 0`), hoặc đang bị `KenDisabled` -> Xả thẳng mọi chiêu!
]]
function KenCheckModule.ShouldUseKenBreak(target): boolean
    return KenCheckModule.CanDodge(target, 0.5)
end

--[[
    Kiểm tra xem Target có VỪA MỚI NÉ ĐÒN bằng Ken trong khoảng `windowSeconds` (mặc định 0.45s) vừa qua hay không.
    Rất hữu ích để phát hiện đòn đánh của bạn vừa bị đối phương bật Ken né.
]]
function KenCheckModule.DidJustDodge(target, windowSeconds: number?): boolean
    local player = resolveTarget(target)
    if not player then
        return false
    end
    local lastDodge = tonumber(player:GetAttribute("LastKenDodge"))
    if not lastDodge or lastDodge <= 0 then
        return false
    end
    local elapsed = workspace:GetServerTimeNow() - lastDodge
    return elapsed >= 0 and elapsed <= (windowSeconds or 0.45)
end

--[[
    Kiểm tra Target sở hữu Haki Quan Sát V1 (`"Ken"`) và V2 (`"KenUpgrade"`).
]]
function KenCheckModule.GetKenTier(target): (boolean, boolean, number)
    local _, char = resolveTarget(target)
    if not char then
        return false, false, 0
    end
    local hasV1 = CollectionService:HasTag(char, "Ken")
    local hasV2 = CollectionService:HasTag(char, "KenUpgrade")
    local tier = hasV2 and 2 or (hasV1 and 1 or 0)
    return hasV1, hasV2, tier
end

--[[
    Lấy toàn bộ thông tin Haki Quan Sát của Target trong 1 bảng duy nhất.
]]
function KenCheckModule.GetStatus(target)
    local player, char = resolveTarget(target)
    if not player then
        return {
            Valid = false,
            Active = false,
            DodgesLeft = 0,
            MaxDodges = 0,
            KenDisabled = false,
            CanDodge = false,
            ShouldKenBreak = false,
            JustDodged = false,
            Tier = 0,
            HasV1 = false,
            HasV2 = false,
            LastDodgeTime = 0,
            TimeSinceLastDodge = math.huge,
        }
    end

    local active = player:GetAttribute("KenActive") == true
    local dodgesLeft = math.max(0, tonumber(player:GetAttribute("KenDodgesLeft")) or 0)
    local maxDodges = tonumber(player:GetAttribute("KenMaxDodges")) or 0
    local kenDisabled = (char and char:FindFirstChild("KenDisabled") ~= nil) or false
    local canDodge = active and (not kenDisabled) and (dodgesLeft >= 0.5)
    local lastDodge = tonumber(player:GetAttribute("LastKenDodge")) or 0
    local timeSince = (lastDodge > 0) and math.max(0, workspace:GetServerTimeNow() - lastDodge) or math.huge
    local hasV1, hasV2, tier = KenCheckModule.GetKenTier(char)

    return {
        Valid = true,
        Player = player,
        Character = char,
        Active = active,
        DodgesLeft = dodgesLeft,
        MaxDodges = maxDodges,
        KenDisabled = kenDisabled,
        CanDodge = canDodge,
        ShouldKenBreak = canDodge,
        JustDodged = timeSince <= 0.45,
        Tier = tier,
        HasV1 = hasV1,
        HasV2 = hasV2,
        LastDodgeTime = lastDodge,
        TimeSinceLastDodge = timeSince,
    }
end

-- ============================================================================
-- 2. LẮNG NGHE SỰ KIỆN REAL-TIME (EVENT WATCHER CHO TARGET)
-- ============================================================================

--[[
    Đăng ký lắng nghe sự thay đổi Ken của một Target cụ thể (Bật/Tắt Ken, mất lượt né, bị phá Ken).
    Trả về hàm `unwatch()` để hủy theo dõi bất cứ lúc nào.
    Ví dụ:
      local stopWatch = KenCheckModule.WatchTarget(targetPlayer, function(status, eventType)
          print(eventType, status.Active, status.DodgesLeft)
      end)
]]
function KenCheckModule.WatchTarget(target, callback: (any, string) -> ())
    local player = resolveTarget(target)
    if _destroyed or not player or type(callback) ~= "function" then
        return function() end
    end

    local watchConns = {}
    local charConns = {}
    local stopped = false
    local watchedChar = nil
    local function cleanupConnections(list)
        for _, conn in ipairs(list) do
            pcall(function() conn:Disconnect() end)
            local index = table.find(_connections, conn)
            if index then table.remove(_connections, index) end
        end
        table.clear(list)
    end
    local disconnectAll
    disconnectAll = function()
        if stopped then return end
        stopped = true
        watchedChar = nil
        cleanupConnections(charConns)
        cleanupConnections(watchConns)
        _watchers[disconnectAll] = nil
    end
    local function track(conn, list)
        table.insert(list, conn)
        table.insert(_connections, conn)
    end
    local function fire(eventType)
        if not stopped and not _destroyed then
            callback(KenCheckModule.GetStatus(player), eventType)
        end
    end
    local function hookChar(char)
        cleanupConnections(charConns)
        watchedChar = char
        if stopped or _destroyed or not char then return end
        track(char.ChildAdded:Connect(function(child)
            if watchedChar == char and player.Character == char and child.Name == "KenDisabled" then
                fire("KenBroken")
            end
        end), charConns)
        track(char.ChildRemoved:Connect(function(child)
            if watchedChar == char and player.Character == char and child.Name == "KenDisabled" then
                fire("KenBreakRecovered")
            end
        end), charConns)
    end

    _watchers[disconnectAll] = true
    track(player:GetAttributeChangedSignal("KenActive"):Connect(function() fire("KenActiveChanged") end), watchConns)
    track(player:GetAttributeChangedSignal("KenDodgesLeft"):Connect(function() fire("DodgesLeftChanged") end), watchConns)
    track(player:GetAttributeChangedSignal("LastKenDodge"):Connect(function() fire("TargetDodged") end), watchConns)
    track(player.CharacterAdded:Connect(hookChar), watchConns)
    track(player.CharacterRemoving:Connect(function(char)
        if watchedChar == char then
            watchedChar = nil
            cleanupConnections(charConns)
        end
    end), watchConns)
    track(Players.PlayerRemoving:Connect(function(leaving)
        if leaving == player then disconnectAll() end
    end), watchConns)
    if player.Character then hookChar(player.Character) end
    return disconnectAll
end

function KenCheckModule.Destroy()
    if _destroyed then return end
    _destroyed = true
    while next(_watchers) do
        local stop = next(_watchers)
        stop()
    end
    table.clear(_connections)
    table.clear(_dodgeListeners)
    if ENV._TrashHub_KenCheck == KenCheckModule then ENV._TrashHub_KenCheck = nil end
    if ENV.KenCheckModule == KenCheckModule then ENV.KenCheckModule = nil end
end

ENV._TrashHub_KenCheck = KenCheckModule
ENV.KenCheckModule = KenCheckModule
return KenCheckModule
end)()

