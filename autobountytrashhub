local function performM1Attack(selectedTool)
    if Hunter.LowHealthEscape and Hunter.LowHealthEscape.Check() then return false end
    if Hunter._isGhostShipRouting then return false end
    if Hunter.ArenaCheck and Hunter.ArenaCheck.ShouldSkip(Hunter.TargetPlayer) then return false end
    if Hunter.IsActionLocked and Hunter.IsActionLocked(LocalPlayer.Character) then return false end
    local equipped = selectedTool or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool"))
    if equipped and (equipped.ToolTip == "Gun" or equipped:GetAttribute("WeaponType") == "Gun") then
        return Hunter.GunM1:TryFire(equipped)
    end
    local attacked = false
    local ok = pcall(function()
        local targetPlayer = Hunter.TargetPlayer
        local targetChar = Hunter.TargetCharacter
        local targetPart = Hunter.TargetPart
        if not targetPlayer or not targetChar or not targetPart or not targetPart.Parent
            or not isAlive(targetChar)
        then
            return
        end

        local char = LocalPlayer.Character
        if not char then return end
        if Hunter.IsActionLocked and Hunter.IsActionLocked(char) then return end
        local tool = selectedTool or char:FindFirstChildOfClass("Tool")
        if not tool or tool.Parent ~= char then return end

        if targetPlayer ~= Hunter.TargetPlayer or targetChar ~= Hunter.TargetCharacter then
            return
        end

        if CombatController and type(CombatController.Attack) == "function" then
            attacked = pcall(function()
                CombatController:Attack(tool)
            end)
        end
        if not attacked then
            if Hunter.LowHealthEscape and Hunter.LowHealthEscape.Check() then return end
            local cooldown = 0
            pcall(function()
                local value = tool:FindFirstChild("Cooldown")
                cooldown = value and tonumber(value.Value) or 0
            end)
            local hits = {{targetChar, targetPart}}
            if type(SendHitsToServer) == "function" then
                if RegisterAttack then RegisterAttack:FireServer(cooldown) end
                SendHitsToServer(targetPart, hits)
                attacked = true
            elseif RegisterHit then
                if RegisterAttack then RegisterAttack:FireServer(cooldown) end
                RegisterHit:FireServer(targetPart, hits)
                attacked = true
            else
                tool:Activate()
                attacked = true
            end
        end
        if not attacked and VirtualInputManager
            and type(VirtualInputManager.SendMouseButtonEvent) == "function"
        then
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
            task.wait(0.008)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            attacked = true
        end
    end)
    return ok and attacked
end
local function castSkillTap(key, holdDuration, count, countInterval, weaponName, keyName, expectedTool, customMaxDist)
