    end
    local function limit(vector, maximum)
        local magnitude = vector.Magnitude
        if not finite(magnitude) then return Vector3.zero end
        maximum = math.max(maximum, 0)
        if magnitude > maximum and magnitude > 0 then
            return vector * (maximum / magnitude)
        end
        return vector
    end
    local function emaAlpha(delta, tau)
        return 1 - math.exp(-math.max(delta, 0) / math.max(tau, 0.001))
    end
    local function disconnect(list)
