Hunter.SkillCheck = (function()

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
assert(player, "SkillCheck must run in the game client")
local API = {Version = "2.0"}
local keys = {"Z", "X", "C", "V", "F"}
local cache = setmetatable({}, {__mode = "k"})
local loaded = {}
local loadedAt = -math.huge
local reader = getupvalues or (debug and debug.getupvalues)

local function numeric(value)
    if type(value) == "number" and value == value and math.abs(value) < math.huge then return value end
end

local function upvalues(fn)
    if type(fn) ~= "function" or type(reader) ~= "function" then return nil end
    local ok, values = pcall(reader, fn)
    if ok and type(values) == "table" then return values end
end

local function readLoaded(module)
    if not module or not module:IsA("ModuleScript") then return nil end
    if os.clock() - loadedAt >= 0.5 then
        loaded, loadedAt = {}, os.clock()
        if type(getloadedmodules) == "function" then
            local ok, list = pcall(getloadedmodules)
            if ok and type(list) == "table" then
                for _, item in pairs(list) do
                    if typeof(item) == "Instance" then loaded[item] = true end
                end
            end
        end
    end
    if not loaded[module] then return nil end
    local ok, data = pcall(require, module)
    if ok and type(data) == "table" then return data end
end

local function resolveTool(value)
    local char = player.Character
    local backpack = player:FindFirstChildOfClass("Backpack")
    if value == nil then return char and char:FindFirstChildOfClass("Tool") end
    if typeof(value) == "Instance" and value:IsA("Tool") then
        if value.Parent == char or (backpack and value.Parent == backpack) then return value end
    elseif type(value) == "string" then
        local found = (char and char:FindFirstChild(value)) or (backpack and backpack:FindFirstChild(value))
        if found and found:IsA("Tool") then return found end
        local category = value == "Fruit" and "Blox Fruit" or value
        for _, container in pairs({char, backpack}) do
            for _, tool in ipairs(container:GetChildren()) do
                if tool:IsA("Tool") and tool.ToolTip == category then return tool end
            end
        end
    end
end

local function isData(value)
    return type(value) == "table" and type(rawget(value, "Lvl")) == "table"
        and type(rawget(value, "Cost")) == "table" and type(rawget(value, "Cooldown")) == "table"
end

local function isSkillTable(value)
    if type(value) ~= "table" then return false end
    for _, key in ipairs(keys) do
        local entry = rawget(value, Enum.KeyCode[key])
        if type(entry) == "table" and type(rawget(entry, 1)) == "function"
            and type(rawget(entry, 2)) == "boolean" then return true end
    end
    return false
end

local getData

local function inspectCallback(fn, tool)
    local values = upvalues(fn)
    if not values then return nil end
    local matchedTool, matchedChar, otherToolFound, flags, data, ambiguous = false, false, false, nil, nil, false
    for _, value in pairs(values) do
        if value == tool then
            matchedTool = true
        elseif typeof(value) == "Instance" and value:IsA("Tool") then
            otherToolFound = true
        end
        if value == player.Character then matchedChar = true end
        if isData(value) then data = value end
        if isSkillTable(value) then
            if flags and flags ~= value then ambiguous = true end
            flags = value
        end
    end
    if flags and type(rawget(flags, "setCooldown")) == "function" then
        for _, value in pairs(upvalues(rawget(flags, "setCooldown")) or {}) do
            if value == tool then
                matchedTool = true
            elseif typeof(value) == "Instance" and value:IsA("Tool") then
                otherToolFound = true
            end
            if value == player.Character then matchedChar = true end
            if isData(value) then data = value end
        end
    end
    if not matchedTool and data and getData then
        local expectedData = getData(tool, nil)
        if expectedData and expectedData ~= data then
            otherToolFound = true
        end
    end
    if not ambiguous and flags and not otherToolFound and (matchedTool or (matchedChar and tool.Parent == player.Character)) then
        return {Flags = flags, Data = data}
    end
end

local function getRuntime(tool)
    local remote = tool:FindFirstChild("RemoteEvent")
    if type(getconnections) == "function" and remote and remote:IsA("RemoteEvent") then
        local ok, connections = pcall(getconnections, remote.OnClientEvent)
        if ok and type(connections) == "table" then
            local found, ambiguous
            for _, connection in pairs(connections) do
                local readable, fn = pcall(function() return connection.Function end)
                local statusOK, connected = pcall(function() return connection.Connected end)
                if readable and (not statusOK or connected ~= false) then
                    local state = inspectCallback(fn, tool)
                    if state then
                        if found and found.Flags ~= state.Flags then ambiguous = true end
                        found = state
                    end
                end
            end
            if found and not ambiguous then found.Source = "ToolCallback"; return found end
        end
    end
    if tool.Parent == player.Character then
        local globalMod = RS:FindFirstChild("Global")
        local global = readLoaded(globalMod)
        if not global and globalMod and globalMod:IsA("ModuleScript") then
            local ok, reqGlobal = pcall(require, globalMod)
            if ok and type(reqGlobal) == "table" then global = reqGlobal end
        end
        local state = global and inspectCallback(global.casFunc, tool)
        if state then state.Source = "BoundCallback"; return state end
    end
end

getData = function(tool, state)
    if state and state.Data then return state.Data end
    local gui = player:FindFirstChildOfClass("PlayerGui")
    local modules = gui and gui:FindFirstChild("MovesetModules")
    local folder = modules and modules:FindFirstChild(tool.Name)
    local uid = tool:GetAttribute("MovesetToolUid")
    if not folder or not uid or folder:GetAttribute("MovesetToolUid") ~= uid then return nil end
    local module = folder:FindFirstChild("LegacyDataAggregate")
    local item = cache[tool]
    if item and item.Module == module and item.Uid == uid then return item.Data end
    local data = readLoaded(module)
    if not isData(data) and module and module:IsA("ModuleScript") then
        local ok, reqData = pcall(require, module)
        if ok then data = reqData end
    end
    if isData(data) then
        cache[tool] = {Module = module, Uid = uid, Data = data}
        return data
    end
end

local function prune()
    local char, backpack = player.Character, player:FindFirstChildOfClass("Backpack")
    for tool in pairs(cache) do
        if tool.Parent ~= char and tool.Parent ~= backpack then cache[tool] = nil end
    end
end

local function estimate(tool, key, data)
    local char = player.Character
    if not char then return nil, nil, "MissingChar" end
    if key == "V" then return nil, nil, "VRequiresRuntime" end
    local stamp = numeric(char:GetAttribute(key .. tostring(tool.ToolTip or ""):gsub(" ", "") .. "CooldownClient"))
    if not stamp then return true, 0, "InitialState" end
    if not data then return nil, nil, "MissingData" end
    local cooldown = data.Cooldown[key]
    local awakened = tool:FindFirstChild("AwakenedMoves")
    if awakened and awakened:FindFirstChild(key) and data.Awakening
        and ((data.Awakening.Cost and data.Awakening.Cost[key] ~= nil)
            or (data.Awakening.Cooldown and data.Awakening.Cooldown[key] ~= nil)) then
        cooldown = data.Awakening.Cooldown and data.Awakening.Cooldown[key]
    end
    if type(cooldown) == "function" then
        local ok, value = pcall(cooldown, tool)
        if not ok then return nil, nil, "DynamicCooldownUnavailable" end
        cooldown = value
    end
    cooldown = numeric(cooldown)
    if cooldown == nil then return nil, nil, "MissingCooldown" end
    local category = tool.ToolTip == "Blox Fruit" and "Fruit" or tool.ToolTip
    local reduction = (numeric(char:GetAttribute(category .. "Cooldown")) or 0)
        + (numeric(char:GetAttribute("AllCooldown")) or 0)
        + (numeric(char:GetAttribute(category .. key .. "Cooldown")) or 0)
    local scale = numeric(tool:GetAttribute("Cooldown" .. key)) or 1
    local duration = cooldown * scale * 1.5 * (1 - reduction)
    if player:GetAttribute("NSUNS") then duration = 0 end
    local remaining = math.max(0, stamp + duration - tick())
    return remaining <= 0, remaining, "TimestampEstimate"
end

function API.Check(toolOrName, key)
    prune()
    if typeof(key) == "EnumItem" then key = key.Name end
    key = type(key) == "string" and string.upper(key) or ""
