                    Size = UDim2.new(1, 0, 1, 0)
                }):Play()
            end
        end)
    end))

    table.insert(Hunter._hudConnections, resetBtn.MouseEnter:Connect(function()
        TweenService:Create(resetBtn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(255, 175, 40)}):Play()
    end))
    table.insert(Hunter._hudConnections, resetBtn.MouseLeave:Connect(function()
        TweenService:Create(resetBtn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(255, 140, 0)}):Play()
    end))
    table.insert(Hunter._hudConnections, resetBtn.MouseButton1Click:Connect(function()
        TweenService:Create(resetBtn, TweenInfo.new(0.08), {BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        task.delay(0.12, function()
            if resetBtn and resetBtn.Parent then
                TweenService:Create(resetBtn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(255, 140, 0)}):Play()
            end
        end)

        _totalActiveTime = 0
        _sessionStartTime = os.time()
        _totalKills = 0
        _serverKillsCount = 0
        _countedServerKills = {}
        if Hunter then
            Hunter.TotalKills = 0
            Hunter._lastProcessedVictim = ""
            Hunter._lastProcessedKillTime = 0
                    end
        getgenv()._TrashHubTotalKills = 0
        _earnedBounty = 0
        getgenv()._TrashHubEarnedBounty = 0

        local cur = getPlayerBounty(LocalPlayer)
        if cur and cur > 0 then
            _lastKnownBounty = cur
        end
        saveStatsToJson()

        _hudLastHours = 0
        _hudLastMins = 0
        _hudLastKills = 0
        _hudLastEarned = 0
        _hudLastBounty = (cur and cur > 0 and cur) or (_lastKnownBounty and _lastKnownBounty > 0 and _lastKnownBounty) or 0

        bountyLabel.Text = "Current Bounty: " .. formatNumber(_hudLastBounty)
        timeLabel.Text = "Time: 0h 0m"
        killLabel.Text = "Total Kill: 0"
        earnedLabel.Text = "Total Earned: +0"
        earnedLabel.TextColor3 = _COLOR_EARNED_POS

        if type(showBottomRightNotify) == "function" then
            showBottomRightNotify("Reset Stats", "Time, Kills & Earned -> 0", Color3.fromRGB(255, 140, 0), "Detail", "Stats saved to JSON")
        end
    end))

    local function _updateHudContent()
        if Hunter.CheckBountyLoss then
            Hunter.CheckBountyLoss()
        end
        local bounty = getPlayerBounty(LocalPlayer)
        if (not bounty or bounty <= 0) and _lastKnownBounty and _lastKnownBounty > 0 then
            bounty = _lastKnownBounty
        end
        local elapsed = getActiveElapsedTime()
        local hours = math.floor(elapsed / 3600)
        local mins = math.floor((elapsed % 3600) / 60)
        local earnedNow = _earnedBounty or 0

        if bounty ~= _hudLastBounty then
            bountyLabel.Text = "Current Bounty: " .. formatNumber(bounty or 0)
            _hudLastBounty = bounty
        end
        if hours ~= _hudLastHours or mins ~= _hudLastMins then
            timeLabel.Text = string.format("Time: %dh %dm", hours, mins)
            _hudLastHours = hours
            _hudLastMins = mins
        end
        local killsNow = _totalKills or 0
        if killsNow ~= _hudLastKills then
            killLabel.Text = "Total Kill: " .. tostring(killsNow)
            _hudLastKills = killsNow
        end
        if earnedNow ~= _hudLastEarned then
            earnedLabel.Text = "Total Earned: " .. (earnedNow < 0 and "" or "+") .. formatNumber(earnedNow)
            earnedLabel.TextColor3 = earnedNow < 0 and _COLOR_EARNED_NEG or _COLOR_EARNED_POS
            _hudLastEarned = earnedNow
        end

        local targetPlayer = Hunter.TargetPlayer
        local targetChar = Hunter.TargetCharacter or (targetPlayer and targetPlayer.Character)
        local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
        local targetRoot = Hunter.TargetPart or (targetChar and (targetChar:FindFirstChild("HumanoidRootPart") or targetChar.PrimaryPart))
        local myChar = LocalPlayer.Character
        local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart)

        local infoTextVal = nil
        local statusDotColorVal = nil
        if isHopping then
            if isBountyAtRisk() then
                local risk = Hunter.BountyRiskStatus or {}
                infoTextVal = risk.State == "unknown" and "Teleport paused | Waiting for combat status"
                    or "Teleport paused | Bounty at risk"
            else
                local hop = Hunter.HopStatus or {}
                infoTextVal = hop.Phase == "waiting-safe-clearance" and "Teleport paused | Confirming bounty is safe"
                    or "Changing server... | Waiting for safe teleport"
            end
            statusDotColorVal = _COLOR_STATUS_HOPPING
        elseif Hunter._isHealingInSky then
            local retreat = Hunter.LowHealthStatus or {}
            infoTextVal = "Low HP retreat | " .. tostring(retreat.Phase or "requested")
            statusDotColorVal = _COLOR_STATUS_HOPPING
        elseif _isPortalWarping then
            local portal = Hunter.PortalStatus or {}
            infoTextVal = string.format("Portal C | %s | %.1fs", portal.Phase or "waiting", math.max(0, tick() - (portal.Since or tick())))
            statusDotColorVal = _COLOR_STATUS_HOPPING
        elseif Hunter.TargetSuspended and targetPlayer then
            local lock = Hunter.TargetLockStatus or {}
            local waiting = Hunter.TargetWaitStatus or {}
            local grace = math.max(tonumber(Hunter.Config.TargetLockGrace) or 8, 0.1)
            if lock.Reason == "character-unavailable" then
                grace = math.max(grace, tonumber(Hunter.Config.TargetLossGrace) or 2)
            end
            local remaining = math.max(0, grace - (tick() - (lock.Since or tick())))
            local label = waiting.Phase == "approaching" and "Approaching" or "Waiting"
            infoTextVal = string.format("%s | %s: %s | %.1fs", targetPlayer.DisplayName or targetPlayer.Name,
                label, lock.Reason or "target-unavailable", remaining)
            statusDotColorVal = _COLOR_STATUS_HOPPING
        elseif Hunter._movementYieldReported then
            infoTextVal = "Movement wait | " .. tostring(Hunter._movementStage or "updating")
            statusDotColorVal = _COLOR_STATUS_HOPPING
        elseif Hunter.SkillDodge and Hunter.SkillDodge.ActiveMode == "SERVER_STUN_LOCKED" then
            infoTextVal = "Stun / grab | Waiting for movement unlock"
            statusDotColorVal = _COLOR_STATUS_HOPPING
        elseif targetPlayer and targetChar and targetHum and targetHum.Health > 0 and targetRoot and myRoot then
            local name = targetPlayer.DisplayName or targetPlayer.Name
            local hp = math.clamp(math.floor((targetHum.Health / math.max(targetHum.MaxHealth, 1)) * 100), 0, 100)
            local realTargetPos = (Hunter.PortalXTracker and Hunter.PortalXTracker.GetRealPosition(targetPlayer)) or targetRoot.Position
            local dist = math.floor((realTargetPos - myRoot.Position).Magnitude)
            local portalXTag = (Hunter.PortalXTracker and Hunter.PortalXTracker.IsInPortalX(targetPlayer)) and " [X-Portal]" or ""
            infoTextVal = string.format("%s%s | HP: %d%% | Dist: %d", name, portalXTag, hp, dist)
            statusDotColorVal = _COLOR_STATUS_ACTIVE
        else
            if isBountyAtRisk() then
                infoTextVal = "Combat Retreat | Climbing to safe sky... | Bounty at risk"
                statusDotColorVal = _COLOR_STATUS_HOPPING
            else
                infoTextVal = "Searching... | HP: -- | Dist: --"
                statusDotColorVal = _COLOR_STATUS_SEARCHING
            end
        end

        if infoTextVal ~= _hudLastInfoText then
            infoText.Text = infoTextVal
            _hudLastInfoText = infoTextVal
        end
        if statusDotColorVal ~= _hudLastStatusColor then
            statusDot.BackgroundColor3 = statusDotColorVal
            _hudLastStatusColor = statusDotColorVal
        end
    end

    local hudConn
    hudConn = RunService.Heartbeat:Connect(function()
        if not screenGui.Parent then
            if hudConn then pcall(hudConn.Disconnect, hudConn) end
            return
        end
        local now = os.clock()
        if now - lastUpdate < 0.18 then return end
        lastUpdate = now

        pcall(_updateHudContent)
    end)
    if Hunter._hudConn then
        pcall(function() Hunter._hudConn:Disconnect() end)
        Hunter._hudConn = nil
    end
    Hunter._hudConn = hudConn
    table.insert(Hunter._hudConnections, hudConn)
    return screenGui
end

task.delay(1.0, function()
    if not (Hunter and Hunter._isRunning) then return end
    local uiOk, uiResult = pcall(createTrashHubHud)
    if uiOk then
        Hunter._gui = uiResult
    else
        Hunter._gui = nil
