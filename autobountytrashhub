    function PortalXTrackerModule.OnDoorXCalled(p1)
        if type(p1) == "table" and not p1.Wake then
            local char = p1.Character
            if char and LocalPlayer and char ~= LocalPlayer.Character then
                local plr = Players:GetPlayerFromCharacter(char)
                if plr then
                    local st = getPlayerState(plr)
                    st.InPortalX = true
                    st.StartTime = os.clock()
