    _lastControlledTargetPos = nil
    _lastControlledCombatTick = 0
    _portalLastTargetPlayer = nil
    _portalLastWarpedIsland = nil
    _portalLastWarpSuccessTick = 0
    if Hunter.SkillDodge then
        Hunter.SkillDodge.EnemyDodgeUntil = 0
        Hunter.SkillDodge.StunDodgeUntil = 0
        Hunter.SkillDodge.ActiveMode = nil
        Hunter.SkillDodge.ReturningFromSky = false
    end
    if Hunter.Sea3TeleporterRoute and Hunter.Sea3TeleporterRoute.Busy then
        Hunter.Sea3TeleporterRoute:Reset("target-skipped")
    end
    if Hunter.Config.SelectedTarget and Hunter.Config.SelectedTarget ~= "LowestHealth" then
        Hunter.Config.SelectedTarget = "LowestHealth"
    end
end

local function isTargetEligible(pName)
    if not pName or pName == "" then return false end
    if _permanentKilledByBlacklist[pName] then
        local t = _permanentKilledByBlacklist[pName]
        if type(t) == "number" and (tick() - t < 10) then
            return false
        elseif type(t) == "boolean" and t == true then
            _permanentKilledByBlacklist[pName] = tick()
            return false
        else
            _permanentKilledByBlacklist[pName] = nil
        end
    end
    if _killedTargets[pName] then
        local t = _killedTargets[pName]
        if type(t) == "number" and (tick() - t < 15) then
            return false
        elseif type(t) == "boolean" and t == true then
            _killedTargets[pName] = tick()
            return false
        else
            _killedTargets[pName] = nil
        end
    end
    if _skippedTargets[pName] then
        local t = _skippedTargets[pName]
        if type(t) == "number" and (tick() - t < 10) then
            return false
        elseif type(t) == "boolean" and t == true then
            _skippedTargets[pName] = tick()
            return false
        else
            _skippedTargets[pName] = nil
        end
    end
    return true
end

local PORTAL_V_ANIM_IDS = {
    ["11839435734"] = true,
}
local PORTAL_V_SOUND_IDS = {
    ["11848251206"]    = true,
    ["73482401425515"] = true,
    ["11848254064"]    = true,
}

local function extractRbxAssetDigits(rawId)
    if not rawId then return nil end
    return tostring(rawId):match("%d+")
end

local function hasPlayingAnimationRbxId(char, idLookup)
    if not char or not idLookup then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then return false end
    local ok, tracks = pcall(function() return animator:GetPlayingAnimationTracks() end)
    if not ok or type(tracks) ~= "table" then return false end
    for _, tr in ipairs(tracks) do
        if tr and tr.IsPlaying and tr.Animation then
            local digits = extractRbxAssetDigits(tr.Animation.AnimationId)
            if digits and idLookup[digits] then
                return true, digits
            end
        end
    end
    return false
end

local function hasActiveSoundRbxId(rootOrChar, idLookup)
    if not rootOrChar or not idLookup then return false end
    for _, child in ipairs(rootOrChar:GetChildren()) do
        if child:IsA("Sound") and child.IsPlaying then
            local digits = extractRbxAssetDigits(child.SoundId)
            if digits and idLookup[digits] then
                return true, digits, child
            end
        end
    end
    return false
end

local function isTargetInPortalVDimension(player)
    if not player then return false end
    if Hunter.PortalXTracker and Hunter.PortalXTracker.IsInPortalX(player) then
        return false
    end
    local ok, res = pcall(function()
        local char = player.Character
        if not char then return false end
        local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
        if not root then return false end

        local _, _, myRoot = getCharacter()
        local pos = root.Position
        if Hunter.PortalXTracker and Hunter.PortalXTracker.IsSpoofedPosition(pos) then
            return false
        end

        local amInDimension = isLocalPlayerInPortalDimension()
        if amInDimension then
            return false
        end

        local targetInRealWorld = isPositionInRealWorld(pos)
        local dist = myRoot and (pos - myRoot.Position).Magnitude or 0
        if dist > 35000 or not targetInRealWorld then
            return true
        end

        local inDimAttr = (char:GetAttribute("PortaledToAnotherDimension") == true)
            or (root:GetAttribute("PortaledToAnotherDimension") == true)
            or (player:GetAttribute("PortaledToAnotherDimension") == true)
            or (char:GetAttribute("InPortalDimension") == true)
            or (root:GetAttribute("InPortalDimension") == true)
            or (player:GetAttribute("InPortalDimension") == true)

        if player == Hunter.TargetPlayer then
            local now = tick()
            local isPlayingVAnim = hasPlayingAnimationRbxId(char, PORTAL_V_ANIM_IDS)
            local isPlayingVSound, soundDigits = hasActiveSoundRbxId(root, PORTAL_V_SOUND_IDS)

            if isPlayingVAnim or isPlayingVSound then
                Hunter._enemyPortalVCastTick = Hunter._enemyPortalVCastTick or {}
                Hunter._enemyPortalVCastPos = Hunter._enemyPortalVCastPos or {}
                if not Hunter._enemyPortalVCastTick[player] or (now - Hunter._enemyPortalVCastTick[player]) > 4.0 then
                    Hunter._enemyPortalVCastPos[player] = pos
                end
                Hunter._enemyPortalVCastTick[player] = now
            end

            if isPlayingVSound and soundDigits == "11848254064" then
                Hunter._enemyPortalVTeleportTick = Hunter._enemyPortalVTeleportTick or {}
                Hunter._enemyPortalVTeleportTick[player] = now
            end

            local vAnimTick = Hunter._enemyPortalVCastTick and Hunter._enemyPortalVCastTick[player]
            local vTpTick = Hunter._enemyPortalVTeleportTick and Hunter._enemyPortalVTeleportTick[player]
            local vCastPos = Hunter._enemyPortalVCastPos and Hunter._enemyPortalVCastPos[player]
            local recentlyCastPortalV = (vAnimTick and (now - vAnimTick) <= 18.0)
                or (vTpTick and (now - vTpTick) <= 18.0)

            if recentlyCastPortalV then
                local movedFromCast = vCastPos and ((pos - vCastPos).Magnitude > 5000) or false
                if inDimAttr or (movedFromCast and (dist > 25000 or not targetInRealWorld)) then
                    return true
                end
            end
        end

        if inDimAttr and dist > 5000 then
            return true
        end

        return false
    end)
    return ok and res or false
end

