        local bestHops = nil
        local bestCost = directDist - MIN_SAVED_STUDS

        for _, edge in ipairs(ONE_HOP_LIST) do
            if isEdgeUnlocked(edge) then
                local cost = evaluateRouteCost({ edge }, myPos, targetPos)
                if cost < bestCost then
                    bestCost = cost
                    bestHops = { edge }
                end
            end
        end

        for _, pair in ipairs(TWO_HOP_LIST) do
            if isEdgeUnlocked(pair[1]) and isEdgeUnlocked(pair[2]) then
                local cost = evaluateRouteCost(pair, myPos, targetPos)
                if cost < bestCost then
                    bestCost = cost
                    bestHops = { pair[1], pair[2] }
                end
            end
        end

        return bestHops, bestCost
