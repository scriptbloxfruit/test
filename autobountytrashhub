    local base = race and race.Value == "Human" and race:FindFirstChild("Evolved") and 10 or 15
    local reduction = char and tonumber(char:GetAttribute("FlashstepCooldown")) or 0
    local duration = base * (1 - math.clamp(reduction or 0, 0, 1))
