local function getEquippedFruitName(fruitTool)
    fruitTool = fruitTool or getToolByType("Fruit")
    if not fruitTool then return nil, nil end
    local rawName = tostring(fruitTool.Name or "")
    local mapped = BLOX_FRUIT_NAMES[rawName]
    if not mapped then
        local nl = string.lower(rawName)
        if nl:find("portal", 1, true) then mapped = "Portal"
        elseif nl:find("spider", 1, true) or nl:find("string", 1, true) then mapped = "Spider"
