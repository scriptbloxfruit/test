        local ok, attr = pcall(function() return player:GetAttribute("LastKenDodge") end)
        if not ok or not attr then
            return false
        end
        local lastDodge = tonumber(attr)
        if not lastDodge or lastDodge <= 0 then
            return false
        end
        local elapsed = getServerTime() - lastDodge
        return elapsed >= 0 and elapsed <= (windowSeconds or 0.45)
    end

    function KenCheckModule.GetKenTier(target): (boolean, boolean, number)
        local player, char = resolveTarget(target)
        local targetInst = char or (target and target:IsA("Instance") and target)
        if not targetInst then
            return false, false, 0
        end
        local hasV1 = false
        local hasV2 = false
        pcall(function()
            hasV1 = CollectionService:HasTag(targetInst, "Ken") or (char and CollectionService:HasTag(char, "Ken")) or (player and CollectionService:HasTag(player, "Ken")) or false
            hasV2 = CollectionService:HasTag(targetInst, "KenUpgrade") or (char and CollectionService:HasTag(char, "KenUpgrade")) or (player and CollectionService:HasTag(player, "KenUpgrade")) or false
        end)
        local tier = hasV2 and 2 or (hasV1 and 1 or 0)
        return hasV1, hasV2, tier
    end

    function KenCheckModule.GetStatus(target)
        local player, char = resolveTarget(target)
        if not player then
            return {
                Valid = false,
                Active = false,
                KenActive = false,
                DodgesLeft = 0,
                KenDodgesLeft = 0,
                MaxDodges = 0,
                KenDisabled = false,
                CanDodge = false,
                ShouldKenBreak = false,
                JustDodged = false,
                Tier = 0,
                HasV1 = false,
                HasV2 = false,
                LastDodgeTime = 0,
                TimeSinceLastDodge = math.huge,
            }
        end

        local active = KenCheckModule.IsKenActive(player)
        local dodgesLeft = KenCheckModule.GetDodgesLeft(player)
        local maxDodges = KenCheckModule.GetMaxDodges(player)
        local kenDisabled = (char and KenCheckModule.IsKenDisabled(char)) or false
        local canDodge = active and (not kenDisabled) and (dodgesLeft >= 0.5)
        local lastDodge = 0
        pcall(function()
            lastDodge = tonumber(player:GetAttribute("LastKenDodge")) or 0
        end)
        local timeSince = (lastDodge > 0) and math.max(0, getServerTime() - lastDodge) or math.huge
        local hasV1, hasV2, tier = KenCheckModule.GetKenTier(char or player)

        return {
            Valid = true,
            Player = player,
            Character = char,
            Active = active,
            KenActive = active,
            DodgesLeft = dodgesLeft,
            KenDodgesLeft = dodgesLeft,
            MaxDodges = maxDodges,
            KenDisabled = kenDisabled,
            CanDodge = canDodge,
            ShouldKenBreak = canDodge,
            JustDodged = timeSince <= 0.45,
            Tier = tier,
            HasV1 = hasV1,
            HasV2 = hasV2,
            LastDodgeTime = lastDodge,
            TimeSinceLastDodge = timeSince,
        }
    end

    function KenCheckModule.WatchTarget(target, callback: (any, string) -> ())
        local player = resolveTarget(target)
        if not player or type(callback) ~= "function" then
            return function() end
        end

        local watchConns = {}
        local charConns = {}

        local function cleanupConnections(list)
            for _, c in ipairs(list) do
                if c and c.Connected then
                    c:Disconnect()
                end
                local idx = table.find(_connections, c)
                if idx then
                    table.remove(_connections, idx)
                end
            end
            table.clear(list)
        end

        local function disconnectAll()
            cleanupConnections(charConns)
            cleanupConnections(watchConns)
        end

        local function fire(eventType)
            callback(KenCheckModule.GetStatus(player), eventType)
        end

        local function trackWatch(conn)
            table.insert(watchConns, conn)
            table.insert(_connections, conn)
            return conn
        end

        local function trackChar(conn)
            table.insert(charConns, conn)
            table.insert(_connections, conn)
            return conn
        end

        trackWatch(player:GetAttributeChangedSignal("KenActive"):Connect(function()
            fire("KenActiveChanged")
        end))

        trackWatch(player:GetAttributeChangedSignal("KenDodgesLeft"):Connect(function()
            fire("DodgesLeftChanged")
        end))

        trackWatch(player:GetAttributeChangedSignal("LastKenDodge"):Connect(function()
            fire("TargetDodged")
        end))

        local function hookChar(char)
            cleanupConnections(charConns)
            if not char then
                return
            end
            trackChar(char.ChildAdded:Connect(function(child)
                if child.Name == "KenDisabled" then
                    fire("KenBroken")
                end
            end))
            trackChar(char.ChildRemoved:Connect(function(child)
                if child.Name == "KenDisabled" then
                    fire("KenBreakRecovered")
                end
            end))
        end

        if player.Character then
            hookChar(player.Character)
        end
        trackWatch(player.CharacterAdded:Connect(hookChar))
        trackWatch(Players.PlayerRemoving:Connect(function(plr)
            if plr == player then
                disconnectAll()
            end
        end))

        return disconnectAll
    end

    function KenCheckModule.Destroy()
        for _, conn in ipairs(_connections) do
            if conn and conn.Connected then
                conn:Disconnect()
            end
        end
        table.clear(_connections)
        table.clear(_dodgeListeners)
        if ENV._TrashHub_KenCheck == KenCheckModule then
            ENV._TrashHub_KenCheck = nil
        end
    end

    ENV._TrashHub_KenCheck = KenCheckModule
    ENV.KenCheckModule = KenCheckModule
    return KenCheckModule
end)()

