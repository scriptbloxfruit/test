local function stepWaitingTarget(dt, root, humanoid)
    local player = Hunter.TargetPlayer
    local status = Hunter.TargetLockStatus
    if not Hunter._isRunning or not Hunter.TargetSuspended or not player or not status then return false end
    local function state(phase, detail)
        local old = Hunter.TargetWaitStatus
        if not old or old.Player ~= player or old.Phase ~= phase or old.Reason ~= detail then
            Hunter.TargetWaitStatus = {Player = player, Phase = phase, Reason = detail, Since = tick()}
            print("[TrashHub][TARGET_WAIT] " .. player.Name .. " Phase=" .. phase .. " Reason=" .. detail)
        end
    end
    local function hold()
        state("holding", status.Reason or "unavailable")
        return false
    end
    local cfg = Hunter.Config or CONFIG
    if cfg.TargetWaitApproach == false then return hold() end
    local info = _targetEvalCache and _targetEvalCache.player == player and _targetEvalCache.info
    if status.Reason ~= "safe-zone" and status.Reason ~= "temporarily-unavailable" then return hold() end
    if not info or not (info.InSafeZone or info.HasForceField or info.HasShield or info.PvPDisabled) then return hold() end
    if info.IsFarOffshore or (tonumber(info.SeaZone) or 0) >= 2 or info.StatusText == "[UNDERWATER ISLAND]" then return hold() end
    if not root or not root.Parent or root.Anchored or not humanoid or humanoid.Health <= 0
        or not player.Parent or Hunter._isHealingInSky or isHopping or _isPortalWarping then return hold() end
    if Hunter.StunCheck and Hunter.StunCheck.IsServerPhysicsLocked(root.Parent) then return hold() end
    local character = player.Character
    local targetHum = character and character:FindFirstChildOfClass("Humanoid")
    local targetRoot = character and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart)
    if not targetRoot or not targetRoot.Parent or not targetHum or targetHum.Health <= 0 then return hold() end
    if isLocalPlayerInPortalDimension() or isPlayerInPortalVDimension(player) or isTargetUsingPortalDimension(player) then return hold() end
    if Hunter.GhostShipRoute and (Hunter.GhostShipRoute.Busy
        or Hunter.GhostShipRoute:GetArea(root.Position) ~= Hunter.GhostShipRoute:GetArea(targetRoot.Position)) then return hold() end
    if Hunter.Sea3TeleporterRoute and Hunter.Sea3TeleporterRoute.Busy then return hold() end
    local position = targetRoot.Position
    local offset = root.Position - position
    local distance = offset.Magnitude
    if distance ~= distance or distance == math.huge then return hold() end
    local minimum = math.max(Hunter.GunM1:GetComboDistance() + 25, 50)
    local configured = tonumber(cfg.TargetWaitDistance) or 75
    if configured ~= configured or math.abs(configured) == math.huge then configured = 75 end
    local standOff = math.clamp(configured, minimum, math.max(200, minimum))
    setHover(true)
    if distance <= standOff + 2 then state("near-target", status.Reason); return true end
    local goal = position + offset.Unit * standOff
    if goal.Y > -140 and goal.Y < 5.5 and goal.X < 45000 and goal.Z < 30000 then
        goal = Vector3.new(goal.X, 5.5, goal.Z)
    end
    local nextCF = Hunter.Motion:Frame("TARGET_WAIT", dt, root, goal, position, tonumber(cfg.TweenSpeed) or 220)
    nextCF = Hunter.AntiLava:FilterMove(root, humanoid, nextCF)
    if Hunter.GhostShipRoute then nextCF = Hunter.GhostShipRoute:ClampInteriorCFrame(root, nextCF) end
    if Hunter.TargetPlayer ~= player or not Hunter.TargetSuspended or player.Character ~= character then return false end
    root.CFrame = nextCF
    root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
    state("approaching", status.Reason)
    return true
end

