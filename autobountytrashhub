    end))

    function api:StepMovement(dt, myRoot, myHum, tPart, skillsCfg)
        updateTargetTracking()
        if not self.Enabled or self.Destroyed or not myRoot or not myHum or myHum.Health <= 0
            or not tPart or not tPart.Parent or Hunter.TargetSuspended then
            self.ActiveMode, self.ReturningFromSky = nil, false
            return false
        end
        local myChar = myRoot.Parent
        if Hunter.StunCheck and Hunter.StunCheck.IsServerPhysicsLocked(myChar) then
            self:IsSelfStunDodging()
            self.ActiveMode = "SERVER_STUN_LOCKED"
            setHover(true, true)
            Hunter.Kinematics:Pause()
            return false
        end
        if (Hunter.GhostShipRoute and (Hunter.GhostShipRoute.Busy
            or Hunter.GhostShipRoute:GetArea(myRoot.Position) ~= Hunter.GhostShipRoute:GetArea(tPart.Position)
            or Hunter.GhostShipRoute:IsInsideGhostShip(myRoot.Position)
            or Hunter.GhostShipRoute:IsInsideGhostShip(tPart.Position)))
            or isLocalPlayerInPortalDimension() then
            self.ActiveMode, self.ReturningFromSky = nil, false
            return false
        end
        local tPos = (Hunter.PortalXTracker and Hunter.TargetPlayer and Hunter.PortalXTracker.GetRealPosition(Hunter.TargetPlayer)) or tPart.Position
        local distance = (myRoot.Position - tPos).Magnitude
        if distance > 2500 or (Hunter.TargetPlayer and (isTargetInPortalVDimension(Hunter.TargetPlayer)
            or (Hunter.PortalXTracker and Hunter.PortalXTracker.IsInPortalX(Hunter.TargetPlayer))
            or isTargetUsingPortalDimension(Hunter.TargetPlayer))) then
            self.EnemyDodgeUntil, self.StunDodgeUntil = 0, 0
            self.ActiveMode, self.ReturningFromSky = nil, false
            return false
        end
        local aim = Hunter.PredictedPos or getPredictedPos(tPart) or tPos
        local shouldKite, reason = self:ShouldKiteInSky(skillsCfg)
        local mode, goal
        if shouldKite then
            if reason == "STUN_DODGE" then cleanSelfStunMovers(myRoot) end
            self.ActiveMode, self.ReturningFromSky = reason, true
            mode = "DODGE_HOLD"
            goal = tPos + Vector3.new(self.SkyLateralOffsetX or 55, self.SkyHeightOffset or 120, self.SkyLateralOffsetZ or 35)
        elseif self.ReturningFromSky then
            self.ActiveMode = "DODGE_RETURN"
            if Hunter.SoruApproach and Hunter.SoruApproach:TryApproach(myRoot, myHum, tPart) then
                self.ActiveMode, self.ReturningFromSky = nil, false
                return true
            end
            if distance <= math.max(Hunter.GunM1:GetComboDistance(), 12) then
                self.ActiveMode, self.ReturningFromSky = nil, false
                return false
            end
            mode, goal = "DODGE_RETURN", tPos + Vector3.new(0, 0.5, 3)
        else
            self.ActiveMode = nil
            return false
        end
        Hunter.Kinematics:Pause()
        setHover(true)
        local nextCF = Hunter.Motion:Frame(mode, dt, myRoot, goal, aim, 220)
        nextCF = Hunter.AntiLava:FilterMove(myRoot, myHum, nextCF)
        if Hunter.GhostShipRoute then nextCF = Hunter.GhostShipRoute:ClampInteriorCFrame(myRoot, nextCF) end
        myRoot.CFrame = nextCF
        myRoot.AssemblyLinearVelocity, myRoot.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
        _lastControlledCombatPos, _lastControlledTargetPos, _lastControlledCombatTick = nextCF.Position, tPos, tick()
        return true
    end

    function api:Destroy()
        self.Destroyed = true
        self.Enabled = false
        self.EnemyDodgeUntil = 0
        self.StunDodgeUntil = 0
        unhookCurrentTarget()
        disconnectList(self._connections)
        disconnectList(self._localCharConns)
        for p, list in pairs(self._playerConns) do disconnectList(list) end
        for p, list in pairs(self._playerCharConns) do disconnectList(list) end
        table.clear(self._playerConns)
        table.clear(self._playerCharConns)
        table.clear(self._enemyRoots)
    end

    return api
end)()

