Hunter.PortalRuntime = (function()
    local api = {Current = nil, Destroyed = false}
    function api.BaseReady()
        if LocalPlayer:GetAttribute("LoadComplete") == false then return false, "game-loading" end
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        local main = pg and pg:FindFirstChild("Main")
        local skills = main and main:FindFirstChild("Skills")
        if not skills then return false, "skills-container-missing" end
        return true, skills
    end
    function api.Read(tool, allowHidden)
        local base, skills = api.BaseReady()
        if not base then return "WAIT_UI", skills end
        if not tool or (not allowHidden and tool.Parent ~= LocalPlayer.Character) then
            return "WAIT_EQUIP", "portal-not-equipped"
        end
        local frame = skills:FindFirstChild("Portal-Portal")
        local slot = frame and frame:FindFirstChild("C")
        local cooldown = slot and slot:FindFirstChild("Cooldown")
        if not frame or not slot or not cooldown or not cooldown:IsA("GuiObject") then
            return "WAIT_UI", "portal-c-slot-missing"
        end
        if cooldown.Size.X.Scale > 0.02 then return "COOLDOWN", "portal-c-cooldown" end
        if not allowHidden then
            for _, object in ipairs({skills, frame, slot}) do
                if object:IsA("GuiObject") and object.Visible ~= true then return "WAIT_UI", "portal-skill-panel-hidden" end
            end
        end
        return "READY", cooldown
    end
    function api.IsCurrent(attempt) return attempt ~= nil and api.Current == attempt and not api.Destroyed end
    function api.Alive(attempt)
        if not api.IsCurrent(attempt) or not Hunter._isRunning or isHopping then return false end
        if Hunter.ArenaCheck and Hunter.ArenaCheck.ShouldSkip(attempt.TargetPlayer) then return false end
        if Hunter.LowHealthEscape and Hunter.LowHealthEscape.Check() then return false end
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        return api.IsCurrent(attempt) and not Hunter._isHealingInSky and char == attempt.Character
            and hum and hum.Health > 0 and Hunter.TargetPlayer == attempt.TargetPlayer
            and os.clock() < attempt.Deadline
    end
    function api.ReleaseKey(attempt)
        if not attempt or not attempt.OwnsKey then return true end
        attempt.OwnsKey = false
        if Hunter._skillHeldKey ~= Enum.KeyCode.C then return true end
        Hunter._skillHeldKey = nil
        return pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.C, false, game) end)
    end
    function api.Finish(attempt, success, reason)
        if not api.IsCurrent(attempt) then return false end
        api.ReleaseKey(attempt)
        if attempt.TimeoutThread then pcall(task.cancel, attempt.TimeoutThread); attempt.TimeoutThread = nil end
        _portalTargetIslandOverride, _portalTargetPosition, _portalTargetPlayerRef = nil, nil, nil
        if attempt.Gateway then pcall(_bindPortalGateway, attempt.Gateway) end
        if attempt.Restore and Hunter._isRunning and not Hunter._isHealingInSky then pcall(attempt.Restore) end
        api.Current = nil
        _isPortalWarping = false
        if not success then
            _portalLastTargetPlayer = nil
            _portalRetryAfterTick = tick() + 1.2
        end
        Hunter.PortalStatus = {Phase = success and "arrived" or "cancelled", Since = tick(), Reason = reason}
        attempt.Character, attempt.TargetPlayer, attempt.Restore, attempt.Gateway = nil, nil, nil, nil
        return true
    end
    function api.Cancel(reason)
        if api.Current then return api.Finish(api.Current, false, reason or "cancelled") end
        return false
    end
    function api.Begin(targetPlayer)
        api.Cancel("superseded")
        if api.Destroyed then return nil end
        local attempt = {Character = LocalPlayer.Character, TargetPlayer = targetPlayer,
            Deadline = os.clock() + 20, Preparing = true}
        api.Current = attempt
        attempt.TimeoutThread = task.delay(20, function()
            attempt.TimeoutThread = nil
            if api.IsCurrent(attempt) then api.Cancel("portal-attempt-timeout") end
        end)
        return attempt
    end
    function api.WaitReady(tool, alive, timeout)
        local deadline, readySince, readyObject = os.clock() + (timeout or 8), nil, nil
        repeat
            if not alive() then return false, "portal-cancelled" end
            local state, detail = api.Read(tool)
            if Hunter.PortalStatus then
                Hunter.PortalStatus.Phase = "waiting-skill-ui"
                Hunter.PortalStatus.Reason = state == "READY" and "confirming-skill-panel" or detail
            end
            if state == "COOLDOWN" then return false, detail end
            if state == "READY" then
                if detail ~= readyObject then readySince, readyObject = os.clock(), detail end
                if os.clock() - readySince >= 0.12 then return true end
            else
                readySince, readyObject = nil, nil
            end
            if os.clock() >= deadline then return false, "portal-skill-ui-timeout" end
            task.wait(0.03)
        until false
    end
    function api.StepPreparationMovement(dt)
        local attempt = api.Current
        if not api.IsCurrent(attempt) or not attempt.Preparing then return false end
        if not api.Alive(attempt) then api.Cancel("preparation-invalidated"); return false end
        local character, humanoid, root = getCharacter()
        local player = attempt.TargetPlayer
        local targetCharacter = player and player.Parent and player.Character
        local targetRoot = targetCharacter and (targetCharacter:FindFirstChild("HumanoidRootPart") or targetCharacter.PrimaryPart)
        if not root or not targetRoot or not targetRoot.Parent or not isAlive(targetCharacter) or Hunter.TargetSuspended then
            api.Cancel("preparation-target-unavailable")
            return false
        end
        local rooms = Hunter.GhostShipRoute
        if rooms and (rooms:IsInside(root.Position) or rooms:HasForcedExit()
            or (rooms.Busy and rooms.Phase ~= "APPROACH")) then
            api.Cancel("preparation-room-handoff")
            return false
        end
        local projected, raw = _portalGetEffectiveTargetPos(player, targetRoot.Position, 1.6)
        local goal = projected or raw or targetRoot.Position
        if rooms and rooms.GetEntrancePosition then goal = rooms:GetEntrancePosition(raw or goal) or goal end
        local remaining = (goal - root.Position).Magnitude
        if remaining <= 25 or (_portalGetLiveTargetDistance(player) or 0) < _portalGetMinDistance() then
            api.Cancel("preparation-route-reached")
            return false
        end
        if root.Anchored or (Hunter.IsActionLocked and Hunter.IsActionLocked(character)) then
            api.Cancel("preparation-action-locked")
            return false
        end
        local nextCF = Hunter.Motion:Frame("PORTAL_PREPARATION", dt, root, goal, raw or goal,
            tonumber((Hunter.Config and Hunter.Config.TweenSpeed) or CONFIG.TweenSpeed) or 220)
        if Hunter.AntiLava then nextCF = Hunter.AntiLava:FilterMove(root, humanoid, nextCF) end
        if not api.Alive(attempt) or not attempt.Preparing or root.Parent ~= character then
            if api.IsCurrent(attempt) then api.Cancel("preparation-invalidated") end
            return false
        end
        if nextCF then
            setHover(true)
            root.CFrame = nextCF
            root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
        end
        return true
    end
    function api.Destroy()
        api.Cancel("destroy")
        api.Destroyed = true
        if api.CharacterConnection then api.CharacterConnection:Disconnect(); api.CharacterConnection = nil end
    end
    api.CharacterConnection = LocalPlayer.CharacterRemoving:Connect(function()
        api.Cancel("character-removed")
    end)
    table.insert(Hunter._connections, api.CharacterConnection)
    return api
end)()

local function _portalCheckGuiCooldownReady(tool)
