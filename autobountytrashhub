            _noTargetStartTime = 0
            _postKillTransitionPending = false
            _postKillTransitionTick = 0
            return bestPlayer.Character, r
        end
    end

    local actCfg = getActiveConfig()
    local hopIfNoPvP = (actCfg.HopIfNoPvPPlayers ~= false)
    if not bestPlayer and hopIfNoPvP and not amInDimension then
        if _postKillTransitionPending then
