        Hunter._enemyPortalVCastTick = Hunter._enemyPortalVCastTick or {}
        Hunter._enemyPortalVCastPos = Hunter._enemyPortalVCastPos or {}
        local enemyRoot = api._enemyRoots[attacker] or (attacker.Character and attacker.Character:FindFirstChild("HumanoidRootPart"))
        if enemyRoot and (not Hunter._enemyPortalVCastTick[attacker] or (now - Hunter._enemyPortalVCastTick[attacker]) > 4.0) then
            Hunter._enemyPortalVCastPos[attacker] = enemyRoot.Position
