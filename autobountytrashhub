local function _portalSelectBestIslandFromList(list, targetPlayer, fallbackTargetPos, fallbackIslandName)
    if typeof(list) ~= "table" then return fallbackIslandName end
    _portalSyncGatewayList(list)

    local projectedPos, rawPos = _portalGetEffectiveTargetPos(targetPlayer, fallbackTargetPos, 1.6)
    local checkRawPos = rawPos or projectedPos
    if projectedPos or rawPos then
        local bestIsland = nil
        local bestScore = math.huge
        local bestRawHorizDist = math.huge
        local curIsl = _portalGetIslandsForCurrentSea()

        for k, v in pairs(list) do
            local islandName = (type(k) == "number" and type(v) == "string") and v or k
            local islandData = (type(k) == "number" and type(v) == "string") and nil or v
            if type(islandName) == "string" then
                local islandPos = nil
                if typeof(islandData) == "Vector3" then
                    islandPos = islandData
                elseif typeof(islandData) == "CFrame" then
                    islandPos = islandData.Position
                elseif typeof(islandData) == "Instance" and islandData:IsA("BasePart") then
                    islandPos = islandData.Position
                elseif typeof(islandData) == "table" and #islandData >= 3 then
                    islandPos = Vector3.new(islandData[1], islandData[2], islandData[3])
                end
                if not islandPos and curIsl then
                    islandPos = curIsl[islandName]
                end
                if islandPos and not _portalIsRestrictedInteriorIsland(islandName, islandPos, checkRawPos) then
                    local score = _portalCalcIslandScore(islandPos, projectedPos, rawPos)
                    if score < bestScore then
                        bestScore = score
                        bestIsland = islandName
                        bestRawHorizDist = checkRawPos and _portalHorizDist(islandPos, checkRawPos) or 0
                    end
                end
            end
        end

        if bestIsland and bestRawHorizDist <= _portalGetMaxOffshoreDistance() then
            return bestIsland
        elseif bestIsland and bestRawHorizDist > _portalGetMaxOffshoreDistance() then
            return nil
        end
    end

    if fallbackIslandName then
        if list[fallbackIslandName] then
            return fallbackIslandName
        end
        for k, v in pairs(list) do
            local islandName = (type(k) == "number" and type(v) == "string") and v or k
            if type(islandName) == "string" then
                if string.lower(islandName) == string.lower(fallbackIslandName) or
                   string.find(string.lower(islandName), string.lower(fallbackIslandName), 1, true) or
                   string.find(string.lower(fallbackIslandName), string.lower(islandName), 1, true) then
                    return islandName
                end
            end
        end
        return fallbackIslandName
    end
    return nil
end

_bindPortalGateway = function(gateway)
    if not gateway then return end
    _portalRequestGateway = gateway
    gateway.OnClientInvoke = function(list)
        if typeof(list) == "table" and (_portalTargetIslandOverride or _portalTargetPosition or _portalTargetPlayerRef) then
            local tPlayer = _portalTargetPlayerRef or Hunter.TargetPlayer
            local tPos = _portalTargetPosition
            local override = _portalTargetIslandOverride
            _portalTargetPosition = nil
            _portalTargetIslandOverride = nil
            _portalTargetPlayerRef = nil

            local chosen = _portalSelectBestIslandFromList(list, tPlayer, tPos, override)
            if chosen then
                _portalLastWarpedIsland = chosen
                _portalLastWarpSuccessTick = tick()
                return chosen
            end
        end
        if _portalDefaultGatewayCtrl and _portalDefaultGatewayCtrl.LoadListAndAwaitSelection then
            return _portalDefaultGatewayCtrl.LoadListAndAwaitSelection(list)
        end
        return nil
    end
end

