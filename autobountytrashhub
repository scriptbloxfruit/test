            or root.Position.Y < -300
        if Hunter._isHealingInSky or isHopping or _isPortalWarping or inPortalDim then
            if self.Busy then self:Reset("preempted") end
            return false
        end
        if Hunter.GhostShipRoute and Hunter.GhostShipRoute.Busy then
            if self.Busy then self:Reset("ghostship-busy") end
            return false
        end

        local now = os.clock()
        if now < state.CooldownUntil then
            if self.Busy then self:Reset("cooldown") end
            return false
        end

        local char = root.Parent
        local busyVal = char and char:FindFirstChild("Busy")
        if (busyVal and busyVal.Value == true) or isCharacterTransformed(char) then
            if self.Busy then self:Reset("char-busy-or-transformed") end
            return false
        end

        refreshUnlocksAsync(false)
        if not self.IndraUnlocked and not self.TyrantUnlocked then
            return false
        end

        local myPos = root.Position
        local effectiveTargetPos = targetPos
        if Hunter.GhostShipRoute and Hunter.GhostShipRoute.GetEntrancePosition
            and not Hunter.GhostShipRoute:IsInside(myPos) then
            effectiveTargetPos = Hunter.GhostShipRoute:GetEntrancePosition(targetPos) or targetPos
        end
        local directDist = (myPos - effectiveTargetPos).Magnitude

        if self.Busy and state.Hops then
            if targetPlayer ~= state.TargetPlayer then
                self:Reset("target-changed")
            elseif directDist <= 1400 then
                self:Reset("target-close")
                return false
            else
                local remHops = {}
                for i = state.HopIndex, #state.Hops do
                    table.insert(remHops, state.Hops[i])
                end
                local remCost = evaluateRouteCost(remHops, myPos, effectiveTargetPos)
                if directDist + 400 < remCost then
                    self:Reset("direct-now-faster")
                    return false
                end
            end
        end

        if not self.Busy then
            local bestHops = findBestRoute(myPos, effectiveTargetPos)
            if not bestHops then
                return false
            end
            self.Busy = true
            state.Hops = bestHops
            state.HopIndex = 1
            state.TargetPlayer = targetPlayer
            state.PhaseStartedAt = now
            state.LastTriggerAt = 0
            state.StreamRequestedHop = 0
            state.ClearExitGoal = nil

            local firstEdge = bestHops[1]
            if firstEdge.Mode == "TOUCH" and (myPos - firstEdge.EntryPos).Magnitude <= 24 then
                local awayDir = (myPos - firstEdge.EntryPos)
                awayDir = Vector3.new(awayDir.X, 0, awayDir.Z)
                if awayDir.Magnitude < 0.1 then
                    awayDir = Vector3.new(1, 0, 0)
                else
                    awayDir = awayDir.Unit
                end
                state.StepOutGoal = firstEdge.EntryPos + awayDir * 28
                self.Phase = "STEP_OUT"
                self.LastReason = "stepping-out-of-portal-lock"
            else
                self.Phase = "APPROACH"
                self.LastReason = "approaching-" .. firstEdge.Id
            end
        end

        if self.Phase == "CLEAR_EXIT" then
            local goal = state.ClearExitGoal or targetPos
            local offset = goal - myPos
            if offset.Magnitude <= 3.0 or (now - state.PhaseStartedAt) >= 0.35 then
                self:Reset("completed")
                return false
            end
            local stepDist = math.min(offset.Magnitude, 220 * math.clamp(tonumber(dt) or 0.016, 0, 0.033))
            local nextPos = myPos + offset.Unit * stepDist
            freezeRoot(root, Hunter.Kinematics:LookAt(nextPos, targetPos, root.CFrame))
            return true
        end

        local curEdge = state.Hops and state.Hops[state.HopIndex]
        if not curEdge then
            self:Reset("no-edge")
            return false
        end

        ensureIslandLodActive(curEdge.IslandFolder)
        ensureIslandLodActive("Boat Castle")
        if state.Hops[state.HopIndex + 1] then
            ensureIslandLodActive(state.Hops[state.HopIndex + 1].IslandFolder)
        end
        if state.StreamRequestedHop ~= state.HopIndex then
            state.StreamRequestedHop = state.HopIndex
            local entryP, exitP = curEdge.EntryPos, curEdge.ExitPos
            task.spawn(function()
                pcall(function() LocalPlayer:RequestStreamAroundAsync(entryP, 5) end)
                pcall(function() LocalPlayer:RequestStreamAroundAsync(exitP, 5) end)
            end)
        end

        if humanoid.Sit then humanoid.Sit = false end

        if self.Phase == "STEP_OUT" then
            local goal = state.StepOutGoal or (curEdge.EntryPos + Vector3.new(28, 0, 0))
            local offset = goal - myPos
            if offset.Magnitude <= 2.5 or (now - state.PhaseStartedAt) >= 0.45 then
                self.Phase = "APPROACH"
                state.PhaseStartedAt = now
                self.LastReason = "approaching-" .. curEdge.Id
            else
                local stepDist = math.min(offset.Magnitude, 220 * math.clamp(tonumber(dt) or 0.016, 0, 0.033))
                local nextPos = myPos + offset.Unit * stepDist
                freezeRoot(root, Hunter.Kinematics:LookAt(nextPos, curEdge.EntryPos, root.CFrame))
                return true
            end
        end

        if self.Phase == "APPROACH" then
            local _, hb = findTeleporterInstances(curEdge)
            local goalPos = (hb and hb.Position) or curEdge.EntryPos
            local offset = goalPos - myPos
            if offset.Magnitude <= 14.0 then
                if unlockSkillState then unlockSkillState() end
                freezeRoot(root, CFrame.new(goalPos) * (root.CFrame - myPos))
                self.Phase = "TELEPORT"
                state.PhaseStartedAt = now
                state.LastTriggerAt = 0
                self.LastReason = "teleporting-" .. curEdge.Id
                return true
            end
            local stepDist = math.min(offset.Magnitude, 220 * math.clamp(tonumber(dt) or 0.016, 0, 0.033))
            local nextPos = myPos + offset.Unit * stepDist
            if nextPos.Y > -140 and nextPos.Y < 5.5 then
                nextPos = Vector3.new(nextPos.X, 5.5, nextPos.Z)
            end
            local nextCF = Hunter.Kinematics:LookAt(nextPos, goalPos, root.CFrame)
            if Hunter.AntiLava then
                nextCF = Hunter.AntiLava:FilterMove(root, humanoid, nextCF)
            end
            freezeRoot(root, nextCF)
            return true
        end

        if self.Phase == "TELEPORT" then
            local distToExit = (myPos - curEdge.ExitPos).Magnitude
            local distFromEntry = (myPos - curEdge.EntryPos).Magnitude
            if distToExit <= 280 or (distFromEntry >= 1500 and (now - state.PhaseStartedAt) > 0.08) then
                if state.HopIndex < #state.Hops then
                    state.HopIndex = state.HopIndex + 1
                    self.Phase = "APPROACH"
                    state.PhaseStartedAt = now
                    state.LastTriggerAt = 0
                    self.LastReason = "approaching-" .. state.Hops[state.HopIndex].Id
                    return true
                else
                    local toTarget = targetPos - myPos
                    local flat = Vector3.new(toTarget.X, 0, toTarget.Z)
                    if flat.Magnitude < 0.1 then
                        flat = Vector3.new(1, 0, 0)
                    else
                        flat = flat.Unit
                    end
                    state.ClearExitGoal = myPos + flat * 26 + Vector3.new(0, 4, 0)
                    self.Phase = "CLEAR_EXIT"
                    state.PhaseStartedAt = now
                    self.LastReason = "clearing-exit-portal"
                    return true
                end
            end

            if (now - state.PhaseStartedAt) > 5.0 then
                state.CooldownUntil = now + 8.0
                self:Reset("teleport-timeout")
                return false
            end

            local tpModel, hb = findTeleporterInstances(curEdge)
            local holdPos = (hb and hb.Position) or curEdge.EntryPos
            local yJitter = ((math.floor(now * 20) % 2) == 0) and 0.4 or -0.4
            freezeRoot(root, CFrame.new(holdPos + Vector3.new(0, yJitter, 0)) * (root.CFrame - myPos))

            if hb and (now - state.LastTriggerAt) >= 0.25 then
                state.LastTriggerAt = now
                if unlockSkillState then unlockSkillState() end
                if type(firetouchinterest) == "function" then
                    pcall(firetouchinterest, root, hb, 0)
                    pcall(firetouchinterest, root, hb, 1)
                end
                if curEdge.Mode == "BOAT_CASTLE_RF" and tpModel then
                    local rf = getBoatCastleRemote()
                    local exitCF = curEdge.ExitCFrame
                    if rf then
                        task.spawn(function()
                            local okI, resI = pcall(function()
                                return rf:InvokeServer("InitiateTeleport", tpModel)
                            end)
                            if okI and resI and root and root.Parent then
                                root.CFrame = exitCF
                            end
                        end)
                    end
                end
            end
            return true
        end

        return false
    end

    function api:Destroy()
        self.Destroyed = true
        self:Reset("destroyed")
        for _, c in ipairs(connections) do
            pcall(function() c:Disconnect() end)
        end
        table.clear(connections)
    end

    table.insert(connections, LocalPlayer.CharacterRemoving:Connect(function()
        api:Reset("character-removing")
    end))

    pcall(function()
        local netMod = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
        if netMod then
            local Net = require(netMod)
            local refreshRE = Net:RemoteEvent("BoatCastleTeleportersRefresh")
            if refreshRE then
                table.insert(connections, refreshRE.OnClientEvent:Connect(function()
                    refreshUnlocksAsync(true)
                end))
            end
        end
    end)

    if isSea3() then
        refreshUnlocksAsync(true)
    end

    return api
end)()

do -- low health scope
Hunter.LowHealthGuard = (function()
    local api = {Ready = false, Active = false, Destroyed = false, HookStatus = "not-prepared", PositionHookStatus = "not-prepared"}
    local ownedMarker, activeCharacter, activeRoot, bodyMover = nil, nil, nil, nil
    local connections = {}
    local registry = getgenv()._TrashHub_RetreatHooks
    if type(registry) ~= "table" or registry.Version ~= 1 then
        registry = {Version = 1}
        getgenv()._TrashHub_RetreatHooks = registry
    end

    local function suppressedHandle()
        local handle = {Enabled = false, Removing = true, Duration = 0, StartTime = tick()}
        local function noChange(self) return self end
        handle.Set = noChange
        handle.SetForce = noChange
        handle.Enable = noChange
        handle.Disable = noChange
        handle.Destroy = noChange
        handle._SetActive = noChange
        return handle
    end
    local function suppressedController(character)
        return {
            _TrashHubSuppressed = true,
            Parent = character:FindFirstChild("HumanoidRootPart"),
            Running = {},
            Create = function() return suppressedHandle() end,
        }
    end
    local function blocking(character)
        return registry.Owner ~= nil and registry.Character == character
            and character == LocalPlayer.Character and character.Parent ~= nil
    end
    local function installHooks(module)
        if registry.Module == module and registry.Installed then return true end
        if type(hookfunction) ~= "function" then return false, "hookfunction-unavailable" end
        local readUpvalues = getupvalues or (debug and debug.getupvalues)
        if type(readUpvalues) ~= "function" then return false, "getupvalues-unavailable" end
        local ok, upvalues = pcall(readUpvalues, module.new)
        if not ok or type(upvalues) ~= "table" then return false, "bodymover-upvalues-unavailable" end
        local prototype
        for _, value in pairs(upvalues) do
            if type(value) == "table" and rawget(value, "new") == module.new
                and type(rawget(value, "Create")) == "function" then
                prototype = value
                break
            end
        end
        if not prototype then return false, "bodymover-signature-changed" end
        local originalNew, originalCreate
        local constructor, create = module.new, prototype.Create
        local hookNew = function(character, ...)
            if blocking(character) then return suppressedController(character) end
            return originalNew(character, ...)
        end
        local hookCreate = function(controller, ...)
            if type(controller) == "table" then
                local parent = rawget(controller, "Parent")
                if rawget(controller, "_TrashHubSuppressed")
                    or (typeof(parent) == "Instance" and parent == registry.Root and blocking(parent.Parent)) then
                    return suppressedHandle()
                end
            end
            return originalCreate(controller, ...)
        end
        local newOK, newResult = pcall(hookfunction, constructor, hookNew)
        if not newOK or type(newResult) ~= "function" then return false, "constructor-hook-failed" end
        originalNew = newResult
        local createOK, createResult = pcall(hookfunction, create, hookCreate)
        if not createOK or type(createResult) ~= "function" then
            pcall(hookfunction, constructor, originalNew)
            return false, "create-hook-failed"
        end
        originalCreate = createResult
        registry.Module, registry.Installed = module, true
        return true
    end
    local function installPositionHook()
        if registry.PositionInstalled then return true end
        if type(hookmetamethod) ~= "function" or type(newcclosure) ~= "function" or type(checkcaller) ~= "function" then
            return false, "position-hook-unavailable"
        end
        local originalIndex
        local replacement = newcclosure(function(object, property, value)
            if registry.PositionEnabled and registry.Owner and object == registry.Root
                and (property == "CFrame" or property == "Position" or (property == "Anchored" and value == true))
                and blocking(object.Parent) and not checkcaller() then
                return
            end
            return originalIndex(object, property, value)
        end)
        local ok, result = pcall(hookmetamethod, game, "__newindex", replacement)
        if not ok or type(result) ~= "function" then return false, "position-hook-failed" end
        originalIndex = result
        registry.PositionInstalled = true
        return true
    end
    function api:Prepare()
        if self.Destroyed then return false end
        if self.Ready then return self.HookStatus == "installed" end
        local util = ReplicatedStorage:FindFirstChild("Util")
        local module = util and util:FindFirstChild("BodyMover")
        if not module then self.HookStatus = "bodymover-module-unavailable"; return false end
        local ok, result = pcall(require, module)
        if not ok or type(result) ~= "table" or type(result.new) ~= "function"
            or type(result.GetActive) ~= "function" then
            self.HookStatus = "bodymover-api-unavailable"
            return false
        end
        if self.Destroyed then return false end
        bodyMover = result
        local installed, reason = installHooks(result)
        local positionInstalled, positionReason = installPositionHook()
        self.PositionHookStatus = positionInstalled and "installed" or positionReason
        self.Ready, self.HookStatus = true, installed and "installed" or reason
        print("[TrashHub][RETREAT_GUARD] BodyMover=" .. tostring(self.HookStatus) .. " Position=" .. tostring(self.PositionHookStatus))
        return installed
    end
    function api:Stop()
        self.Active = false
        if registry.Owner == self then
            registry.Owner, registry.Character, registry.Root, registry.PositionEnabled = nil, nil, nil, false
        end
        if ownedMarker then pcall(function() ownedMarker:Destroy() end) end
        ownedMarker, activeCharacter, activeRoot = nil, nil, nil
    end
    function api:Start(character, root, humanoid)
        if self.Destroyed or not Hunter._isRunning or not Hunter._isHealingInSky
            or character ~= LocalPlayer.Character or not root or root.Parent ~= character then return false end
        if self.Active and activeCharacter == character and activeRoot == root then return true end
        self:Stop()
        if registry.Owner and registry.Owner ~= self then registry.Owner:Stop() end
        activeCharacter, activeRoot, self.Active = character, root, true
        registry.Owner, registry.Character, registry.Root = self, character, root
        local marker = character:FindFirstChild("AntiMover")
        if not marker then
            marker = Instance.new("Folder")
            marker.Name = "AntiMover"
            ownedMarker = marker
            marker.Parent = character
        end
        -- M1WeldFor closes its running drag when this timestamp changes.
        pcall(function() root:SetAttribute("DragM1Timestamp", nil) end)
        -- Try releasing the local anchor once; a server re-anchor is still respected.
        pcall(function() root.Anchored = false end)
        if humanoid then pcall(function() humanoid.PlatformStand = false end) end
        self:Step(character, root)
        return true
    end
    function api:ArmPositionProtection()
        if self.Active and registry.Owner == self then registry.PositionEnabled = true end
    end
    function api:DisarmPositionProtection()
        if registry.Owner == self then registry.PositionEnabled = false end
    end
    function api:Step(character, root)
        if not self.Active then return end
        if self.Destroyed or not Hunter._isRunning or not Hunter._isHealingInSky
            or character ~= activeCharacter or character ~= LocalPlayer.Character
            or root ~= activeRoot or root.Parent ~= character then self:Stop(); return end
        if ownedMarker and ownedMarker.Parent ~= character then
            ownedMarker = nil
            if not character:FindFirstChild("AntiMover") then
                ownedMarker = Instance.new("Folder")
                ownedMarker.Name = "AntiMover"
                ownedMarker.Parent = character
            end
        end
        if bodyMover then
            local ok, active = pcall(bodyMover.GetActive, bodyMover, character)
            if ok and type(active) == "table" then
                for _, kind in ipairs({"BodyVelocity", "BodyPosition", "BodyGyro"}) do
                    local entries = active[kind]
                    if type(entries) == "table" then
                        for _, entry in pairs(entries) do
                            local value = type(entry) == "table" and entry.value
                            if type(value) == "table" then value.Enabled, value.Removing = false, true end
                        end
                    end
                    -- Keep the game's instances alive; its updater owns their lifecycle.
                    local mover = root:FindFirstChild(kind)
                    if mover and mover:IsA(kind) then
                        pcall(function()
                            if kind == "BodyGyro" then mover.MaxTorque = Vector3.zero
                            else mover.MaxForce = Vector3.zero end
                        end)
                    end
                end
            end
        end
    end
    function api:Destroy()
        self:Stop()
        self.Destroyed = true
        for _, connection in ipairs(connections) do pcall(function() connection:Disconnect() end) end
        table.clear(connections)
        bodyMover = nil
    end
    -- Hooks become inert after Stop; their shared registry prevents stacked hooks on re-execute.
    connections[1] = LocalPlayer.CharacterRemoving:Connect(function(character)
        if character == activeCharacter then api:Stop() end
    end)
    connections[2] = RunService.PreSimulation:Connect(function()
        if api.Active then api:Step(activeCharacter, activeRoot) end
    end)
    for _, connection in ipairs(connections) do table.insert(Hunter._connections, connection) end
    task.spawn(function() if not api.Destroyed then api:Prepare() end end)
    return api
end)()

local LOW_HP_ESCAPE_CFG = {
    TriggerHealth = 4000,
    InitialHeightOffset = 450,
    ClimbSpeed = 220,
}
local _lowHpEscapeRoot, _lowHpEscapeCharacter = nil, nil
local _lowHpSkyStarted = false
local _lowHpSkyCFrame = nil
local _lowHpLastHopAttempt = -math.huge
local _lowHpListenerGeneration = 0

local function lowHpStatus(phase, reason)
    local old = Hunter.LowHealthStatus
    if not old or old.Phase ~= phase or old.Reason ~= reason then
        Hunter.LowHealthStatus = {Phase = phase, Reason = reason, Since = os.clock(), Active = Hunter._isHealingInSky == true}
        print("[TrashHub][LOW_HEALTH] Phase=" .. phase .. " Reason=" .. tostring(reason or ""))
    end
end
local function stopLowHealthCombat()
    local heldKey = Hunter._skillHeldKey
    Hunter._skillHeldKey = nil
    isSkillHolding = false
    Hunter._isPreparingSkillCast = false
    Hunter._combatPhase = "LOW_HEALTH_RETREAT"
    if heldKey then
        pcall(function() VirtualInputManager:SendKeyEvent(false, heldKey, false, game) end)
    end
    pcall(function() VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0) end)
    pcall(function() Hunter.Kinematics:Reset() end)
    if Hunter.Motion then pcall(Hunter.Motion.Reset, Hunter.Motion) end
end
local function releaseLowHealthEscape(reason)
    if Hunter.LowHealthGuard then Hunter.LowHealthGuard:Stop() end
    _lowHpSkyCFrame = nil
    Hunter._isHealingInSky = false
    _lowHpEscapeRoot, _lowHpEscapeCharacter = nil, nil
    _lowHpSkyStarted = false
    _lowHpLastHopAttempt = -math.huge
    lowHpStatus("idle", reason)
end
local function handleLowHealthEscape(root, hum)
    if not Hunter._isRunning or isHopping or Hunter._isHealingInSky then return false end
    local character, liveHum, liveRoot = getCharacter()
    if not character or character ~= LocalPlayer.Character then return false end
    hum, root = liveHum, liveRoot
    if not hum or hum.Parent ~= character or hum.Health <= 0 or hum.Health > LOW_HP_ESCAPE_CFG.TriggerHealth then return false end
    Hunter._isHealingInSky = true
    _lowHpEscapeCharacter, _lowHpEscapeRoot = character, root
    _lowHpSkyCFrame = nil
    _lowHpSkyStarted = false
    _lowHpLastHopAttempt = -math.huge
    Hunter.LowHealthTelemetry = {Health = hum.Health, DetectedAt = os.clock()}
    stopLowHealthCombat()
    if Hunter.PortalRuntime then Hunter.PortalRuntime.Cancel("low-health") end
    pcall(function()
        Hunter.TargetSuspended = true
        Hunter.TargetPart = nil
        Hunter.PredictedPos = nil
        if Hunter.TargetPlayer then
            Hunter.TargetLockStatus = {Phase = "waiting", PlayerName = Hunter.TargetPlayer.Name, Reason = "health-retreat"}
        end
        setHover(true)
    end)
    lowHpStatus("requested", "health-at-or-below-4000")
    if LOW_HP_ESCAPE_CFG.TryLift then LOW_HP_ESCAPE_CFG.TryLift() end
    return true
end
local function checkLowHealthEscape()
    if not Hunter._isRunning then return false end
    local character, hum = getCharacter()
    if _lowHpEscapeCharacter and character ~= _lowHpEscapeCharacter then releaseLowHealthEscape("character-changed") end
    if hum and hum.Health <= 0 then
        if Hunter._isHealingInSky then releaseLowHealthEscape("character-died") end
        return false
    end
    if not Hunter._isHealingInSky and hum and hum.Health > 0 and hum.Health <= LOW_HP_ESCAPE_CFG.TriggerHealth then
        handleLowHealthEscape(nil, hum)
    end
    if Hunter._isHealingInSky then
        Hunter.TargetSuspended = true
        Hunter.TargetPart = nil
        Hunter.PredictedPos = nil
        if LOW_HP_ESCAPE_CFG.TryLift then LOW_HP_ESCAPE_CFG.TryLift() end
    end
    return Hunter._isHealingInSky == true
end

LOW_HP_ESCAPE_CFG.TryLift = function()
    if not Hunter._isRunning or not Hunter._isHealingInSky or isHopping then return false end
    local character, hum, root = getCharacter()
    if not root or not hum or hum.Health <= 0 or root.Parent ~= character then return false end
    if root ~= _lowHpEscapeRoot then _lowHpEscapeRoot, _lowHpSkyStarted, _lowHpSkyCFrame = root, false, nil end
    if _lowHpSkyStarted then return true end
    local guard = Hunter.LowHealthGuard
    if guard then guard:Start(character, root, hum); guard:Step(character, root) end
    if isLocalPlayerInPortalDimension() or _isPortalWarping then return false end
    local clientLocksBlocked = guard and guard.Active and guard.HookStatus == "installed" and guard.PositionHookStatus == "installed"
    if root.Anchored or (not clientLocksBlocked and Hunter.StunCheck and Hunter.StunCheck.IsServerPhysicsLocked(character)) then return false end
    local route = Hunter.GhostShipRoute
    if route and (route:IsInside(root.Position) or route:DeferLowHealth()) then return false end
    if route and route.Busy then route:Reset("sky-retreat") end
    setHover(true)
    if guard then guard:ArmPositionProtection() end
    if Hunter.Noclip then Hunter.Noclip:Apply() end
    local currentCFrame = root.CFrame
    local position = currentCFrame.Position
    root.CFrame = CFrame.new(position.X, position.Y + LOW_HP_ESCAPE_CFG.InitialHeightOffset, position.Z) * (currentCFrame - position)
    root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
    _lowHpSkyStarted, _lowHpSkyCFrame = true, root.CFrame
    if Hunter.Motion then Hunter.Motion:Reset() end
    local telemetry = Hunter.LowHealthTelemetry or {}
    telemetry.LiftAt = os.clock()
    telemetry.DelayMs = telemetry.DetectedAt and (telemetry.LiftAt - telemetry.DetectedAt) * 1000 or nil
    Hunter.LowHealthTelemetry = telemetry
    lowHpStatus("climbing", "instant-lift-complete")
    return true
end

LOW_HP_ESCAPE_CFG.Climb = function(dt, root)
    if not Hunter._isRunning or not Hunter._isHealingInSky or not root or not root.Parent or root.Anchored then return false end
    setHover(true)
    if _lowHpSkyCFrame and (root.Position - _lowHpSkyCFrame.Position).Magnitude > 90 and Hunter.Motion then Hunter.Motion:Reset() end
    local position = root.Position
    local nextCF = Hunter.Motion:Frame("LOW_HEALTH_ESCAPE", dt, root, position + Vector3.new(0, 3000, 0),
        position + root.CFrame.LookVector * 100, LOW_HP_ESCAPE_CFG.ClimbSpeed)
    if nextCF then root.CFrame = nextCF end
    _lowHpSkyCFrame = root.CFrame
    root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
    lowHpStatus("climbing", "waiting-for-safe-hop")
    return true
end

local function stepLowHealthEscape(dt)
    if not checkLowHealthEscape() then return false end
    local character, hum, root = getCharacter()
    if not root or not hum or root.Parent ~= character then lowHpStatus("waiting-character", "root-unavailable"); return true end
    if root ~= _lowHpEscapeRoot then
        _lowHpEscapeRoot, _lowHpSkyStarted, _lowHpSkyCFrame = root, false, nil
    end
    if Hunter.LowHealthGuard then
        Hunter.LowHealthGuard:Start(character, root, hum)
        Hunter.LowHealthGuard:Step(character, root)
    end
    if isHopping then lowHpStatus("hopping", "teleport-in-progress"); return true end
    if isLocalPlayerInPortalDimension() then
        if Hunter.LowHealthGuard then Hunter.LowHealthGuard:DisarmPositionProtection() end
        setHover(true)
        lowHpStatus("waiting-dimension-exit", "combat-paused-in-portal-v")
        return true
    end
    if _isPortalWarping then
        if Hunter.LowHealthGuard then Hunter.LowHealthGuard:DisarmPositionProtection() end
        setHover(true)
        lowHpStatus("waiting-portal", "finishing-current-portal-action")
        return true
    end
    local guard = Hunter.LowHealthGuard
    local clientLocksBlocked = guard and guard.Active and guard.HookStatus == "installed" and guard.PositionHookStatus == "installed"
    if root.Anchored or (not clientLocksBlocked and Hunter.StunCheck and Hunter.StunCheck.IsServerPhysicsLocked(character)) then
        setHover(true, true)
        lowHpStatus("waiting-stun", "combat-paused-until-physics-unlock")
        return true
    end
    local route = Hunter.GhostShipRoute
    if route then
        if route:IsInside(root.Position) then
            if Hunter.LowHealthGuard then Hunter.LowHealthGuard:DisarmPositionProtection() end
            local requested = route:RequestExit("LOW_HEALTH")
            setHover(true)
            lowHpStatus(requested and "exiting-room" or "waiting-room-exit", "combat-paused")
            if requested then route:Step(dt, root, hum, nil, nil) end
            return true
        end
        if route:DeferLowHealth() then
            if Hunter.LowHealthGuard then Hunter.LowHealthGuard:DisarmPositionProtection() end
            setHover(true)
            lowHpStatus("exiting-room", "waiting-for-door-settle")
            route:Step(dt, root, hum, nil, nil)
            return true
        end
        if route.Busy then route:Reset("sky-retreat") end
        route:ConsumeLowHealthExit(root)
    end
    setHover(true)
    if Hunter.LowHealthGuard then Hunter.LowHealthGuard:ArmPositionProtection() end
    LOW_HP_ESCAPE_CFG.TryLift()
    LOW_HP_ESCAPE_CFG.Climb(dt, root)
    if not isBountyAtRisk() and type(autoHopServer) == "function" and os.clock() - _lowHpLastHopAttempt >= 1 then
        _lowHpLastHopAttempt = os.clock()
        local ok, accepted = pcall(autoHopServer, "LowHealthRetreat")
        if not ok or accepted ~= true then
            lowHpStatus("climbing", ok and "hop-not-started-retrying" or "hop-error-retrying")
        else
            lowHpStatus("hopping", "teleport-request-accepted")
        end
    end
    return true
end
Hunter.LowHealthEscape = {Check = checkLowHealthEscape, Step = stepLowHealthEscape, Stop = releaseLowHealthEscape, ContinueClimb = LOW_HP_ESCAPE_CFG.Climb}

if getgenv()._TrashHub_LowHpHeartbeat then
    pcall(function() getgenv()._TrashHub_LowHpHeartbeat:Disconnect() end)
end
getgenv()._TrashHub_LowHpHeartbeat = RunService.Heartbeat:Connect(function(dt)
    if not Hunter._isRunning then return end
    local ok, err = pcall(stepLowHealthEscape, dt)
    if not ok then
        if os.clock() - (Hunter._lowHealthLastErrorAt or -math.huge) >= 3 then
            Hunter._lowHealthLastErrorAt = os.clock()
            warn("[TrashHub][LOW_HEALTH_ERROR] " .. tostring(err))
        end
    end
end)
table.insert(Hunter._connections, getgenv()._TrashHub_LowHpHeartbeat)
table.insert(Hunter._connections, RunService.PreSimulation:Connect(function()
    if Hunter._isRunning then pcall(checkLowHealthEscape) end
end))

local function setupLowHealthEscapeListener(character)
    if not Hunter._isRunning or not character or character ~= LocalPlayer.Character then return end
    _lowHpListenerGeneration += 1
    local generation = _lowHpListenerGeneration
    local oldConnections = getgenv()._TrashHub_HealthConns
