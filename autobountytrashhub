local function _resolveHopRegion()
    local raw = nil
    if type(getgenv) == "function" then
        local ahc = getgenv().AutoHopConfig
        local thc = getgenv().TrashHubConfig or getgenv().CONFIG
        if type(ahc) == "table" and ahc.TargetRegion ~= nil and ahc.TargetRegion ~= "" then
            raw = ahc.TargetRegion
        elseif type(thc) == "table" and thc.TargetRegion ~= nil and thc.TargetRegion ~= "" then
            raw = thc.TargetRegion
        end
    end
    if not raw or raw == "" then
        if HOP_CONFIG.TargetRegion and HOP_CONFIG.TargetRegion ~= "Singapore" then
            raw = HOP_CONFIG.TargetRegion
        elseif CONFIG and CONFIG.TargetRegion ~= nil and CONFIG.TargetRegion ~= "" then
            raw = CONFIG.TargetRegion
        else
            raw = HOP_CONFIG.TargetRegion or "Singapore"
        end
    end

    local rawList = {}
    if type(raw) == "table" then
        for _, item in ipairs(raw) do
            if type(item) == "string" and item ~= "" then
                table.insert(rawList, item)
            end
        end
    elseif type(raw) == "string" then
        for part in raw:gmatch("[^,/|]+") do
            local trimmed = part:match("^%s*(.-)%s*$")
            if trimmed and trimmed ~= "" then
                table.insert(rawList, trimmed)
            end
        end
    end
    if #rawList == 0 then
        table.insert(rawList, "Singapore")
    end

    local displayParts = {}
    local filterList = {}
    for _, name in ipairs(rawList) do
        local norm = name:lower():gsub("[%s_%-]+", "")
        if norm == "hongkong" or norm == "hk" then
            table.insert(displayParts, "Hong Kong")
            table.insert(filterList, "hongkong")
        elseif norm == "singapore" or norm == "sg" then
            table.insert(displayParts, "Singapore")
            table.insert(filterList, "singapore")
        elseif norm == "all" or norm == "any" or norm == "*" then
            table.insert(displayParts, "All")
            table.insert(filterList, "")
        else
            table.insert(displayParts, name)
            table.insert(filterList, norm)
        end
    end

    local display = table.concat(displayParts, ", ")
    return display, filterList
end

local function scanHopServers()
    local serverBrowser = ReplicatedStorage:FindFirstChild("__ServerBrowser")
    if not serverBrowser or not serverBrowser:IsA("RemoteFunction") then
        return {}, "__ServerBrowser RemoteFunction unavailable"
    end
    pruneHopBlacklist()
    local currentJobId = game.JobId
    pcall(function()
        local remoteJobId = serverBrowser:InvokeServer("getjob")
        if type(remoteJobId) == "string" and remoteJobId ~= "" then currentJobId = remoteJobId end
    end)
    if currentJobId and currentJobId ~= "" then hopBlacklist[currentJobId] = os.time() end

    local _, regionFilterList = _resolveHopRegion()
    local minPlayers = tonumber(HOP_CONFIG.MinPlayers) or 8
    local maxPlayers = tonumber(HOP_CONFIG.MaxPlayers) or 10
    local minBounty = tonumber(HOP_CONFIG.MinBounty) or 15000000
    local maxBounty = tonumber(HOP_CONFIG.MaxBounty) or 50000000
    local totalBuckets = math.clamp(math.floor(tonumber(HOP_CONFIG.MaxBuckets) or 100), 1, 100)
    local candidates, candidateIds = {}, {}
    local scannedBuckets, stopScan = 0, false
    local scanStartedAt = tick()

    for bucket = 1, totalBuckets do
        task.spawn(function()
            local ok, result = pcall(function() return serverBrowser:InvokeServer(bucket) end)
            if ok and type(result) == "table" and not stopScan then
                for jobId, data in pairs(result) do
                    if stopScan then break end
                    if type(jobId) == "string" and #jobId > 20 and jobId ~= game.JobId
                        and not hopBlacklist[jobId] and not candidateIds[jobId] and type(data) == "table"
                    then
                        local region = tostring(data.Region or "")
                        local regionNorm = region:lower():gsub("[%s_%-]+", "")
                        local count = tonumber(data.Count) or 0
                        local bounty = tonumber(data.Bounty) or 0
                        local isRegionMatched = false
                        if #regionFilterList == 0 then
                            isRegionMatched = true
                        else
                            for _, filterNorm in ipairs(regionFilterList) do
                                if filterNorm == "" or regionNorm:find(filterNorm, 1, true) ~= nil then
                                    isRegionMatched = true
                                    break
                                end
                            end
                        end

                        if isRegionMatched
                            and count >= minPlayers and count <= maxPlayers
                            and bounty >= minBounty and bounty <= maxBounty
                        then
                            candidateIds[jobId] = true
                            table.insert(candidates, {
                                JobId = jobId, Region = region, Count = count, Bounty = bounty,
                                BountyText = string.format("%.1fM", bounty / 1000000),
                            })
                            if HOP_CONFIG.FastHopFirstFound then stopScan = true; break end
                        end
                    end
                end
            end
            scannedBuckets = scannedBuckets + 1
        end)
        if bucket % 25 == 0 then task.wait(0.02) end
    end
    while not stopScan and scannedBuckets < totalBuckets and tick() - scanStartedAt < 2.2 do
        if #candidates >= 3 and tick() - scanStartedAt >= 1.2 then break end
        task.wait(0.05)
    end
    stopScan = true
    if HOP_CONFIG.SortByHighestBounty then
        table.sort(candidates, function(a, b)
            if a.Bounty == b.Bounty then return a.Count > b.Count end
            return a.Bounty > b.Bounty
        end)
    end
    return candidates
end
autoHopServer = function(reason)
    pcall(saveStatsToJson)
    pcall(function()
        local parentGui = (type(gethui) == "function" and gethui()) or game:GetService("CoreGui")
        if parentGui then
            local oldGui = parentGui:FindFirstChild("BF_HunterTargetMenu")
            if oldGui then oldGui:Destroy() end
        end
    end)
    if isHopping then return end
    if isLocalPlayerInPortalDimension() then return end
    isHopping = true
    Hunter.Kinematics:Reset()
    Hunter.TargetPlayer = nil
    Hunter.TargetCharacter = nil
    Hunter.TargetPart = nil
    task.spawn(function()
        pcall(function()
            local _, myHum, myRoot = getCharacter()
            if not myRoot then
                isHopping = false
                return
            end
            if Hunter.GhostShipRoute:IsInside(myRoot.Position) then
                Hunter.GhostShipRoute:RequestExit("SERVER_HOP")
            else
                Hunter.GhostShipRoute:Reset("server-hop")
            end
            pcall(function()
                if Hunter.GhostShipRoute:IsInside(myRoot.Position) then return end
                local curCF = myRoot.CFrame
                local curPos = curCF.Position
                local rotOnly = curCF - curPos
                myRoot.CFrame = CFrame.new(curPos.X, curPos.Y + 250, curPos.Z) * rotOnly
                myRoot.AssemblyLinearVelocity = Vector3.zero
                myRoot.AssemblyAngularVelocity = Vector3.zero
            end)

            local hopConn
            TrashHubNotify.NotifyHopStatus("Waiting for safe teleport", "Climbing to safe sky (+250Y)")
            hopConn = RunService.RenderStepped:Connect(function(dt)
                if not isHopping or not Hunter._isRunning then
                    if hopConn then hopConn:Disconnect() end
                    return
                end
                local _, hum, root = getCharacter()
                if root then
                    if isLocalPlayerInPortalDimension() then
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        return
                    end
                    if Hunter.GhostShipRoute:IsInside(root.Position) or Hunter.GhostShipRoute.Busy then
                        Hunter.GhostShipRoute:RequestExit("SERVER_HOP")
                        Hunter.Kinematics:Pause()
                        setHover(true)
                        Hunter.GhostShipRoute:Step(dt, root, hum, nil, nil)
                        return
                    end
                    local hopAscendSpeed = 220
                    local clampedDt = math.clamp(dt, 0, 0.033)
                    local newPos = root.Position + Vector3.new(0, hopAscendSpeed * clampedDt, 0)
                    root.CFrame = CFrame.new(newPos) * (root.CFrame - root.CFrame.Position)
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end
            end)

            local _hopWaitStart = tick()
            while isBountyAtRisk() and Hunter._isRunning do
                local _, myHumWait, myRootWait = getCharacter()
                if myRootWait then
                    myRootWait.AssemblyLinearVelocity = Vector3.zero
                    myRootWait.AssemblyAngularVelocity = Vector3.zero
                end
                if tick() - _hopWaitStart > 60 then
                    TrashHubNotify.NotifyHopStatus("Timeout 60s - Force Hopping", "Bypassing Bounty At Risk wait", FLUENT_ACCENTS.Warning)
                    break
                end
                TrashHubNotify.NotifyStatus("Bounty At Risk", "Waiting for safe teleport", FLUENT_ACCENTS.Hop, "Action", "Waiting for combat tag to clear...")
                task.wait(0.5)
            end

            local originalJobId = game.JobId
            local activeAttempt = nil
            local teleportInitConn = TeleportService.TeleportInitFailed:Connect(function(player, result, errorMessage, placeId, teleportOptions)
                local ctx = activeAttempt
                if player ~= LocalPlayer or not ctx then return end
                if tonumber(placeId) and tonumber(placeId) ~= game.PlaceId then return end
                local failedJobId = nil
                pcall(function() failedJobId = teleportOptions and teleportOptions.ServerInstanceId end)
                if failedJobId and failedJobId ~= "" and failedJobId ~= ctx.jobId then return end
                ctx.failed = true
                ctx.error = tostring(result) .. ": " .. tostring(errorMessage or "")
            end)
            local teleportStateConn = LocalPlayer.OnTeleport:Connect(function(state)
                local ctx = activeAttempt
                if not ctx then return end
                local stateName = string.lower(tostring(state))
                if stateName:find("failed", 1, true) then
                    ctx.failed = true
                    ctx.error = tostring(state)
                elseif stateName:find("started", 1, true) or stateName:find("waiting", 1, true)
                    or stateName:find("progress", 1, true) then
                    ctx.started = true
                    ctx.startedAt = ctx.startedAt or tick()
                end
            end)
            while game.JobId == originalJobId and Hunter._isRunning do
                if isBountyAtRisk() then
                    TrashHubNotify.NotifyStatus("Bounty At Risk", "Waiting for safe teleport", FLUENT_ACCENTS.Warning, "Action", "Waiting for combat tag to clear...")
                    task.wait(0.25)
                    continue
                end
                local regionDisplay, _ = _resolveHopRegion()
                TrashHubNotify.NotifyHopStatus(
                    "Scanning servers...",
                    string.format("Region: %s | %d-%d Players", tostring(regionDisplay), tonumber(HOP_CONFIG.MinPlayers) or 8, tonumber(HOP_CONFIG.MaxPlayers) or 10)
                )
                local candidates = scanHopServers()
                if #candidates == 0 then
                    if not HOP_CONFIG.RetryIfNotFound then break end
                    task.wait(math.max(tonumber(HOP_CONFIG.RetryDelaySeconds) or 3, 0.25))
                    continue
                end

                for _, chosen in ipairs(candidates) do
                    if game.JobId ~= originalJobId or not Hunter._isRunning then break end
                    if isBountyAtRisk() then break end
                    local targetJobId = chosen.JobId
                    if type(targetJobId) == "string" and #targetJobId > 20
                        and targetJobId ~= game.JobId and not hopBlacklist[targetJobId]
                    then
                        hopBlacklist[targetJobId] = os.time()
                        local ctx = { jobId = targetJobId, started = false, failed = false, error = "" }
                        activeAttempt = ctx
                        TrashHubNotify.NotifyHopStatus(
                            "Teleporting to server...",
                            string.format("%s | %d Players (%s)", tostring(chosen.Region or "Server"), tonumber(chosen.Count) or 0, tostring(chosen.BountyText or "?")),
                            FLUENT_ACCENTS.Earned
                        )

                        local requestStartedAt = tick()
                        local serverBrowser = ReplicatedStorage:FindFirstChild("__ServerBrowser")
                        local canUseNativeRemote = serverBrowser and serverBrowser:IsA("RemoteFunction")
                        if canUseNativeRemote then
                            task.spawn(function()
                                local ok, err = pcall(function()
                                    serverBrowser:InvokeServer("teleport", targetJobId)
                                end)
                                ctx.remoteDone = true
                                if not ok then ctx.remoteError = tostring(err) end
                            end)
                        end
                        local fallbackAt = requestStartedAt + (canUseNativeRemote and 3.5 or 0)
                        local attemptDeadline = requestStartedAt + 13.5
                        while game.JobId == originalJobId and tick() < attemptDeadline
                            and Hunter._isRunning and not ctx.failed
                        do
                            if ctx.started then
                                if tick() - (ctx.startedAt or requestStartedAt) >= 10 then
                                    ctx.failed = true
                                    ctx.error = "Teleport handoff timed out"
                                    break
                                end
                            elseif not ctx.fallbackRequested and tick() >= fallbackAt then
                                ctx.fallbackRequested = true
                                local ok, err = pcall(function()
                                    TeleportService:TeleportToPlaceInstance(game.PlaceId, targetJobId, LocalPlayer)
                                end)
                                if not ok then
                                    ctx.failed = true
                                    ctx.error = tostring(err)
                                else
                                    ctx.fallbackAt = tick()
                                end
                            elseif ctx.fallbackRequested and not ctx.started
                                and tick() - (ctx.fallbackAt or requestStartedAt) >= 8
                            then
                                ctx.failed = true
                                ctx.error = "No teleport acknowledgement"
                                break
                            end
                            task.wait(0.05)
                        end
                        if game.JobId ~= originalJobId then break end
                        if not ctx.failed then
                            ctx.failed = true
                            ctx.error = "Teleport attempt timed out"
                        end
                        if activeAttempt == ctx then activeAttempt = nil end
                        task.wait(0.1)
                    end
                end
                if game.JobId == originalJobId and Hunter._isRunning then
                    task.wait(math.max(tonumber(HOP_CONFIG.RetryDelaySeconds) or 3, 0.25))
                end
            end
            activeAttempt = nil
            pcall(function() teleportInitConn:Disconnect() end)
            pcall(function() teleportStateConn:Disconnect() end)
            if hopConn then hopConn:Disconnect() end
        end)
        task.wait(1.5)
        isHopping = false
    end)
end
