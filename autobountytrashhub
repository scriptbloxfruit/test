local extractVictimKey, scanNotificationsForVictimEarned, updateBountyStats
do
local _recentNotifEarnedByVictim = {}
local _lastNotifEarnedVal = nil
local _lastNotifEarnedTick = 0

extractVictimKey = function(rawVictim)
    if not rawVictim or type(rawVictim) ~= "string" then return "" end
    local atUser = rawVictim:match("@([%w_]+)")
    if atUser and atUser ~= "" then
        return atUser:lower()
    end
    local clean = rawVictim:gsub("<[^>]->", ""):gsub("[%.!]", ""):match("^%s*(.-)%s*$") or ""
    return clean:lower()
end

local function extractEarnedAmount(s)
    if not s or s == "" then return nil end
    local numStr = s:match("([%d,%.]+)%s*[Bb]ounty")
        or s:match("([%d,%.]+)%s*[Hh]onor")
        or s:match("[Ee]arned[^%d]-([%d,%.]+)%s*[Bb]ounty")
        or s:match("[Ee]arned[^%d]-([%d,%.]+)%s*[Hh]onor")
        or s:match("[Ee]arned%s*:%s*%+?([%d,%.]+)")
        or s:match("[Ee]arned%s+%+?([%d,%.]+)")
    if numStr then
        local digits = numStr:gsub("[^%d]", "")
        local val = tonumber(digits)
        if val and val > 0 then return val end
    end
    return nil
end

local function parseKillNotificationText(rawText, contentText)
    local t1 = tostring(rawText or ""):gsub("<[^>]->", "")
    local t2 = tostring(contentText or ""):gsub("<[^>]->", "")
    local clean = (#t1 > 0 and t1:lower():find("killing", 1, true)) and t1
        or ((#t2 > 0 and t2:lower():find("killing", 1, true)) and t2 or "")
    if clean == "" then
        return nil, nil, nil
    end

    local victim = clean:match("killing%s+([%w_]+)") or clean:match("killing%s+(.-)[%.!%s]*$")
    if not victim or victim == "" then
        return nil, nil, nil
    end
    local cleanVictim = victim:gsub("[%.!]", ""):match("^%s*(.-)%s*$")
    if not cleanVictim or cleanVictim == "" then
        return nil, nil, nil
    end

    local earnedVal = extractEarnedAmount(t1) or extractEarnedAmount(t2)
    if not earnedVal or earnedVal <= 0 then
        local curBounty = getPlayerBounty and getPlayerBounty(LocalPlayer) or 0
        if curBounty >= 30000000 then
            earnedVal = 10000
        end
    end
    return cleanVictim, earnedVal, clean
end

scanNotificationsForVictimEarned = function(targetVictim)
    local targetKey = extractVictimKey(targetVictim)
    if targetKey ~= "" and _recentNotifEarnedByVictim[targetKey] then
        local entry = _recentNotifEarnedByVictim[targetKey]
        if entry.earned and entry.earned > 0 and not entry.consumed and (tick() - (entry.tick or 0) < 6.0) then
            return entry.earned, entry.victimDisplay
        end
    end
    local foundEarned, foundVictim = nil, nil
    pcall(function()
        local pg = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
        if not pg then return end
        for _, child in ipairs(pg:GetChildren()) do
            if child.Name == "Notifications" then
                for _, desc in ipairs(child:GetDescendants()) do
                    if desc:IsA("TextLabel") and desc.Text ~= "" then
                        local cText = ""
                        pcall(function() cText = desc.ContentText end)
                        local cleanVictim, earnedVal = parseKillNotificationText(desc.Text, cText)
                        if cleanVictim and earnedVal and earnedVal > 0 then
                            local vKey = cleanVictim:lower()
                            local entry = _recentNotifEarnedByVictim[vKey]
                            if not entry or not entry.consumed then
                                _recentNotifEarnedByVictim[vKey] = {
                                    earned = earnedVal,
                                    tick = tick(),
                                    victimDisplay = cleanVictim,
                                    consumed = false
                                }
                            end
                            if targetKey ~= "" and (vKey == targetKey or targetKey:find(vKey, 1, true) or vKey:find(targetKey, 1, true)) then
                                if not _recentNotifEarnedByVictim[vKey].consumed then
                                    foundEarned = earnedVal
                                    foundVictim = cleanVictim
                                    break
                                end
                            end
                        end
                    end
                end
                if foundEarned then break end
            end
        end
    end)
    return foundEarned, foundVictim
end

updateBountyStats = function(explicitVictim, overrideEarned)
    local cur = getPlayerBounty(LocalPlayer)
    if not cur or cur <= 0 then return end

    if not _lastKnownBounty or _lastKnownBounty == 0 then
        _lastKnownBounty = cur
        saveStatsToJson()
