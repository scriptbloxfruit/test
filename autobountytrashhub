local function tryExecuteSniper(distToTarget, realTargetPos, targetChar, targetPart, comboTriggerDist)
    if Hunter.LowHealthEscape and Hunter.LowHealthEscape.Check() then return false end
    if not Hunter._isRunning or isHopping or _isPortalWarping or Hunter._isHealingInSky or Hunter._isGhostShipRouting then
        return false
    end
    if not targetPart or not targetPart.Parent or not isAlive(targetChar) then
        return false
    end
    local myChar, myHum, myRoot = getCharacter()
    if not myChar or not myHum or myHum.Health <= 0 or not myRoot then
        return false
    end
    if Hunter.IsActionLocked and Hunter.IsActionLocked(myChar) then
        return false
    end
    if Hunter.SkillDodge and Hunter.SkillDodge:IsEnemySkillDodging() then
        return false
    end

    local sword = getToolByType("Sword")
    local gun = getToolByType("Gun")
    local fruitName, fruit = getEquippedFruitName()

    local isBuddy = isBuddySword(sword)
    local isGuitar = isSoulGuitar(gun)
    local isSpider = (fruitName == "Spider")

    -- Only allow long-range sniper skills: Buddy X, Spider C, Soul Guitar Z.
    -- Pole V2 X and other short-range skills are explicitly excluded!
    if not isBuddy and not isSpider and not isGuitar then
        return false
    end

    local skillsCfg = (Hunter.Config and Hunter.Config.Skills) or CONFIG.Skills
    local minSnipeDist = comboTriggerDist or 35
    local candidates = {}

    -- 1. Spider Fruit C (Over-heated Sniper / Eternal White) - Safe Range: minSnipeDist to 700 studs
    if isSpider and fruit then
        local kC = skillsCfg and skillsCfg.Fruit and skillsCfg.Fruit.C
        if not kC or kC.Enable ~= false then
            table.insert(candidates, {
                Weapon = "Fruit",
                Tool = fruit,
                Key = "C",
                Hold = (kC and tonumber(kC.HoldTime)) or 0.15,
                Count = (kC and tonumber(kC.Count)) or 2,
                CountInterval = math.max((kC and tonumber(kC.CountInterval)) or 0.05, 0.035),
                DelayChange = (kC and tonumber(kC.DelayChange)) or 0.15,
                MaxRange = 700,
                MinRange = minSnipeDist,
                Priority = 1,
            })
        end
    end

    -- 2. Buddy Sword X (Lightning Wave) - Safe Range: minSnipeDist to 700 studs
    if isBuddy and sword then
        local kX = skillsCfg and skillsCfg.Sword and skillsCfg.Sword.X
        if not kX or kX.Enable ~= false then
            table.insert(candidates, {
                Weapon = "Sword",
                Tool = sword,
                Key = "X",
                Hold = (kX and tonumber(kX.HoldTime)) or 0.15,
                Count = (kX and tonumber(kX.Count)) or 2,
                CountInterval = math.max((kX and tonumber(kX.CountInterval)) or 0.05, 0.035),
                DelayChange = (kX and tonumber(kX.DelayChange)) or 0.15,
                MaxRange = 700,
                MinRange = minSnipeDist,
                Priority = 2,
            })
        end
    end

    -- 3. Soul Guitar Z (Soul Shaker) - Safe Range: minSnipeDist to 650 studs
    if isGuitar and gun then
        local kZ = skillsCfg and skillsCfg.Gun and skillsCfg.Gun.Z
        if not kZ or kZ.Enable ~= false then
            table.insert(candidates, {
                Weapon = "Gun",
                Tool = gun,
                Key = "Z",
                Hold = (kZ and tonumber(kZ.HoldTime)) or 0.15,
                Count = (kZ and tonumber(kZ.Count)) or 2,
                CountInterval = math.max((kZ and tonumber(kZ.CountInterval)) or 0.05, 0.035),
                DelayChange = (kZ and tonumber(kZ.DelayChange)) or 0.15,
                MaxRange = 650,
                MinRange = minSnipeDist,
                Priority = 3,
            })
        end
    end

    if #candidates == 0 then
        return false
    end

    table.sort(candidates, function(a, b)
        return a.Priority < b.Priority
    end)

    for _, cand in ipairs(candidates) do
        if distToTarget <= cand.MaxRange and distToTarget >= cand.MinRange then
            local currentTool = getToolByType(cand.Weapon) or cand.Tool
            if currentTool and isSkillReady(currentTool, cand.Weapon, cand.Key, true) then
                Hunter._isPreparingSkillCast = true
                Hunter._combatPhase = "SNIPER:" .. cand.Weapon .. "_" .. cand.Key
                autoActivateBuffs()
                local targetSnapshot = Hunter.TargetPlayer
                local wasAlreadyEquipped = (currentTool.Parent == LocalPlayer.Character)
                local equippedTool = equipWeapon(cand.Weapon)
                if equippedTool then
                    local waitDelay = wasAlreadyEquipped and 0 or math.min(cand.DelayChange or 0.15, 0.02)
                    if waitDelay > 0 then
                        task.wait(waitDelay)
                    end
                    local refreshedPart = Hunter.TargetPart
                    local refreshedChar, _, refreshedRoot = getCharacter()
                    local refreshedTargetPos = (Hunter.PortalXTracker and Hunter.TargetPlayer and Hunter.PortalXTracker.GetRealPosition(Hunter.TargetPlayer))
                        or (refreshedPart and refreshedPart.Position)
                    local canCast = Hunter._isRunning and not isHopping
                        and not Hunter._isHealingInSky and not _isPortalWarping and not Hunter._isGhostShipRouting
                        and not (Hunter.SkillDodge and Hunter.SkillDodge:IsEnemySkillDodging())
                        and Hunter.TargetPlayer == targetSnapshot
                        and refreshedPart and refreshedPart.Parent
                        and isAlive(Hunter.TargetCharacter)
                        and refreshedRoot and refreshedTargetPos ~= nil

                    if canCast then
                        local curDist = (refreshedTargetPos - refreshedRoot.Position).Magnitude
                        if curDist <= cand.MaxRange and curDist >= cand.MinRange then
                            local didCast = castSkillTap(
                                Enum.KeyCode[cand.Key],
                                cand.Hold,
                                cand.Count,
                                cand.CountInterval,
                                cand.Weapon,
                                cand.Key,
                                equippedTool,
                                cand.MaxRange
                            )
                            Hunter._isPreparingSkillCast = false
                            if didCast then
                                if Hunter.IsRaceV4Ready and Hunter.IsRaceV4Ready() then
                                    Hunter.TryActivateRaceV4(true)
                                end
                                task.wait(0.01)
                                return true
                            end
                        else
                            Hunter._isPreparingSkillCast = false
                        end
                    else
                        Hunter._isPreparingSkillCast = false
                    end
                else
                    Hunter._isPreparingSkillCast = false
                end
            end
        end
    end

    Hunter._isPreparingSkillCast = false
    return false
end

local function runSkillsOnlyLoop()
    if not Hunter._isRunning then return end
    if Hunter._skillLoopThread and coroutine.status(Hunter._skillLoopThread) ~= "dead" then return end
    Hunter._isSkillLoopRunning = true
    Hunter._skillLoopThread = task.spawn(function()
        local loopOk, loopError = xpcall(function()
        while Hunter._isRunning do
            if Hunter.LowHealthEscape and Hunter.LowHealthEscape.Check() then
                task.wait(0.03)
                continue
            end
            if Hunter.IsRaceV4Ready and Hunter.IsRaceV4Ready() then
                Hunter.TryActivateRaceV4(true)
            end
            local targetChar = Hunter.TargetCharacter
            local targetPart = Hunter.TargetPart
            if targetChar and targetPart and isAlive(targetChar) then
                local myChar, myHum, myRoot = getCharacter()
                if not (myRoot and myHum and myHum.Health > 0) then
                    task.wait(0.1)
                else
                    local isLocked, lockReason = false, nil
                    if Hunter.IsActionLocked then
                        isLocked, lockReason = Hunter.IsActionLocked(myChar)
                    end
                    local realTargetPos = (Hunter.PortalXTracker and Hunter.TargetPlayer and Hunter.PortalXTracker.GetRealPosition(Hunter.TargetPlayer)) or targetPart.Position
                    local dist = (realTargetPos - myRoot.Position).Magnitude
                    local triggerDist = Hunter.GunM1:GetComboDistance()
                    local comboTriggerDist = math.max(triggerDist, 35)

                    local amInDimension = isLocalPlayerInPortalDimension()
                    local targetInPortal = not amInDimension and Hunter.TargetPlayer ~= nil and isTargetUsingPortalDimension(Hunter.TargetPlayer)

                    if Hunter._isHealingInSky or _isPortalWarping or Hunter._isGhostShipRouting or targetInPortal then
                        Hunter._isPreparingSkillCast = false
                        task.wait(targetInPortal and 0.02 or 0.08)
                    elseif isLocked then
                        Hunter._isPreparingSkillCast = false
                        Hunter._combatPhase = "LOCKED:" .. tostring(lockReason or "StunOrGodhumanZ")
                        if not (Hunter.StunCheck and Hunter.StunCheck.IsInGodhumanZ(myChar)) then
                            activateRaceV3()
                        end
                        task.wait(0.03)
                    elseif dist <= comboTriggerDist and not (Hunter.SkillDodge and Hunter.SkillDodge:IsEnemySkillDodging()) then
                        Hunter._combatPhase = "COMBO"
                        Hunter._gunApproachReason = "combo-range"
                        autoActivateBuffs()
                        activateRaceV3()
                        local skillsCfg = (Hunter.Config and Hunter.Config.Skills) or CONFIG.Skills
                        local readySkillFound = false
                        if skillsCfg then
                            local orderedSkills = {}
                            for weaponName, wData in pairs(skillsCfg) do
                                if type(wData) == "table" and wData.Enable ~= false then
                                    local tool = getToolByType(weaponName)
                                    if tool then
                                        local isPortalFruit = (weaponName == "Fruit" and (tool.Name == "Portal-Portal" or (getEquippedFruitName and getEquippedFruitName(tool) == "Portal")))
                                        for keyName, kData in pairs(wData) do
                                            if keyName ~= "Enable" and keyName ~= "GunMode" and type(kData) == "table" and kData.Enable ~= false then
                                                -- Chặn Portal C: World Warp là chiêu mở bảng dịch chuyển bản đồ, tuyệt đối không dùng làm skill tấn công!
                                                if isPortalFruit and keyName == "C" then
                                                    continue
                                                end
                                                table.insert(orderedSkills, {
                                                    Tool = tool,
                                                    Weapon = weaponName,
                                                    Key = keyName,
                                                    Hold = tonumber(kData.HoldTime) or 0.15,
                                                    Priority = tonumber(kData.Priority) or (_SKILL_KEY_ORDER[keyName] or 99),
                                                    KeyOrder = _SKILL_KEY_ORDER[keyName] or 99,
                                                    WeaponOrder = _WEAPON_ORDER[weaponName] or 99,
                                                    Count = tonumber(kData.Count) or 2,
                                                    CountInterval = math.max(tonumber(kData.CountInterval) or 0.05, 0.05),
                                                    DelayChange = math.max(tonumber(kData.DelayChange) or 0.15, 0.15),
                                                })
                                            end
                                        end
                                    end
                                end
                            end
                            if #orderedSkills > 0 then
                                local activeMethod = tostring((Hunter.Config and Hunter.Config.SkillMethod) or CONFIG.SkillMethod or "Priority"):lower()
                                if activeMethod:find("rand") then
                                    for i = #orderedSkills, 2, -1 do
                                        local j = math.random(1, i)
                                        orderedSkills[i], orderedSkills[j] = orderedSkills[j], orderedSkills[i]
                                    end
                                else
                                    table.sort(orderedSkills, function(a, b)
                                        if a.Priority ~= b.Priority then
                                            return a.Priority < b.Priority
                                        end
                                        if a.WeaponOrder ~= b.WeaponOrder then
                                            return a.WeaponOrder < b.WeaponOrder
                                        end
                                        return a.KeyOrder < b.KeyOrder
                                    end)
                                end
                                for _, chosen in ipairs(orderedSkills) do
                                    if Hunter.IsRaceV4Ready and Hunter.IsRaceV4Ready() then
                                        Hunter.TryActivateRaceV4(true)
                                    end
                                    if not Hunter._isRunning or isHopping or Hunter._isHealingInSky
                                        or _isPortalWarping or Hunter._isGhostShipRouting
                                        or (Hunter.Sea3TeleporterRoute and Hunter.Sea3TeleporterRoute.Busy)
                                        or (Hunter.SkillDodge and (Hunter.SkillDodge:IsEnemySkillDodging() or Hunter.SkillDodge:IsSelfStunDodging()))
                                        or not isAlive(Hunter.TargetCharacter) then break end
                                    if Hunter.IsActionLocked and Hunter.IsActionLocked(LocalPlayer.Character) then
                                        waitUntilSkillAnimationDone(1.65)
                                        if Hunter.IsActionLocked and Hunter.IsActionLocked(LocalPlayer.Character) then
                                            break
                                        end
                                    end
                                    local currentTool = getToolByType(chosen.Weapon) or chosen.Tool
                                    if currentTool and isSkillReady(currentTool, chosen.Weapon, chosen.Key, true) then
                                        Hunter._isPreparingSkillCast = true
                                        local targetSnapshot = Hunter.TargetPlayer
                                        local wasAlreadyEquipped = (currentTool.Parent == LocalPlayer.Character)
                                        local equippedTool = equipWeapon(chosen.Weapon)
                                        if equippedTool then
                                            -- Smart weapon swap: 0 delay if tool already equipped, max 0.02s if freshly equipped
                                            local waitDelay = wasAlreadyEquipped and 0 or math.min(chosen.DelayChange, 0.02)
                                            if waitDelay > 0 then
                                                task.wait(waitDelay)
                                            end
                                            if Hunter.IsRaceV4Ready and Hunter.IsRaceV4Ready() then
                                                Hunter.TryActivateRaceV4(false)
                                            end

                                            local refreshedPart = Hunter.TargetPart
                                            local refreshedChar, _, refreshedRoot = getCharacter()
                                            local refreshedTargetPos = (Hunter.PortalXTracker and Hunter.TargetPlayer and Hunter.PortalXTracker.GetRealPosition(Hunter.TargetPlayer))
                                                or (refreshedPart and refreshedPart.Position)
                                            local targetStillValid = Hunter._isRunning and not isHopping
                                                and not Hunter._isHealingInSky and not _isPortalWarping and not Hunter._isGhostShipRouting
                                                and not (Hunter.Sea3TeleporterRoute and Hunter.Sea3TeleporterRoute.Busy)
                                                and not (Hunter.SkillDodge and Hunter.SkillDodge:IsEnemySkillDodging())
                                                and Hunter.TargetPlayer == targetSnapshot
                                                and refreshedPart and refreshedPart.Parent
                                                and refreshedTargetPos ~= nil
                                                and isAlive(Hunter.TargetCharacter)
                                                and refreshedRoot
                                                and (refreshedTargetPos - refreshedRoot.Position).Magnitude <= math.max(comboTriggerDist + 15, 45)

                                            if targetStillValid then
                                                local didCast = castSkillTap(Enum.KeyCode[chosen.Key], chosen.Hold, chosen.Count, chosen.CountInterval, chosen.Weapon, chosen.Key, equippedTool, math.max(comboTriggerDist + 15, 45))
                                                Hunter._isPreparingSkillCast = false
                                                if didCast then
                                                    readySkillFound = true
                                                    if Hunter.IsRaceV4Ready and Hunter.IsRaceV4Ready() then
                                                        Hunter.TryActivateRaceV4(true)
                                                    end
                                                    task.wait(0.01)
                                                end
                                            else
                                                Hunter._isPreparingSkillCast = false
                                            end
                                        else
                                            Hunter._isPreparingSkillCast = false
                                        end
                                    end
                                end
                            end
                        end
                        Hunter._isPreparingSkillCast = false
                        if not readySkillFound then
                            task.wait(0.025)
                        end
                    elseif Hunter.SoruApproach and Hunter.SoruApproach:IsPending(myRoot, myHum, targetPart) then
                        Hunter._isPreparingSkillCast = false
                        Hunter._combatPhase = "COMBO_APPROACH"
                        task.wait(0.02)
                    else
                        Hunter._isPreparingSkillCast = false
                        autoActivateBuffs()
                        Hunter._combatPhase = (Hunter.SkillDodge and Hunter.SkillDodge.ActiveMode) or "APPROACH"
                        local cfg = Hunter.Config or CONFIG

                        local didSnipe = false
                        if (cfg.SniperMode ~= false) and not (Hunter.SkillDodge and Hunter.SkillDodge:IsEnemySkillDodging()) then
                            didSnipe = tryExecuteSniper(dist, realTargetPos, targetChar, targetPart, comboTriggerDist)
                        end

