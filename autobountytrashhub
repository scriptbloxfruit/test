local function validPart(part, character)
    return typeof(part) == "Instance" and part:IsA("BasePart")
        and part.Parent ~= nil and part:IsDescendantOf(character)
end

function Aim:_Target(payload, weaponData)
    local target, preferred
    if self._provider then
        target, preferred = self._provider(payload, weaponData)
    elseif self._target then
        target = self._target
    else
        local bot = ENV._StandaloneAimBot
        if type(bot) ~= "table" or bot._isRunning == false then
            return nil, nil, nil, "waiting-for-aimbot"
        end
        local selected = bot.Config and bot.Config.SelectedTarget
        if type(selected) == "string" and selected ~= "" and selected ~= "Nearest" and selected ~= "LowestHealth" then
            target = Players:FindFirstChild(selected)
        else
            target = bot.TargetPlayer or bot.TargetCharacter or bot.TargetPart
        end
        preferred = bot.TargetPart
    end
    if typeof(target) ~= "Instance" or target.Parent == nil then
        return nil, nil, nil, "no-target"
    end

    local character, player
    if target:IsA("Player") then
        if target == LocalPlayer then return nil, nil, nil, "self-target" end
        player, character = target, target.Character
    elseif target:IsA("Model") then
        character = target
    elseif target:IsA("BasePart") then
        character, preferred = characterOf(target), target
    else
        return nil, nil, nil, "invalid-target-type"
    end
    if not character or character == LocalPlayer.Character then
        return nil, nil, nil, "self-or-missing-character"
    end
    player = player or Players:GetPlayerFromCharacter(character)
    if player and player.Character ~= character then
        return nil, nil, nil, "stale-character"
    end
    if not alive(character) then return nil, nil, nil, "dead-target" end
    if self.Config.CheckProtection and protected(character) then
        return nil, nil, nil, "protected-target"
    end

    local part
    if self.Config.AimPart ~= "Shared" then
        part = character:FindFirstChild(self.Config.AimPart)
    end
    if not validPart(part, character) then
        part = validPart(preferred, character) and preferred
            or character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
            or character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
            or character:FindFirstChild("Head")
    end
    if not validPart(part, character) then return nil, nil, nil, "missing-target-part" end
    return character, part, player, nil
end

function Aim:_Resolve(payload, weaponData)
    if type(payload) ~= "table" or type(weaponData) ~= "table" then
        return nil, "invalid-shot"
    end
    if payload.AttackerIsMob then return nil, "mob-shot" end
    local character = LocalPlayer.Character
    if not alive(character) then return nil, "local-character-unavailable" end
    if payload.AttackerCharacter and payload.AttackerCharacter ~= character then
        return nil, "other-attacker"
    end
    if payload.HRP and (typeof(payload.HRP) ~= "Instance"
        or not payload.HRP:IsDescendantOf(character)) then
        return nil, "other-attacker"
    end
    if weaponData.WeaponType ~= "Gun" or (weaponData.ShootType ~= "HitscanSingleShot" and weaponData.ShootType ~= "Custom") then
        return nil, "unsupported-weapon"
    end
    self._lastWeapon = weaponData.Name
    local allowedWeapons = self.Config.AllowedWeapons
    if allowedWeapons and allowedWeapons[weaponData.Name] ~= true then
        return nil, "weapon-not-allowed"
    end
    local origin, range = payload.origin, weaponData.Range
    if weaponData.ShootType == "Custom" and not finiteVector(origin) and payload.HRP then
        origin = payload.HRP.Position
    end
    if not finiteVector(origin) or not finite(range) or range <= 0 then
        return nil, "invalid-origin-or-range"
    end
    if not finiteVector(self.Config.Offset) then return nil, "invalid-offset" end

    local target, part, player, reason = self:_Target(payload, weaponData)
    if not target then return nil, reason end
    local candidates, included = { part }, { [part] = true }
    if self.Config.TryVisibleParts and self.Config.CheckLineOfSight then
        for _, name in ipairs({ "UpperTorso", "Torso", "Head", "HumanoidRootPart" }) do
            local alternate = target:FindFirstChild(name)
            if validPart(alternate, target) and not included[alternate] then
                included[alternate] = true
                table.insert(candidates, alternate)
            end
        end
    end

    local params
    if self.Config.CheckLineOfSight then
        params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local excluded = { character }
        for _, name in ipairs({ "Boats", "_WorldOrigin" }) do
            local folder = Workspace:FindFirstChild(name)
            if folder then table.insert(excluded, folder) end
        end
        params.FilterDescendantsInstances = excluded
    end

    local lastReason = "no-visible-part"
    for _, candidate in ipairs(candidates) do
        local point = candidate.Position + self.Config.Offset
        local delta = point - origin
        if not finiteVector(point) or not finite(delta.Magnitude) then
            lastReason = "invalid-target-position"
        elseif delta.Magnitude < 0.0001 then
            lastReason = "zero-direction"
        elseif delta.Magnitude > range then
            lastReason = "out-of-range"
        elseif self.Config.IsAllowedTarget
            and self.Config.IsAllowedTarget(target, player, candidate, weaponData) ~= true then
            lastReason = "target-not-allowed"
        elseif not params then
            return point, "redirected", target
        else
            local hit = Workspace:Raycast(origin, delta, params)
            if not hit or (hit.Instance and hit.Instance:IsDescendantOf(target)) then
                return point, "redirected", target
            end
            lastReason = hit and "occluded" or "no-target-ray-hit"
        end
    end
    return nil, lastReason
end

function Aim:SetEnabled(enabled)
    assert(not self._destroyed, "M1GunAim: module was destroyed; execute the file again")
    assert(type(enabled) == "boolean", "M1GunAim: SetEnabled expects a boolean")
    self.Config.Enabled = enabled
    self._lastReason = enabled and "ready" or "disabled"
    return self
end

function Aim:SetTarget(target)
    assert(not self._destroyed, "M1GunAim: module was destroyed")
    assert(target == nil or (typeof(target) == "Instance"
        and (target:IsA("Player") or target:IsA("Model") or target:IsA("BasePart"))),
        "M1GunAim: target must be a Player, character Model, BasePart, or nil")
    self._target, self._provider = target, nil
    return self
end

function Aim:SetTargetProvider(provider)
    assert(not self._destroyed, "M1GunAim: module was destroyed")
    assert(provider == nil or type(provider) == "function",
        "M1GunAim: provider must be a function or nil")
    self._provider, self._target = provider, nil
    return self
end

function Aim:GetStatus()
    local stats = {}
    for key, value in pairs(self._stats) do stats[key] = value end
    return {
        Version = self.Version,
        Enabled = self.Config.Enabled and not self._destroyed,
        Active = not self._destroyed and ((state ~= nil and state.Active == self)
            or (customState ~= nil and customState.Active == self)),
        HookInstalled = state ~= nil and state.Active == self and type(state.Original) == "function",
        CustomHookInstalled = customState ~= nil and customState.Active == self and type(customState.Original) == "function",
        Destroyed = self._destroyed,
        AimBotPresent = type(ENV._StandaloneAimBot) == "table",
        LastReason = self._lastReason,
        LastError = self._lastError,
        LastTarget = self._lastTarget,
        LastWeapon = self._lastWeapon,
        Stats = stats,
    }
end

function Aim:Destroy()
    if self._destroyed then return end
    self._destroyed, self.Config.Enabled = true, false
    self._target, self._provider, self._nativeShot = nil, nil, nil
    self._lastReason, self._lastTarget = "destroyed", nil
    if state and state.Active == self then state.Active = nil end
    if customState and customState.Active == self then customState.Active = nil end
    if ENV._StandaloneM1GunAim == self then ENV._StandaloneM1GunAim = nil end
end

local function installHook(targetHandler, custom)
    if not targetHandler or type(targetHandler) ~= "function" then return false end
    local key = custom and "_StandaloneM1GunCustomAimHook_v1" or HOOK_KEY
    local tag = custom and "M1GunAim/custom/v1" or HOOK_TAG
    local handlerState = ENV[key]
    if not (handlerState and handlerState.Tag == tag and handlerState.Source == targetHandler
        and type(handlerState.Original) == "function") then
        if type(hook) ~= "function" then return false end
        handlerState = {Tag = tag, Source = targetHandler, Original = nil, Active = nil}
        local function dispatcher(payload, weaponData, ...)
            local active = handlerState.Active
            if active and not active._destroyed and active.Config.Enabled then
                local pending = active._nativeShot
                local owned = pending and pending.Thread == coroutine.running()
                    and type(weaponData) == "table" and (pending.Data == weaponData
                    or (pending.Data.Name == weaponData.Name and pending.Data.ShootType == weaponData.ShootType))
                active._stats.Intercepted = active._stats.Intercepted + 1
                active._lastTarget = nil
                local ok, point, reason, target = pcall(active._Resolve, active, payload, weaponData)
                if active._destroyed or handlerState.Active ~= active or not active.Config.Enabled then
                    active._stats.Bypassed = active._stats.Bypassed + 1
                    if owned then pending.Reason = "aim-cancelled"; return nil end
                elseif ok then
                    active._lastReason, active._lastError = reason, nil
                    if point then
                        payload.TargetPosition = point
                        active._lastTarget = target and target:GetFullName() or nil
                        active._stats.Redirected = active._stats.Redirected + 1
                        if owned then pending.Dispatched = true end
                    else
                        active._stats.Bypassed = active._stats.Bypassed + 1
                        if owned then pending.Reason = reason or "aim-rejected"; return nil end
                    end
                else
                    active._lastReason, active._lastError = "resolve-error", tostring(point)
                    active._stats.Errors = active._stats.Errors + 1
                    active._stats.Bypassed = active._stats.Bypassed + 1
                    if owned then pending.Reason = "aim-resolve-error"; return nil end
                end
            end
            return handlerState.Original(payload, weaponData, ...)
        end
        local okHook, original = pcall(hook, targetHandler, dispatcher)
        if not (okHook and type(original) == "function") then return false end
        handlerState.Original = original
        ENV[key] = handlerState
    end
    handlerState.Active = Aim
    if custom then customState = handlerState else state = handlerState end
    return true
end

local function bindShootType(custom)
    local name = custom and "Custom" or "HitscanSingleShot"
    local function bind(waitTimeout)
        if Aim._destroyed or not Hunter._isRunning then return end
        local shootModule = getShootModule(waitTimeout, name)
        if shootModule then
            local okReq, handler = pcall(require, shootModule)
            if okReq and type(handler) == "function" and not Aim._destroyed and Hunter._isRunning then
                return installHook(handler, custom)
            end
        end
    end
    if not bind(0) then task.defer(function() bind(1.5) end) end
end
