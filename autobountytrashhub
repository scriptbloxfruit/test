    cfg.EnterCombat = math.clamp(cfg.EnterCombat, 1, 79)
    cfg.ExitCombat = math.max(cfg.ExitCombat, cfg.EnterCombat + 1)
    cfg.TravelSpeed = math.clamp(tonumber(Hunter.Config.TweenSpeed) or cfg.TravelSpeed, 1, 220)
    cfg.CombatSpeed = math.clamp(cfg.CombatSpeed, 1, 220)
    cfg.CombatMovementLead = math.clamp(cfg.CombatMovementLead, 0, 3)
    cfg.CombatDistance = math.clamp(cfg.CombatDistance, 2, 12)
    Hunter.Config.FollowDistance = cfg.CombatDistance

    local api = {Config = cfg, CastTimes = castTimes}
    local state = {
        player = nil, part = nil, character = nil,
        history = {}, count = 0, cursor = 0,
        velocity = Vector3.zero, acceleration = Vector3.zero,
        measuredVelocity = Vector3.zero, hasVelocity = false,
        lastSampleAt = nil, lastPosition = nil, lastMotionAt = nil,
        motionInterval = 1 / 30, stopped = false,
        movementOffset = nil, desiredPosition = nil, distance = nil,
        mode = "TRAVEL", side = nil, destroyed = false,
        targetConnections = {}, connections = {},
        humanoid = nil, savedAutoRotate = nil,
        castSerial = 0, castTime = nil, castUntil = 0,
