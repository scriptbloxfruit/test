    local FAST_KILL_CLASSES = {
        ParticleEmitter = true,
        Beam            = true,
        Trail           = true,
        Fire            = true,
        Smoke           = true,
        Sparkles        = true,
    }

    local FAST_LIGHT_CLASSES = {
        PointLight   = true,
        SpotLight    = true,
        SurfaceLight = true,
    }

    -- Sequence / Range constants tái sử dụng để không tốn GC heap
    local ZERO_NR = NumberRange.new(0)
    local ZERO_NS = NumberSequence.new(0)
    local ONE_NS = NumberSequence.new(1)

    local wo = Workspace:FindFirstChild("_WorldOrigin")

    local function cleanSingleInstance(inst)
        if not inst then return end
        local c = inst.ClassName

        -- 1. Bỏ qua ngay các class dữ liệu / vật lý không có visual
        if c == "Folder" or c == "Configuration" or c == "Weld" or c == "Motor6D"
           or c == "Attachment" or c == "Script" or c == "LocalScript" or c == "ModuleScript"
           or c == "Humanoid" or c == "Animator" or c == "Animation" or c == "ClickDetector"
           or c == "ProximityPrompt" or c == "TouchTransmitter" or c == "BodyVelocity"
           or c == "BodyPosition" or c == "BodyGyro" or c == "BodyForce" or c == "LinearVelocity"
           or c == "AlignPosition" or c == "AlignOrientation" or c == "VectorForce" then
            return
        end

        -- 2. Triệt tiêu 100% hạt & tia chiêu thức (Khóa cả :Emit() khi game tung chiêu)
        if FAST_KILL_CLASSES[c] then
            inst.Enabled = false
            if c == "ParticleEmitter" then
                inst.Rate = 0
                inst.Lifetime = ZERO_NR
                inst.Size = ZERO_NS
                inst.Transparency = ONE_NS
                pcall(inst.Clear, inst)
            elseif c == "Trail" then
                inst.Lifetime = 0
                inst.Transparency = ONE_NS
            elseif c == "Beam" then
                inst.Transparency = ONE_NS
            end
            return
        end

        -- 3. Nguồn sáng cục bộ động
        if FAST_LIGHT_CLASSES[c] then
            inst.Enabled = false
            inst.Brightness = 0
            inst.Shadows = false
            return
        end

        -- 4. Highlight (Hào quang Ken Haki, Tộc V4, aura... ngoại trừ Target/ESP của Bot)
        if c == "Highlight" or inst:IsA("Highlight") then
            local hlName = inst.Name
            if not (hlName:find("ESP") or hlName:find("Target") or hlName:find("BF_")) then
                inst.Enabled = false
            end
            return
        end

        -- 5. Decal / Texture / SurfaceAppearance
        if c == "Decal" then
            inst.Transparency = 1
            return
        elseif c == "Texture" then
            if inst:GetAttribute("Offset") == nil then
                pcall(inst.Destroy, inst)
            else
                inst.Transparency = 1
            end
            return
        elseif c == "SurfaceAppearance" then
            pcall(inst.Destroy, inst)
            return
        end

        -- 6. PostEffect & Khí quyển
        if c == "PostEffect" or c == "Atmosphere" or c == "Clouds"
           or c == "BloomEffect" or c == "BlurEffect" or c == "ColorCorrectionEffect"
           or c == "SunRaysEffect" or c == "DepthOfFieldEffect" then
            inst.Enabled = false
            return
        end

        -- 7. Sound: Chỉ hạ Volume = 0 ở client, TUYỆT ĐỐI KHÔNG DESTROY kẻo hỏng SkillDodge!
        if c == "Sound" then
            inst.Volume = 0
            return
        end

        -- 8. Ghế ngồi Seat: Ngăn ngồi nhầm khi di chuyển
        if c == "Seat" and not inst:IsA("VehicleSeat") then
            inst.Disabled = true
            inst.CanTouch = false
            return
        end

        -- 9. Explosion
        if c == "Explosion" then
            inst.Visible = false
            return
        end

        -- 10. BasePart (Part, MeshPart, UnionOperation, WedgePart, CornerWedgePart...)
        if inst:IsA("BasePart") then
            local nameL = inst.Name:lower()

            -- Ranh giới an toàn: không đụng vào Hitbox, Root, Head, bệ nước TrashHub, cổng dịch chuyển Sea 3
            if nameL:find("root") or nameL:find("head") or nameL:find("hitbox")
               or nameL:find("humanoidrootpart") or nameL:find("safezone") or nameL:find("shield")
               or inst.Name == "TrashHub_WaterPlatform"
               or nameL:find("gate") or nameL:find("teleport") then
                return
            end

            -- Bỏ qua Tool và vũ khí đang cầm trên tay
            if inst:FindFirstAncestorOfClass("Tool") then
                return
            end

            -- Kiểm tra nếu nằm trong _WorldOrigin:
            -- Mọi Part trong _WorldOrigin không thuộc thư mục được bảo vệ đều là chiêu thức (Portal vortex, Godhuman rings...)
            if wo and inst:IsDescendantOf(wo) then
                local inProtectedWO = false
                for protName in pairs(_woProtected) do
                    local protFolder = wo:FindFirstChild(protName)
                    if protFolder and (inst == protFolder or inst:IsDescendantOf(protFolder)) then
                        inProtectedWO = true
                        break
                    end
                end
                if not inProtectedWO then
                    inst.Transparency = 1
                    inst.CastShadow = false
                    inst.CanTouch = false
                    inst.CanCollide = false
                    return
                end
            end

            -- Kiểm tra nếu thuộc Model Character (Player / Bot):
            -- Ẩn các part VFX, Aura, Wing, Halo, Horn, Flame gắn trên người mà không làm mất thân xác
            local charModel = inst:FindFirstAncestorOfClass("Model")
            if charModel and charModel:FindFirstChildOfClass("Humanoid") then
                local pNameL = (inst.Parent and inst.Parent.Name:lower()) or ""
                if nameL:find("aura") or nameL:find("vfx") or nameL:find("effect")
                   or nameL:find("wing") or nameL:find("halo") or nameL:find("horn")
                   or nameL:find("lightning") or nameL:find("flame") or nameL:find("glow")
                   or pNameL:find("aura") or pNameL:find("effect") or pNameL:find("wing") then
                    inst.Transparency = 1
                    inst.CastShadow = false
                end
                return
            end

            -- Kiểm tra tên Part và Model cha (Bắt trọn Cây cối, Nấm Green Zone, Dây leo Kingdom of Rose...)
            local parentModel = inst:FindFirstAncestorOfClass("Model")
            local parentNameL = (parentModel and parentModel.Name:lower()) or (inst.Parent and inst.Parent.Name:lower()) or ""

            if nameL:find("tree") or parentNameL:find("tree")
               or nameL:find("bush") or parentNameL:find("bush")
               or nameL:find("plant") or parentNameL:find("plant")
               or nameL:find("vine") or parentNameL:find("vine")
               or nameL:find("mushroom") or parentNameL:find("mushroom")
               or nameL:find("leaf") or parentNameL:find("leaf")
               or nameL:find("leaves") or parentNameL:find("leaves")
               or nameL:find("foliage") or parentNameL:find("foliage")
               or nameL:find("grass") or parentNameL:find("grass")
               or nameL:find("flower") or parentNameL:find("flower")
               or nameL:find("trunk") or parentNameL:find("trunk")
               or nameL:find("stem") or parentNameL:find("stem")
               or nameL:find("fruitdeco") or parentNameL:find("fruitdeco")
               or nameL:find("oranges") or parentNameL:find("oranges")
               or nameL:find("fanart") or parentNameL:find("fanart") then
                inst.Transparency = 1
                inst.CanCollide = false
                inst.CastShadow = false
                return
            end

            -- Mảnh vỡ combat & hiệu ứng chiêu thức (Aura, blast, slash, flyrock, tornado, shockwave, debris...)
            if nameL:find("flyrock") or nameL:find("dust") or nameL:find("domerock")
               or nameL:find("lightningcloud") or nameL:find("emitterpart") or nameL:find("debris")
               or nameL:find("crater") or nameL:find("foam") or nameL:find("aura")
               or nameL:find("vfx") or nameL:find("blast") or nameL:find("slash")
               or nameL:find("shockwave") or nameL:find("ring") or nameL:find("tornado")
               or nameL:find("explosion") or nameL:find("domain") then
                inst.Transparency = 1
                inst.Material = Enum.Material.SmoothPlastic
                inst.CastShadow = false
                inst.CanTouch = false
                return
            end

            -- Ultra Potato Mode: chuyển toàn bộ part bản đồ về SmoothPlastic, tắt bóng, xóa texture
            inst.Material = Enum.Material.SmoothPlastic
            inst.Reflectance = 0
            inst.CastShadow = false
            if inst:IsA("MeshPart") then
                -- Bảo vệ cổng dịch chuyển Sea 3 (MapTeleport SpecialMesh / Color part)
                if not (inst.Parent and inst.Parent.Name:find("MapTeleport")) then
                    inst.TextureID = ""
                end
            end
        end
    end

