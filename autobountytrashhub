Hunter.Noclip = (function()
    local env = getgenv()
    local previous = env._TrashHubNoclip
    if type(previous) == "table" and type(previous.Destroy) == "function" then
        pcall(previous.Destroy, previous)
    end
    local api = {Version = "2.0", Enabled = true, Destroyed = false}
    local character, retiringCharacter
    local tracked, characterConnections, connections = {}, {}, {}
    local physicsConnection

    local function disconnect(list)
        for _, connection in ipairs(list) do pcall(function() connection:Disconnect() end) end
        table.clear(list)
    end

    local function untrack(part)
        local state = tracked[part]
        if not state then return end
        tracked[part] = nil
        if state.Connection then state.Connection:Disconnect() end
        local ok, message = pcall(function() part.CanCollide = state.OriginalCanCollide end)
        if not ok then api.LastError = tostring(message) end
    end

    local function enforce(part, state)
        if api.Destroyed or not api.Enabled or not Hunter._isRunning or state.Writing
            or tracked[part] ~= state or not character or character ~= LocalPlayer.Character
            or character == retiringCharacter or not part:IsDescendantOf(character) then return end
        if not part.CanCollide then return end
        state.Writing = true
        local ok, message = pcall(function() part.CanCollide = false end)
        state.Writing = false
        if not ok then api.LastError = tostring(message) end
    end

    local function track(part)
        if tracked[part] or not part:IsA("BasePart") or not character
            or not part:IsDescendantOf(character) then return end
        local state = {OriginalCanCollide = part.CanCollide, Writing = false}
        tracked[part] = state
        state.Connection = part:GetPropertyChangedSignal("CanCollide"):Connect(function()
            enforce(part, state)
        end)
        enforce(part, state)
    end

    local function bind(nextCharacter)
        if character == nextCharacter then return end
        disconnect(characterConnections)
        for part in pairs(tracked) do untrack(part) end
        character = nextCharacter
        if not character then return end
        local boundCharacter = character
        table.insert(characterConnections, character.DescendantAdded:Connect(function(part)
            if character == boundCharacter and api.Enabled and not api.Destroyed and Hunter._isRunning then
                track(part)
            end
        end))
        table.insert(characterConnections, character.DescendantRemoving:Connect(function(part)
            if character == boundCharacter then untrack(part) end
        end))
        for _, part in ipairs(character:GetDescendants()) do track(part) end
    end

    function api:Apply()
        if self.Destroyed or not self.Enabled or not Hunter._isRunning then
            bind(nil)
            return false
        end
        local current = LocalPlayer.Character
        if current == retiringCharacter then current = nil end
        bind(current)
        if not character then return false end
        for part, state in pairs(tracked) do
            if part:IsDescendantOf(character) then enforce(part, state) else untrack(part) end
        end
        return true
    end

    function api:SetEnabled(enabled)
        if self.Destroyed then return end
        self.Enabled = enabled == true
        self:Apply()
    end

    function api:GetStatus()
        local count = 0
        for _ in pairs(tracked) do count += 1 end
        return {Active = not self.Destroyed and self.Enabled and Hunter._isRunning and character ~= nil,
            Character = character, PartCount = count, LastError = self.LastError}
    end

    function api:Destroy()
        if self.Destroyed then return end
        self.Destroyed, self.Enabled = true, false
        disconnect(connections)
        bind(nil)
        retiringCharacter = nil
        if env._TrashHubNoclip == self then env._TrashHubNoclip = nil end
        if env._TrashHubNoclipConn == physicsConnection then env._TrashHubNoclipConn = nil end
    end

    table.insert(connections, LocalPlayer.CharacterAdded:Connect(function(nextCharacter)
        if api.Destroyed or nextCharacter ~= LocalPlayer.Character then return end
        retiringCharacter = nil
        api:Apply()
    end))
    table.insert(connections, LocalPlayer.CharacterRemoving:Connect(function(oldCharacter)
        if oldCharacter ~= character and oldCharacter ~= LocalPlayer.Character then return end
        retiringCharacter = oldCharacter
        if character == oldCharacter then bind(nil) end
    end))
    physicsConnection = RunService.PreSimulation:Connect(function() api:Apply() end)
    table.insert(connections, physicsConnection)
    for _, connection in ipairs(connections) do table.insert(Hunter._connections, connection) end
    env._TrashHubNoclip, env._TrashHubNoclipConn = api, physicsConnection
    api:Apply()
    return api
end)()

