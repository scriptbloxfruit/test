        if not player or not char then
            return false
        end
        if KenCheckModule.IsKenActive(player) ~= true then
            return false
        end
        if KenCheckModule.IsKenDisabled(char) then
            return false
        end
        local dodgesLeft = KenCheckModule.GetDodgesLeft(player)
        local threshold = minDodgeCost or 0.5
