    local PortalXTrackerModule = {}
    PortalXTrackerModule.__index = PortalXTrackerModule

    PortalXTrackerModule.Config = {
        SafeGlideSpeed = 195,
        SnapDistance = 25,
        PortalFollowOffset = CFrame.new(0, 12, 0),
        CombatFollowOffset = CFrame.new(0, 4, 3),
        LookAtTarget = true,
    }

    local _connections = {}
    local _portalState = {}
    local _autoFollowConn = nil
    local _activeTarget = nil
    local _bodyVelocity = nil

    local function resolveTarget(target)
        if typeof(target) ~= "Instance" then
            return nil, nil
        end
        if target:IsA("Player") then
            return target, target.Character
        elseif target:IsA("Model") then
            return Players:GetPlayerFromCharacter(target), target
        elseif target:IsA("BasePart") or target:IsA("Humanoid") then
            local model = target:FindFirstAncestorOfClass("Model")
            if model then
                return Players:GetPlayerFromCharacter(model), model
            end
        end
