        and nativeState and type(rawget(nativeState, "LastUse")) == "number"
    local lastUse = bound and rawget(nativeState, "LastUse") or ownLastUse
    local remaining = math.max(0, duration - (now - lastUse))
    if not bound then remaining = math.max(remaining, fallbackReadyAt - now) end
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local charges = hum and tonumber(hum:GetAttribute("SoruCharges")) or 0
