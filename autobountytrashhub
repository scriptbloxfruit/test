    Hunter.Kinematics:Reset()
    local enemy = Hunter.TargetPlayer or _currentCombatTarget
    local enemyName = (enemy and enemy.Name) or _lastCombatEnemyName
    if enemyName and enemyName ~= "" then
        if markSkipped ~= false then _skippedTargets[enemyName] = tick() end
        print("[TrashHub][TARGET_RELEASE] " .. enemyName .. " Reason=" .. tostring(reason or "explicit-skip"))
    end
    Hunter.TargetSuspended = false
    Hunter.TargetLockStatus = {Phase = "released", PlayerName = enemyName, Reason = reason or "explicit-skip"}
    Hunter.TargetPlayer = nil
    Hunter.TargetCharacter = nil
    Hunter.TargetPart = nil
    _currentCombatTarget = nil
    _lastCombatEnemyName = ""
    _combatElapsedTime = 0
    _lastCombatTick = nil
