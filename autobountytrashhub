local function _update3DLaserImpl(tCharOverride, tPartOverride)
    if Hunter._laserAdorn then
        local old = Hunter._laserAdorn
        Hunter._laserAdorn = nil
        pcall(old.Destroy, old)
    end
    local cfg = Hunter.Config or CONFIG
    local myChar = LocalPlayer.Character
    local _, _, myRoot = getCharacter()
    local targetChar = tCharOverride or Hunter.TargetCharacter
    local targetPart = tPartOverride or Hunter.TargetPart

    if myRoot and targetChar and targetPart and targetPart.Parent and isAlive(targetChar) then
        local isPortalX = Hunter.TargetPlayer ~= nil and isTargetUsingPortalDimension(Hunter.TargetPlayer)
        local realCF = isPortalX and Hunter.PortalXTracker and Hunter.PortalXTracker.GetRealCFrame(Hunter.TargetPlayer)
        local realPos = (realCF and realCF.Position) or (isPortalX and Hunter.PortalXTracker and Hunter.PortalXTracker.GetRealPosition(Hunter.TargetPlayer))

        local targetChestPart = (targetChar:FindFirstChild("UpperTorso") or targetChar:FindFirstChild("Torso")) or targetPart
        local pB = realPos and (realPos + Vector3.new(0, 1.5, 0)) or targetChestPart.Position
        local dist = (pB - myRoot.Position).Magnitude

        if cfg and cfg.DisableCombatHighlight then
            if Hunter._targetHighlight then
                local oldHl = Hunter._targetHighlight
                Hunter._targetHighlight = nil
                pcall(oldHl.Destroy, oldHl)
            end
        else
            if not Hunter._targetHighlight or Hunter._targetHighlight.Parent ~= Workspace.Terrain then
                if Hunter._targetHighlight then
                    local oldHl = Hunter._targetHighlight
                    Hunter._targetHighlight = nil
                    pcall(oldHl.Destroy, oldHl)
                end
                local hl = Instance.new("Highlight")
                hl.Name = "BF_HunterHighlight"
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = Workspace.Terrain
                Hunter._targetHighlight = hl
                Hunter._lastHighlightMode = nil
            end
            local hl = Hunter._targetHighlight
            if hl.Adornee ~= targetChar or Hunter._lastHighlightMode ~= isPortalX then
                hl.Adornee = targetChar
                if isPortalX then
                    hl.FillColor = _HL_PORTALX_FILL
                    hl.FillTransparency = 0.45
                    hl.OutlineColor = _HL_PORTALX_OUTLINE
                    hl.OutlineTransparency = 0.0
                else
                    hl.FillColor = _HL_DEFAULT_FILL
                    hl.FillTransparency = 0.92
                    hl.OutlineColor = _HL_DEFAULT_OUTLINE
                    hl.OutlineTransparency = 0.0
                end
                Hunter._lastHighlightMode = isPortalX
            end
            if not hl.Enabled then
                hl.Enabled = true
            end
        end

        if isPortalX then
            if not Hunter._portalXBillboard or Hunter._portalXBillboard.Parent ~= Workspace.Terrain then
                if Hunter._portalXBillboard then
                    local oldBb = Hunter._portalXBillboard
                    Hunter._portalXBillboard = nil
                    pcall(oldBb.Destroy, oldBb)
                end
                local bb = Instance.new("BillboardGui")
                bb.Name = "BF_HunterPortalX_ESP"
                bb.Adornee = Workspace.Terrain
                bb.AlwaysOnTop = true
                bb.Size = UDim2.new(0, 240, 0, 48)
                bb.Parent = Workspace.Terrain
                local lbl = Instance.new("TextLabel")
                lbl.Name = "PortalXLabel"
                lbl.BackgroundTransparency = 1
                lbl.Size = UDim2.new(1, 0, 1, 0)
                lbl.Font = Enum.Font.GothamBold
                lbl.TextSize = 13
                lbl.TextColor3 = Color3.fromRGB(0, 255, 255)
                lbl.TextStrokeColor3 = Color3.fromRGB(140, 0, 255)
                lbl.TextStrokeTransparency = 0
                lbl.Parent = bb
                Hunter._portalXBillboard = bb
                Hunter._portalXLabel = lbl
            end
            if Hunter._portalXBillboard and Hunter._portalXLabel then
                local targetDisplayName = (Hunter.TargetPlayer and Hunter.TargetPlayer.DisplayName) or "Target"
                local distM = math.floor(dist)
                Hunter._portalXBillboard.StudsOffsetWorldSpace = pB + Vector3.new(0, 3.2, 0)
                Hunter._portalXLabel.Text = string.format("[PORTAL X] %s (%dm)\n[INVINCIBLE - FOLLOWING]", targetDisplayName, distM)
                if not Hunter._portalXBillboard.Enabled then
                    Hunter._portalXBillboard.Enabled = true
                end
            end
        elseif Hunter._portalXBillboard and Hunter._portalXBillboard.Enabled then
            Hunter._portalXBillboard.Enabled = false
        end
    else
        if Hunter._laserAdorn then
            local old = Hunter._laserAdorn
            Hunter._laserAdorn = nil
            pcall(old.Destroy, old)
        end
        if Hunter._targetHighlight then
            if Hunter._targetHighlight.Enabled then
                Hunter._targetHighlight.Enabled = false
            end
            if Hunter._targetHighlight.Adornee ~= nil then
                Hunter._targetHighlight.Adornee = nil
            end
            Hunter._lastHighlightMode = nil
        end
        if Hunter._portalXBillboard and Hunter._portalXBillboard.Enabled then
            Hunter._portalXBillboard.Enabled = false
        end
    end
