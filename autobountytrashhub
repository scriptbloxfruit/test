                offshoreDist = curInfo.OffshoreDist or 0
                nearestIslName = curInfo.NearestIslName
            end
            _targetEvalCache.player = Hunter.TargetPlayer
            _targetEvalCache.time = tick()
            _targetEvalCache.info = curInfo
            _targetEvalCache.isFarOffshore = isFarOffshore
            _targetEvalCache.offshoreDist = offshoreDist
            _targetEvalCache.nearestIslName = nearestIslName
            _targetEvalCache.isTooFast = false
            _targetEvalCache.targetSpd = 0
        end
        local isOverMaxDist = (not isPortalX) and (not isLocalPlayerInPortalDimension()) and (distToTarget > maxTargetDist)
        if Hunter.TargetPlayer and not isPortalX and (isInPortalV or isFarOffshore or isOverMaxDist) then
            if Hunter.SkillDodge then
                Hunter.SkillDodge.EnemyDodgeUntil = 0
                Hunter.SkillDodge.StunDodgeUntil = 0
                Hunter.SkillDodge.ActiveMode = nil
                Hunter.SkillDodge.ReturningFromSky = false
            end
            local tName = Hunter.TargetPlayer.Name
            if tName and tName ~= "" then
                local now = tick()
                _skippedTargets[tName] = now
                if isInPortalV then
                    if not _portalVNotifiedAt[tName] or (now - _portalVNotifiedAt[tName] > 6.0) then
                        _portalVNotifiedAt[tName] = now
                        if type(showBottomRightNotify) == "function" then
                            showBottomRightNotify("Portal V Detected", string.format("Skipped %s (%dm)", tostring(tName), math.floor(distToTarget)), Color3.fromRGB(180, 80, 255), "Target", tostring(tName))
                        end
                    end
                else
                    if not _offshoreNotifiedAt[tName] or (now - _offshoreNotifiedAt[tName] > 6.0) then
                        _offshoreNotifiedAt[tName] = now
                        if type(showBottomRightNotify) == "function" then
                            showBottomRightNotify("Offshore Target Skipped", string.format("Skipped %s (%dm from %s)", tostring(tName), math.floor(offshoreDist or distToTarget or 0), tostring(nearestIslName or "Island")), Color3.fromRGB(0, 175, 255), "Target", tostring(tName))
                        end
                    end
                end
            end
            skipCurrentTarget()
            return
        end

        if Hunter.TargetPlayer and not isPortalX then
            local inCombatNow = (_currentCombatTarget == Hunter.TargetPlayer and _hasEngagedInCombat) or isLocalPlayerInCombat()
            local inCombatGrace = inCombatNow and _targetCombatLossSince and (tick() - _targetCombatLossSince < 5.0)
            if not inCombatGrace then
                curInfo = curInfo or inspectPlayer(Hunter.TargetPlayer, true)
                if curInfo.InSafeZone or not curInfo.CanPvP then
                    local tName = (Hunter.TargetPlayer and Hunter.TargetPlayer.Name) or _lastCombatEnemyName
                    if tName and tName ~= "" then
                        _skippedTargets[tName] = tick()
                    end
                    skipCurrentTarget()
                    return
                end
            end
        end

        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
        if Hunter.TargetPlayer and tHum and tHum.Health > 0 then
            local now = tick()
            local curHp = tHum.Health
            if _currentCombatTarget ~= Hunter.TargetPlayer then
                _currentCombatTarget = Hunter.TargetPlayer
                _lastCombatEnemyName = Hunter.TargetPlayer.Name
                _combatElapsedTime = 0
                _lastCombatTick = now
                _lastTargetHealth = curHp
                _lastDamageDealtTick = nil
                _lastControlledCombatPos = nil
                _lastControlledTargetPos = nil
                _lastControlledCombatTick = 0
            else
                if _lastCombatTick then
                    _combatElapsedTime = _combatElapsedTime + (now - _lastCombatTick)
                end
                _lastCombatTick = now
                if _lastTargetHealth and curHp < _lastTargetHealth then
                    _lastDamageDealtTick = now
                    _lastTargetHealth = curHp
                    _hasEngagedInCombat = true
                elseif _lastTargetHealth and curHp > _lastTargetHealth then
                    _lastTargetHealth = curHp
                end
                local maxKillTime = (Hunter.Config and Hunter.Config.MaxKillTime) or CONFIG.MaxKillTime or 50
                if inCombatRange and _lastDamageDealtTick and (now - _lastDamageDealtTick >= maxKillTime) then
                    local info = curInfo or inspectPlayer(Hunter.TargetPlayer, true)
                    if not info.CanPvP and not isLocalPlayerInCombat() then
                        skipCurrentTarget()
                        return
                    end
                    _lastDamageDealtTick = now
                end
            end
        end

        if isLocalPlayerInCombat() or (_lastDamageDealtTick ~= nil and _currentCombatTarget == Hunter.TargetPlayer) then
            _hasEngagedInCombat = true
        end

        local controlNow = tick()
        if _lastControlledCombatPos
            and _lastControlledTargetPos
            and controlNow - _lastControlledCombatTick < 0.35
        then
            local selfJump = (mPos - _lastControlledCombatPos).Magnitude
            local targetJump = (tPos - _lastControlledTargetPos).Magnitude
            if selfJump > 35 and targetJump < 35 then
                if Hunter.SkillDodge and (
                    Hunter.SkillDodge._hasSnappedForCurrentStun
                    or (Hunter.StunCheck and Hunter.StunCheck.IsRealStun and Hunter.StunCheck.IsRealStun(myChar))
                ) then
                    Hunter.SkillDodge._grabLockedDuringStun = true
                    Hunter.SkillDodge._grabLockUntil = math.max(Hunter.SkillDodge._grabLockUntil or 0, os.clock() + 0.28)
                end
                Hunter.Kinematics:Pause()
                _lastControlledCombatPos = mPos
                _lastControlledTargetPos = tPos
                _lastControlledCombatTick = controlNow
            end
        end

        if Hunter.StunCheck and Hunter.StunCheck.IsServerPhysicsLocked and Hunter.StunCheck.IsServerPhysicsLocked(myChar) then
            if Hunter.SkillDodge then
                Hunter.SkillDodge:IsSelfStunDodging()
                Hunter.SkillDodge.ActiveMode = "SERVER_STUN_LOCKED"
            end
            Hunter.Kinematics:Pause()
            setHover(false)
            _lastControlledCombatPos, _lastControlledTargetPos, _lastControlledCombatTick = nil, nil, 0
            runSkillsOnlyLoop()
            return
        end

        if Hunter.GhostShipRoute:GetDirection(myRoot, tPos) == "EXIT" then
            Hunter.Kinematics:Pause()
            setHover(true)
            _lastControlledCombatPos, _lastControlledTargetPos, _lastControlledCombatTick = nil, nil, 0
            if Hunter.GhostShipRoute:Step(dt, myRoot, myHum, tPos, Hunter.TargetPlayer) then return end
        end

        local minPortalDist = _portalGetMinDistance()
        local portalDist = _portalGetLiveTargetDistance(Hunter.TargetPlayer) or distToTarget
        local deferPortalForSea3Gate = (Hunter.Sea3TeleporterRoute and Hunter.Sea3TeleporterRoute:ShouldDeferPortalC(myRoot.Position))
        if not amInDimension and _portalIsEnabled() and not _isPortalWarping and not deferPortalForSea3Gate and portalDist >= minPortalDist then
            local canPortal, _ = _portalCanUse()
            if canPortal then
                _portalExecuteSmartWarp(Hunter.TargetPlayer, tPos)
                if _isPortalWarping then
                    if Hunter.Sea3TeleporterRoute and Hunter.Sea3TeleporterRoute.Busy then
                        Hunter.Sea3TeleporterRoute:Reset("portal-c-started")
                    end
                    Hunter.Kinematics:Pause()
                    return
                end
            end
        end

        if not amInDimension and Hunter.Sea3TeleporterRoute and not Hunter.GhostShipRoute.Busy
            and Hunter.Sea3TeleporterRoute:Step(dt, myRoot, myHum, tPos, Hunter.TargetPlayer) then
            Hunter.Kinematics:Pause()
            setHover(true)
            _lastControlledCombatPos, _lastControlledTargetPos, _lastControlledCombatTick = nil, nil, 0
            return
        end

        if not amInDimension and Hunter.GhostShipRoute:Step(dt, myRoot, myHum, tPos, Hunter.TargetPlayer) then
            if Hunter.Sea3TeleporterRoute and Hunter.Sea3TeleporterRoute.Busy then
                Hunter.Sea3TeleporterRoute:Reset("ghostship-started")
            end
            Hunter.Kinematics:Pause()
            setHover(true)
            _lastControlledCombatPos, _lastControlledTargetPos, _lastControlledCombatTick = nil, nil, 0
            return
        end

        if not isPortalX and Hunter.SkillDodge and Hunter.SkillDodge:StepMovement(dt, myRoot, myHum, tPart, actCfg and actCfg.Skills) then
            setHover(true)
            local bv = Hunter._hoverVelocity or (myRoot and myRoot:FindFirstChild("BF_HunterHover"))
            if bv then bv.Velocity = Vector3.zero end
            runSkillsOnlyLoop()
            return
        end
        if not isPortalX and not (Hunter.SkillDodge and Hunter.SkillDodge.ReturningFromSky) and Hunter.SoruApproach:TryApproach(myRoot, myHum, tPart) then
            setHover(true)
            _lastControlledCombatPos = myRoot.Position
            _lastControlledTargetPos = tPart.Position
            _lastControlledCombatTick = tick()
            runSkillsOnlyLoop()
            return
        end
        if amInDimension then
            if distToTarget > 2500 or (Hunter.TargetPlayer and not isPlayerInPortalVDimension(Hunter.TargetPlayer)) then
                Hunter.Kinematics:Pause()
                return
            end
        end

        setHover(true)
        if isPortalX and realTargetCF then
            local goalPos = realTargetCF.Position + Vector3.new(0, 12, 0)
            local diff = goalPos - myRoot.Position
            local dist = diff.Magnitude
            local stepDt = math.clamp(dt or 0.016, 0.001, 0.05)
            local speed = 220
            local nextPos
            if dist <= 25 then
                nextPos = goalPos
            else
                local stepLen = math.min(dist, speed * stepDt)
                nextPos = myRoot.Position + diff.Unit * stepLen
            end
            local nextCF = CFrame.lookAt(nextPos, realTargetCF.Position)
            nextCF = Hunter.AntiLava:FilterMove(myRoot, myHum, nextCF)
            if Hunter.GhostShipRoute then
                nextCF = Hunter.GhostShipRoute:ClampInteriorCFrame(myRoot, nextCF)
            end
            myRoot.CFrame = nextCF
            Hunter.PredictedPos = realTargetCF.Position
            _lastControlledCombatPos = nextPos
            _lastControlledTargetPos = realTargetCF.Position
            _lastControlledCombatTick = tick()
        else
            local nextCFrame, lead = Hunter.Kinematics:Step(dt, myRoot, myHum)
            if not nextCFrame then return end
            nextCFrame = Hunter.AntiLava:FilterMove(myRoot, myHum, nextCFrame)
            if Hunter.GhostShipRoute then
                nextCFrame = Hunter.GhostShipRoute:ClampInteriorCFrame(myRoot, nextCFrame)
            end
            local nPos = nextCFrame.Position
            if nPos.Y > -140 and nPos.Y < 5.5 and nPos.X < 45000 and nPos.Z < 30000 and not isLocalPlayerInPortalDimension() then
                nextCFrame = (nextCFrame - nPos) + Vector3.new(nPos.X, 5.5, nPos.Z)
            end
            myRoot.CFrame = nextCFrame
            Hunter.PredictedPos = lead
            _lastControlledCombatPos = nextCFrame.Position
            _lastControlledTargetPos = tPos
            _lastControlledCombatTick = tick()
        end

        myRoot.AssemblyLinearVelocity = Vector3.zero
        local nowTick = tick()
        if nowTick - _lastRootMoverCleanTick >= 0.2 then
            _lastRootMoverCleanTick = nowTick
            for _, obj in ipairs(myRoot:GetChildren()) do
                if (obj:IsA("BodyVelocity") or obj:IsA("BodyPosition") or obj:IsA("BodyForce")
                    or obj:IsA("LinearVelocity") or obj:IsA("VectorForce"))
                    and obj.Name ~= "BF_HunterHover" and not obj.Name:find("BF_") then
                    pcall(obj.Destroy, obj)
                end
            end
        end

        local bv = Hunter._hoverVelocity or (myRoot and myRoot:FindFirstChild("BF_HunterHover"))
        if bv then bv.Velocity = Vector3.zero end

        if not isPortalX then
            runSkillsOnlyLoop()
        end
end

