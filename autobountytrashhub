local function waitUntilSkillAnimationDone(maxWaitSeconds)
    local deadline = os.clock() + (tonumber(maxWaitSeconds) or 1.2)
    local startTime = os.clock()
    while os.clock() < deadline do
        if not Hunter._isRunning or isHopping or _isPortalWarping or Hunter._isHealingInSky or Hunter._isGhostShipRouting then
            break
        end
        if Hunter.SkillDodge and (Hunter.SkillDodge:IsEnemySkillDodging() or Hunter.SkillDodge:IsSelfStunDodging()) then
            break
        end
        local char = LocalPlayer.Character
        if not char then break end
        if Hunter.StunCheck and Hunter.StunCheck.IsRealStun(char) then
            break
        end
        local locked = Hunter.IsActionLocked and Hunter.IsActionLocked(char)
        if not locked then
            break
        end
        -- Animation cancel optimization: if skill already executed and 0.28s passed, allow next action
        if (os.clock() - startTime) >= 0.28 and Hunter._lastSkillCast and (os.clock() - Hunter._lastSkillCast.At) < 0.35 then
            break
        end
        task.wait(0.015)
    end
end

local function equipWeapon(toolType)
    if _isPortalWarping then return nil end
    local char, hum = getCharacter()
    if not char or not hum or hum.Health <= 0 then return nil end
    if Hunter.IsActionLocked and Hunter.IsActionLocked(char) then
        waitUntilSkillAnimationDone(1.65)
        char, hum = getCharacter()
        if not char or not hum or hum.Health <= 0 then return nil end
        if Hunter.IsActionLocked and Hunter.IsActionLocked(char) then return nil end
    end
    local tool = getToolByType(toolType)
    if not tool then
        local bp = LocalPlayer:FindFirstChild("Backpack") or LocalPlayer:WaitForChild("Backpack", 0.5)
        if bp then
            local waitStart = tick()
            while tick() - waitStart < 0.4 do
                if _isPortalWarping or (Hunter.IsActionLocked and Hunter.IsActionLocked(LocalPlayer.Character)) then return nil end
                tool = getToolByType(toolType)
                if tool then break end
                task.wait(0.05)
            end
        end
    end
    if not tool or _isPortalWarping then return nil end
    char, hum = getCharacter()
    if not char or not hum or hum.Health <= 0 then return nil end
    if _isPortalWarping or (Hunter.IsActionLocked and Hunter.IsActionLocked(char)) then return nil end
    if not char:FindFirstChild("HasBuso") then
        task.spawn(function()
            pcall(function() ReplicatedStorage.Remotes.CommF_:InvokeServer("Buso") end)
        end)
    end
    if tool.Parent ~= char then
        unlockSkillState()
        hum:EquipTool(tool)
        local equipStarted = os.clock()
        Hunter._lastSkillEquipTool, Hunter._lastSkillEquipAt = tool, equipStarted
        while tool.Parent ~= char and os.clock() - equipStarted < 0.35 do
            if _isPortalWarping or (Hunter.IsActionLocked and Hunter.IsActionLocked(char)) then break end
            task.wait()
        end
        unlockSkillState()
    end
    if tool.Parent ~= char then return nil end
    return tool
end
