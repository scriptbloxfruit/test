local function _portalHorizDist(a, b)
    local dx = a.X - b.X
    local dz = a.Z - b.Z
    return math.sqrt(dx * dx + dz * dz)
end

local function _portalGetDoorApproachPosition(targetPosition, myPosition)
    local rooms = Hunter and Hunter.GhostShipRoute
    if not (targetPosition and myPosition and rooms and rooms.GetEntrancePosition)
        or rooms:IsInside(myPosition) then return nil end
    if rooms.IsInsideGhostShip and rooms:IsInsideGhostShip(targetPosition) then return nil end
    return rooms:GetEntrancePosition(targetPosition)
end

local function _portalGetEffectiveTargetPos(targetPlayer, fallbackPos, leadTime)
    local livePos = fallbackPos
    local velXZ = Vector3.zero
    if targetPlayer and targetPlayer.Parent then
        local tChar = targetPlayer.Character
        local tRoot = tChar and (tChar:FindFirstChild("HumanoidRootPart") or tChar.PrimaryPart)
        if tRoot and tRoot.Parent then
            livePos = (Hunter and Hunter.PortalXTracker and Hunter.PortalXTracker.GetRealPosition(targetPlayer)) or tRoot.Position
            local v = tRoot.AssemblyLinearVelocity
            if v then
                velXZ = Vector3.new(v.X, 0, v.Z)
            end
        end
    end
    if not livePos then
        return nil, nil
    end

    local _, _, myRoot = getCharacter()
    if myRoot then
        local entrancePos = _portalGetDoorApproachPosition(livePos, myRoot.Position)
        if entrancePos then
            return entrancePos, entrancePos
        end
    end

    local speedXZ = velXZ.Magnitude
    local projectedPos = livePos
    if speedXZ >= 25 then
        local clampedSpeed = math.min(speedXZ, 250)
        local leadSec = tonumber(leadTime) or 1.8
        projectedPos = livePos + (velXZ.Unit * (clampedSpeed * leadSec))
    end
    return projectedPos, livePos
end

local function _portalCalcIslandScore(islandPos, projectedGoalPos, rawGoalPos)
    local goalA = projectedGoalPos or rawGoalPos
    local goalB = rawGoalPos or projectedGoalPos
    if not (islandPos and goalA and goalB) then return math.huge end
    local dLeadXZ = _portalHorizDist(islandPos, goalA)
    local dRawXZ = _portalHorizDist(islandPos, goalB)
    local vertDiff = math.abs(islandPos.Y - goalB.Y)
    return (dLeadXZ * 0.72 + dRawXZ * 0.28) + (vertDiff * 0.08)
end

_portalGetLiveTargetDistance = function(targetPlayer)
    if not targetPlayer then return nil end
    local _, _, myRoot = getCharacter()
    local targetChar = targetPlayer.Character
    local targetRoot = targetChar and (targetChar:FindFirstChild("HumanoidRootPart") or targetChar.PrimaryPart)
    if not myRoot or not targetRoot or not targetRoot.Parent then return nil end
    local tRealPos = (Hunter and Hunter.PortalXTracker and Hunter.PortalXTracker.GetRealPosition(targetPlayer)) or targetRoot.Position
    local rawDist = (myRoot.Position - tRealPos).Magnitude
    do
        local entrancePos = _portalGetDoorApproachPosition(tRealPos, myRoot.Position)
        if entrancePos then
            local distToEntrance = (myRoot.Position - entrancePos).Magnitude
            if distToEntrance < 850 then
                return distToEntrance
            end
            return math.max(distToEntrance, rawDist)
        end
    end
    return rawDist
end

