local function _resolveHopRegion()
    local raw = nil
    if type(getgenv) == "function" then
        local ahc = getgenv().AutoHopConfig
        local thc = getgenv().TrashHubConfig or getgenv().CONFIG
        if type(ahc) == "table" and ahc.TargetRegion ~= nil and ahc.TargetRegion ~= "" then
            raw = ahc.TargetRegion
        elseif type(thc) == "table" and thc.TargetRegion ~= nil and thc.TargetRegion ~= "" then
            raw = thc.TargetRegion
        end
    end
    if not raw or raw == "" then
        if HOP_CONFIG.TargetRegion and HOP_CONFIG.TargetRegion ~= "Singapore" then
            raw = HOP_CONFIG.TargetRegion
        elseif CONFIG and CONFIG.TargetRegion ~= nil and CONFIG.TargetRegion ~= "" then
            raw = CONFIG.TargetRegion
        else
            raw = HOP_CONFIG.TargetRegion or "Singapore"
        end
    end

    local rawList = {}
    if type(raw) == "table" then
        for _, item in ipairs(raw) do
            if type(item) == "string" and item ~= "" then
                table.insert(rawList, item)
            end
        end
    elseif type(raw) == "string" then
        for part in raw:gmatch("[^,/|]+") do
            local trimmed = part:match("^%s*(.-)%s*$")
            if trimmed and trimmed ~= "" then
                table.insert(rawList, trimmed)
            end
        end
    end
    if #rawList == 0 then
        table.insert(rawList, "Singapore")
    end

    local displayParts = {}
    local filterList = {}
    for _, name in ipairs(rawList) do
        local norm = name:lower():gsub("[%s_%-]+", "")
        if norm == "hongkong" or norm == "hk" then
            table.insert(displayParts, "Hong Kong")
            table.insert(filterList, "hongkong")
        elseif norm == "singapore" or norm == "sg" then
            table.insert(displayParts, "Singapore")
            table.insert(filterList, "singapore")
        elseif norm == "all" or norm == "any" or norm == "*" then
            table.insert(displayParts, "All")
            table.insert(filterList, "")
        else
            table.insert(displayParts, name)
            table.insert(filterList, norm)
        end
    end

    local display = table.concat(displayParts, ", ")
    return display, filterList
end

