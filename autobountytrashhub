local function normalizeFruitName(rawName)
    if not rawName or rawName == "" or rawName == "None" then return "None" end
    local lower = tostring(rawName):lower()
    for keyword, standardName in pairs(FRUIT_ALIASES) do
        if lower:find(keyword, 1, true) then
