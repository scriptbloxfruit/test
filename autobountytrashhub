    local function evaluateRouteCost(hops, startPos, targetPos)
        local cur = startPos
        local total = 0
        for _, edge in ipairs(hops) do
            if not isEdgeUnlocked(edge) then
                return math.huge
            end
            total = total + (cur - edge.EntryPos).Magnitude + HOP_EQUIV_STUDS
            cur = edge.ExitPos
        end
        total = total + (cur - targetPos).Magnitude
        return total
    end

    local function findBestRoute(myPos, targetPos)
        local directDist = (myPos - targetPos).Magnitude
        if directDist < 2200 then
            return nil, directDist
