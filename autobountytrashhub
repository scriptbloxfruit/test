    end

    function PortalXTrackerModule.Init()
        local ec = ReplicatedStorage:FindFirstChild("EffectContainer")
            or (ReplicatedStorage:FindFirstChild("Effect") and ReplicatedStorage.Effect:FindFirstChild("Container"))
            or ReplicatedStorage:FindFirstChild("FX")
        local doorFolder = (ec and ec:FindFirstChild("Door"))
            or (ReplicatedStorage:FindFirstChild("Effect") and ReplicatedStorage.Effect:FindFirstChild("Door"))
        local doorXMod = doorFolder and doorFolder:FindFirstChild("X")

        if doorXMod and doorXMod:IsA("ModuleScript") then
            local ok, doorXFn = pcall(require, doorXMod)
            if ok and type(doorXFn) == "function" and type(hookfunction) == "function" and not ENV._TrashHub_DoorXHookInstalled then
                local success, oldFn = pcall(function()
                    return hookfunction(doorXFn, function(p1, ...)
                        local activeTracker = ENV._TrashHub_PortalXTracker
                        if activeTracker and type(activeTracker.OnDoorXCalled) == "function" then
                            local okCall, intercepted = pcall(activeTracker.OnDoorXCalled, p1)
                            if okCall and intercepted == true then
                                return nil
                            end
                        end
                        local orig = ENV._TrashHub_OriginalDoorX
                        if type(orig) == "function" then
                            return orig(p1, ...)
                        end
                        return nil
                    end)
                end)
                if success and oldFn then
                    ENV._TrashHub_OriginalDoorX = oldFn
                    ENV._TrashHub_DoorXHookInstalled = true
                end
            end
        end

        local effectMod = ReplicatedStorage:FindFirstChild("Effect")
        local bindable = effectMod and effectMod:FindFirstChild("Bindable")
        if bindable and bindable:IsA("BindableEvent") then
            local fxConn = bindable.Event:Connect(function(action, mod, payload, meta)
                if action ~= "spawn" or type(payload) ~= "table" then
                    return
                end
                local metaName = (type(meta) == "table" and meta.Name) or (typeof(mod) == "Instance" and mod.Name) or ""
                local plr = payload.player or payload.Player or (type(meta) == "table" and meta.Sender)
                if typeof(plr) ~= "Instance" or not plr:IsA("Player") then
                    local char = payload.char or payload.Character
                    if typeof(char) == "Instance" then
                        plr = Players:GetPlayerFromCharacter(char)
                    end
                end
                if not plr or plr == LocalPlayer then
                    return
                end

                local st = getPlayerState(plr)
                if metaName == "Portal.XInit" or metaName == "XInit" then
                    st.InPortalX = true
                    st.StartTime = os.clock()
                    st.Duration = tonumber(payload.portalLastsFor) or 4.5
                    if typeof(payload.origin) == "Vector3" then
                        st.EntryCFrame = CFrame.new(payload.origin)
                        st.LastValidCFrame = st.LastValidCFrame or st.EntryCFrame
                    end
                elseif metaName == "Portal.XEnd" or metaName == "XEnd" then
                    st.InPortalX = false
                    st.StartTime = 0
                    if st.DetachedDoorMode then
                        pcall(function()
                            st.DetachedDoorMode:Destroy()
                        end)
                        st.DetachedDoorMode = nil
                    end
                    if typeof(payload.origin) == "Vector3" then
                        st.ExitCFrame = CFrame.new(payload.origin)
                        st.LastValidCFrame = st.ExitCFrame
                    end
                end
            end)
            table.insert(_connections, fxConn)
        end

        local _lastAllPlrsCheck = 0
        local hbConn = RunService.Heartbeat:Connect(function()
            local targetPlr = Hunter and Hunter.TargetPlayer
            if targetPlr and targetPlr.Parent then
                local char = targetPlr.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if char and hrp then
                    breakRunningDoorXLoopIfNeeded(targetPlr, char, hrp)
                end
            end
            local now = os.clock()
            if now - _lastAllPlrsCheck >= 0.25 then
                _lastAllPlrsCheck = now
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr ~= targetPlr then
                        local char = plr.Character
                        local hrp = char and char:FindFirstChild("HumanoidRootPart")
                        if char and hrp then
                            breakRunningDoorXLoopIfNeeded(plr, char, hrp)
                        end
                    end
                end
            end
        end)
        table.insert(_connections, hbConn)

        local remConn = Players.PlayerRemoving:Connect(function(plr)
            _portalState[plr] = nil
        end)
        table.insert(_connections, remConn)

        return true
    end

    function PortalXTrackerModule.IsInPortalX(target)
        local player, char = resolveTarget(target)
        local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
        if player and char and hrp then
            breakRunningDoorXLoopIfNeeded(player, char, hrp)
        end
        if char and char:FindFirstChild("DoorMode") ~= nil then
            return true
        end
        if player and _portalState[player] then
            local st = _portalState[player]
            if st.InPortalX then
                if st.StartTime > 0 and (os.clock() - st.StartTime) > (st.Duration + 0.5) then
                    st.InPortalX = false
                    return false
                end
                return true
            end
        end
        return false
    end

    function PortalXTrackerModule.CanAttackTarget(target)
        local _, char = resolveTarget(target)
        if not char or not char:FindFirstChild("HumanoidRootPart") then
            return false
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then
            return false
        end
        return not PortalXTrackerModule.IsInPortalX(target)
    end

    function PortalXTrackerModule.GetRealCFrame(target)
        local player, char = resolveTarget(target)
        if not char then
            return nil, false, false
        end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            return nil, false, false
        end

        if player then
            breakRunningDoorXLoopIfNeeded(player, char, hrp)
        end

        local inPortalX = PortalXTrackerModule.IsInPortalX(target)
        local st = player and _portalState[player]

        if not isSpoofedPortalPosition(hrp.Position) then
            if st then
                st.LastValidCFrame = hrp.CFrame
            end
            return hrp.CFrame, inPortalX, true
        end

        if st then
            local fallback = st.ExitCFrame or st.LastValidCFrame or st.EntryCFrame
            if fallback then
                return fallback, inPortalX, false
            end
        end

        return nil, inPortalX, false
    end

    function PortalXTrackerModule.GetRealPosition(target)
        local cf, inPortalX, isLive = PortalXTrackerModule.GetRealCFrame(target)
        return cf and cf.Position or nil, inPortalX, isLive
    end

    local function ensureAntiGravity(myHrp)
        if not _bodyVelocity or _bodyVelocity.Parent ~= myHrp then
            if _bodyVelocity then
                pcall(function() _bodyVelocity:Destroy() end)
            end
            local bv = Instance.new("BodyVelocity")
            bv.Name = "PortalXTrackerBV"
            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.Velocity = Vector3.zero
            bv.Parent = myHrp
            _bodyVelocity = bv
        end
        myHrp.AssemblyLinearVelocity = Vector3.zero
    end

    local function cleanupAntiGravity()
        if _bodyVelocity then
            pcall(function() _bodyVelocity:Destroy() end)
            _bodyVelocity = nil
        end
    end

    function PortalXTrackerModule.FollowTargetStep(target, dt, options)
        options = options or {}
        local realCF, inPortalX, isLive = PortalXTrackerModule.GetRealCFrame(target)
        if not realCF then
            cleanupAntiGravity()
            return {
                Followed = false,
                InPortalX = false,
                CanAttack = false,
                TargetCFrame = nil,
                GoalCFrame = nil,
                Distance = math.huge,
            }
        end

        if options.OnlyFollowDuringPortalX and not inPortalX then
            cleanupAntiGravity()
            return {
                Followed = false,
                InPortalX = false,
                CanAttack = true,
                TargetCFrame = realCF,
                GoalCFrame = realCF,
                Distance = 0,
            }
        end

        local offset = inPortalX
            and (options.PortalOffset or PortalXTrackerModule.Config.PortalFollowOffset)
            or (options.CombatOffset or PortalXTrackerModule.Config.CombatFollowOffset)

        local goalPos = (realCF * offset).Position
        local goalCF
        if PortalXTrackerModule.Config.LookAtTarget then
            goalCF = CFrame.lookAt(goalPos, realCF.Position)
        else
            goalCF = CFrame.new(goalPos)
        end

        local myChar = LocalPlayer and LocalPlayer.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

        if not myHrp or not myHum or myHum.Health <= 0 then
            cleanupAntiGravity()
            return {
                Followed = false,
                InPortalX = inPortalX,
                CanAttack = not inPortalX,
                TargetCFrame = realCF,
                GoalCFrame = goalCF,
                Distance = math.huge,
            }
        end

        local currentPos = myHrp.Position
        local diff = goalPos - currentPos
        local dist = diff.Magnitude

        if type(options.CustomMoveCallback) == "function" then
            options.CustomMoveCallback(goalCF, inPortalX, realCF)
            return {
                Followed = true,
                InPortalX = inPortalX,
                CanAttack = not inPortalX,
                IsLivePosition = isLive,
                TargetCFrame = realCF,
                GoalCFrame = goalCF,
                Distance = dist,
            }
        end

        ensureAntiGravity(myHrp)
        local stepDt = math.clamp(dt or (1 / 60), 0.001, 0.2)
        local speed = options.Speed or PortalXTrackerModule.Config.SafeGlideSpeed
        local snapDist = options.SnapDistance or PortalXTrackerModule.Config.SnapDistance

        if dist <= snapDist then
            myHrp.CFrame = goalCF
        else
            local stepLen = math.min(dist, speed * stepDt)
            local nextPos = currentPos + diff.Unit * stepLen
            if PortalXTrackerModule.Config.LookAtTarget then
                myHrp.CFrame = CFrame.lookAt(nextPos, realCF.Position)
            else
                myHrp.CFrame = CFrame.new(nextPos)
            end
        end

        return {
            Followed = true,
            InPortalX = inPortalX,
            CanAttack = not inPortalX,
            IsLivePosition = isLive,
            TargetCFrame = realCF,
            GoalCFrame = goalCF,
            Distance = dist,
        }
    end

    function PortalXTrackerModule.StartAutoFollow(target, options)
        PortalXTrackerModule.StopAutoFollow()
        _activeTarget = target
        options = options or {}

        local wasInPortalX = false

        _autoFollowConn = RunService.Heartbeat:Connect(function(dt)
            if not _activeTarget then
                PortalXTrackerModule.StopAutoFollow()
                return
            end

            local state = PortalXTrackerModule.FollowTargetStep(_activeTarget, dt, options)

            if state.InPortalX and not wasInPortalX then
                wasInPortalX = true
                if type(options.OnPortalEnter) == "function" then
                    task.spawn(options.OnPortalEnter, _activeTarget, state.TargetCFrame)
                end
            elseif not state.InPortalX and wasInPortalX then
                wasInPortalX = false
                if type(options.OnPortalExit) == "function" then
                    task.spawn(options.OnPortalExit, _activeTarget, state.TargetCFrame)
                end
            end
        end)
    end

    function PortalXTrackerModule.StopAutoFollow()
        if _autoFollowConn and _autoFollowConn.Connected then
            _autoFollowConn:Disconnect()
        end
        _autoFollowConn = nil
        _activeTarget = nil
        cleanupAntiGravity()
    end

    function PortalXTrackerModule.Destroy()
        PortalXTrackerModule.StopAutoFollow()
        for _, conn in ipairs(_connections) do
            if conn and conn.Connected then
                conn:Disconnect()
            end
        end
        table.clear(_connections)
        table.clear(_portalState)
        if ENV._TrashHub_PortalXTracker == PortalXTrackerModule then
            ENV._TrashHub_PortalXTracker = nil
        end
    end

    ENV._TrashHub_PortalXTracker = PortalXTrackerModule
    ENV.PortalXTrackerModule = PortalXTrackerModule
    PortalXTrackerModule.Init()
    return PortalXTrackerModule
end)()

Hunter.KenCheck = (function()
