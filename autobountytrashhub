        local function setupChar(char)
            disconnectList(api._playerCharConns[player])
            api._enemyRoots[player] = nil
            local charConnList = api._playerCharConns[player]
            if not char then return end

            local immediateRoot = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
            if immediateRoot then api._enemyRoots[player] = immediateRoot end

            local raceVal = char:FindFirstChild("RaceTransformed")
            if raceVal then bindRaceV4Value(raceVal, charConnList) end

            task.spawn(function()
                local root = immediateRoot or char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 2.0) or char.PrimaryPart
                if player.Character ~= char or api.Destroyed or _activeTrackedTarget ~= player or api._playerCharConns[player] ~= charConnList then return end
                api._enemyRoots[player] = root

                local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 2.0)
                if player.Character ~= char or api.Destroyed or _activeTrackedTarget ~= player or api._playerCharConns[player] ~= charConnList then return end
                if hum and player.Character == char then
                    local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 2.0)
                    if animator and _activeTrackedTarget == player and api._playerCharConns[player] == charConnList then
                        bindAnimator(animator, charConnList)
                    end
                end
                if _activeTrackedTarget ~= player or api._playerCharConns[player] ~= charConnList or api.Destroyed then return end

                for _, desc in ipairs(char:GetDescendants()) do
                    if desc:IsA("Animator") then bindAnimator(desc, charConnList)
                    elseif desc:IsA("Sound") then bindEnemySound(desc, charConnList)
                    elseif desc:IsA("Tool") then bindTransformedToolRig(desc, charConnList)
                    elseif desc.Name == "RaceTransformed" and desc:IsA("BoolValue") then bindRaceV4Value(desc, charConnList) end
                end

                table.insert(charConnList, char.DescendantAdded:Connect(function(desc)
                    if _activeTrackedTarget ~= player or api.Destroyed then return end
                    if desc.Name == "HumanoidRootPart" and desc:IsA("BasePart") then api._enemyRoots[player] = desc
                    elseif desc:IsA("Animator") then bindAnimator(desc, charConnList)
                    elseif desc:IsA("Sound") then bindEnemySound(desc, charConnList)
                    elseif desc:IsA("Tool") then bindTransformedToolRig(desc, charConnList)
                    elseif desc.Name == "RaceTransformed" and desc:IsA("BoolValue") then bindRaceV4Value(desc, charConnList) end
                end))
