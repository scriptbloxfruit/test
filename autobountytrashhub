        for _, edge in ipairs(hops) do
            if not isEdgeUnlocked(edge) then
                return math.huge
            end
            total = total + (cur - edge.EntryPos).Magnitude + HOP_EQUIV_STUDS
            cur = edge.ExitPos
        end
        total = total + (cur - targetPos).Magnitude
        return total
    end

