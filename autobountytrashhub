    local clearance = math.max(0, tonumber(api.Config.Clearance) or 0.75)
    local below = math.max(0, humanoid.HipHeight) + root.Size.Y * 0.5 + clearance
    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        local leg = root.Parent:FindFirstChild("Left Leg") or root.Parent:FindFirstChild("Right Leg")
        below += leg and leg.Size.Y or 2
    end
    local above = root.Size.Y * 0.5 + 2 + clearance
    local size = Vector3.new(math.max(4, root.Size.X + 2) + clearance * 2,
        above + below, math.max(3, root.Size.Z + 2) + clearance * 2)
    return size, (above - below) * 0.5
end

local function overlapsLava(cframe, size, centerOffset)
    local boxCFrame = cframe * CFrame.new(0, centerOffset, 0)
    local pos = boxCFrame.Position
    local now = os.clock()
    if _lastOverlapPos and (now - _lastOverlapTick) < 0.05 then
        local dx = pos.X - _lastOverlapPos.X
        local dy = pos.Y - _lastOverlapPos.Y
        local dz = pos.Z - _lastOverlapPos.Z
        if (dx * dx + dy * dy + dz * dz) < 0.04 then
            return _lastOverlapResult
        end
    end

    local broad = Workspace:GetPartBoundsInBox(boxCFrame, size, overlap)
    local res = (#broad > 0)
    _lastOverlapPos = pos
    _lastOverlapResult = res
    _lastOverlapTick = now
    return res
end

local function _filterMoveNearLava(self, root, desiredCFrame, size, centerOffset)
    if not overlapsLava(desiredCFrame, size, centerOffset) then
        lastSafeRoot, lastSafeCFrame = root, desiredCFrame
        return desiredCFrame, "clear"
    end
    self.Blocks += 1
    local maxRise = math.clamp(tonumber(self.Config.MaxRise) or 512, 0, 512)
    local lower, rise = 0, math.min(2, maxRise)
    while rise > 0 and rise <= maxRise do
        local lifted = desiredCFrame + Vector3.new(0, rise, 0)
        if not overlapsLava(lifted, size, centerOffset) then
            for _ = 1, 5 do
                local middle = (lower + rise) * 0.5
                if overlapsLava(desiredCFrame + Vector3.new(0, middle, 0), size, centerOffset) then
                    lower = middle
                else
                    rise = middle
                end
            end
            lifted = desiredCFrame + Vector3.new(0, rise + 0.25, 0)
            if not overlapsLava(lifted, size, centerOffset) then
                lastSafeRoot, lastSafeCFrame = root, lifted
                return lifted, "raised-above-lava"
            end
            break
        end
        if rise == maxRise then break end
        lower, rise = rise, math.min(rise * 2, maxRise)
    end
    if not overlapsLava(root.CFrame, size, centerOffset) then return root.CFrame, "blocked-lava-entry" end
    if lastSafeRoot == root and lastSafeCFrame
        and (lastSafeCFrame.Position - root.Position).Magnitude <= 512
        and not overlapsLava(lastSafeCFrame, size, centerOffset) then
        return lastSafeCFrame, "returned-to-safe-position"
    end
    return root.CFrame, "no-clear-lava-exit"
end

local _lastFilteredDesiredPos = nil
local _lastFilteredResultCF = nil
local _lastFilteredTick = 0
local _lastFilteredReason = "cached"

function api:FilterMove(root, humanoid, desiredCFrame)
    if self.Destroyed or not self.Config.Enabled then return desiredCFrame end
    if not root or not root.Parent or not humanoid or humanoid.Health <= 0 then return desiredCFrame end
    if type(self.MovementGuard) == "function" then
        local ok, allowed = pcall(self.MovementGuard, root, humanoid, desiredCFrame)
        if not ok then self.LastError = tostring(allowed); return root.CFrame end
        if allowed == false then self.LastReason = "movement-owned-by-route"; return desiredCFrame end
    end
    refreshList()
    if not hasAnyLava then self.LastReason = "no-map-lava"; return desiredCFrame end

    local pos = desiredCFrame.Position
    local now = os.clock()
    if _lastFilteredDesiredPos and (now - _lastFilteredTick) < 0.08 and not listDirty then
        local dx = pos.X - _lastFilteredDesiredPos.X
        local dy = pos.Y - _lastFilteredDesiredPos.Y
        local dz = pos.Z - _lastFilteredDesiredPos.Z
        if (dx * dx + dy * dy + dz * dz) < 0.0225 then
            self.LastReason = _lastFilteredReason
            return _lastFilteredResultCF
        end
    end

    local size, centerOffset = bodyBox(root, humanoid)
    local halfBodyY = size.Y * 0.5
    local bodyBottom = (pos.Y + centerOffset) - halfBodyY
    local bodyTop = (pos.Y + centerOffset) + halfBodyY

    -- Fast altitude gate: if completely above or below all lava in the map, exit in 0ms!
    if bodyBottom > (maxLavaY + 4) or bodyTop < (minLavaY - 4) then
        self.LastReason = "altitude-clear"
        lastSafeRoot, lastSafeCFrame = root, desiredCFrame
        _lastFilteredDesiredPos = pos
        _lastFilteredResultCF = desiredCFrame
        _lastFilteredTick = now
        _lastFilteredReason = "altitude-clear"
        return desiredCFrame
    end

    -- Fast proximity gate: check 3D distance to all lava bounds
    local bodyRadius = size.Magnitude * 0.5
    local isNearLava = false
    for i = 1, #lavaBounds do
        local lb = lavaBounds[i]
        local maxDist = lb.radius + bodyRadius + 4
        local dx = pos.X - lb.pos.X
        local dz = pos.Z - lb.pos.Z
        if math.abs(dx) <= maxDist and math.abs(dz) <= maxDist then
            local dy = (pos.Y + centerOffset) - lb.pos.Y
            if math.abs(dy) <= (lb.halfY + halfBodyY + 4) then
                if (dx * dx + dz * dz) <= (maxDist * maxDist) then
                    isNearLava = true
                    break
                end
            end
        end
    end

    if not isNearLava then
        self.LastReason = "far-from-lava"
        lastSafeRoot, lastSafeCFrame = root, desiredCFrame
        _lastFilteredDesiredPos = pos
        _lastFilteredResultCF = desiredCFrame
        _lastFilteredTick = now
        _lastFilteredReason = "far-from-lava"
        return desiredCFrame
    end

    local ok, safeCFrame, reason = pcall(_filterMoveNearLava, self, root, desiredCFrame, size, centerOffset)
    if not ok then
        self.LastReason, self.LastError = "overlap-query-failed", tostring(safeCFrame)
        return root.CFrame
    end
    self.LastReason, self.LastError = reason, nil
    _lastFilteredDesiredPos = pos
    _lastFilteredResultCF = safeCFrame
    _lastFilteredTick = now
    _lastFilteredReason = reason
    return safeCFrame
end

