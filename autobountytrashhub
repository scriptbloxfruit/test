local _cachedGlobalModule = nil
unlockSkillState = function()
    local char = LocalPlayer.Character
    if not char then return end
    if Hunter and Hunter.IsActionLocked and Hunter.IsActionLocked(char) then
        return
    end
    pcall(function()
        local busy = char:FindFirstChild("Busy")
        if busy and (busy:IsA("BoolValue") or busy:IsA("ValueBase")) then
            busy.Value = false
        end
        if not (Hunter and Hunter._skillHeldKey) then
            for _, child in ipairs(char:GetChildren()) do
                if child:IsA("Tool") then
                    local holding = child:FindFirstChild("Holding")
                    if holding and holding:IsA("BoolValue") then
                        holding.Value = false
                    end
                end
            end
        end
    end)
    pcall(function()
        if getgenv().__FastSkill and getgenv().__FastSkill.Bypass then
            getgenv().__FastSkill.Bypass()
        end
    end)
    pcall(function()
        if not _cachedGlobalModule then
            local gm = ReplicatedStorage:FindFirstChild("Global")
            if gm then _cachedGlobalModule = require(gm) end
        end
        if _cachedGlobalModule then
            _cachedGlobalModule.busy = false
            _cachedGlobalModule.castTimer = 0
            _cachedGlobalModule.equipTimer = 0
            _cachedGlobalModule.tapCooldown = 0
            _cachedGlobalModule.fruitSwapTimeLockout = 0
