    end
    PortalXTrackerModule.IsSpoofedPosition = isSpoofedPortalPosition

    local function getPlayerState(plr)
        local st = _portalState[plr]
        if not st then
            st = {
                InPortalX = false,
                StartTime = 0,
                Duration = 4.5,
                EntryCFrame = nil,
                ExitCFrame = nil,
                LastValidCFrame = nil,
                DetachedDoorMode = nil,
