local function setupBloxMouse(mouseInst)
    if not mouseInst then return end
    local BloxMouse = nil
    pcall(function() BloxMouse = require(mouseInst) end)
    Hunter._bloxMouse = BloxMouse

    if BloxMouse then
        pcall(function()
            local mt = getrawmetatable(BloxMouse)
            if not mt then return end
            if type(setreadonly) == "function" then setreadonly(mt, false) end

            if not getgenv()._TrashHub_OrigMTSaved then
                getgenv()._TrashHub_OrigMTIndex = mt.__index
                getgenv()._TrashHub_OrigMTNewIndex = mt.__newindex
                getgenv()._TrashHub_OrigMTSaved = true
            end
            local oldIndex = getgenv()._TrashHub_OrigMTIndex

            Hunter._storedHit = rawget(BloxMouse, "Hit") or Hunter._storedHit or CFrame.new()
            Hunter._storedTarget = rawget(BloxMouse, "Target") or Hunter._storedTarget
            Hunter._storedX = rawget(BloxMouse, "X") or Hunter._storedX or 0
            Hunter._storedY = rawget(BloxMouse, "Y") or Hunter._storedY or 0

            rawset(BloxMouse, "Hit", nil)
            rawset(BloxMouse, "Target", nil)
            rawset(BloxMouse, "X", nil)
            rawset(BloxMouse, "Y", nil)

            mt.__newindex = function(self, key, val)
                if key == "Hit" then Hunter._storedHit = val return end
                if key == "Target" then Hunter._storedTarget = val return end
                if key == "X" then Hunter._storedX = val return end
                if key == "Y" then Hunter._storedY = val return end
                rawset(self, key, val)
            end

            mt.__index = function(self, key)
                if Hunter._isRunning and Hunter.TargetPart and Hunter.TargetPart.Parent and isAlive(Hunter.TargetCharacter) then
                    local predPos = getPredictedPos(Hunter.TargetPart)
                    local aimCamera = Workspace.CurrentCamera or Camera
                    local camPos = aimCamera.CFrame.Position

                    if key == "Hit" then return CFrame.new(predPos, camPos) * CFrame.Angles(0, math.pi, 0) end
                    if key == "Target" then return Hunter.TargetPart end
                    if key == "X" then return aimCamera:WorldToViewportPoint(predPos).X end
                    if key == "Y" then return aimCamera:WorldToViewportPoint(predPos).Y end
                end

                if key == "Hit" then return Hunter._storedHit or RealMouse.Hit end
                if key == "Target" then return Hunter._storedTarget or RealMouse.Target end
                if key == "X" then return Hunter._storedX or RealMouse.X end
                if key == "Y" then return Hunter._storedY or RealMouse.Y end

                if type(oldIndex) == "function" then return oldIndex(self, key) end
                return nil
            end
        end)
    end
end

