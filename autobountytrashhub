local function formatNumber(n)
    local left, num, right = string.match(tostring(math.floor(n or 0)), '^([^%d]*%d)(%d*)(.-)$')
    if not left then return tostring(math.floor(n or 0)) end
    return left .. (num:reverse():gsub('(%d%d%d)', '%1,'):reverse()) .. right
end
local function formatElapsedTime(seconds)
    local s = math.floor(seconds or 0)
    local hrs = math.floor(s / 3600)
    local mins = math.floor((s % 3600) / 60)
    local secs = math.floor(s % 60)
    return string.format("%02d:%02d:%02d", hrs, mins, secs)
end
local function getActiveElapsedTime()
    local curSession = math.max(0, math.floor(os.time() - (_sessionStartTime or os.time())))
    return (_totalActiveTime or 0) + curSession
end

local function maskUsername(name)
    if not name or type(name) ~= "string" then return "Pla******" end
    local len = #name
    if len <= 3 then
        return name:sub(1, 1) .. string.rep("*", math.max(2, len - 1))
    end
    local visibleCount = math.max(1, math.floor(len / 3))
    local maskedCount = len - visibleCount
    return name:sub(1, visibleCount) .. string.rep("*", math.max(3, maskedCount))
end

