                            local gun = cfg.M1GunChipDuringApproach ~= false and getToolByType("Gun")
                            local state, reason = Hunter.GunM1:GetApproachState(gun)
                            Hunter._gunApproachReason = reason
                            if state then
                                local wasAlreadyEquipped = (gun and gun.Parent == LocalPlayer.Character)
                                local equippedGun = equipWeapon("Gun")
                                if equippedGun and not wasAlreadyEquipped then
                                    task.wait(0.10)
                                end
                                if equippedGun == gun and Hunter.TargetPlayer == state.Player
                                    and Hunter.TargetCharacter == state.TargetCharacter then
                                    performM1Attack(equippedGun)
                                    Hunter._gunApproachReason = Hunter.GunM1.LastReason
                                end
                            end
                            task.wait(0.04)
                        end
                    end
                end
            else
                Hunter._isPreparingSkillCast = false
                task.wait(0.2)
            end
        end
        end, function(err) return tostring(err) .. "\n" .. debug.traceback() end)
        Hunter._isSkillLoopRunning = false
        Hunter._isPreparingSkillCast = false
        if Hunter._skillHeldKey then
            pcall(function() VirtualInputManager:SendKeyEvent(false, Hunter._skillHeldKey, false, game) end)
