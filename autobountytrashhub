        if type(isfile) == "function" and isfile(STATS_FILE) then
            local raw = readfile(STATS_FILE)
            if raw and #raw > 2 then
                local HttpService = game:GetService("HttpService")
                local data = HttpService:JSONDecode(raw)
                if data and type(data) == "table" then
                    _earnedBounty = tonumber(data.EarnedBounty) or 0
                    _totalKills = tonumber(data.TotalKills) or 0
                    local savedBounty = tonumber(data.CurrentAccountBounty) or 0
                    if savedBounty > 0 and (not _lastKnownBounty or _lastKnownBounty == 0) then
                        _lastKnownBounty = savedBounty
                    end
                    if data.TotalActiveTime and tonumber(data.TotalActiveTime) then
                        _totalActiveTime = tonumber(data.TotalActiveTime) or 0
                    elseif data.StartTime and tonumber(data.StartTime) and tonumber(data.StartTime) > 0 then
                        _totalActiveTime = 0
                    end
                end
            end
        end
    end)
    _sessionStartTime = os.time()
end
local function saveStatsToJson()
    pcall(function()
        if type(writefile) == "function" then
            local HttpService = game:GetService("HttpService")
            local data = {
                EarnedBounty = _earnedBounty or 0,
                TotalKills = _totalKills or 0,
                TotalActiveTime = getActiveElapsedTime(),
                CurrentAccountBounty = getPlayerBounty(LocalPlayer),
                LastUpdated = os.date("%Y-%m-%d %H:%M:%S")
            }
            writefile(STATS_FILE, HttpService:JSONEncode(data))
        end
    end)
end
pcall(function()
    game:BindToClose(function()
        pcall(saveStatsToJson)
    end)
end)
loadStatsFromJson()
task.spawn(function()
    while Hunter._isRunning do
        task.wait(30)
        pcall(saveStatsToJson)
    end
end)
local extractVictimKey, scanNotificationsForVictimEarned, updateBountyStats
do
local _recentNotifEarnedByVictim = {}
local _lastNotifEarnedVal = nil
local _lastNotifEarnedTick = 0

extractVictimKey = function(rawVictim)
    if not rawVictim or type(rawVictim) ~= "string" then return "" end
    local atUser = rawVictim:match("@([%w_]+)")
    if atUser and atUser ~= "" then
        return atUser:lower()
    end
    local clean = rawVictim:gsub("<[^>]->", ""):gsub("[%.!]", ""):match("^%s*(.-)%s*$") or ""
    return clean:lower()
end

local function extractEarnedAmount(s)
    if not s or s == "" then return nil end
    local numStr = s:match("([%d,%.]+)%s*[Bb]ounty")
        or s:match("([%d,%.]+)%s*[Hh]onor")
        or s:match("[Ee]arned[^%d]-([%d,%.]+)%s*[Bb]ounty")
        or s:match("[Ee]arned[^%d]-([%d,%.]+)%s*[Hh]onor")
        or s:match("[Ee]arned%s*:%s*%+?([%d,%.]+)")
        or s:match("[Ee]arned%s+%+?([%d,%.]+)")
    if numStr then
        local digits = numStr:gsub("[^%d]", "")
        local val = tonumber(digits)
        if val and val > 0 then return val end
    end
    return nil
end

local function parseKillNotificationText(rawText, contentText)
    local t1 = tostring(rawText or ""):gsub("<[^>]->", "")
    local t2 = tostring(contentText or ""):gsub("<[^>]->", "")
    local clean = (#t1 > 0 and t1:lower():find("killing", 1, true)) and t1
        or ((#t2 > 0 and t2:lower():find("killing", 1, true)) and t2 or "")
    if clean == "" then
        return nil, nil, nil
    end

    local victim = clean:match("killing%s+([%w_]+)") or clean:match("killing%s+(.-)[%.!%s]*$")
    if not victim or victim == "" then
        return nil, nil, nil
    end
    local cleanVictim = victim:gsub("[%.!]", ""):match("^%s*(.-)%s*$")
    if not cleanVictim or cleanVictim == "" then
        return nil, nil, nil
    end

    local earnedVal = extractEarnedAmount(t1) or extractEarnedAmount(t2)
    if not earnedVal or earnedVal <= 0 then
        local curBounty = getPlayerBounty and getPlayerBounty(LocalPlayer) or 0
        if curBounty >= 30000000 then
            earnedVal = 10000
        end
    end
    return cleanVictim, earnedVal, clean
end

scanNotificationsForVictimEarned = function(targetVictim)
    local targetKey = extractVictimKey(targetVictim)
    if targetKey ~= "" and _recentNotifEarnedByVictim[targetKey] then
        local entry = _recentNotifEarnedByVictim[targetKey]
        if entry.earned and entry.earned > 0 and not entry.consumed and (tick() - (entry.tick or 0) < 6.0) then
            return entry.earned, entry.victimDisplay
        end
    end
    local foundEarned, foundVictim = nil, nil
    pcall(function()
        local pg = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
        if not pg then return end
        for _, child in ipairs(pg:GetChildren()) do
            if child.Name == "Notifications" then
                for _, desc in ipairs(child:GetDescendants()) do
                    if desc:IsA("TextLabel") and desc.Text ~= "" then
                        local cText = ""
                        pcall(function() cText = desc.ContentText end)
                        local cleanVictim, earnedVal = parseKillNotificationText(desc.Text, cText)
                        if cleanVictim and earnedVal and earnedVal > 0 then
                            local vKey = cleanVictim:lower()
                            local entry = _recentNotifEarnedByVictim[vKey]
                            if not entry or not entry.consumed then
                                _recentNotifEarnedByVictim[vKey] = {
                                    earned = earnedVal,
                                    tick = tick(),
                                    victimDisplay = cleanVictim,
                                    consumed = false
                                }
                            end
                            if targetKey ~= "" and (vKey == targetKey or targetKey:find(vKey, 1, true) or vKey:find(targetKey, 1, true)) then
                                if not _recentNotifEarnedByVictim[vKey].consumed then
                                    foundEarned = earnedVal
                                    foundVictim = cleanVictim
                                    break
                                end
                            end
                        end
                    end
                end
                if foundEarned then break end
            end
        end
    end)
    return foundEarned, foundVictim
end

updateBountyStats = function(explicitVictim, overrideEarned)
    local cur = getPlayerBounty(LocalPlayer)
    if not cur or cur <= 0 then return end

    if not _lastKnownBounty or _lastKnownBounty == 0 then
        _lastKnownBounty = cur
        saveStatsToJson()
        return
    end

    local vic = explicitVictim or _lastKilledVictimName
    if (not vic or vic == "" or vic == "PvP Target") and _currentCombatTarget then
        vic = string.format("%s (@%s)", _currentCombatTarget.DisplayName, _currentCombatTarget.Name)
    end
    if not vic or vic == "" then vic = _lastCombatEnemyName end
    if not vic or vic == "" then vic = "PvP Target" end

    local vicKey = extractVictimKey(vic)
    local now = tick()

    if not overrideEarned or overrideEarned <= 0 then
        local scannedEarned = scanNotificationsForVictimEarned(vic)
        if scannedEarned and scannedEarned > 0 then
            overrideEarned = scannedEarned
        end
    end

    local isAt30M = (cur >= 30000000)
    local diff = 0
    local shouldCountKill = false

    if Hunter and (
        (Hunter._lastProcessedVictim == vic)
        or (vicKey ~= "" and Hunter._lastProcessedVictimKey == vicKey)
    ) and (now - (Hunter._lastProcessedKillTime or 0) < 4.0) then
        return
    end

    -- CHỈ TÍNH KILL KHI CÓ BẰNG CHỨNG XÁC THỰC:
    -- 1. Có thông báo killing cụ thể trong PlayerGui.Notifications (áp dụng cho cả người chơi 30M và < 30M)
    -- 2. Hoặc điểm Bounty thực tế trong leaderstats tăng lên (> _lastKnownBounty)
    if overrideEarned and overrideEarned > 0 and overrideEarned <= 350000 then
        diff = overrideEarned
        shouldCountKill = true
        _lastKnownBounty = cur
    elseif not isAt30M and cur > _lastKnownBounty then
        diff = cur - _lastKnownBounty
        if diff <= 350000 then
            shouldCountKill = true
        end
        _lastKnownBounty = cur
    elseif cur < _lastKnownBounty then
        local lost = _lastKnownBounty - cur
        _lastKnownBounty = cur
        if lost > 0 and lost <= 250000 then
            _earnedBounty = (_earnedBounty or 0) - lost
            getgenv()._TrashHubEarnedBounty = _earnedBounty
            saveStatsToJson()
            pcall(function()
                if type(showBottomRightNotify) == "function" then
                    showBottomRightNotify("Bounty Lost", "-" .. formatNumber(lost) .. " Bounty", Color3.fromRGB(255, 85, 85), "Penalty", "Deducted from Bounty Earned")
                end
            end)
        end
    end

    if shouldCountKill and diff <= 350000 then
        if Hunter then
            Hunter._lastProcessedVictim = vic
            Hunter._lastProcessedVictimKey = vicKey
            Hunter._lastProcessedKillTime = now
                    end

        local vicServerKey = vicKey ~= "" and vicKey or vic:lower()
        if vicKey ~= "" and _recentNotifEarnedByVictim[vicKey] then
            _recentNotifEarnedByVictim[vicKey].consumed = true
        end
        local lastServerCounted = _countedServerKills[vicServerKey]
        if not lastServerCounted or now - lastServerCounted > 5 then
            _countedServerKills[vicServerKey] = now
            _serverKillsCount = _serverKillsCount + 1
        end

        _earnedBounty = (_earnedBounty or 0) + diff
        getgenv()._TrashHubEarnedBounty = _earnedBounty
        _totalKills = (_totalKills or 0) + 1
        if Hunter then Hunter.TotalKills = _totalKills end
        getgenv()._TrashHubTotalKills = _totalKills

        _lastKnownBounty = cur
        saveStatsToJson()
        pcall(function()
            if type(getgenv) == "function" and getgenv().TrashHubNotify and type(getgenv().TrashHubNotify.NotifyEarned) == "function" then
                getgenv().TrashHubNotify.NotifyEarned(diff, vic)
            elseif type(showBottomRightNotify) == "function" then
                showBottomRightNotify("Earned", "+" .. formatNumber(diff) .. " Bounty", Color3.fromRGB(0, 235, 135), "Killed Target", tostring(vic or "Player"))
            end
        end)
        pcall(function()
            sendKillWebhooks(cur, _earnedBounty, diff, vic)
        end)

        local actCfg = getActiveConfig()
        local maxKills = tonumber(actCfg and actCfg.MaxKillsPerServer) or 6
        if maxKills > 0 and _serverKillsCount >= maxKills then
            task.delay(1.2, function()
                if type(autoHopServer) == "function" then
                    autoHopServer(string.format("KillLimitReached (%d/%d Kills in Server)", _serverKillsCount, maxKills))
                end
            end)
        end
    end
end

local function checkAndDeductBountyLoss()
    local cur = getPlayerBounty(LocalPlayer)
    if not cur or cur <= 0 then return end
    if not _lastKnownBounty or _lastKnownBounty <= 0 then
        _lastKnownBounty = cur
        return
    end
    if cur < _lastKnownBounty then
        local lost = _lastKnownBounty - cur
        _lastKnownBounty = cur
        if lost > 0 and lost <= 250000 then
            _earnedBounty = (_earnedBounty or 0) - lost
            getgenv()._TrashHubEarnedBounty = _earnedBounty
            saveStatsToJson()
            pcall(function()
                if type(showBottomRightNotify) == "function" then
                    showBottomRightNotify("Bounty Lost", "-" .. formatNumber(lost) .. " Bounty", Color3.fromRGB(255, 85, 85), "Penalty", "Deducted from Bounty Earned")
                end
            end)
        end
    elseif (cur - _lastKnownBounty) > 350000 then
        _lastKnownBounty = cur
    end
end
Hunter.CheckBountyLoss = checkAndDeductBountyLoss

task.defer(function()
    pcall(function()
        if getgenv()._TrashHub_BountyLossConns then
