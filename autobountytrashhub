local function maskUsername(name)
    if not name or type(name) ~= "string" then return "Pla******" end
    local len = #name
    if len <= 3 then
        return name:sub(1, 1) .. string.rep("*", math.max(2, len - 1))
    end
    local visibleCount = math.max(1, math.floor(len / 3))
    local maskedCount = len - visibleCount
    return name:sub(1, visibleCount) .. string.rep("*", math.max(3, maskedCount))
end

