            if os.clock() - (Hunter._lastSkillLoopErrorLog or -math.huge) >= 3 then
                Hunter._lastSkillLoopErrorLog = os.clock()
            end
            task.wait(0.25)
        else
            Hunter._skillLoopLastError = nil
        end
    end)
end

