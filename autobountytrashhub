    return self
end

function Aim:GetStatus()
    local stats = {}
    for key, value in pairs(self._stats) do stats[key] = value end
    return {
        Version = self.Version,
        Enabled = self.Config.Enabled and not self._destroyed,
        Active = state ~= nil and state.Active == self and not self._destroyed,
        HookInstalled = state ~= nil and type(state.Original) == "function",
        Destroyed = self._destroyed,
        AimBotPresent = type(ENV._StandaloneAimBot) == "table",
        LastReason = self._lastReason,
        LastError = self._lastError,
        LastTarget = self._lastTarget,
        LastWeapon = self._lastWeapon,
