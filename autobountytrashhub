    end
    local function clearHistory()
        state.count, state.cursor = 0, 0
        state.velocity, state.acceleration = Vector3.zero, Vector3.zero
        state.measuredVelocity, state.hasVelocity = Vector3.zero, false
        state.lastSampleAt, state.lastPosition, state.lastMotionAt = nil, nil, nil
        state.motionInterval, state.stopped = 1 / 30, false
        state.movementOffset, state.desiredPosition, state.distance = nil, nil, nil
        for _, sample in ipairs(state.history) do
            sample.time, sample.position = 0, Vector3.zero
        end
    end
    function api:Pause()
        releaseRotation()
        state.mode = "TRAVEL"
        state.movementOffset, state.desiredPosition, state.distance = nil, nil, nil
        state.castSerial = state.castSerial + 1
        state.castTime, state.castUntil = nil, 0
        Hunter.PredictedPos = nil
    end
    function api:Reset()
        self:Pause()
        if Hunter.Motion then Hunter.Motion:Reset() end
        disconnect(state.targetConnections)
        clearHistory()
        state.player, state.part, state.character, state.side = nil, nil, nil, nil
    end
    local function isCurrentTarget(part)
        return not state.destroyed and Hunter._isRunning
            and part ~= nil and part == state.part and part.Parent ~= nil
            and state.player ~= nil and state.player.Parent ~= nil
            and state.player == Hunter.TargetPlayer
            and state.character == state.player.Character
    end
    local function bind(player, part)
        api:Reset()
        state.player, state.part, state.character = player, part, player.Character
        local character = state.character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local function resetIfCurrent()
            if state.player == player and state.part == part then api:Reset() end
        end
        if humanoid then
            table.insert(state.targetConnections, humanoid.Died:Connect(resetIfCurrent))
        end
        table.insert(state.targetConnections, player.CharacterRemoving:Connect(function(removed)
            if removed == character then resetIfCurrent() end
        end))
        table.insert(state.targetConnections, part.AncestryChanged:Connect(function()
            if not part:IsDescendantOf(character) then resetIfCurrent() end
        end))
    end

    local function parsePingText(value)
        if type(value) ~= "string" then return nil end
        local text = value:lower():gsub(",", ".")
        local number = tonumber(text:match("[%d%.]+"))
        if not finite(number) or number < 0 then return nil end
        if text:find("ms", 1, true) or text:find("millisecond", 1, true) then
            return number / 1000
        end
        if text:find("sec", 1, true) or text:match("%d%s*s%s*$") then return number end
        return nil
    end
    local function pollPing(now)
        if now - state.lastPingPoll < math.max(cfg.PingPollInterval, 0.1) then return end
        local elapsed = now - state.lastPingPoll
        state.lastPingPoll = now
        local ping, source
        pcall(function()
            local performance = StatsService:FindFirstChild("PerformanceStats")
            local item = performance and performance:FindFirstChild("Ping")
            if not item then return end
            local textOk, textValue = pcall(function() return item:GetValueString() end)
            if textOk then ping = parsePingText(textValue) end
            if ping == nil then
                local valueOk, value = pcall(function() return item:GetValue() end)
                if valueOk and finite(value) and value >= 0 then ping = value / 1000 end
            end
            if ping ~= nil then source = "Stats.PerformanceStats.Ping" end
        end)
        if ping == nil then
            local ok, value = pcall(function() return LocalPlayer:GetNetworkPing() end)
            if ok and finite(value) and value >= 0 then
                ping, source = value, "LocalPlayer:GetNetworkPing (seconds)"
            end
        end
        if ping ~= nil then
            ping = math.clamp(ping, 0, 1)
            local alpha = state.pingReady and emaAlpha(elapsed, cfg.PingTau) or 1
            state.ping = state.ping + (ping - state.ping) * alpha
            state.pingSource, state.pingReady = source, true
        end
    end

    local function estimateVelocity(now)
        local count, meanTime, meanPosition = 0, 0, Vector3.zero
        for _, sample in ipairs(state.history) do
            if sample.time > 0 and now - sample.time <= cfg.HistoryWindow then
                count = count + 1
                meanTime = meanTime + (sample.time - now)
                meanPosition = meanPosition + sample.position
            end
        end
        if count < 2 then return nil end
        meanTime, meanPosition = meanTime / count, meanPosition / count
        local numerator, denominator = Vector3.zero, 0
        for _, sample in ipairs(state.history) do
            if sample.time > 0 and now - sample.time <= cfg.HistoryWindow then
                local timeOffset = (sample.time - now) - meanTime
                numerator = numerator + (sample.position - meanPosition) * timeOffset
                denominator = denominator + timeOffset * timeOffset
            end
        end
        if denominator <= 1e-8 then return nil end
        return limit(numerator / denominator, cfg.MaxVelocity)
    end

    local function pushSample(position, now)
        state.cursor = (state.cursor % #state.history) + 1
        state.count = math.min(state.count + 1, #state.history)
        state.history[state.cursor].time = now
        state.history[state.cursor].position = position
    end

    function api:Track(player, part, now)
        if state.destroyed then return false end
        now = now or os.clock()
        if not player or not player.Parent or not player.Character
            or not part or not part.Parent or not part:IsDescendantOf(player.Character) then
            self:Reset()
            return false
        end
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then self:Reset(); return false end
        if player ~= state.player or part ~= state.part or player.Character ~= state.character then
            bind(player, part)
        end
        pollPing(now)
        local position = (Hunter.PortalXTracker and Hunter.PortalXTracker.GetRealPosition(player)) or part.Position
        if not finiteVector(position) then self:Reset(); return false end
        local elapsed = state.lastSampleAt and (now - state.lastSampleAt) or nil
        if elapsed and elapsed < math.max(cfg.SampleInterval, 0.001) - 1e-5 and elapsed >= 0 then return true end
        if elapsed and (elapsed > cfg.ResetGap or elapsed <= 0
            or (position - state.lastPosition).Magnitude > math.max(cfg.TeleportDistance, cfg.MaxObservedSpeed * elapsed)) then
            clearHistory()
            state.mode, state.side = "TRAVEL", nil
            elapsed = nil
        end
        if not elapsed then
            pushSample(position, now)
            state.lastSampleAt, state.lastMotionAt, state.lastPosition = now, now, position
            return true
        end
        state.lastSampleAt = now
        local displacement = position - state.lastPosition
        local motionElapsed = now - (state.lastMotionAt or now)
        if displacement.Magnitude <= cfg.PositionEpsilon then
            local stopAfter = math.clamp(state.motionInterval * 1.75, cfg.StopDelay, 0.18)
            if motionElapsed >= stopAfter then
                local decay = math.exp(-elapsed / math.max(cfg.StopTau, 0.001))
                state.velocity = state.velocity * decay
                state.acceleration = state.acceleration * decay
                if state.velocity.Magnitude < 0.5 then state.velocity = Vector3.zero end
                state.stopped = true
            end
            return true
        end
        if state.stopped then
            motionElapsed = math.max(elapsed, math.min(motionElapsed, state.motionInterval))
            for _, sample in ipairs(state.history) do sample.time = 0 end
            state.count, state.cursor = 0, 0
            state.velocity, state.acceleration = Vector3.zero, Vector3.zero
            state.measuredVelocity, state.hasVelocity = Vector3.zero, false
            pushSample(state.lastPosition, now - motionElapsed)
        end
        motionElapsed = math.max(motionElapsed, 0.001)
        local segmentVelocity = limit(displacement / motionElapsed, cfg.MaxVelocity)
        state.motionInterval = state.motionInterval + (motionElapsed - state.motionInterval) * 0.25
        state.stopped = false
        pushSample(position, now)
        state.lastMotionAt, state.lastPosition = now, position
        local measured = estimateVelocity(now)
        if measured then
            local reversal = state.velocity.Magnitude > 8
                and segmentVelocity.Magnitude > 8 and segmentVelocity:Dot(state.velocity) < 0
            if reversal then
                local previous = ((state.cursor - 2) % #state.history) + 1
                for i, sample in ipairs(state.history) do
                    if i ~= state.cursor and i ~= previous then sample.time = 0 end
                end
                state.count = 2
                measured = segmentVelocity
            end
            local rawAcceleration = state.hasVelocity
                and limit((measured - state.measuredVelocity) / motionElapsed, cfg.MaxAcceleration)
                or Vector3.zero
            local alpha = emaAlpha(motionElapsed, reversal and cfg.TurnTau or cfg.VelocityTau)
            if not state.hasVelocity then alpha = math.min(alpha, 0.5) end
            state.velocity = state.velocity:Lerp(measured, alpha)
            state.acceleration = state.acceleration:Lerp(rawAcceleration, emaAlpha(motionElapsed, cfg.AccelerationTau))
            state.measuredVelocity, state.hasVelocity = measured, true
        end
        return true
    end

    function api:BeginCast(weapon, key, player, window)
        state.castSerial = state.castSerial + 1
        state.castTime, state.castUntil = nil, 0
        if player == state.player and player == Hunter.TargetPlayer then
            state.castTime = castTimes[tostring(weapon) .. "_" .. tostring(key)] or cfg.DefaultCastTime
            state.castUntil = os.clock() + math.clamp(tonumber(window) or 1, 0.1, 5)
        end
        return state.castSerial
    end
    function api:IsCastCurrent(serial, player)
        return serial == state.castSerial and player == state.player and isCurrentTarget(state.part)
    end
    function api:EndCast(serial)
        if serial == state.castSerial then state.castTime, state.castUntil = nil, 0 end
    end
    function api:GetLead(part, now)
        if not part or not part.Parent then return Vector3.zero end
        local position = (Hunter.PortalXTracker and state.player and Hunter.PortalXTracker.GetRealPosition(state.player)) or part.Position
        if not finiteVector(position) then return Vector3.zero end
        return position + Vector3.new(0, 0.2, 0)
    end

    function api:LookAt(position, aim, previous)
        local direction = aim - position
        if direction.Magnitude <= 1e-5 then
            return previous and (CFrame.new(position) * (previous - previous.Position)) or CFrame.new(position)
        end
        local up = math.abs(direction.Unit.Y) > 0.98 and Vector3.new(0, 0, 1) or Vector3.new(0, 1, 0)
        return CFrame.lookAt(position, aim, up)
    end
    function api:Face(root, aim)
        if not state.destroyed and root and root.Parent then
            local flatTarget = Vector3.new(aim.X, root.Position.Y, aim.Z)
            if (flatTarget - root.Position).Magnitude > 1e-4 then
                root.CFrame = CFrame.new(root.Position, flatTarget)
            end
        end
    end
    function api:Step(dt, root, humanoid)
        if Hunter.Noclip then Hunter.Noclip:Apply() end
        local part = state.part
        if not root or not root.Parent or not humanoid or humanoid.Health <= 0
            or not isCurrentTarget(part) then self:Pause(); return nil end
        dt = tonumber(dt) or 0
        if not finite(dt) then return nil end
        dt = math.clamp(dt, 0, math.max(cfg.MaxDt, 0.001))
        local position, targetPosition = root.Position, (Hunter.PortalXTracker and state.player and Hunter.PortalXTracker.GetRealPosition(state.player)) or part.Position
        if not finiteVector(position) or not finiteVector(targetPosition) then self:Pause(); return nil end
        local amInDimension = isLocalPlayerInPortalDimension()
        if amInDimension then
            local distToTarget = (targetPosition - position).Magnitude
            if distToTarget > 2500 or (state.player and not isPlayerInPortalVDimension(state.player)) then
                self:Pause()
                return nil
            end
        end
        local distance = (targetPosition - position).Magnitude
        state.distance = distance
        if state.mode == "COMBAT" then
            if distance >= cfg.ExitCombat then state.mode = "TRAVEL" end
        elseif distance <= cfg.EnterCombat then
            state.mode = "COMBAT"
        end
        local lead = self:GetLead(part)
        local horizon = math.clamp(cfg.MovementHorizon + state.ping * cfg.MovementPingWeight, 0, cfg.MaxMovementHorizon)
        local movementPrediction = state.velocity * horizon
        if not state.side then
            local delta = position - targetPosition
            local flat = Vector3.new(delta.X, 0, delta.Z)
            state.side = flat.Magnitude > 0.001 and flat.Unit or Vector3.new(1, 0, 0)
        end
        local flatPrediction = Vector3.new(movementPrediction.X, 0, movementPrediction.Z)
        local tangentialLead = flatPrediction - state.side * flatPrediction:Dot(state.side)
        local horizontal = state.side * cfg.CombatDistance + limit(tangentialLead, cfg.CombatMovementLead)
        if not state.movementOffset then state.movementOffset = horizontal end
        state.movementOffset = state.movementOffset:Lerp(horizontal, emaAlpha(dt, cfg.MovementOffsetTau))
        horizontal = state.movementOffset
        local closeOffset = horizontal.Magnitude > 0.001 and horizontal.Unit * cfg.CombatDistance
            or state.side * cfg.CombatDistance
        local blend = math.clamp((distance - cfg.EnterCombat) / math.max(cfg.ExitCombat - cfg.EnterCombat, 1), 0, 1)
        blend = blend * blend * (3 - 2 * blend)
        local travelOffset = limit(flatPrediction, cfg.MaxMovementLead) + state.side * cfg.CombatDistance
        local desired = targetPosition + closeOffset:Lerp(travelOffset, blend)
        local safeTargetY = targetPosition.Y
        if safeTargetY > -140 and safeTargetY < 5.5 and desired.X < 45000 and desired.Z < 30000 then
            safeTargetY = 5.5
        end
        if Hunter.PortalXTracker and state.player and Hunter.PortalXTracker.IsInPortalX(state.player) then
            safeTargetY = safeTargetY + 12
        end
        desired = Vector3.new(desired.X, safeTargetY, desired.Z)
        state.desiredPosition = desired
        local speed = state.mode == "COMBAT" and cfg.CombatSpeed or cfg.TravelSpeed
        ownRotation(humanoid)
        local nextPos = Hunter.Motion:StepPosition("FOLLOW", dt, root, desired, speed)
        if nextPos.Y > -140 and nextPos.Y < 5.5 and nextPos.X < 45000 and nextPos.Z < 30000 then
            nextPos = Vector3.new(nextPos.X, 5.5, nextPos.Z)
        end
        local facePos = isSkillHolding and lead or targetPosition
        local flatFace = Vector3.new(facePos.X, nextPos.Y, facePos.Z)
        return Hunter.Motion:Orient(root, nextPos, flatFace, dt), lead, state.mode
    end
    function api:GetDiagnostics()
        return {
            Mode = state.mode, Samples = state.count,
            Velocity = state.velocity, Acceleration = state.acceleration,
            PingSeconds = state.ping, PingSource = state.pingSource,
            CastTime = state.castTime or cfg.DefaultCastTime,
            CombatDistance = cfg.CombatDistance, DesiredPosition = state.desiredPosition,
            MotionUpdateInterval = state.motionInterval, Stopped = state.stopped,
        }
    end
    function api:Destroy()
        if state.destroyed then return end
        self:Reset()
        state.destroyed = true
        disconnect(state.connections)
        table.clear(state.history)
    end
    table.insert(state.connections, Players.PlayerRemoving:Connect(function(player)
        if state.player == player then api:Reset() end
    end))
    table.insert(state.connections, LocalPlayer.CharacterAdded:Connect(function() api:Reset() end))
    table.insert(state.connections, LocalPlayer.CharacterRemoving:Connect(function() api:Reset() end))
    return api
end)()

Hunter.Motion = (function()
    local api = {}
    local owner, currentRoot, velocity, expected, lastAt = nil, nil, Vector3.zero, nil, nil
    local function finite(value)
        return type(value) == "number" and value == value and math.abs(value) < math.huge
    end
    function api:Reset()
        owner, currentRoot, expected, lastAt = nil, nil, nil, nil
        velocity = Vector3.zero
    end
    function api:StepPosition(mode, dt, root, goal, speed)
        if Hunter.Noclip then Hunter.Noclip:Apply() end
        if not root or not root.Parent then return nil end
        dt = tonumber(dt) or 0
        if not finite(dt) or dt <= 0 then return root.Position end
        speed = tonumber(speed) or 220
        if not finite(speed) then speed = 220 end
        speed = math.clamp(speed, 1, 220)
        local now = os.clock()
        if owner == mode and currentRoot == root and lastAt then
            local elapsed = now - lastAt
            if elapsed > 0 then dt = elapsed end
        end
        dt = math.clamp(dt, 0, 0.10)
        local position = root.Position
        if owner ~= mode or currentRoot ~= root or not expected
            or (position - expected).Magnitude > math.max(12, speed * dt * 3) then
            velocity = Vector3.zero
        end
        owner, currentRoot, lastAt = mode, root, now
        local offset = goal - position
        local distance = offset.Magnitude
        if not finite(distance) then self:Reset(); return position end
        if distance <= 0.005 then velocity = Vector3.zero; expected = position; return position end
        local targetSpeed = math.min(speed, distance / 0.065)
        local desiredVelocity = offset.Unit * targetSpeed
        velocity = velocity:Lerp(desiredVelocity, 1 - math.exp(-dt / 0.055))
        local step = velocity * dt
        if step:Dot(offset) < 0 then step = Vector3.zero end
        local stepLength = step.Magnitude
        local maximum = math.min(distance, speed * dt)
        if stepLength > maximum and stepLength > 0 then step *= maximum / stepLength end
        expected = position + step
        return expected
    end
    function api:Orient(root, position, aim, dt)
        local desired = Hunter.Kinematics:LookAt(position, aim, root.CFrame)
        dt = math.clamp(tonumber(dt) or 0, 0, 0.1)
        local rotation = (root.CFrame - root.Position):Lerp(desired - desired.Position, 1 - math.exp(-dt / 0.045))
        return CFrame.new(position) * rotation
    end
    function api:Frame(mode, dt, root, goal, aim, speed)
        local position = self:StepPosition(mode, dt, root, goal, speed)
        if not position then return nil end
        return self:Orient(root, position, aim, dt)
    end
    function api:GetStatus() return {Owner = owner, Velocity = velocity, Position = expected} end
    table.insert(Hunter._connections, LocalPlayer.CharacterRemoving:Connect(function() api:Reset() end))
    api.Destroy = api.Reset
    return api
end)()

