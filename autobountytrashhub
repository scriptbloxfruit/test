local function discoverNativeStateAsync(char, serial)
    local scriptInstance = char:FindFirstChild("Soru") or char:WaitForChild("Soru", 3.0)
    if not scriptInstance or serial ~= bindingSerial or SoruBody.Destroyed or LocalPlayer.Character ~= char then return false end
    local getter = type(getupvalues) == "function" and getupvalues or debug and debug.getupvalues
    if type(getgc) ~= "function" or type(getfenv) ~= "function" or type(getter) ~= "function" then return false end
    local ok, list = pcall(getgc, false)
    if not ok or type(list) ~= "table" then return false end
    local sliceStart = os.clock()
    for i = 1, #list do
        if serial ~= bindingSerial or SoruBody.Destroyed or LocalPlayer.Character ~= char then return false end
        local fn = list[i]
        if type(fn) == "function" then
            local envOk, environment = pcall(getfenv, fn)
            if envOk and type(environment) == "table" and rawget(environment, "script") == scriptInstance then
                local upOk, values = pcall(getter, fn)
                if upOk and type(values) == "table" then
