local function getSpawnsForCurrentSea()
    local spawns = {}
    local seenNames = {}
    pcall(function()
        local worldOrigin = Workspace:FindFirstChild("_WorldOrigin")
        local pSpawns = worldOrigin and worldOrigin:FindFirstChild("PlayerSpawns")
        if pSpawns then
            local teamName = (LocalPlayer.Team and LocalPlayer.Team.Name) or "Pirates"
            local teamFolder = pSpawns:FindFirstChild(teamName) or pSpawns:FindFirstChild("Pirates") or pSpawns:FindFirstChild("Marines") or pSpawns:GetChildren()[1]
            if teamFolder then
                for _, spawnModel in ipairs(teamFolder:GetChildren()) do
                    pcall(function()
                        local pivot = spawnModel:GetPivot()
                        if pivot then
                            seenNames[spawnModel.Name] = true
                            table.insert(spawns, {
                                Name = spawnModel.Name,
                                Spawn = spawnModel.Name,
                                Pos = pivot.Position
                            })
                        end
                    end)
                end
            end
        end
    end)
    local sea = getCurrentSeaNum()
    local baseList = SEA_SPAWNS[sea] or SEA_SPAWNS[3]
    for _, sp in ipairs(baseList) do
        if not seenNames[sp.Spawn] and not seenNames[sp.Name] then
            table.insert(spawns, sp)
        end
    end
    return spawns
end
local function getNearestSpawn(targetPos)
    local spawns = getSpawnsForCurrentSea()
    local best, bestDist = nil, math.huge
    for _, sp in ipairs(spawns) do
        local d = (sp.Pos - targetPos).Magnitude
        if d < bestDist then
            best = sp
            bestDist = d
        end
    end
    return best, bestDist
end

