                    pillStartPos.Y.Scale,
                    pillStartPos.Y.Offset + delta.Y
                )
            end
        end
    end))

    table.insert(Hunter._hudConnections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isPillDragging = false
        end
    end))

    local isStatsDragging = false
    local statsDragStart = nil
    local statsStartPos = nil

    table.insert(Hunter._hudConnections, statsContainer.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isStatsDragging = true
            statsDragStart = input.Position
            statsStartPos = statsContainer.Position
        end
    end))

    table.insert(Hunter._hudConnections, UserInputService.InputChanged:Connect(function(input)
        if isStatsDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - statsDragStart
            if statsStartPos then
                statsContainer.Position = UDim2.new(
                    statsStartPos.X.Scale,
                    statsStartPos.X.Offset + delta.X,
                    statsStartPos.Y.Scale,
                    statsStartPos.Y.Offset + delta.Y
                )
            end
        end
    end))

    table.insert(Hunter._hudConnections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isStatsDragging = false
        end
    end))

    table.insert(Hunter._hudConnections, pillClickButton.MouseEnter:Connect(function()
        TweenService:Create(pillStroke, TweenInfo.new(0.2), {Transparency = 0.35}):Play()
    end))
    table.insert(Hunter._hudConnections, pillClickButton.MouseLeave:Connect(function()
        TweenService:Create(pillStroke, TweenInfo.new(0.2), {Transparency = 0.65}):Play()
    end))
    table.insert(Hunter._hudConnections, pillClickButton.MouseButton1Click:Connect(function()
        if pillHasMoved then return end
        local now = tick()
        if now - _lastToggleTick < 0.15 then return end
        _lastToggleTick = now

        isContentVisible = not isContentVisible
        statsContainer.Visible = isContentVisible

        if isContentVisible then
            statsContainer.AutomaticSize = Enum.AutomaticSize.None
            statsContainer.Size = UDim2.new(0.35, 0, 0, 0)
            task.defer(function()
                if statsContainer and statsContainer.Parent then
                    statsContainer.AutomaticSize = Enum.AutomaticSize.Y
                end
            end)
        end

        TweenService:Create(pillFrame, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0.98, 0, 1, -2)
        }):Play()
        task.delay(0.08, function()
            if pillFrame and pillFrame.Parent then
                TweenService:Create(pillFrame, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Size = UDim2.new(1, 0, 1, 0)
                }):Play()
            end
        end)
    end))

    table.insert(Hunter._hudConnections, resetBtn.MouseEnter:Connect(function()
        TweenService:Create(resetBtn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(255, 175, 40)}):Play()
    end))
    table.insert(Hunter._hudConnections, resetBtn.MouseLeave:Connect(function()
        TweenService:Create(resetBtn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(255, 140, 0)}):Play()
    end))
    table.insert(Hunter._hudConnections, resetBtn.MouseButton1Click:Connect(function()
        TweenService:Create(resetBtn, TweenInfo.new(0.08), {BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        task.delay(0.12, function()
            if resetBtn and resetBtn.Parent then
                TweenService:Create(resetBtn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(255, 140, 0)}):Play()
            end
        end)

        _totalActiveTime = 0
        _sessionStartTime = os.time()
        _totalKills = 0
        _serverKillsCount = 0
        _countedServerKills = {}
        if Hunter then
            Hunter.TotalKills = 0
            Hunter._lastProcessedVictim = ""
            Hunter._lastProcessedKillTime = 0
                    end
        getgenv()._TrashHubTotalKills = 0
        _earnedBounty = 0
        getgenv()._TrashHubEarnedBounty = 0

        local cur = getPlayerBounty(LocalPlayer)
        if cur and cur > 0 then
            _lastKnownBounty = cur
        end
        saveStatsToJson()

        _hudLastHours = 0
        _hudLastMins = 0
        _hudLastKills = 0
        _hudLastEarned = 0
        _hudLastBounty = (cur and cur > 0 and cur) or (_lastKnownBounty and _lastKnownBounty > 0 and _lastKnownBounty) or 0

        bountyLabel.Text = "Current Bounty: " .. formatNumber(_hudLastBounty)
        timeLabel.Text = "Time: 0h 0m"
        killLabel.Text = "Total Kill: 0"
        earnedLabel.Text = "Total Earned: +0"
        earnedLabel.TextColor3 = _COLOR_EARNED_POS

        if type(showBottomRightNotify) == "function" then
            showBottomRightNotify("Reset Stats", "Time, Kills & Earned -> 0", Color3.fromRGB(255, 140, 0), "Detail", "Stats saved to JSON")
        end
    end))

    local function _updateHudContent()
        if Hunter.CheckBountyLoss then
            Hunter.CheckBountyLoss()
        end
        local bounty = getPlayerBounty(LocalPlayer)
        if (not bounty or bounty <= 0) and _lastKnownBounty and _lastKnownBounty > 0 then
            bounty = _lastKnownBounty
        end
        local elapsed = getActiveElapsedTime()
        local hours = math.floor(elapsed / 3600)
        local mins = math.floor((elapsed % 3600) / 60)
        local earnedNow = _earnedBounty or 0

        if bounty ~= _hudLastBounty then
            bountyLabel.Text = "Current Bounty: " .. formatNumber(bounty or 0)
            _hudLastBounty = bounty
        end
        if hours ~= _hudLastHours or mins ~= _hudLastMins then
            timeLabel.Text = string.format("Time: %dh %dm", hours, mins)
            _hudLastHours = hours
            _hudLastMins = mins
        end
        local killsNow = _totalKills or 0
        if killsNow ~= _hudLastKills then
            killLabel.Text = "Total Kill: " .. tostring(killsNow)
            _hudLastKills = killsNow
        end
        if earnedNow ~= _hudLastEarned then
            earnedLabel.Text = "Total Earned: " .. (earnedNow < 0 and "" or "+") .. formatNumber(earnedNow)
            earnedLabel.TextColor3 = earnedNow < 0 and _COLOR_EARNED_NEG or _COLOR_EARNED_POS
            _hudLastEarned = earnedNow
        end

        local targetPlayer = Hunter.TargetPlayer
        local targetChar = Hunter.TargetCharacter or (targetPlayer and targetPlayer.Character)
        local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
        local targetRoot = Hunter.TargetPart or (targetChar and (targetChar:FindFirstChild("HumanoidRootPart") or targetChar.PrimaryPart))
        local myChar = LocalPlayer.Character
        local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart)

        local infoTextVal = nil
        local statusDotColorVal = nil
        if isHopping then
            if isBountyAtRisk() then
                infoTextVal = "Changing server... | Climbing sky (Bounty at risk)"
            else
                infoTextVal = "Changing server... | Waiting for safe teleport"
            end
            statusDotColorVal = _COLOR_STATUS_HOPPING
        elseif targetPlayer and targetChar and targetHum and targetHum.Health > 0 and targetRoot and myRoot then
            local name = targetPlayer.DisplayName or targetPlayer.Name
            local hp = math.clamp(math.floor((targetHum.Health / math.max(targetHum.MaxHealth, 1)) * 100), 0, 100)
            local realTargetPos = (Hunter.PortalXTracker and Hunter.PortalXTracker.GetRealPosition(targetPlayer)) or targetRoot.Position
            local dist = math.floor((realTargetPos - myRoot.Position).Magnitude)
            local portalXTag = (Hunter.PortalXTracker and Hunter.PortalXTracker.IsInPortalX(targetPlayer)) and " [X-Portal]" or ""
            infoTextVal = string.format("%s%s | HP: %d%% | Dist: %d", name, portalXTag, hp, dist)
            statusDotColorVal = _COLOR_STATUS_ACTIVE
        else
            if isBountyAtRisk() then
                infoTextVal = "Combat Retreat | Climbing to safe sky... | Bounty at risk"
                statusDotColorVal = _COLOR_STATUS_HOPPING
            else
                infoTextVal = "Searching... | HP: -- | Dist: --"
                statusDotColorVal = _COLOR_STATUS_SEARCHING
            end
        end

        if infoTextVal ~= _hudLastInfoText then
            infoText.Text = infoTextVal
            _hudLastInfoText = infoTextVal
        end
        if statusDotColorVal ~= _hudLastStatusColor then
            statusDot.BackgroundColor3 = statusDotColorVal
            _hudLastStatusColor = statusDotColorVal
        end
    end

    local hudConn
    hudConn = RunService.Heartbeat:Connect(function()
        if not screenGui.Parent then
            if hudConn then pcall(hudConn.Disconnect, hudConn) end
            return
        end
        local now = os.clock()
        if now - lastUpdate < 0.18 then return end
        lastUpdate = now

        pcall(_updateHudContent)
    end)
    if Hunter._hudConn then
        pcall(function() Hunter._hudConn:Disconnect() end)
        Hunter._hudConn = nil
    end
    Hunter._hudConn = hudConn
    table.insert(Hunter._hudConnections, hudConn)
    return screenGui
end

task.delay(1.0, function()
    if not (Hunter and Hunter._isRunning) then return end
    local uiOk, uiResult = pcall(createTrashHubHud)
    if uiOk then
        Hunter._gui = uiResult
    else
        Hunter._gui = nil
    end
end)

task.spawn(function()
    while Hunter and Hunter._isRunning do
        task.wait(2.0)
        local gui = Hunter._gui
        if not gui or not gui.Parent or not gui:IsDescendantOf(game) then
            pcall(function()
                local ok, newGui = pcall(createTrashHubHud)
                if ok and newGui then
                    Hunter._gui = newGui
                end
            end)
        end
    end
end)

table.insert(Hunter._connections, LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1.0)
    if Hunter and Hunter._isRunning then
        local gui = Hunter._gui
        if not gui or not gui.Parent or not gui:IsDescendantOf(game) then
            pcall(function()
                local ok, newGui = pcall(createTrashHubHud)
                if ok and newGui then
                    Hunter._gui = newGui
                end
            end)
        end
    end
end))
end

function Hunter.Destroy()
    Hunter._isRunning = false
    if Hunter.M1GunAim then pcall(Hunter.M1GunAim.Destroy, Hunter.M1GunAim) end
    if Hunter.PortalXTracker then pcall(Hunter.PortalXTracker.Destroy) end
    if Hunter.KenCheck and type(Hunter.KenCheck.Destroy) == "function" then pcall(Hunter.KenCheck.Destroy) end
        if Hunter.SkillCheck then pcall(Hunter.SkillCheck.ClearCache) end
    if Hunter.SkillDodge then pcall(Hunter.SkillDodge.Destroy, Hunter.SkillDodge) end
    if Hunter.WaterWalker then pcall(Hunter.WaterWalker.Destroy, Hunter.WaterWalker) end
    if Hunter.SoruApproach then pcall(Hunter.SoruApproach.Destroy, Hunter.SoruApproach) end
    if Hunter.GhostShipRoute then pcall(Hunter.GhostShipRoute.Destroy, Hunter.GhostShipRoute) end
    if Hunter.Sea3TeleporterRoute then pcall(Hunter.Sea3TeleporterRoute.Destroy, Hunter.Sea3TeleporterRoute) end
    if Hunter.AntiLava then pcall(Hunter.AntiLava.Destroy, Hunter.AntiLava) end
    pcall(function() Hunter.Kinematics:Destroy() end)
    pcall(releaseLowHealthEscape, "destroy")
    for _, conn in ipairs(Hunter._connections) do pcall(function() conn:Disconnect() end) end
    pcall(function() RunService:UnbindFromRenderStep("BF_AimOverride_Post") end)
    if Hunter._laserAdorn then pcall(function() Hunter._laserAdorn:Destroy() end) end
    if Hunter._targetHighlight then pcall(function() Hunter._targetHighlight:Destroy() end) end
    if Hunter._skeletonLines then
        for _, line in pairs(Hunter._skeletonLines) do
            if line and type(line.Remove) == "function" then
                pcall(function() line:Remove() end)
            end
        end
        Hunter._skeletonLines = {}
    end
    if Hunter._hudConn then
        pcall(function() Hunter._hudConn:Disconnect() end)
        Hunter._hudConn = nil
    end
    if Hunter._hudConnections then
        for _, conn in ipairs(Hunter._hudConnections) do
            pcall(function() conn:Disconnect() end)
        end
        Hunter._hudConnections = nil
    end
    if Hunter._gui then pcall(function() Hunter._gui:Destroy() end) end
    pcall(function()
        for _, gName in ipairs({"TrashHub_FluentNotifyGui", "HopToastGui"}) do
            local c = game:GetService("CoreGui"):FindFirstChild(gName)
            if c then c:Destroy() end
            local pgui = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
            local p = pgui and pgui:FindFirstChild(gName)
            if p then p:Destroy() end
            if type(gethui) == "function" then
                local hui = gethui()
                local h = hui and hui:FindFirstChild(gName)
                if h then h:Destroy() end
            end
        end
    end)
    pcall(function()
        local wp = Workspace:FindFirstChild("BF_WaterWalkerPlatform")
        if wp then wp:Destroy() end
    end)
    setHover(false)
    if Hunter._bloxMouse then
        pcall(function()
            rawset(Hunter._bloxMouse, "Hit", Hunter._storedHit or RealMouse.Hit)
            rawset(Hunter._bloxMouse, "Target", Hunter._storedTarget or RealMouse.Target)
            rawset(Hunter._bloxMouse, "X", Hunter._storedX or RealMouse.X)
            rawset(Hunter._bloxMouse, "Y", Hunter._storedY or RealMouse.Y)
        end)
    end
    for _, connName in ipairs({
        "_TrashHub_SoundMuteConn", "_TrashHub_CleanMapConn", "_TrashHub_SeatConn",
        "_TrashHub_MainCharConn", "_TrashHub_KenCharConn", "_TrashHub_SpawnCombatConn", "_TrashHubNoclipConn",
        "_TrashHub_KenChildConn", "_TrashHub_KenAttrConn", "_TrashHub_NotifConn", "_TrashHub_EscapeConn",
        "_TrashHub_CameraConn", "_TrashHub_DiedConn", "_TrashHub_ZeroDelayConn",
        "_TrashHub_LowHpHeartbeat", "_TrashHub_V4EnergyConn", "_TrashHub_V4ChildConn",
        "_TrashHub_V4CharConn"
    }) do
        pcall(function()
            if getgenv()[connName] then
                getgenv()[connName]:Disconnect()
                getgenv()[connName] = nil
            end
        end)
    end
    getgenv()._BF_HunterKiller = nil
    getgenv()._BF_AimBot = nil
    getgenv()._TrashHub_GCLoopGen = nil
    getgenv()._TrashHub_BoostGen = nil
    if getgenv()._TrashHub_BoostConnections then
        for _, c in ipairs(getgenv()._TrashHub_BoostConnections) do
            pcall(function() c:Disconnect() end)
        end
        getgenv()._TrashHub_BoostConnections = nil
    end
    if getgenv()._TrashHub_NotifTextConns then
        for _, c in ipairs(getgenv()._TrashHub_NotifTextConns) do
            pcall(function() c:Disconnect() end)
        end
        getgenv()._TrashHub_NotifTextConns = nil
    end
    if getgenv()._TrashHub_HealthConns then
        for _, conn in ipairs(getgenv()._TrashHub_HealthConns) do
            pcall(function() conn:Disconnect() end)
        end
        getgenv()._TrashHub_HealthConns = nil
    end
    isHopping = false
    Hunter._isHealingInSky = false
end
return Hunter
