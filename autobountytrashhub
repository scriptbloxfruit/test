local _bountyRiskSafeSince = nil
local _bountyRiskLastObservationAt = nil
local _bountyRiskCharacter, _bountyRiskWidget = nil, nil
local BOUNTY_SAFE_CLEAR_SECONDS = 2

local function readBountyRisk()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local main = playerGui and playerGui:FindFirstChild("Main")
    local bottom = main and main:FindFirstChild("BottomHUDList")
    local widget = (bottom and bottom:FindFirstChild("InCombat")) or (main and main:FindFirstChild("InCombat"))
    if not widget or not widget:IsA("GuiObject") then return "unknown", "combat-widget-unavailable", widget end
    if widget.Visible == false then return "safe", "combat-indicator-inactive", widget end

    local risk, ordinaryCombat, unknownText = false, false, false
    local function inspect(label)
        if not (label:IsA("TextLabel") or label:IsA("TextButton") or label:IsA("TextBox")) then return end
        local ancestor = label
        while ancestor and ancestor ~= widget do
            if ancestor:IsA("GuiObject") and ancestor.Visible == false then return end
            ancestor = ancestor.Parent
        end
        local text = tostring(label.Text or ""):gsub("<[^>]*>", ""):lower():gsub("%s+", " ")
        local letters = text:gsub("[^a-z]", "")
        if text:find("at risk", 1, true) then
            risk = true
        elseif letters == "incombat" then
            ordinaryCombat = true
        elseif text:match("%S") and not text:match("^[%d%s%p]+$") then
            unknownText = true
        end
    end
    inspect(widget)
    for _, descendant in ipairs(widget:GetDescendants()) do inspect(descendant) end
    if risk then return "risk", "bounty-or-honor-at-risk", widget end
    if ordinaryCombat and not unknownText then return "safe", "ordinary-in-combat", widget end
    return "unknown", "unrecognized-combat-indicator", widget
end

